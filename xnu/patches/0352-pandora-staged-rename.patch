--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -14770,5 +14770,24 @@ pandora_rmrf(const char *path)
 	(void)pandora_rmrf_walk(vp, path);
 	vnode_put(vp);
 	return pandora_rmdir(path);
 }
+
+/* Staged system apps move across directories on the root volume before the cache mount.
+ * renameat_internal takes mount_lock_renames when the parents differ. fchownat_internal with
+ * AT_SYMLINK_NOFOLLOW does not follow a link into /System. */
+int
+pandora_rename(const char *from, const char *to)
+{
+	return renameat_internal(vfs_context_kernel(), AT_FDCWD,
+	    CAST_USER_ADDR_T(from), AT_FDCWD, CAST_USER_ADDR_T(to),
+	    UIO_SYSSPACE, 0);
+}
+
+int
+pandora_lchown(const char *path, uid_t uid, gid_t gid)
+{
+	return fchownat_internal(vfs_context_kernel(), AT_FDCWD,
+	    CAST_USER_ADDR_T(path), uid, gid, AT_SYMLINK_NOFOLLOW,
+	    UIO_SYSSPACE);
+}
 #endif /* PANDORA */
