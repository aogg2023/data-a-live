--- /dev/null
+++ b/bsd/dev/pandora_cachevol.c
@@ -0,0 +1,73 @@
+/*
+ * PANDORA GPU cache volume (0273).
+ *
+ * The GPU shader cache (/var/tmp/.../m2v) needs a writable file system with free space, but the
+ * root volume is deliberately not grown (a grown volume makes the iOS data migration start and
+ * never finish). Instead deploy writes a second, small empty HFS+ volume into a pinned userdata
+ * region; sweet_ufs exposes it as /dev/ufscache0 (0272) and this file mounts it at
+ * /private/var/tmp before launchd starts.
+ *
+ * Boot-arg pandora_cachevol=1 enables it (default off, so a bad volume can never stop the boot).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/mount_internal.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+
+extern int pandora_mount_hfs(const char *dev, const char *mnt);
+extern vnode_t rootvnode;
+extern kern_return_t thread_terminate(thread_t);
+extern int kernel_thread_start(thread_continue_t, void *, thread_t *);
+
+static int cv_chan;
+
+static void
+cv_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&cv_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+pandora_cachevol_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	int on = 0;
+	(void)PE_parse_boot_argn("pandora_cachevol", &on, sizeof(on));
+	if (!on) {
+		goto out;
+	}
+	/* Wait until the root volume is mounted, then let launchd read its plists from it. */
+	for (int i = 0; i < 600 && rootvnode == NULLVP; i++) {
+		cv_sleep(100);
+	}
+	if (rootvnode == NULLVP) {
+		printf("PANDORA CACHE: no root, not mounting /private/var/tmp\n");
+		goto out;
+	}
+	cv_sleep(1500);
+	int error = pandora_mount_hfs("/dev/ufscache0", "/private/var/tmp");
+	printf("PANDORA CACHE: mount /dev/ufscache0 on /private/var/tmp -> %d\n", error);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+pandora_cachevol_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(pandora_cachevol_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
