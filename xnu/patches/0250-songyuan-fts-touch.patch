+/*
+ * SONGYUAN (Redmi K90 Pro Max, SM8850) main screen touch: FocalTech FT3683 on
+ * QUPv3 wrapper 4 SE0 (0x01a80000), polled through the wrapper's GPI DMA.
+ *
+ * Engine layer: pandora_touch.c (same SoC, same QUP4 SE0, already set up for
+ * GSI with the FIFO interface disabled): the SM8850 GCC registers, the RCG
+ * level, the TLMM pins, the GENI SE registers, the GPI DMA rings and the apps
+ * SMMU stream matches are that file's, unchanged. Hardware facts: the myron
+ * board data for this phone (spi@1a80000 / qupv3_4, pinctrl@f100000,
+ * gcc-kaanapali.c) and myron's driver for this IC. Protocol: FocalTech
+ * register frames and the 0x01 touch frame (84 bytes, CRC-16/MCRF4XX, v1/v2
+ * points), as myron's driver exercises them on this phone. fuxi's FTS driver
+ * (xnu/patches/0091-fuxi-touch-fts-spi.patch) supplied the shape of the thread,
+ * poll and report functions; its register transaction is the ST FTS one
+ * (opcode + address, then a dummy byte and n data bytes) and does not apply to
+ * this IC, so the frames below are FocalTech's.
+ *
+ * Sources, per constant, are given next to the constant and tabulated in
+ * REPORT.md. In short:
+ *   MYRON = E:\songyuan\ref\myron\myron-device\package\MyronTouchBoard.h (authoritative
+ *           board data for songyuan; the same phone as myron)
+ *   MYRONC = ...\MyronTouch.cpp (the same FTS/QUP4 sequence on this phone)
+ *   PAND = E:\songyuan\ref\data-a-live\wsl\pandora_touch.c (SM8850 engine)
+ *   FUXI = E:\songyuan\ref\data-a-live\xnu\patches\0091-fuxi-touch-fts-spi.patch
+ *
+ * Boot-args:
+ *   songyuan_fts=1        enable; default 0, the driver does nothing
+ *   songyuan_ftshz=HZ     SPI clock, 100000..15000000 Hz (MYRONC:535); default
+ *                         9600000 (MYRON:69: the DT allows 15 MHz, the first
+ *                         runs stay below it)
+ *   songyuan_ftsdelay=S   seconds before the first register access (default 5)
+ *
+ * Power: avdd is a fixed regulator enabled by TLMM GPIO 117, active high
+ * (MYRON:45) - a pin, so no RPMh/RSC vote is needed and none is here (PAND's
+ * RSC block voted an iovdd rail, not this avdd). iovdd (L4I, 1.8 V) *is* an
+ * RPMh rail that XNU cannot switch (MYRONC:20); it is not touched here, which
+ * is the first thing to suspect when the chip does not answer (REPORT.md).
+ */
+/*
+ * TODO(REPORT.md U4): the songyuan machine config must define SONGYUAN, as
+ * MACHINE_FLAGS_ARM64_PANDORA defines PANDORA (0102:166). Without it this file
+ * compiles to nothing and songyuan_touch_init() fails to link - a loud failure,
+ * but the flag itself is not in the evidence read for this port.
+ */
+#if defined(SONGYUAN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+#include <vm/pmap.h>
+#include <arm/caches_internal.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern kern_return_t kernel_thread_start_priority(thread_continue_t continuation,
+    void *parameter, integer_t priority, thread_t *new_thread);
+void songyuan_touch_init(void);
+
+/* ---- hardware ------------------------------------------------------------------ */
+
+/* Register regions (MYRON:11-15,41; PAND:50-52 maps the same values). */
+#define SY_GCC_PA	0x00100000u	/* MYRON:15 */
+#define SY_SE_PA	0x01a80000u	/* MYRON:12: spi@1a80000 = qupv3_se19_spi = QUP4 SE0 */
+#define SY_SE_SIZE	0x4000u		/* MYRON:13; PAND:1576 */
+#define SY_TLMM_PA	0x0f100000u	/* MYRON:41; 0x0f0xxxxx aborts (PAND:9-10) */
+#define SY_GPIO(n)	((uint32_t)(n) * 0x1000u)	/* MYRON:42, offset of the pin's CFG */
+#define SY_IRQ		158u		/* MYRON:46, active low, low until the frame is read */
+#define SY_RESET	66u		/* MYRON:44 */
+#define SY_AVDD		117u		/* MYRON:45, fixed regulator, enable active high */
+#define SY_FINGERS	10u		/* MYRON:113-116: v2 count 1..10, every id below 10 */
+#define SY_XFER_MAX	4096u		/* PAND:116: DMA TX 0x2000-0x2fff, RX 0x3000-0x3fff */
+#define SY_DMA_SIZE	0x4000u		/* PAND:334 */
+#define SY_PRIORITY	92		/* PAND:61: BASEPRI_PREEMPT, as fuxi_touch */
+
+/* GCC (MYRON:17-38; PAND:63-71 holds the identical offsets). */
+#define SY_GCC_VOTE	0x52018u	/* MYRON:17; PAND:64 */
+#define SY_GCC_VOTE_BITS (0x1fu << 22)	/* MYRON:19-24: m_ahb s_ahb core core2x s0 */
+#define SY_GCC_M_AHB	0x23548u	/* MYRON:25 */
+#define SY_GCC_S_AHB	0x2354cu	/* MYRON:26 */
+#define SY_GCC_CORE	0x23550u	/* MYRON:27 */
+#define SY_GCC_CORE2X	0x23564u	/* MYRON:28 */
+#define SY_GCC_S0	0xa9004u	/* MYRON:29 */
+#define SY_GCC_S0_RCG	0xa9014u	/* MYRON:33; PAND:71: CMD; CFG +4, DFSR +0x14 */
+#define SY_GCC_CLK_OFF	0x80000000u	/* MYRON:30 */
+
+/* GENI serial engine (all PAND:74-116; the register file is QUPv3's, not
+ * board-specific, and pandora reads and writes these on this SoC). */
+#define SE_FORCE_DEFAULT 0x020u
+#define SE_OUTPUT_CTRL   0x024u
+#define SE_CGC_CTRL      0x028u
+#define SE_STATUS        0x040u
+#define SE_M_CLK_CFG     0x048u
+#define SE_IF_DISABLE    0x064u
+#define SE_FW_REV        0x068u
+#define SE_CLK_SEL       0x07cu
+#define SE_SPI_CPHA      0x224u
+#define SE_SPI_LOOPBACK  0x22cu
+#define SE_SPI_CPOL      0x230u
+#define SE_SPI_DEMUX_INV 0x24cu
+#define SE_SPI_DEMUX_SEL 0x250u
+#define SE_BYTE_GRAN     0x254u
+#define SE_DMA_MODE      0x258u
+#define SE_TX_PACK0      0x260u
+#define SE_TX_PACK1      0x264u
+#define SE_SPI_WORD_LEN  0x268u
+#define SE_SPI_TX_LEN    0x26cu
+#define SE_SPI_RX_LEN    0x270u
+#define SE_RX_PACK0      0x284u
+#define SE_RX_PACK1      0x288u
+#define SE_M_CMD0        0x600u
+#define SE_M_CMD_CTRL    0x604u
+#define SE_M_IRQ         0x610u
+#define SE_M_IRQ_EN      0x614u
+#define SE_M_IRQ_CLR     0x618u
+#define SE_S_IRQ_CLR     0x648u
+#define SE_TX_FIFO       0x700u
+#define SE_RX_FIFO       0x780u
+#define SE_TX_STATUS     0x800u
+#define SE_RX_STATUS     0x804u
+#define SE_TX_WM         0x80cu
+#define SE_RX_WM         0x810u
+#define SE_RX_RFR_WM     0x814u
+#define SE_DMA_TX_CLR    0xc44u
+#define SE_DMA_RX_CLR    0xd44u
+#define SE_GSI_EVENT_EN  0xe18u
+#define SE_IRQ_EN        0xe1cu
+#define SE_HW_PARAM0     0xe24u
+#define SE_HW_PARAM1     0xe28u
+#define SY_SPI_DIV	2u		/* PAND:115: 19.2 MHz XO / 2 = 9.6 MHz (MYRON:69) */
+
+/* GPI DMA of wrapper 4. PAND:321-345: qcom,gpi-dma@1a00000, ee-offset 0x10000,
+ * GPII 1 (the first of the DT's HLOS gpii-mask 0x1e); per-GPII window =
+ * ee base (0x1a00000 - 0x10000) + 0x20000 + 0x4000 * n. fuxi's ft_gpi_init is
+ * the same recipe (FUXI:237-307). The myron board data does not list the GPI
+ * base, so pandora's is used: same SoC, same wrapper (REPORT.md, D1). */
+#define SY_GPII	1u
+#define SY_GPI_PA	(0x01a00000u - 0x10000u + 0x20000u + 0x4000u * SY_GPII)
+#define SY_GPI_SIZE	0x4000u
+#define SY_EV_OFF	0x0000u
+#define SY_RING_OFF(k)	(0x1000u + 0x400u * (k))
+#define SY_TXB_OFF	0x2000u		/* PAND:337: up to 0x800 */
+#define SY_RXB_OFF	0x3000u		/* PAND:338: up to 0x1000 */
+#define SY_RING		64u
+#define SY_EVRING	256u
+#define GPI_CH(k)	(0x0000u + 0x80u * (k))
+#define GPI_EV		0x1000u
+#define GPI_CHDB(k)	(0x2000u + 8u * (k))
+#define GPI_EVDB	0x2100u
+#define GPI_GPII	0x3000u
+
+/* Apps SMMU (MYRON:162-164; PAND:331-333,386-431). */
+#define SY_SMMU_PA	0x15000000u	/* MYRON:162 */
+#define SY_QUP4_SMMU_SID 0x523u		/* MYRON:163: qupv3_4 SE DMA (GPI is 0x536) */
+#define SY_GPI_SMMU_SID	0x536u		/* MYRON:163 */
+#define SY_UFS_SMMU_SID	0x60		/* MYRON:164: the stream whose routing is copied */
+
+/* FocalTech FT3683 (MYRON:104-119,155-156; MYRONC:22-24,305-359). */
+#define SY_FTS_FRAME	84u		/* MYRON:117: the 0x01 frame */
+#define SY_FTS_MAX	128u		/* driver buffer: 84 + 7 + 2 fits with room */
+#define SY_FTS_HDR	7u		/* MYRONC:22-23: addr, opcode, len hi/lo, 3 dummy */
+#define SY_FTS_READ	0xa0u		/* MYRONC:310: read opcode */
+#define SY_FTS_WRITE	0x00u		/* MYRONC:327 */
+#define SY_FTS_STATUS	0xa0u		/* MYRONC:313: status byte 3 must have 0xA0 clear */
+#define SY_FTS_ADDR_FRAME 0x01u		/* MYRON:25: contacts at 0x01 in TIC mode */
+#define SY_FTS_ADDR_ID_A3 0xa3u		/* MYRONC:340 */
+#define SY_FTS_ADDR_ID_9F 0x9fu		/* MYRONC:341 */
+#define SY_FTS_ADDR_FW	0xa6u		/* MYRONC:345 */
+#define SY_FTS_ADDR_TIC	0x9eu		/* MYRON:26: 0x9E = 0 enters TIC mode */
+#define SY_FTS_ID_A3	0x36u		/* MYRONC:342 (FT3683, MYRONC:2) */
+#define SY_FTS_ID_9F	0x83u		/* MYRONC:342 */
+#define SY_FTS_TIC_MODE	0x00u		/* MYRONC:351 */
+#define SY_FTS_TRIES	3u		/* MYRONC:308: three attempts per frame */
+#define SY_FTS_ID_TRIES	5u		/* MYRONC:339 */
+#define SY_CS_HIGH_MS	1u		/* MYRONC:298: 150 us chip-select high; delay(1) >= that */
+#define SY_PANEL_W	1200u		/* MYRON:70: points come in 1/16 pixel */
+#define SY_PANEL_H	2608u		/* MYRON:71 */
+#define SY_LOGICAL_W	1125u	/* data-a-live pandora_touch.c:1286-1304: presented width */
+#define SY_LOGICAL_H	2436u	/* presented height (0125/0126 fill) */
+#define SY_SPI_HZ	9600000u	/* MYRON:69 */
+#define SY_SPI_HZ_MIN	100000u		/* MYRONC:535 */
+#define SY_SPI_HZ_MAX	15000000u	/* MYRONC:535, MYRON:69 (DT ceiling) */
+#define SY_IDLE_POLLS	12u		/* ~100 ms of 8 ms sleeps (MYRONC:483) */
+
+/* TLMM CFG words (MYRON:48-52,53-54,58-59): the reference values. sy_gpio()
+ * takes the same word apart (pull, function, drive, output enable), so the
+ * calls in sy_power_on() read as the board data writes them. */
+#define SY_CFG_SPI_DATA	0x84u		/* func 1, 6 mA, no pull (MISO, MOSI) */
+#define SY_CFG_SPI_CLK	0x44u		/* func 1, 4 mA */
+#define SY_CFG_SPI_CS	0x87u		/* func 1, 6 mA, pull-up */
+#define SY_CFG_INPUT_PULLUP 0x3u	/* input, pull-up */
+#define SY_CFG_OUTPUT	0x240u		/* output (OE), 4 mA, no pull */
+#define SY_CFG_LOW_MASK	0x3ffu
+#define SY_CFG_EGPIO_PRESENT (1u << 11)
+#define SY_CFG_EGPIO_ENABLE (1u << 12)
+#define SY_FUNC_QUP4_SE0 1u		/* MYRON:47 */
+
+static struct {
+	vm_offset_t gcc, se, tlmm, gpi, smmu, dma;
+	uint64_t dma_pa;
+	bool started, dead;
+	unsigned level;			/* DFS level the RCG is on (PAND:304) */
+	unsigned hz, spi_div, actual_hz;
+	unsigned wp[2], evrp;
+	uint8_t tx[SY_FTS_MAX], rx[SY_FTS_MAX];
+	uint32_t active;		/* fingers delivered down */
+	int x[SY_FINGERS], y[SY_FINGERS];	/* last delivered, HID axes */
+	unsigned frames, touch_frames, type_v1, type_v2, restarts, errors, bad;
+	unsigned logs;			/* bounded frame/CRC logs */
+	unsigned logged_frames;
+	unsigned last_count;
+	uint8_t frame[SY_FTS_FRAME];
+} sy;
+static int sy_chan;
+
+/* ---- mmio, sleep, pins ---------------------------------------------------------- */
+
+static uint32_t
+sy_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+sy_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+sy_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&sy_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+sy_sleep_until(uint64_t deadline)
+{
+	(void)assert_wait_deadline_with_leeway(&sy_chan, THREAD_UNINT,
+	    TIMEOUT_URGENCY_SYS_CRITICAL, deadline, 0);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+sy_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask, unsigned us)
+{
+	for (unsigned i = 0; i < us; i++) {
+		if (!(sy_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/*
+ * TLMM CTL: pull [1:0] (1 down, 3 up), func [5:2], drive [8:6] = mA/2-1, OE [9],
+ * EGPIO_PRESENT [11], EGPIO_ENABLE [12]. As PAND:218-234, plus mt_pin_cfg
+ * (MYRON:63-66): the low bits are replaced, the bits above kept, and the pin is
+ * claimed (EGPIO_ENABLE) when it is egpio capable; egpio forces PRESENT for the
+ * SPI pins, whose stock state is 0x801 (present, not enabled, MYRON:55-59).
+ * The level is written before the output enable, so the pin never glitches.
+ */
+static void
+sy_gpio(unsigned n, unsigned func, unsigned pull, unsigned ma, int out, bool egpio)
+{
+	if (out >= 0) {
+		sy_wr(sy.tlmm, SY_GPIO(n) + 4, out ? 2u : 0u);
+	}
+	uint32_t old = sy_rd(sy.tlmm, SY_GPIO(n));
+	if (egpio) {
+		old |= SY_CFG_EGPIO_PRESENT;
+	}
+	uint32_t ctl = (old & ~(SY_CFG_LOW_MASK | SY_CFG_EGPIO_ENABLE)) |
+	    (pull | (func << 2) | ((ma / 2 - 1) << 6) | (out >= 0 ? 0x200u : 0u));
+	if (old & SY_CFG_EGPIO_PRESENT) {
+		ctl |= SY_CFG_EGPIO_ENABLE;
+	}
+	sy_wr(sy.tlmm, SY_GPIO(n), ctl);
+}
+
+static void
+sy_pins_dump(const char *when)
+{
+	static const uint8_t pins[] = {48, 49, 50, 51, SY_RESET, SY_AVDD, SY_IRQ};
+	printf("SONGYUAN TOUCH: pins %s:", when);
+	for (unsigned i = 0; i < sizeof(pins); i++) {
+		printf(" %u=%#x/%u", pins[i], sy_rd(sy.tlmm, SY_GPIO(pins[i])),
+		    sy_rd(sy.tlmm, SY_GPIO(pins[i]) + 4) & 3u);
+	}
+	printf("\n");
+}
+
+/* ---- clocks and serial engine --------------------------------------------------- */
+
+static bool
+sy_on(uint32_t cbcr)
+{
+	return !(sy_rd(sy.gcc, cbcr) & SY_GCC_CLK_OFF);
+}
+
+static void
+sy_clock_dump(const char *when)
+{
+	uint32_t r = SY_GCC_S0_RCG;
+	printf("SONGYUAN TOUCH: gcc %s: vote=%#x m_ahb=%#x s_ahb=%#x core=%#x core2x=%#x s0=%#x "
+	    "rcg=%#x cfg=%#x dfs=%#x perf0..3=%#x %#x %#x %#x\n", when,
+	    sy_rd(sy.gcc, SY_GCC_VOTE), sy_rd(sy.gcc, SY_GCC_M_AHB), sy_rd(sy.gcc, SY_GCC_S_AHB),
+	    sy_rd(sy.gcc, SY_GCC_CORE), sy_rd(sy.gcc, SY_GCC_CORE2X), sy_rd(sy.gcc, SY_GCC_S0),
+	    sy_rd(sy.gcc, r), sy_rd(sy.gcc, r + 4), sy_rd(sy.gcc, r + 0x14),
+	    sy_rd(sy.gcc, r + 0x1c), sy_rd(sy.gcc, r + 0x20), sy_rd(sy.gcc, r + 0x24),
+	    sy_rd(sy.gcc, r + 0x28));
+}
+
+/* PAND:269-306, unchanged: vote the four wrapper 4 branches (s0 follows the
+ * SE's own clock request), wait for them, then put the S0 root on XO
+ * undivided - with DFS, pick the level whose CFG is XO/1; without, write
+ * CFG and toggle the update bit. No PLL or voltage change. */
+static int
+sy_clocks(void)
+{
+	sy_wr(sy.gcc, SY_GCC_VOTE, sy_rd(sy.gcc, SY_GCC_VOTE) | SY_GCC_VOTE_BITS);
+	static const uint32_t branches[] = {SY_GCC_M_AHB, SY_GCC_S_AHB, SY_GCC_CORE, SY_GCC_CORE2X};
+	for (unsigned i = 0; i < 4; i++) {
+		for (unsigned t = 0; t < 10000 && !sy_on(branches[i]); t++) {
+			delay(1);
+		}
+		if (!sy_on(branches[i])) {
+			sy_clock_dump("branch off");
+			return EIO;
+		}
+	}
+	uint32_t r = SY_GCC_S0_RCG;
+	unsigned level = 0;
+	if (sy_rd(sy.gcc, r + 0x14) & 1u) {
+		while (level < 8 && (sy_rd(sy.gcc, r + 0x1c + 4 * level) & 0x371fu) != 1u) {
+			level++;
+		}
+		if (level == 8) {
+			sy_clock_dump("no XO DFS level");
+			return EIO;
+		}
+	} else {
+		uint32_t cfg = (sy_rd(sy.gcc, r + 4) & ~(0x371fu | (1u << 20))) | 1u;
+		sy_wr(sy.gcc, r + 4, cfg);
+		sy_wr(sy.gcc, r, sy_rd(sy.gcc, r) | 1u);
+		if (!sy_wait_clear(sy.gcc, r, 1u, 5000)) {
+			sy_clock_dump("RCG update timeout");
+			return EIO;
+		}
+	}
+	sy.level = level;
+	return 0;
+}
+
+/*
+ * The SE divider of the CONFIG0 TRE (PAND:642 writes it in the low half of the
+ * word that carries the DFS level at bits 16-18). The level sy_clocks selects
+ * is XO undivided, 19.2 MHz, so SPI = 19.2 MHz / div (PAND:115). The divider
+ * field's exact width is not in the evidence: 12 bits keeps it clear of the
+ * level and covers 19.2 MHz / 0xfff .. 19.2 MHz / 1 (TODO, REPORT.md U3).
+ */
+static void
+sy_set_hz(unsigned hz)
+{
+	if (hz == 0u) {
+		hz = SY_SPI_HZ;
+	}
+	unsigned div = (19200000u + hz / 2) / hz;
+	if (div == 0u) {
+		div = 1u;
+	}
+	if (div > 0xfffu) {
+		div = 0xfffu;
+	}
+	sy.hz = hz;
+	sy.spi_div = div;
+	sy.actual_hz = 19200000u / div;
+}
+
+static void
+sy_se_dump(const char *when)
+{
+	printf("SONGYUAN TOUCH: se %s: fw=%#x if_disable=%#x status=%#x hw0=%#x hw1=%#x "
+	    "clk_sel=%#x m_clk=%#x dma=%#x gsi_ev=%#x irq_en=%#x m_irq=%#x m_irq_en=%#x "
+	    "word=%#x tx=%#x rx=%#x\n", when,
+	    sy_rd(sy.se, SE_FW_REV), sy_rd(sy.se, SE_IF_DISABLE), sy_rd(sy.se, SE_STATUS),
+	    sy_rd(sy.se, SE_HW_PARAM0), sy_rd(sy.se, SE_HW_PARAM1), sy_rd(sy.se, SE_CLK_SEL),
+	    sy_rd(sy.se, SE_M_CLK_CFG), sy_rd(sy.se, SE_DMA_MODE), sy_rd(sy.se, SE_GSI_EVENT_EN),
+	    sy_rd(sy.se, SE_IRQ_EN), sy_rd(sy.se, SE_M_IRQ), sy_rd(sy.se, SE_M_IRQ_EN),
+	    sy_rd(sy.se, SE_SPI_WORD_LEN), sy_rd(sy.se, SE_TX_STATUS), sy_rd(sy.se, SE_RX_STATUS));
+}
+
+static void
+sy_dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(sy.dma_pa + off), len, TRUE);
+}
+
+static uint32_t
+sy_gstate(uint32_t ctx)
+{
+	return (sy_rd(sy.gpi, ctx) >> 20) & 0xf;
+}
+
+static bool
+sy_gpi_cmd(uint32_t reg, uint32_t v, uint32_t ctx, uint32_t want)
+{
+	sy_wr(sy.gpi, GPI_GPII + reg, v);
+	for (unsigned i = 0; i < 50000; i++) {
+		uint32_t st = sy_gstate(ctx);
+		if (st == want) {
+			sy_wr(sy.gpi, GPI_GPII + 0xa0, sy_rd(sy.gpi, GPI_GPII + 0x90));
+			sy_wr(sy.gpi, GPI_GPII + 0xa4, sy_rd(sy.gpi, GPI_GPII + 0x94));
+			return true;
+		}
+		if (st == 0xf) {
+			break;
+		}
+		delay(1);
+	}
+	printf("SONGYUAN TOUCH: GPI cmd %#x -> state %#x (want %u), error log %#x\n",
+	    v, sy_gstate(ctx), want, sy_rd(sy.gpi, GPI_GPII + 0x200));
+	return false;
+}
+
+/*
+ * Stream matches for the GPI (0x536) and the QUP (0x523), pointing where UFS's
+ * 0x60 points (PAND:384-431, same SIDs as MYRON:163-164). The firmware owns the
+ * context banks (GR1 aborts from EL1), so GR0 gets a stream-match group whose
+ * S2CR is copied from the UFS stream's; only GR0 is read or written.
+ * Idempotent.
+ */
+static int
+sy_smmu_setup(void)
+{
+	static const uint16_t sid[] = {SY_GPI_SMMU_SID, SY_QUP4_SMMU_SID};
+	uint32_t nsmr = sy_rd(sy.smmu, 0x20) & 0xff, s2cr = 0;
+	bool found = false;
+	for (unsigned i = 0; i < nsmr; i++) {
+		uint32_t smr = sy_rd(sy.smmu, 0x800 + 4 * i);
+		if ((smr & 0x80000000u) && ((SY_UFS_SMMU_SID ^ smr) & ~(smr >> 16) & 0x7fff) == 0) {
+			s2cr = sy_rd(sy.smmu, 0xc00 + 4 * i);
+			found = true;
+			break;
+		}
+	}
+	if (!found || ((s2cr >> 16) & 3) != 0) {
+		printf("SONGYUAN TOUCH: no UFS stream match to copy (s2cr %#x)\n", s2cr);
+		return ENODEV;
+	}
+	for (unsigned j = 0; j < 2; j++) {
+		unsigned i, freei = ~0u;
+		for (i = 0; i < nsmr; i++) {
+			uint32_t smr = sy_rd(sy.smmu, 0x800 + 4 * i);
+			if (!(smr & 0x80000000u)) {
+				if (freei == ~0u) {
+					freei = i;
+				}
+				continue;
+			}
+			if (((sid[j] ^ smr) & ~(smr >> 16) & 0x7fff) == 0) {
+				break;
+			}
+		}
+		if (i < nsmr) {
+			printf("SONGYUAN TOUCH: sid %#x already matched by SMR %u (S2CR %#x)\n",
+			    sid[j], i, sy_rd(sy.smmu, 0xc00 + 4 * i));
+			continue;
+		}
+		if (freei == ~0u) {
+			return ENOSPC;
+		}
+		sy_wr(sy.smmu, 0xc00 + 4 * freei, s2cr);
+		sy_wr(sy.smmu, 0x800 + 4 * freei, 0x80000000u | sid[j]);
+		printf("SONGYUAN TOUCH: SMR %u = sid %#x -> S2CR %#x (as UFS)\n", freei, sid[j],
+		    sy_rd(sy.smmu, 0xc00 + 4 * freei));
+	}
+	return 0;
+}
+
+/* PAND:433-502: stop/reset/free both channels and the event ring, then set up
+ * the event ring and the two channel rings in the DMA page. Channel 0 carries
+ * what the SE transmits (our TX), channel 1 what it receives (our RX). */
+static int
+sy_gpi_init(void)
+{
+	uint32_t lo = (uint32_t)sy.dma_pa, hi = (uint32_t)(sy.dma_pa >> 32);
+	for (unsigned k = 0; k < 2; k++) {
+		if (sy_gstate(GPI_CH(k)) == 2) {
+			(void)sy_gpi_cmd(0x08, (2u << 24) | k, GPI_CH(k), 3);
+		}
+		if (sy_gstate(GPI_CH(k))) {
+			(void)sy_gpi_cmd(0x08, (9u << 24) | k, GPI_CH(k), 1);
+			sy_wr(sy.gpi, GPI_GPII + 0x08, (10u << 24) | k);
+			delay(1000);
+		}
+	}
+	if (sy_gstate(GPI_EV)) {
+		(void)sy_gpi_cmd(0x10, 9u << 24, GPI_EV, 1);
+		sy_wr(sy.gpi, GPI_GPII + 0x10, 10u << 24);
+		delay(1000);
+	}
+	bzero((void *)sy.dma, SY_DMA_SIZE);
+	sy_dma_sync(0, SY_DMA_SIZE);
+	sy_wr(sy.gpi, GPI_GPII + 0x88, 0x4f);
+	sy_wr(sy.gpi, GPI_GPII + 0xb8, 1);
+	sy_wr(sy.gpi, GPI_GPII + 0x98, 3);
+	sy_wr(sy.gpi, GPI_GPII + 0x9c, 1);
+	sy_wr(sy.gpi, GPI_GPII + 0x108, 1);
+	sy_wr(sy.gpi, GPI_GPII + 0x120, 0xf);
+	sy_wr(sy.gpi, GPI_GPII + 0x188, 0);
+	sy_wr(sy.gpi, GPI_GPII + 0x18c, 0);
+	sy_wr(sy.gpi, GPI_GPII + 0x400, 0);
+	sy_wr(sy.gpi, GPI_GPII + 0x404, 0);
+	sy_wr(sy.gpi, GPI_GPII + 0x180, 1);
+	sy_wr(sy.gpi, GPI_GPII + 0x200, 0);
+	if (!sy_gpi_cmd(0x10, 0, GPI_EV, 1)) {
+		return EIO;
+	}
+	sy_wr(sy.gpi, GPI_EV + 0x00, 0x10010002u);
+	sy_wr(sy.gpi, GPI_EV + 0x04, SY_EVRING * 16);
+	sy_wr(sy.gpi, GPI_EV + 0x08, lo + SY_EV_OFF);
+	sy_wr(sy.gpi, GPI_EV + 0x0c, hi);
+	sy_wr(sy.gpi, GPI_EVDB + 4, hi);
+	for (uint32_t o = 0x20; o <= 0x34; o += 4) {
+		sy_wr(sy.gpi, GPI_EV + o, 0);
+	}
+	sy.evrp = 0;
+	sy_wr(sy.gpi, GPI_EVDB, lo + SY_EV_OFF + SY_EVRING * 16 - 16);
+	for (unsigned k = 0; k < 2; k++) {
+		if (!sy_gpi_cmd(0x08, k, GPI_CH(k), 1)) {
+			return EIO;
+		}
+		sy_wr(sy.gpi, GPI_CH(k) + 0x00, k ? 0x10000002u : 0x1000000au);
+		sy_wr(sy.gpi, GPI_CH(k) + 0x04, SY_RING * 16);
+		sy_wr(sy.gpi, GPI_CH(k) + 0x08, lo + SY_RING_OFF(k));
+		sy_wr(sy.gpi, GPI_CH(k) + 0x0c, hi);
+		sy_wr(sy.gpi, GPI_CHDB(k) + 4, hi);
+		/* SCRATCH_0: pair channel, protocol 1 (SPI), SE 0. fuxi writes 0x14
+		 * here because its engine is SE 4 (FUXI:294); ours is SE0. */
+		sy_wr(sy.gpi, GPI_CH(k) + 0x60, k ? 0x00000010u : 0x00010010u);
+		sy_wr(sy.gpi, GPI_CH(k) + 0x64, 0);
+		sy_wr(sy.gpi, GPI_CH(k) + 0x68, 0);
+		sy_wr(sy.gpi, GPI_CH(k) + 0x6c, 0);
+		sy_wr(sy.gpi, GPI_CH(k) + 0x5c, 1);
+		sy.wp[k] = 0;
+	}
+	for (unsigned k = 0; k < 2; k++) {
+		if (!sy_gpi_cmd(0x08, (1u << 24) | k, GPI_CH(k), 2)) {
+			return EIO;
+		}
+	}
+	return 0;
+}
+
+/*
+ * PAND:504-565 (geni_se_select_mode(GENI_GPI_DMA)): SE0 must idle in SPI mode,
+ * the interrupts and DMA channels are cleared, the GSI event interface is
+ * enabled, then the SMMU streams, the GPII window and the DMA page. The 36-bit
+ * SMMU range check is PAND:552-555.
+ */
+static int
+sy_se_init(void)
+{
+	uint32_t fw = sy_rd(sy.se, SE_FW_REV);
+	if (((fw >> 8) & 0xff) != 1) {
+		printf("SONGYUAN TOUCH: SE0 firmware %#x is not SPI\n", fw);
+		return ENODEV;
+	}
+	if (sy_rd(sy.se, SE_STATUS) & 1u) {
+		printf("SONGYUAN TOUCH: SE0 busy (status %#x)\n", sy_rd(sy.se, SE_STATUS));
+		return EBUSY;
+	}
+	sy_wr(sy.se, SE_GSI_EVENT_EN, 0);
+	sy_wr(sy.se, SE_M_IRQ_CLR, 0xffffffffu);
+	sy_wr(sy.se, SE_S_IRQ_CLR, 0xffffffffu);
+	sy_wr(sy.se, SE_DMA_TX_CLR, 0xffffffffu);
+	sy_wr(sy.se, SE_DMA_RX_CLR, 0xffffffffu);
+	sy_wr(sy.se, SE_CGC_CTRL, sy_rd(sy.se, SE_CGC_CTRL) | 0x7fu);
+	sy_wr(sy.se, 0xe30, sy_rd(sy.se, 0xe30) | 0xfu);
+	sy_wr(sy.se, SE_OUTPUT_CTRL, 0x7fu);
+	sy_wr(sy.se, SE_FORCE_DEFAULT, 1);
+	sy_wr(sy.se, SE_IRQ_EN, 0);
+	sy_wr(sy.se, SE_M_IRQ_EN, sy_rd(sy.se, SE_M_IRQ_EN) &
+	    ~((1u << 0) | (1u << 26) | (1u << 27) | (1u << 30)));
+	sy_wr(sy.se, 0x644, sy_rd(sy.se, 0x644) & ~1u);
+	sy_wr(sy.se, SE_DMA_MODE, 1);
+	sy_wr(sy.se, SE_GSI_EVENT_EN, sy_rd(sy.se, SE_GSI_EVENT_EN) | 0xfu);
+	sy.smmu = ml_io_map(SY_SMMU_PA, 0x1000);
+	sy.gpi = ml_io_map(SY_GPI_PA, SY_GPI_SIZE);
+	if (!sy.smmu || !sy.gpi) {
+		printf("SONGYUAN TOUCH: no SMMU/GPI mapping\n");
+		return ENOMEM;
+	}
+	int err;
+	if ((err = sy_smmu_setup())) {
+		return err;
+	}
+	if (kmem_alloc_contig(kernel_map, &sy.dma, SY_DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SONGYUAN TOUCH: no DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)sy.dma);
+	if (!pn) {
+		printf("SONGYUAN TOUCH: DMA page has no physical address\n");
+		return ENOMEM;
+	}
+	sy.dma_pa = ptoa_64(pn);
+	if (sy.dma_pa + SY_DMA_SIZE > (1ULL << 36)) {
+		printf("SONGYUAN TOUCH: DMA at %#llx is outside the SMMU's 36-bit range\n",
+		    sy.dma_pa);
+		return ENOMEM;
+	}
+	printf("SONGYUAN TOUCH: GPII %u before: ch0 %#x ch1 %#x ev %#x\n", SY_GPII,
+	    sy_rd(sy.gpi, GPI_CH(0)), sy_rd(sy.gpi, GPI_CH(1)), sy_rd(sy.gpi, GPI_EV));
+	if ((err = sy_gpi_init())) {
+		return err;
+	}
+	printf("SONGYUAN TOUCH: SE0 SPI over GPII %u, DMA page %#llx, DFS level %u, div %u = %u Hz\n",
+	    SY_GPII, sy.dma_pa, sy.level, sy.spi_div, sy.actual_hz);
+	return 0;
+}
+
+/* ---- TRE ring and transfers ------------------------------------------------------ */
+
+static void
+sy_tre(unsigned k, uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3)
+{
+	uint32_t off = SY_RING_OFF(k) + 16 * sy.wp[k];
+	volatile uint32_t *t = (volatile uint32_t *)(sy.dma + off);
+	t[0] = d0;
+	t[1] = d1;
+	t[2] = d2;
+	t[3] = d3;
+	sy_dma_sync(off, 16);
+	sy.wp[k] = (sy.wp[k] + 1) % SY_RING;
+}
+
+static void
+sy_ring_db(unsigned k)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_wr(sy.gpi, GPI_CHDB(k), (uint32_t)sy.dma_pa + SY_RING_OFF(k) + 16 * sy.wp[k]);
+}
+
+/* PAND:587-621: drain events until end-of-transfer (code 2) has come from every
+ * channel in want. */
+static int
+sy_gpi_wait(unsigned want)
+{
+	unsigned seen = 0;
+	for (unsigned us = 0; us < 50000; us++) {
+		uint32_t hw = sy_rd(sy.gpi, GPI_EV + 0x10);
+		bool bad = false;
+		while (hw != (uint32_t)sy.dma_pa + SY_EV_OFF + 16 * sy.evrp) {
+			uint32_t off = SY_EV_OFF + 16 * sy.evrp;
+			sy_dma_sync(off, 16);
+			volatile uint32_t *e = (volatile uint32_t *)(sy.dma + off);
+			uint32_t d2 = e[2], d3 = e[3];
+			sy.evrp = (sy.evrp + 1) % SY_EVRING;
+			unsigned code = d2 >> 24, type = (d3 >> 16) & 0xff, ch = d3 >> 24;
+			if (code == 16 || type == 0xff || ch >= 2) {
+				bad = true;
+				printf("SONGYUAN TOUCH: GPI event %#x %#x\n", d2, d3);
+			} else if (type == 0x22 && code == 2) {
+				seen |= 1u << ch;
+			}
+		}
+		sy_wr(sy.gpi, GPI_EVDB, (uint32_t)sy.dma_pa + SY_EV_OFF +
+		    16 * ((sy.evrp + SY_EVRING - 1) % SY_EVRING));
+		sy_wr(sy.gpi, GPI_GPII + 0xc0, 1);
+		if (bad) {
+			return EIO;
+		}
+		if ((seen & want) == want) {
+			return 0;
+		}
+		delay(1);
+	}
+	return ETIMEDOUT;
+}
+
+/*
+ * One full-duplex transfer with chip select held for its length (PAND:623-666).
+ * Both directions always carry n bytes: the FocalTech frame is one transaction
+ * of n bytes out and n bytes in, so tx is never NULL here (PAND sends 0xff when
+ * it is). CONFIG0 sets 8-bit words (8 - 4), TX/RX packing, mode 0, the DFS level
+ * and the divider; GO is full duplex (3) with the RX length; then the TX DMA.
+ */
+static int
+sy_spi(const uint8_t *tx, uint8_t *rx, unsigned n)
+{
+	if (sy.dead || n == 0 || n > SY_XFER_MAX) {
+		return EIO;
+	}
+	uint8_t *txb = (uint8_t *)(sy.dma + SY_TXB_OFF), *rxb = (uint8_t *)(sy.dma + SY_RXB_OFF);
+	if (tx) {
+		memcpy(txb, tx, n);
+	} else {
+		memset(txb, 0xff, n);
+	}
+	sy_dma_sync(SY_TXB_OFF, n);
+	sy_dma_sync(SY_RXB_OFF, n);
+	uint32_t hi = (uint32_t)(sy.dma_pa >> 32);
+	sy_tre(1, (uint32_t)sy.dma_pa + SY_RXB_OFF, hi, n, 0x00100200u);
+	sy_tre(0, 0x03000004u, 0, (sy.level << 16) | sy.spi_div, 0x00220001u);
+	sy_tre(0, 3u, 0, n, 0x00200801u);
+	sy_tre(0, (uint32_t)sy.dma_pa + SY_TXB_OFF, hi, n, 0x00100200u);
+	sy_ring_db(1);
+	sy_ring_db(0);
+	int err = sy_gpi_wait(3u);
+	if (err) {
+		static unsigned fails;
+		if (fails++ < 10) {
+			printf("SONGYUAN TOUCH: SPI over GPI failed %d (n %u), ch0 %#x ch1 %#x err log %#x\n",
+			    err, n, sy_rd(sy.gpi, GPI_CH(0)), sy_rd(sy.gpi, GPI_CH(1)),
+			    sy_rd(sy.gpi, GPI_GPII + 0x200));
+		}
+		if (sy_gpi_init()) {
+			sy.dead = true;
+		}
+		return err;
+	}
+	sy_dma_sync(SY_RXB_OFF, n);
+	if (rx) {
+		memcpy(rx, rxb, n);
+	}
+	return 0;
+}
+
+/* ---- FocalTech protocol ---------------------------------------------------------- */
+
+/* CRC-16/MCRF4XX (reflected 0x8408, init 0xffff), MYRON:104-109; the stock
+ * driver stores it little endian after the data (MYRONC:314). */
+static uint16_t
+sy_fts_crc(const uint8_t *p, unsigned n)
+{
+	uint16_t c = 0xffff;
+	while (n--) {
+		c ^= *p++;
+		for (unsigned b = 0; b < 8; ++b) {
+			c = (c & 1) ? (uint16_t)((c >> 1) ^ 0x8408) : (uint16_t)(c >> 1);
+		}
+	}
+	return c;
+}
+
+/*
+ * One frame: send it, then wait out the chip-select high gap (MYRONC:298 wants
+ * at least 150 us; delay(1) is a 1 ms tick).
+ */
+static int
+sy_fts_xfer(unsigned len)
+{
+	int err = sy_spi(sy.tx, sy.rx, len);
+	delay(SY_CS_HIGH_MS);
+	return err;
+}
+
+/*
+ * Register read (MYRONC:305-319): {addr, 0xa0, len hi, len lo, 0, 0, 0} then n
+ * bytes of data from byte 7 and a CRC-16/MCRF4XX over them, little endian, at
+ * bytes 7+n and 8+n. Status byte 3 must have 0xA0 clear. Three attempts.
+ */
+static int
+sy_fts_read(uint8_t addr, uint8_t *out, unsigned n)
+{
+	if (n == 0 || n + SY_FTS_HDR + 2 > sizeof(sy.tx) || n + SY_FTS_HDR + 2 > sizeof(sy.rx)) {
+		return EINVAL;
+	}
+	unsigned len = n + SY_FTS_HDR + 2;
+	int err = EIO;
+	for (unsigned attempt = 0; attempt < SY_FTS_TRIES; attempt++) {
+		memset(sy.tx, 0, len);
+		sy.tx[0] = addr;
+		sy.tx[1] = SY_FTS_READ;
+		sy.tx[2] = (uint8_t)(n >> 8);
+		sy.tx[3] = (uint8_t)n;
+		if ((err = sy_fts_xfer(len))) {
+			continue;
+		}
+		if (sy.rx[3] & SY_FTS_STATUS) {
+			err = EIO;
+			if (sy.logs++ < 8) {
+				printf("SONGYUAN TOUCH: read %#x: status %#x\n", addr, sy.rx[3]);
+			}
+			continue;
+		}
+		uint16_t want = sy_fts_crc(sy.rx + SY_FTS_HDR, n);
+		uint16_t got = (uint16_t)(sy.rx[SY_FTS_HDR + n] |
+		    (sy.rx[SY_FTS_HDR + n + 1] << 8));
+		if (want != got) {
+			err = EIO;
+			if (sy.logs++ < 8) {
+				printf("SONGYUAN TOUCH: read %#x: CRC %#x want %#x\n", addr, got, want);
+			}
+			continue;
+		}
+		memcpy(out, sy.rx + SY_FTS_HDR, n);
+		return 0;
+	}
+	return err;
+}
+
+/* Register write (MYRONC:321-335): {addr, 0x00, len hi, len lo, 0, 0, 0} then
+ * the bytes; no CRC. The status byte is checked the same way. */
+static int
+sy_fts_write(uint8_t addr, const uint8_t *data, unsigned n)
+{
+	unsigned len = n ? SY_FTS_HDR + n : 4;
+	if (n > sizeof(sy.tx) || len > sizeof(sy.tx) || len > sizeof(sy.rx)) {
+		return EINVAL;
+	}
+	int err = EIO;
+	for (unsigned attempt = 0; attempt < SY_FTS_TRIES; attempt++) {
+		memset(sy.tx, 0, len);
+		sy.tx[0] = addr;
+		sy.tx[1] = SY_FTS_WRITE;
+		sy.tx[2] = (uint8_t)(n >> 8);
+		sy.tx[3] = (uint8_t)n;
+		if (n) {
+			memcpy(sy.tx + SY_FTS_HDR, data, n);
+		}
+		if ((err = sy_fts_xfer(len))) {
+			continue;
+		}
+		if (sy.rx[3] & SY_FTS_STATUS) {
+			err = EIO;
+			if (sy.logs++ < 8) {
+				printf("SONGYUAN TOUCH: write %#x: status %#x\n", addr, sy.rx[3]);
+			}
+			continue;
+		}
+		return 0;
+	}
+	return err;
+}
+
+/* fts_system_reset (FUXI:542-545, MYRONC:241): reset low 10 ms, high, then let
+ * the firmware boot - nothing answers before 200 ms (MYRONC:241). */
+static void
+sy_fts_reset(void)
+{
+	sy_gpio(SY_RESET, 0, 0, 4, 0, false);
+	sy_sleep(10);
+	sy_gpio(SY_RESET, 0, 0, 4, 1, false);
+	sy_sleep(200);
+}
+
+/*
+ * Power-on in the stock order (MYRONC:230-245): reset level low before its
+ * output enable (no glitch high), 2 ms, avdd on (GPIO 117 high), 3 ms, reset
+ * high, then 200 ms of firmware boot. The pins are muxed first: SPI 48-51 as
+ * qup4_se0 function 1 with the board data's drive and pull (MYRON:48-50), IRQ
+ * as an input with a pull-up (MYRON:51), reset and avdd as outputs (MYRON:52).
+ * No RPMh/RSC vote: avdd is this pin (MYRON:45), and iovdd (L4I) is a rail XNU
+ * cannot switch (MYRONC:20) - see REPORT.md, D2.
+ */
+static void
+sy_power_on(void)
+{
+	sy_gpio(48, SY_FUNC_QUP4_SE0, 0, 6, -1, true);		/* MISO, 6 mA, no pull */
+	sy_gpio(49, SY_FUNC_QUP4_SE0, 0, 6, -1, true);		/* MOSI */
+	sy_gpio(50, SY_FUNC_QUP4_SE0, 0, 4, -1, true);		/* CLK, 4 mA */
+	sy_gpio(51, SY_FUNC_QUP4_SE0, 3, 6, -1, true);		/* CS, 6 mA, pull-up */
+	sy_gpio(SY_IRQ, 0, 3, 2, -1, false);			/* input, pull-up */
+	sy_gpio(SY_RESET, 0, 0, 4, 0, false);			/* level low first */
+	sy_sleep(2);
+	sy_gpio(SY_AVDD, 0, 0, 4, 1, false);			/* avdd on */
+	sy_sleep(3);
+	sy_gpio(SY_RESET, 0, 0, 4, 1, false);
+	sy_sleep(200);
+}
+
+/* Chip id (MYRONC:337-347): 0xA3 must read 0x36 and 0x9F 0x83 (FT3683); 0xA6 is
+ * the firmware version and only gets logged. Five tries, 200 ms apart. */
+static int
+sy_fts_chip_id(void)
+{
+	uint8_t a3 = 0, id9f = 0, fw = 0;
+	int r3 = EIO, r9f = EIO, rfw = EIO;
+	for (unsigned t = 1; t <= SY_FTS_ID_TRIES; t++) {
+		r3 = sy_fts_read(SY_FTS_ADDR_ID_A3, &a3, 1);
+		r9f = sy_fts_read(SY_FTS_ADDR_ID_9F, &id9f, 1);
+		if (!r3 && !r9f && a3 == SY_FTS_ID_A3 && id9f == SY_FTS_ID_9F) {
+			break;
+		}
+		sy_sleep(200);
+	}
+	rfw = sy_fts_read(SY_FTS_ADDR_FW, &fw, 1);
+	printf("SONGYUAN TOUCH: chip id A3 %02x (err %d), 9F %02x (err %d), fw A6 %02x (err %d), "
+	    "want %02x/%02x\n", a3, r3, id9f, r9f, fw, rfw, SY_FTS_ID_A3, SY_FTS_ID_9F);
+	if (r3 || r9f || a3 != SY_FTS_ID_A3 || id9f != SY_FTS_ID_9F) {
+		return ENODEV;
+	}
+	return 0;
+}
+
+/* 0x9E = 0 selects TIC mode, where the contacts come from 0x01 (MYRON:26,
+ * MYRONC:349-359): write, 1 ms, read back and compare; three attempts. */
+static int
+sy_fts_tic(void)
+{
+	static const uint8_t tic = SY_FTS_TIC_MODE;
+	uint8_t mode = 0xff;
+	int err = EIO;
+	for (unsigned t = 0; t < SY_FTS_TRIES; t++) {
+		err = sy_fts_write(SY_FTS_ADDR_TIC, &tic, 1);
+		delay(1);
+		if (!err) {
+			err = sy_fts_read(SY_FTS_ADDR_TIC, &mode, 1);
+		}
+		if (!err && mode == tic) {
+			printf("SONGYUAN TOUCH: TIC mode (0x9e=0) set\n");
+			return 0;
+		}
+	}
+	printf("SONGYUAN TOUCH: TIC mode failed (0x9e reads %02x, err %d)\n", mode, err);
+	return err ? err : EIO;
+}
+
+/* FTS raw units -> panel 1200x2608 -> presented 1125x2436, as data-a-live
+ * pandora_touch.c:1286-1304 does for its 1220x2656 panel; clamped to 1124/2435. */
+static int
+sy_scale(uint64_t v, unsigned per_panel, unsigned axis)
+{
+	uint64_t out = v * axis / per_panel;
+
+	return out >= axis ? (int)(axis - 1) : (int)out;
+}
+
+/*
+ * Points of a 0x01 frame (MYRON:111-116, 120-154): buf[1] low nibble = count,
+ * high nibble = layout. 2 = v2: 8-byte points from buf+4, X/Y in 1/16 pixel,
+ * every id below 10; 0 = v1: 6-byte points from buf+2, whole pixels, walked
+ * until an id of 10 or more, and dropped as a whole when a slot is down while
+ * the count is 0 (an all-zero frame reads exactly like that). For both, the
+ * event is p0 bits 7:6 (0 down, 1 up, 2 contact) and the id p2 bits 7:4.
+ */
+static unsigned
+sy_fts_decode(const uint8_t *f, int *ids, int *xs, int *ys)
+{
+	unsigned type = f[1] >> 4, reported = f[1] & 0xf, count = 0;
+
+	if (reported > SY_FINGERS) {
+		return 0;
+	}
+	if (type == 2) {
+		if (!reported) {
+			return 0;
+		}
+		for (unsigned i = 0; i < reported; i++) {
+			const uint8_t *p = f + 4 + 8 * i;
+			if ((p[2] >> 4) >= SY_FINGERS) {
+				return 0;
+			}
+		}
+		for (unsigned i = 0; i < reported; i++) {
+			const uint8_t *p = f + 4 + 8 * i;
+			unsigned event = p[0] >> 6;
+			if (event != 0 && event != 2) {
+				continue;
+			}
+			uint64_t x = ((uint64_t)(p[0] & 0xfu) << 12) |
+			    ((uint64_t)p[1] << 4) | (p[4] >> 4);
+			uint64_t y = ((uint64_t)(p[2] & 0xfu) << 12) |
+			    ((uint64_t)p[3] << 4) | (p[4] & 0xfu);
+			ids[count] = (int)(p[2] >> 4);
+			xs[count] = sy_scale(x, SY_PANEL_W * 16u, SY_LOGICAL_W);
+			ys[count] = sy_scale(y, SY_PANEL_H * 16u, SY_LOGICAL_H);
+			count++;
+		}
+	} else if (type == 0) {
+		for (unsigned i = 0; i < SY_FINGERS; i++) {
+			const uint8_t *p = f + 2 + 6 * i;
+			unsigned id = p[2] >> 4, event = p[0] >> 6;
+			if (id >= SY_FINGERS) {
+				break;
+			}
+			if (event != 0 && event != 2) {
+				continue;
+			}
+			if (!reported) {
+				return 0;
+			}
+			uint64_t x = ((uint64_t)(p[0] & 0xfu) << 8) | p[1];
+			uint64_t y = ((uint64_t)(p[2] & 0xfu) << 8) | p[3];
+			ids[count] = (int)id;
+			xs[count] = sy_scale(x, SY_PANEL_W, SY_LOGICAL_W);
+			ys[count] = sy_scale(y, SY_PANEL_H, SY_LOGICAL_H);
+			count++;
+		}
+	}
+	return count;
+}
+
+/* An all-ones header: the firmware restarted and is back in its default THP
+ * mode (MYRON:155-156). */
+static bool
+sy_frame_restarted(const uint8_t *f)
+{
+	return f[0] == 0xff && f[1] == 0xff;
+}
+
+/*
+ * Deliver to SweetHIDTouch: the contact id is the finger (0..9, as the tree's
+ * SWEET_TOUCH_FINGERS, 0058:20946), a release for every finger that was down
+ * and is not in this frame (FUXI:436-452, PAND:1289-1318). Coordinates are the
+ * presented display pixels 0..1124 x 0..2435 (pandora_touch.c:1286-1304).
+ * TODO(REPORT.md U1): the consumer in this tree must accept that axis space.
+ * SweetHIDTouch::touch() clamps to fPanelW/fPanelH (0058:21041, 0130:1420-1423),
+ * which PANDORA sets to the presented display; if songyuan's does the same,
+ * every point above 1079/2399 is clamped into the top-left corner.
+ */
+static void
+sy_report(unsigned count, const int *ids, const int *xs, const int *ys)
+{
+	uint32_t mask = 0;
+	for (unsigned i = 0; i < count; i++) {
+		if (ids[i] >= 0 && ids[i] < (int)SY_FINGERS) {
+			mask |= 1u << ids[i];
+		}
+	}
+	for (unsigned id = 0; id < SY_FINGERS; id++) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			for (unsigned i = 0; i < count; i++) {
+				if (ids[i] == (int)id) {
+					sy.x[id] = xs[i];
+					sy.y[id] = ys[i];
+					break;
+				}
+			}
+			sweet_hid_touch((int)id, 1, sy.x[id], sy.y[id]);
+		} else if (sy.active & bit) {
+			sweet_hid_touch((int)id, 0, sy.x[id], sy.y[id]);
+		}
+	}
+	sy.active = mask;
+}
+
+/* One 0x01 frame: read it (CRC inside sy_fts_read), catch a firmware restart,
+ * decode, deliver. */
+static int
+sy_fts_frame(void)
+{
+	int ids[SY_FINGERS], xs[SY_FINGERS], ys[SY_FINGERS];
+	int err = sy_fts_read(SY_FTS_ADDR_FRAME, sy.frame, SY_FTS_FRAME);
+	if (err) {
+		return err;
+	}
+	sy.frames++;
+	if (sy_frame_restarted(sy.frame)) {
+		/* The firmware restarted and streams THP frames again: take it
+		 * back to TIC (MYRONC:490-498). */
+		sy.restarts++;
+		printf("SONGYUAN TOUCH: firmware restart (all-ones header), TIC mode again -> %d\n",
+		    sy_fts_tic());
+		if (sy.active) {
+			sy_report(0, NULL, NULL, NULL);
+		}
+		return 0;
+	}
+	unsigned type = sy.frame[1] >> 4;
+	if (type == 0) {
+		sy.type_v1++;
+	} else if (type == 2) {
+		sy.type_v2++;
+	}
+	if (sy.logged_frames < 4) {
+		sy.logged_frames++;
+		printf("SONGYUAN TOUCH: frame %u (%u):", sy.frames, SY_FTS_FRAME);
+		for (unsigned i = 0; i < SY_FTS_FRAME; i++) {
+			printf(" %02x", sy.frame[i]);
+			if ((i % 21) == 20) {
+				printf("\n");
+			}
+		}
+		printf("\n");
+	}
+	unsigned count = sy_fts_decode(sy.frame, ids, xs, ys);
+	if (count) {
+		sy.touch_frames++;
+		if (sy.touch_frames <= 10) {
+			printf("SONGYUAN TOUCH: %u contact(s), id %d at %d,%d of %u x %u\n",
+			    count, ids[0], xs[0], ys[0], SY_LOGICAL_W - 1, SY_LOGICAL_H - 1);
+		}
+	}
+	if ((sy.frames % 500u) == 0) {
+		printf("SONGYUAN TOUCH: %u frames (%u with contacts: v1 %u, v2 %u), %u restarts, "
+		    "%u errors\n", sy.frames, sy.touch_frames, sy.type_v1, sy.type_v2,
+		    sy.restarts, sy.errors);
+	}
+	if (count || sy.last_count) {
+		sy_report(count, ids, xs, ys);
+	}
+	sy.last_count = count;
+	return 0;
+}
+
+/* Identify and TIC, without touching reset: what follows sy_power_on(). */
+static int
+sy_fts_setup(void)
+{
+	int err;
+	if ((err = sy_fts_chip_id())) {
+		return err;
+	}
+	return sy_fts_tic();
+}
+
+/* fts_system_reset, then identify and TIC: what runs again when the bus lost
+ * step (PAND:1640-1647 resets the IC after 20 bad frames). */
+static int
+sy_fts_start(void)
+{
+	sy_fts_reset();
+	return sy_fts_setup();
+}
+
+/* ---- thread -------------------------------------------------------------------- */
+
+static void
+sy_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 5;
+	unsigned hz = SY_SPI_HZ;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("songyuan_ftsdelay", &delay_s, sizeof(delay_s));
+	if (PE_parse_boot_argn("songyuan_ftshz", &hz, sizeof(hz)) &&
+	    (hz < SY_SPI_HZ_MIN || hz > SY_SPI_HZ_MAX)) {
+		printf("SONGYUAN TOUCH: songyuan_ftshz=%u outside %u..%u, keeping %u\n", hz,
+		    SY_SPI_HZ_MIN, SY_SPI_HZ_MAX, SY_SPI_HZ);
+		hz = SY_SPI_HZ;
+	}
+	sy_set_hz(hz);
+	printf("SONGYUAN TOUCH: starting in %u s, SPI %u Hz (div %u, %u Hz)\n", delay_s,
+	    sy.hz, sy.spi_div, sy.actual_hz);
+	sy_sleep(delay_s * 1000u);
+	sy.gcc = ml_io_map(SY_GCC_PA, 0x1f0000);
+	sy.tlmm = ml_io_map(SY_TLMM_PA, 0xa0000);
+	sy.se = ml_io_map(SY_SE_PA, SY_SE_SIZE);
+	if (!sy.gcc || !sy.tlmm || !sy.se) {
+		printf("SONGYUAN TOUCH: no GCC/TLMM/SE mapping\n");
+		goto out;
+	}
+	sy_clock_dump("before");
+	int err;
+	if ((err = sy_clocks())) {
+		printf("SONGYUAN TOUCH: clocks failed %d\n", err);
+		goto out;
+	}
+	sy_clock_dump("after");
+	sy_se_dump("before");
+	if ((err = sy_se_init())) {
+		printf("SONGYUAN TOUCH: engine set-up failed %d\n", err);
+		goto out;
+	}
+	sy_se_dump("after");
+	sy_pins_dump("before");
+	sy_power_on();
+	if ((err = sy_fts_setup())) {
+		printf("SONGYUAN TOUCH: FTS start failed %d\n", err);
+		sy_pins_dump("after failed start");
+		goto out;
+	}
+	sy_pins_dump("after reset");
+	printf("SONGYUAN TOUCH: running, polling GPIO %u\n", SY_IRQ);
+	uint64_t active_abs, idle_abs, next = mach_absolute_time();
+	nanoseconds_to_absolutetime(4 * NSEC_PER_MSEC, &active_abs);
+	nanoseconds_to_absolutetime(8 * NSEC_PER_MSEC, &idle_abs);
+	unsigned idle = 0;
+	for (;;) {
+		/* Low while the chip holds a frame and until it is read (MYRON:46). */
+		bool ready = !(sy_rd(sy.tlmm, SY_GPIO(SY_IRQ) + 4) & 1u);
+		unsigned got = 0;
+		while (ready && got < 4) {
+			if (sy_fts_frame()) {
+				if ((++sy.errors % 100u) == 1) {
+					printf("SONGYUAN TOUCH: frame error (%u total)\n", sy.errors);
+				}
+				if (sy.active) {
+					sy_report(0, NULL, NULL, NULL);
+				}
+				/* Out of step with the chip: reset it after 20 bad frames
+				 * (PAND:1640-1647). */
+				if (++sy.bad >= 20) {
+					sy.bad = 0;
+					printf("SONGYUAN TOUCH: IC reset after errors -> %d\n",
+					    sy_fts_start());
+				}
+				break;
+			}
+			sy.bad = 0;
+			got++;
+			ready = !(sy_rd(sy.tlmm, SY_GPIO(SY_IRQ) + 4) & 1u);
+		}
+		if (!got) {
+			/* ~100 ms idle: one frame anyway, to catch a firmware restart
+			 * (MYRONC:482-483). */
+			if (++idle >= SY_IDLE_POLLS) {
+				idle = 0;
+				if (sy_fts_frame()) {
+					sy.errors++;
+				}
+			}
+		} else {
+			idle = 0;
+		}
+		if (sy.dead) {
+			break;
+		}
+		uint64_t period = (sy.active || got) ? active_abs : idle_abs;
+		next += period;
+		uint64_t now = mach_absolute_time();
+		if (next <= now) {
+			next = now + period;
+		}
+		sy_sleep_until(next);
+	}
+out:
+	printf("SONGYUAN TOUCH: stopped\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+songyuan_touch_init(void)
+{
+	thread_t thread;
+	int enabled = 0;
+	if (sy.started) {
+		return;
+	}
+	sy.started = true;
+	(void)PE_parse_boot_argn("songyuan_fts", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SONGYUAN TOUCH: off (songyuan_fts=1 to enable)\n");
+		return;
+	}
+	if (kernel_thread_start_priority(sy_thread, NULL, SY_PRIORITY, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SONGYUAN TOUCH: no thread\n");
+	}
+}
+#endif /* SONGYUAN */
