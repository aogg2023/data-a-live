+#define SE_M_CMD_CANCEL	(1u << 2)
+#define SE_M_CMD_CANCEL_DONE (1u << 4)
+#define SE_M_CMD_ABORT	(1u << 1)
+#define SE_M_CMD_ABORT_DONE (1u << 5)
+#define SE_M_IO_DATA_DEASSERT (1u << 22)
+#define SE_M_IO_DATA_ASSERT (1u << 23)
+#define SE_M_RX_FIFO_RD_ERR (1u << 24)
+#define SE_M_RX_FIFO_WR_ERR (1u << 25)
+#define SE_M_RX_FIFO_WATERMARK (1u << 26)
+#define SE_M_RX_FIFO_LAST (1u << 27)
+#define SE_M_TX_FIFO_RD_ERR (1u << 28)
+#define SE_M_TX_FIFO_WR_ERR (1u << 29)
+#define SE_M_TX_FIFO_WATERMARK (1u << 30)
+#define SE_M_COMMON_IRQ_EN (0x7eu | SE_M_IO_DATA_DEASSERT | SE_M_IO_DATA_ASSERT | \
+			    SE_M_RX_FIFO_RD_ERR | SE_M_RX_FIFO_WR_ERR | \
+			    SE_M_TX_FIFO_RD_ERR | SE_M_TX_FIFO_WR_ERR)
+#define SE_S_COMMON_IRQ_EN (0x3eu | 0x3e00u | (1u << 24) | (1u << 25))
+#define SE_M_ERRORS	(SE_M_CMD_OVERRUN | SE_M_ILLEGAL_CMD | SE_M_CMD_FAILURE | \
+			 SE_M_RX_FIFO_RD_ERR | SE_M_RX_FIFO_WR_ERR | \
+			 SE_M_TX_FIFO_RD_ERR | SE_M_TX_FIFO_WR_ERR)
+#define SE_DMA_DONE	(1u << 0)
+#define SE_DMA_EOT	(1u << 1)
+#define SE_DMA_AHB_ERR	(1u << 2)
+#define SE_DMA_TX_ATTR_EOT_BUF (1u << 0)
+#define SE_DMA_GENERAL_CFG 0xe30u
+#define SE_DMA_TX_PTR_L	0xc30u
+#define SE_DMA_TX_PTR_H	0xc34u
+#define SE_DMA_TX_ATTR	0xc38u
+#define SE_DMA_TX_LEN	0xc3cu
+#define SE_DMA_TX_IRQ_STAT 0xc40u
+#define SE_DMA_TX_IRQ_EN_SET 0xc4cu
+#define SE_DMA_TX_LEN_IN 0xc54u
+#define SE_DMA_TX_FSM_RST 0xc58u
+#define SE_DMA_RX_PTR_L	0xd30u
+#define SE_DMA_RX_PTR_H	0xd34u
