+} sy;
+static int sy_chan;
+
+/* ---- mmio, sleep, pins ---------------------------------------------------------- */
+
+static uint32_t
+sy_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+sy_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+sy_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&sy_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+sy_sleep_until(uint64_t deadline)
+{
+	(void)assert_wait_deadline_with_leeway(&sy_chan, THREAD_UNINT,
+	    TIMEOUT_URGENCY_SYS_CRITICAL, deadline, 0);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+sy_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask, unsigned us)
+{
+	for (unsigned i = 0; i < us; i++) {
+		if (!(sy_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/*
+ * TLMM CTL: pull [1:0] (1 down, 3 up), func [5:2], drive [8:6] = mA/2-1, OE [9],
+ * EGPIO_PRESENT [11], EGPIO_ENABLE [12]. As PAND:218-234, plus mt_pin_cfg
+ * (MYRON:63-66): the low bits are replaced, the bits above kept, and ENABLE is
+ * only mirrored from whatever PRESENT the boot chain left (pandora_touch.c:209-
+ * 223, its working driver on the same pins). The touch pins pass egpio = false:
+ * the kernel does not force PRESENT/ENABLE into the SPI pad registers. The level
+ * is written before the output enable, so the pin never glitches.
+ */
+static void
+sy_gpio(unsigned n, unsigned func, unsigned pull, unsigned ma, int out, bool egpio)
+{
+	if (out >= 0) {
+		sy_wr(sy.tlmm, SY_GPIO(n) + 4, out ? 2u : 0u);
+	}
+	uint32_t old = sy_rd(sy.tlmm, SY_GPIO(n));
+	if (egpio) {
+		old |= SY_CFG_EGPIO_PRESENT;
+	}
+	uint32_t ctl = (old & ~(SY_CFG_LOW_MASK | SY_CFG_EGPIO_ENABLE)) |
+	    (pull | (func << 2) | ((ma / 2 - 1) << 6) | (out >= 0 ? 0x200u : 0u));
+	if (old & SY_CFG_EGPIO_PRESENT) {
+		ctl |= SY_CFG_EGPIO_ENABLE;
+	}
+	sy_wr(sy.tlmm, SY_GPIO(n), ctl);
+}
+
+static void
+sy_pins_dump(const char *when)
+{
+	static const uint8_t pins[] = {48, 49, 50, 51, SY_RESET, SY_AVDD, SY_IRQ};
+	printf("SONGYUAN TOUCH: pins %s:", when);
+	for (unsigned i = 0; i < sizeof(pins); i++) {
+		printf(" %u=%#x/%u", pins[i], sy_rd(sy.tlmm, SY_GPIO(pins[i])),
+		    sy_rd(sy.tlmm, SY_GPIO(pins[i]) + 4) & 3u);
+	}
+	printf("\n");
+}
+
+/* ---- RPMh: L4I_E0 on (iovdd, 1.8 V) ---------------------------------------------- */
+
+/*
+ * iovdd (L4I, 1.8 V) is an RPMh LDO, so XNU has to vote it through the apps RSC
+ * before the chip can answer. This is pandora_touch.c:657-825 (same SM8850, same
+ * PMH0110 PMIC; there the same vote powers the panel) with this file's helpers.
+ * Everything it addresses is songyuan's own live DT, E:\songyuan\dl\live.dtb:
+ *   /soc/rsc@18900000: compatible "qcom,rpmh-rsc", reg-names "drv-0" "drv-1"
+ *       "drv-2", drv-2 at 0x18920000 size 0x10000; /drv@2: qcom,drv-id <2>,
+ *       qcom,tcs-offset <0xd00>, qcom,tcs-distance <0x2a0>;
+ *       /drv@2/channel@0: qcom,tcs-config = <2 3>,<0 2>,<1 2>,<3 0>,<4 1>. A
+ *       tuple is <type, count> and type 2 is ACTIVE (PAND:667 and UniXNU's
+ *       WifiProbe.cpp:303 read it the same way), so the ACTIVE TCSs are 0..2.
+ *   /reserved-memory/aop_cmd_db_region@81c60000: compatible "qcom,cmd-db",
+ *       reg 0x81c60000 size 0x20000 - the command database.
+ *   /soc/rsc@18900000/drv@2/rpmh-regulator-l4i-e0: qcom,resource-name
+ *       "L4I_E0", qcom,regulator-type "pmic7-ldo";
+ *       /regulator-pmh0110-i-l4: regulator-min/max-microvolt 0x1b7740
+ *       (1800000), qcom,init-mode 3.
+ * A VRM resource takes three commands at (cmd-db address + offset): voltage in
+ * millivolts at +0, enable at +4, mode at +8 (PAND:787; UniXNU's QcomRpmh
+ * comments "the mode (7: HPM ...), the voltage in millivolts, then the
+ * enable"). The TCS register layout follows the RSC's major version; PAND:659-
+ * 664 and QcomRpmh.c:53-57 hold the same two tables (v2: 2.7, v3: 3.0). A
+ * version that is neither is refused, never guessed.
+ */
+#define SY_RSC_PA	0x18920000u	/* live DT rsc@18900000 drv-2 */
+#define SY_RSC_SIZE	0x10000u	/* live DT drv-2 reg size */
+#define SY_CMDDB_PA	0x81c60000u	/* live DT aop_cmd_db_region@81c60000 */
+#define SY_CMDDB_SIZE	0x20000u	/* live DT aop_cmd_db_region size */
+#define SY_TCS_OFF	0xd00u		/* live DT qcom,tcs-offset */
+#define SY_TCS_STRIDE	0x2a0u		/* live DT qcom,tcs-distance */
+#define SY_TCS_ACTIVE	3u		/* live DT qcom,tcs-config: ACTIVE x3 */
+#define SY_RSC_DRV	2u		/* live DT qcom,drv-id */
+#define SY_VRM_MV	1800u		/* live DT regulator-min-microvolt */
+#define SY_VRM_MODE	7u		/* high power mode (PAND:787) */
+#define SY_VRM_ENABLE	1u		/* enable (PAND:787) */
+#define SY_RPMH_WRITE	(8u | (1u << 8) | (1u << 16))	/* PAND:669: write, 4-byte, ack */
+#define SY_RPMH_AMC	(1u << 16)	/* PAND:796: ACTIVE mode command */
+#define SY_RPMH_DONE	0x10100u	/* PAND:806: issued | complete */
+#define SY_RPMH_TRIGGER	(1u << 24)	/* PAND:799: start the TCS */
+#define SY_CMDDB_MAGIC	0x0c0330dbu	/* PAND:670 */
+#define SY_CMDDB_HEADER	144u		/* PAND:671 */
+#define SY_CMDDB_ENTRY	24u		/* PAND:672 */
+
+/* Register layout per RSC major version (PAND:660-664; QcomRpmh.c:55-56). */
+struct sy_rpmh_layout {
+	uint32_t wait, control, status, enable, msgid, addr, data, cmd_status, cmd_stride;
+};
+static const struct sy_rpmh_layout sy_rpmh_v2 = {0x10, 0x14, 0x18, 0x1c, 0x30, 0x34, 0x38, 0x3c, 20};
+static const struct sy_rpmh_layout sy_rpmh_v3 = {0x20, 0x24, 0x28, 0x2c, 0x34, 0x38, 0x3c, 0x40, 24};
+
+static vm_offset_t sy_rsc, sy_cmddb;
+static bool sy_rpmh_tried;	/* the vote runs once per boot */
+static int sy_rpmh_result;	/* 0: the vote landed, else its errno */
+
+static uint16_t
+sy_cmddb16(uint32_t off)
+{
+	return (uint16_t)(sy_rd(sy_cmddb, off & ~3u) >> (8u * (off & 3u)));
+}
+
+/* PAND:722-734: write, then read back until the register keeps the value. */
+static bool
+sy_rpmh_sync(uint32_t off, uint32_t v)
+{
+	sy_wr(sy_rsc, off, v);
+	for (unsigned i = 0; i < 1000; i++) {
+		if (sy_rd(sy_rsc, off) == v) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* PAND:682-720: the resource's RPMh address out of the cmd-db (slave 4 = VRM). */
+static int
+sy_rpmh_lookup(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; i++) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; i++) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = sy_cmddb16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = SY_CMDDB_HEADER + sy_cmddb16(h + 2);
+		unsigned count = sy_cmddb16(h + 6);
+		if ((entries & 3u) || entries + count * SY_CMDDB_ENTRY > SY_CMDDB_SIZE) {
+			printf("SONGYUAN TOUCH: cmd-db slave header %u malformed\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; j++) {
+			uint32_t e = entries + SY_CMDDB_ENTRY * j;
+			if (sy_rd(sy_cmddb, e) != key[0] || sy_rd(sy_cmddb, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = sy_rd(sy_cmddb, e + 16);
+			printf("SONGYUAN TOUCH: cmd-db %s addr=%#x slave=%u\n", res, addr, slave);
+			if (slave == 4 && ((addr >> 16) & 7u) == 4 && !(addr & 15u)) {
+				*address = addr;
+				matches++;
+			}
+		}
+	}
+	if (matches != 1) {
+		printf("SONGYUAN TOUCH: cmd-db %s: %u VRM matches; not voting\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+/*
+ * PAND:736-825: one ACTIVE TCS carries the three commands of the vote
+ * (voltage, mode, enable); the RSC is triggered and reports completion in the
+ * TCS status and in each command's status. Only this TCS's interrupt enable bit
+ * is touched, and it is put back. The first call's outcome is kept, so a second
+ * call cannot arm a second request for the same rail.
+ */
+static int
+sy_rpmh_vote(void)
+{
+	const struct sy_rpmh_layout *L = NULL;
+	uint32_t id = 0, config = 0, magic = 0, address = 0;
+	uint32_t major, minor, ntcs, ncpt, b = 0, bit = 0, irq_en = 0;
+	uint32_t word[3] = {0, 0, 0}, cs[3] = {0, 0, 0};
+	uint32_t vals[3] = {SY_VRM_MV, SY_VRM_MODE, SY_VRM_ENABLE};
+	static const uint32_t offs[3] = {0, 8, 4};	/* voltage, mode, enable */
+	unsigned t = 0;
+	int chosen = -1, rc = 0;
+	bool done = false;
+
+	if (sy_rpmh_tried) {
+		return sy_rpmh_result;
+	}
+	sy_rsc = ml_io_map(SY_RSC_PA, SY_RSC_SIZE);
+	sy_cmddb = ml_io_map(SY_CMDDB_PA, SY_CMDDB_SIZE);
+	if (!sy_rsc || !sy_cmddb) {
+		printf("SONGYUAN TOUCH: RPMh: RSC/cmd-db mapping failed\n");
+		rc = ENOMEM;
+		goto out;
+	}
+	id = sy_rd(sy_rsc, 0);
+	config = sy_rd(sy_rsc, 0x0c);
+	major = (id >> 16) & 0xffu;
+	minor = (id >> 8) & 0xffu;
+	ntcs = (config >> (6u * SY_RSC_DRV)) & 0x3fu;
+	ncpt = (config >> 27) & 0x1fu;
+	printf("SONGYUAN TOUCH: RPMh: rsc=%#x id=%#x (v%u.%u) solver=%#x config=%#x tcs=%u ncpt=%u\n",
+	    SY_RSC_PA, id, major, minor, sy_rd(sy_rsc, 4), config, ntcs, ncpt);
+	/* Linux uses the 3.0 layout for every major >= 3 (PAND:751-756). */
+	L = major >= 3 ? &sy_rpmh_v3 : (major == 2 ? &sy_rpmh_v2 : NULL);
+	if (!L || ntcs < SY_TCS_ACTIVE || ntcs > 16 || ncpt < 3 || ncpt > 16) {
+		printf("SONGYUAN TOUCH: RPMh: RSC v%u.%u layout/geometry not known (tcs %u, "
+		    "ncpt %u); not voting\n", major, minor, ntcs, ncpt);
+		rc = ENODEV;
+		goto out;
+	}
+	magic = sy_rd(sy_cmddb, 4);
+	printf("SONGYUAN TOUCH: RPMh: cmd-db %#x size %#x version=%#x magic=%#x\n",
+	    SY_CMDDB_PA, SY_CMDDB_SIZE, sy_rd(sy_cmddb, 0), magic);
+	if (magic != SY_CMDDB_MAGIC) {
+		printf("SONGYUAN TOUCH: RPMh: cmd-db magic %#x is not %#x; not voting\n",
+		    magic, SY_CMDDB_MAGIC);
+		rc = ENODEV;
+		goto out;
+	}
+	if ((rc = sy_rpmh_lookup("L4I_E0", &address))) {
+		goto out;
+	}
+	for (t = 0; t < SY_TCS_ACTIVE; t++) {
+		b = SY_TCS_OFF + t * SY_TCS_STRIDE;
+		uint32_t st = sy_rd(sy_rsc, b + L->status), ctl = sy_rd(sy_rsc, b + L->control);
+		uint32_t en = sy_rd(sy_rsc, b + L->enable), wt = sy_rd(sy_rsc, b + L->wait);
+		printf("SONGYUAN TOUCH: RPMh: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, st, ctl, en, wt);
+		if (chosen < 0 && st != 0 && st != 0xffffffffu && ctl == 0 && en == 0 && wt == 0 &&
+		    !(sy_rd(sy_rsc, SY_TCS_OFF + 4) & (1u << t))) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("SONGYUAN TOUCH: RPMh: no free ACTIVE TCS; not voting\n");
+		rc = EBUSY;
+		goto out;
+	}
+	{
+		unsigned tc = (unsigned)chosen;
+		t = tc;
+		b = SY_TCS_OFF + tc * SY_TCS_STRIDE;
+		bit = 1u << tc;
+	}
+	irq_en = sy_rd(sy_rsc, SY_TCS_OFF);
+	if (!sy_rpmh_sync(SY_TCS_OFF, irq_en & ~bit)) {
+		printf("SONGYUAN TOUCH: RPMh: IRQ enable readback failed (want %#x, got %#x)\n",
+		    irq_en & ~bit, sy_rd(sy_rsc, SY_TCS_OFF));
+		rc = EIO;
+		goto out;
+	}
+	for (unsigned c = 0; c < 3; c++) {
+		uint32_t cmd = b + c * L->cmd_stride;
+		word[c] = address + offs[c];
+		if (!sy_rpmh_sync(cmd + L->msgid, SY_RPMH_WRITE) ||
+		    !sy_rpmh_sync(cmd + L->addr, word[c]) ||
+		    !sy_rpmh_sync(cmd + L->data, vals[c])) {
+			printf("SONGYUAN TOUCH: RPMh: command %u write failed: msgid %#x (want %#x), "
+			    "addr %#x (want %#x), data %#x (want %u); id=%#x (v%u.%u)\n", c,
+			    sy_rd(sy_rsc, cmd + L->msgid), SY_RPMH_WRITE,
+			    sy_rd(sy_rsc, cmd + L->addr), word[c],
+			    sy_rd(sy_rsc, cmd + L->data), vals[c], id, major, minor);
+			rc = EIO;
+			goto restore;
+		}
+	}
+	if (!sy_rpmh_sync(b + L->wait, 7) || !sy_rpmh_sync(b + L->enable, 7) ||
+	    !sy_rpmh_sync(b + L->control, 0) || !sy_rpmh_sync(b + L->control, SY_RPMH_AMC)) {
+		printf("SONGYUAN TOUCH: RPMh: TCS%u arm failed: wait=%#x enable=%#x control=%#x "
+		    "(want 7, 7, %#x), irq-enable=%#x, commands %#x/%#x/%#x = %u/%u/%u\n",
+		    t, sy_rd(sy_rsc, b + L->wait), sy_rd(sy_rsc, b + L->enable),
+		    sy_rd(sy_rsc, b + L->control), SY_RPMH_AMC, sy_rd(sy_rsc, SY_TCS_OFF),
+		    word[0], word[1], word[2], vals[0], vals[1], vals[2]);
+		rc = EIO;
+		goto restore;
+	}
+	sy_wr(sy_rsc, b + L->control, SY_RPMH_AMC | SY_RPMH_TRIGGER);
+	for (unsigned us = 0; us < 100000 && !done; us++) {
+		bool all = true;
+		for (unsigned c = 0; c < 3; c++) {
+			cs[c] = sy_rd(sy_rsc, b + L->cmd_status + c * L->cmd_stride);
+			all &= cs[c] != 0xffffffffu && (cs[c] & SY_RPMH_DONE) == SY_RPMH_DONE;
+		}
+		done = all && sy_rd(sy_rsc, b + L->status) != 0;
+		if (!done) {
+			delay(1);
+		}
+	}
+	printf("SONGYUAN TOUCH: RPMh: L4I_E0 %u mV/mode %u/enable on TCS%u done=%d irq=%#x "
+	    "status=%#x cmd-status=%#x/%#x/%#x\n", SY_VRM_MV, SY_VRM_MODE, t, done,
+	    sy_rd(sy_rsc, SY_TCS_OFF + 4), sy_rd(sy_rsc, b + L->status),
+	    cs[0], cs[1], cs[2]);
+	if (!done) {
+		printf("SONGYUAN TOUCH: RPMh: L4I_E0 vote timed out: rsc id=%#x (v%u.%u), "
+		    "commands %#x/%#x/%#x = %u/%u/%u, control=%#x status=%#x\n", id, major, minor,
+		    word[0], word[1], word[2], vals[0], vals[1], vals[2],
+		    sy_rd(sy_rsc, b + L->control), sy_rd(sy_rsc, b + L->status));
+		rc = ETIMEDOUT;
+	}
+restore:
+	/* Proven or not, return the TCS to idle and put the interrupt mask back. */
+	(void)sy_rpmh_sync(b + L->control, SY_RPMH_AMC);
+	(void)sy_rpmh_sync(b + L->control, 0);
+	(void)sy_rpmh_sync(b + L->enable, 0);
+	(void)sy_rpmh_sync(b + L->wait, 0);
+	sy_wr(sy_rsc, SY_TCS_OFF + 8, bit);	/* W1C: only our TCS's bit */
+	(void)sy_rpmh_sync(SY_TCS_OFF, irq_en);
+out:
+	sy_rpmh_tried = true;
+	sy_rpmh_result = rc;
+	return rc;
+}
+
+/* ---- clocks and serial engine --------------------------------------------------- */
+
+static bool
+sy_on(uint32_t cbcr)
+{
+	return !(sy_rd(sy.gcc, cbcr) & SY_GCC_CLK_OFF);
+}
+
+static void
+sy_clock_dump(const char *when)
+{
+	uint32_t r = SY_GCC_S0_RCG;
+	printf("SONGYUAN TOUCH: gcc %s: vote=%#x m_ahb=%#x s_ahb=%#x core=%#x core2x=%#x s0=%#x "
+	    "rcg=%#x cfg=%#x dfs=%#x perf0..3=%#x %#x %#x %#x\n", when,
+	    sy_rd(sy.gcc, SY_GCC_VOTE), sy_rd(sy.gcc, SY_GCC_M_AHB), sy_rd(sy.gcc, SY_GCC_S_AHB),
+	    sy_rd(sy.gcc, SY_GCC_CORE), sy_rd(sy.gcc, SY_GCC_CORE2X), sy_rd(sy.gcc, SY_GCC_S0),
+	    sy_rd(sy.gcc, r), sy_rd(sy.gcc, r + 4), sy_rd(sy.gcc, r + 0x14),
+	    sy_rd(sy.gcc, r + 0x1c), sy_rd(sy.gcc, r + 0x20), sy_rd(sy.gcc, r + 0x24),
+	    sy_rd(sy.gcc, r + 0x28));
+}
+
+/* PAND:269-306, unchanged: vote the four wrapper 4 branches (s0 follows the
+ * SE's own clock request), wait for them, then put the S0 root on XO
+ * undivided - with DFS, pick the level whose CFG is XO/1; without, write
+ * CFG and toggle the update bit. No PLL or voltage change. */
+static int
+sy_clocks(void)
+{
+	sy_wr(sy.gcc, SY_GCC_VOTE, sy_rd(sy.gcc, SY_GCC_VOTE) | SY_GCC_VOTE_BITS);
+	static const uint32_t branches[] = {SY_GCC_M_AHB, SY_GCC_S_AHB, SY_GCC_CORE, SY_GCC_CORE2X};
+	for (unsigned i = 0; i < 4; i++) {
+		for (unsigned t = 0; t < 10000 && !sy_on(branches[i]); t++) {
+			delay(1);
+		}
+		if (!sy_on(branches[i])) {
+			sy_clock_dump("branch off");
+			return EIO;
+		}
+	}
+	uint32_t r = SY_GCC_S0_RCG;
+	unsigned level = 0;
+	if (sy_rd(sy.gcc, r + 0x14) & 1u) {
+		while (level < 8 && (sy_rd(sy.gcc, r + 0x1c + 4 * level) & 0x371fu) != 1u) {
+			level++;
+		}
+		if (level == 8) {
+			sy_clock_dump("no XO DFS level");
+			return EIO;
+		}
+	} else {
+		uint32_t cfg = (sy_rd(sy.gcc, r + 4) & ~(0x371fu | (1u << 20))) | 1u;
+		sy_wr(sy.gcc, r + 4, cfg);
+		sy_wr(sy.gcc, r, sy_rd(sy.gcc, r) | 1u);
+		if (!sy_wait_clear(sy.gcc, r, 1u, 5000)) {
+			sy_clock_dump("RCG update timeout");
+			return EIO;
+		}
+	}
+	sy.level = level;
+	return 0;
+}
+
+/*
+ * The SE divider of the CONFIG0 TRE (PAND:642 writes it in the low half of the
+ * word that carries the DFS level at bits 16-18). The level sy_clocks selects
+ * is XO undivided, 19.2 MHz, so SPI = 19.2 MHz / div (PAND:115). The divider
+ * field's exact width is not in the evidence: 12 bits keeps it clear of the
+ * level and covers 19.2 MHz / 0xfff .. 19.2 MHz / 1 (TODO, REPORT.md U3).
+ */
+static void
+sy_set_hz(unsigned hz)
+{
+	if (hz == 0u) {
+		hz = SY_SPI_HZ;
+	}
+	unsigned div = (19200000u + hz / 2) / hz;
+	if (div == 0u) {
+		div = 1u;
+	}
+	if (div > 0xfffu) {
+		div = 0xfffu;
+	}
+	sy.hz = hz;
+	sy.spi_div = div;
+	sy.actual_hz = 19200000u / div;
+}
+
+/*
+ * GeniSpi.c:20-35: engine identity, FIFO geometry and the QUP hardware version.
+ * The wrapper's version register decides how HW_PARAM0 encodes the FIFO depth.
+ */
+static int
+sy_geni_info(void)
+{
+	uint32_t fw = sy_rd(sy.se, SE_FW_REV);
+	uint32_t hw0 = sy_rd(sy.se, SE_HW_PARAM0);
+	uint32_t ver = sy_rd(sy.wrapper, SE_QUP_HW_VER);
+	unsigned major = ver >> 28, minor = (ver >> 16) & 0xfffu;
+	unsigned mask = ((major == 3 && minor >= 10) || major > 3) ? 0xff0000u : 0x3f0000u;
+	unsigned proto = (fw >> 8) & 0xffu, ifd = sy_rd(sy.se, SE_IF_DISABLE);
+	sy.qup_major = major;
+	sy.qup_minor = minor;
+	sy.fifo_depth = (hw0 & mask) >> 16;
+	sy.fifo_bits = (hw0 >> 24) & 0x3fu;
+	sy.oversample = (major == 1 && minor == 0) ? 2u : 1u;
+	printf("SONGYUAN TOUCH: GENI: qup v%u.%u fw=%#x proto=%u if_disable=%#x hw0=%#x "
+	    "fifo %u x %u bits, oversampling %u\n", major, minor, fw, proto, ifd, hw0,
+	    sy.fifo_depth, sy.fifo_bits, sy.oversample);
+	if (proto != 1) {
+		printf("SONGYUAN TOUCH: SE0 is not configured for SPI\n");
+		return ENODEV;
+	}
+	if (sy.fifo_depth < 4 || sy.fifo_bits != 32) {
+		/* myron's GeniSpi.c:81 refuses this; the SE DMA path only needs the
+		 * depth for the watermarks, so log it and go on rather than lose the
+		 * boot over a geometry we do not use. */
+		printf("SONGYUAN TOUCH: GENI geometry is not 4+ x 32 bits; watermarks skipped\n");
+	}
+	return 0;
+}
+
+/*
+ * GeniSpi.c:37-72 for 8-bit words: the engine packs four bytes into each FIFO
+ * word, most significant first, and this has to be in the SPI registers - the
+ * GPI CONFIG0 TRE carries word length and clock but not these packing vectors.
+ */
+static void
+sy_geni_word_len(void)
+{
+	uint32_t cfg[4] = {0, 0, 0, 0};
+	unsigned start = 8u - 1u, idx = start;
+	for (unsigned i = 0; i < 4; i++) {
+		cfg[i] = ((uint32_t)idx << SE_PACK_START_SHIFT) | (1u << SE_PACK_DIR_SHIFT) |
+		    ((8u - 1u) << SE_PACK_LEN_SHIFT);
+		idx = (i + 1) * 8u + start;
+	}
+	cfg[3] |= SE_PACK_STOP;
+	uint32_t cfg0 = cfg[0] | (cfg[1] << SE_PACK_VECTOR_SHIFT);
+	uint32_t cfg1 = cfg[2] | (cfg[3] << SE_PACK_VECTOR_SHIFT);
+	sy_wr(sy.se, SE_TX_PACK0, cfg0);
+	sy_wr(sy.se, SE_TX_PACK1, cfg1);
+	sy_wr(sy.se, SE_RX_PACK0, cfg0);
+	sy_wr(sy.se, SE_RX_PACK1, cfg1);
+	sy_wr(sy.se, SE_BYTE_GRAN, 0);	/* GeniSpi.c:65: bpw/16 = 0 for 8-bit words */
+	sy_wr(sy.se, SE_SPI_WORD_LEN, 8u - SE_WORD_LEN_MIN);
+}
+
+/* GeniSpi.c:139-148: the SE's serial clock: DFS level in CLK_SEL, divider in SER_M_CLK_CFG. */
+static void
+sy_geni_clock(void)
+{
+	unsigned os = sy.oversample ? sy.oversample : 1u;
+	unsigned div;
+	if (sy.hz == 0u) {
+		return;
+	}
+	div = (19200000u + os * sy.hz - 1u) / (os * sy.hz);
+	if (div == 0u) {
+		div = 1u;
+	}
+	if (div > SE_CLK_DIV_MAX) {
+		div = SE_CLK_DIV_MAX;
+	}
+	sy.se_clk_div = div;
+	sy_wr(sy.se, SE_CLK_SEL, sy.level);
+	sy_wr(sy.se, SE_M_CLK_CFG, (div << SE_CLK_DIV_SHIFT) | SE_SER_CLK_EN);
+}
+
+/*
+ * Select the engine's transfer mode: FIFO/PIO (path 1, GeniSpi.c:99-101) or the
+ * SE's own DMA master (path 0, GeniSpi.c:113-118). Kept separate because the
+ * boot self-test runs both modes to find out which one actually carries data.
+ */
+static void
+sy_engine_select(unsigned path)
+{
+	sy_wr(sy.se, SE_M_IRQ_CLR, 0xffffffffu);
+	sy_wr(sy.se, SE_S_IRQ_CLR, 0xffffffffu);
+	sy_wr(sy.se, SE_DMA_TX_CLR, 0xffffffffu);
+	sy_wr(sy.se, SE_DMA_RX_CLR, 0xffffffffu);
+	sy_wr(sy.se, SE_GSI_EVENT_EN, 0);
+	if (path == 0) {
+		sy_wr(sy.se, SE_M_IRQ_EN, sy_rd(sy.se, SE_M_IRQ_EN) &
+		    ~(SE_M_CMD_DONE | SE_M_TX_FIFO_WATERMARK | SE_M_RX_FIFO_WATERMARK |
+		    SE_M_RX_FIFO_LAST));
+		sy_wr(sy.se, SE_DMA_MODE, sy_rd(sy.se, SE_DMA_MODE) | 1u);
+	} else {
+		sy_wr(sy.se, SE_M_IRQ_EN, sy_rd(sy.se, SE_M_IRQ_EN) |
+		    (SE_M_CMD_DONE | SE_M_TX_FIFO_WATERMARK | SE_M_RX_FIFO_WATERMARK |
+		    SE_M_RX_FIFO_LAST));
+		sy_wr(sy.se, SE_DMA_MODE, sy_rd(sy.se, SE_DMA_MODE) & ~1u);
+	}
+}
+
+/* GeniSpi.c:199-209: poll one of the M interrupt status bits, clearing what is latched. */
+static int
+sy_geni_wait(uint32_t bits, unsigned limit)
+{
+	for (unsigned i = 0; i < limit; i++) {
+		uint32_t st = sy_rd(sy.se, SE_M_IRQ);
+		if (st & bits) {
+			sy_wr(sy.se, SE_M_IRQ_CLR, st);
+			return 0;
+		}
+		delay(1);
+	}
+	return ETIMEDOUT;
+}
+
+/* GeniSpi.c:211-217: cancel a transfer that did not complete, then abort it. */
+static void
+sy_geni_recover(void)
+{
+	sy_wr(sy.se, SE_TX_WM, 0);
+	sy_wr(sy.se, SE_M_CMD_CTRL, SE_M_CMD_CANCEL);
+	if (!sy_geni_wait(SE_M_CMD_CANCEL_DONE | SE_M_CMD_DONE, 20000)) {
+		return;
+	}
+	sy_wr(sy.se, SE_M_CMD_CTRL, SE_M_CMD_ABORT);
+	(void)sy_geni_wait(SE_M_CMD_ABORT_DONE | SE_M_CMD_DONE, 20000);
+}
+
+/*
+ * What the next boot's log must show: the GENI registers on both sides of a
+ * transfer (and on every failed one), plus the QUP wrapper version. sy.dbg
+ * (songyuan_ftsdbg=1) prints it around every transfer; otherwise it is printed
+ * after a failure and for the first two transfers.
+ */
+static void
+sy_geni_dump(const char *when)
+{
+	printf("SONGYUAN TOUCH: geni %s: m_cmd0=%#x m_cmd_ctrl=%#x m_irq=%#x m_irq_en=%#x "
+	    "s_irq_en=%#x irq_en=%#x status=%#x gsi_ev=%#x dma_mode=%#x "
+	    "trans_cfg=%#x demux=%#x/%#x cpha=%#x cpol=%#x loop=%#x word=%#x "
+	    "pack=%#x/%#x rxpack=%#x/%#x byte_gran=%#x clk_sel=%#x m_clk=%#x\n", when,
+	    sy_rd(sy.se, SE_M_CMD0), sy_rd(sy.se, SE_M_CMD_CTRL), sy_rd(sy.se, SE_M_IRQ),
+	    sy_rd(sy.se, SE_M_IRQ_EN), sy_rd(sy.se, SE_S_IRQ_EN),
+	    sy_rd(sy.se, SE_IRQ_EN), sy_rd(sy.se, SE_STATUS), sy_rd(sy.se, SE_GSI_EVENT_EN),
+	    sy_rd(sy.se, SE_DMA_MODE), sy_rd(sy.se, SE_SPI_TRANS_CFG),
+	    sy_rd(sy.se, SE_SPI_DEMUX_SEL), sy_rd(sy.se, SE_SPI_DEMUX_INV),
+	    sy_rd(sy.se, SE_SPI_CPHA), sy_rd(sy.se, SE_SPI_CPOL), sy_rd(sy.se, SE_SPI_LOOPBACK),
+	    sy_rd(sy.se, SE_SPI_WORD_LEN), sy_rd(sy.se, SE_TX_PACK0), sy_rd(sy.se, SE_TX_PACK1),
+	    sy_rd(sy.se, SE_RX_PACK0), sy_rd(sy.se, SE_RX_PACK1), sy_rd(sy.se, SE_BYTE_GRAN),
+	    sy_rd(sy.se, SE_CLK_SEL), sy_rd(sy.se, SE_M_CLK_CFG));
+	printf("SONGYUAN TOUCH: geni %s dma: tx_irq=%#x tx_irq_en=%#x tx_ptr=%#x tx_len=%#x "
+	    "tx_len_in=%#x rx_irq=%#x rx_irq_en=%#x rx_ptr=%#x rx_len=%#x rx_len_in=%#x "
+	    "rx_attr=%#x fifo tx=%#x rx=%#x\n", when,
+	    sy_rd(sy.se, SE_DMA_TX_IRQ_STAT), sy_rd(sy.se, SE_DMA_TX_IRQ_EN_SET),
+	    sy_rd(sy.se, SE_DMA_TX_PTR_L), sy_rd(sy.se, SE_DMA_TX_LEN),
+	    sy_rd(sy.se, SE_DMA_TX_LEN_IN), sy_rd(sy.se, SE_DMA_RX_IRQ_STAT),
+	    sy_rd(sy.se, SE_DMA_RX_IRQ_EN_SET), sy_rd(sy.se, SE_DMA_RX_PTR_L),
+	    sy_rd(sy.se, SE_DMA_RX_LEN), sy_rd(sy.se, SE_DMA_RX_LEN_IN),
+	    sy_rd(sy.se, SE_DMA_RX_ATTR), sy_rd(sy.se, SE_TX_STATUS), sy_rd(sy.se, SE_RX_STATUS));
+	if (sy.gpi) {
+		printf("SONGYUAN TOUCH: geni %s gpi: ch0=%#x ch1=%#x ev=%#x gpii-err=%#x\n", when,
+		    sy_rd(sy.gpi, GPI_CH(0)), sy_rd(sy.gpi, GPI_CH(1)), sy_rd(sy.gpi, GPI_EV),
+		    sy_rd(sy.gpi, GPI_GPII + 0x200));
+	}
+}
+
+static void
+sy_dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(sy.dma_pa + off), len, TRUE);
+}
+
+static uint32_t
+sy_gstate(uint32_t ctx)
+{
+	return (sy_rd(sy.gpi, ctx) >> 20) & 0xf;
+}
+
+static bool
+sy_gpi_cmd(uint32_t reg, uint32_t v, uint32_t ctx, uint32_t want)
+{
+	sy_wr(sy.gpi, GPI_GPII + reg, v);
+	for (unsigned i = 0; i < 50000; i++) {
+		uint32_t st = sy_gstate(ctx);
+		if (st == want) {
+			sy_wr(sy.gpi, GPI_GPII + 0xa0, sy_rd(sy.gpi, GPI_GPII + 0x90));
+			sy_wr(sy.gpi, GPI_GPII + 0xa4, sy_rd(sy.gpi, GPI_GPII + 0x94));
+			return true;
+		}
+		if (st == 0xf) {
+			break;
+		}
+		delay(1);
+	}
+	printf("SONGYUAN TOUCH: GPI cmd %#x -> state %#x (want %u), error log %#x\n",
+	    v, sy_gstate(ctx), want, sy_rd(sy.gpi, GPI_GPII + 0x200));
+	return false;
+}
+
+/*
+ * Stream matches for the GPI (0x536) and the QUP (0x523), pointing where UFS's
+ * 0x60 points (PAND:384-431, same SIDs as MYRON:163-164). The firmware owns the
+ * context banks (GR1 aborts from EL1), so GR0 gets a stream-match group whose
+ * S2CR is copied from the UFS stream's; only GR0 is read or written.
+ * Idempotent.
+ */
+static int
+sy_smmu_setup(void)
+{
+	static const uint16_t sid[] = {SY_GPI_SMMU_SID, SY_QUP4_SMMU_SID};
+	uint32_t nsmr = sy_rd(sy.smmu, 0x20) & 0xff, s2cr = 0;
+	bool found = false;
+	for (unsigned i = 0; i < nsmr; i++) {
+		uint32_t smr = sy_rd(sy.smmu, 0x800 + 4 * i);
+		if ((smr & 0x80000000u) && ((SY_UFS_SMMU_SID ^ smr) & ~(smr >> 16) & 0x7fff) == 0) {
+			s2cr = sy_rd(sy.smmu, 0xc00 + 4 * i);
+			found = true;
+			break;
+		}
+	}
+	if (!found || ((s2cr >> 16) & 3) != 0) {
+		printf("SONGYUAN TOUCH: no UFS stream match to copy (s2cr %#x)\n", s2cr);
+		return ENODEV;
+	}
+	for (unsigned j = 0; j < 2; j++) {
+		unsigned i, freei = ~0u;
+		for (i = 0; i < nsmr; i++) {
+			uint32_t smr = sy_rd(sy.smmu, 0x800 + 4 * i);
+			if (!(smr & 0x80000000u)) {
+				if (freei == ~0u) {
+					freei = i;
+				}
+				continue;
+			}
+			if (((sid[j] ^ smr) & ~(smr >> 16) & 0x7fff) == 0) {
+				break;
+			}
+		}
+		if (i < nsmr) {
+			printf("SONGYUAN TOUCH: sid %#x already matched by SMR %u (S2CR %#x)\n",
+			    sid[j], i, sy_rd(sy.smmu, 0xc00 + 4 * i));
+			continue;
+		}
+		if (freei == ~0u) {
+			return ENOSPC;
+		}
+		sy_wr(sy.smmu, 0xc00 + 4 * freei, s2cr);
+		sy_wr(sy.smmu, 0x800 + 4 * freei, 0x80000000u | sid[j]);
+		printf("SONGYUAN TOUCH: SMR %u = sid %#x -> S2CR %#x (as UFS)\n", freei, sid[j],
+		    sy_rd(sy.smmu, 0xc00 + 4 * freei));
+	}
+	return 0;
+}
+
+/* PAND:433-502: stop/reset/free both channels and the event ring, then set up
+ * the event ring and the two channel rings in the DMA page. Channel 0 carries
+ * what the SE transmits (our TX), channel 1 what it receives (our RX). */
+static int
+sy_gpi_init(void)
+{
+	uint32_t lo = (uint32_t)sy.dma_pa, hi = (uint32_t)(sy.dma_pa >> 32);
+	for (unsigned k = 0; k < 2; k++) {
+		if (sy_gstate(GPI_CH(k)) == 2) {
+			(void)sy_gpi_cmd(0x08, (2u << 24) | k, GPI_CH(k), 3);
+		}
+		if (sy_gstate(GPI_CH(k))) {
+			(void)sy_gpi_cmd(0x08, (9u << 24) | k, GPI_CH(k), 1);
+			sy_wr(sy.gpi, GPI_GPII + 0x08, (10u << 24) | k);
+			delay(1000);
+		}
+	}
+	if (sy_gstate(GPI_EV)) {
+		(void)sy_gpi_cmd(0x10, 9u << 24, GPI_EV, 1);
+		sy_wr(sy.gpi, GPI_GPII + 0x10, 10u << 24);
+		delay(1000);
+	}
+	bzero((void *)sy.dma, SY_DMA_SIZE);
+	sy_dma_sync(0, SY_DMA_SIZE);
+	sy_wr(sy.gpi, GPI_GPII + 0x88, 0x4f);
+	sy_wr(sy.gpi, GPI_GPII + 0xb8, 1);
+	sy_wr(sy.gpi, GPI_GPII + 0x98, 3);
+	sy_wr(sy.gpi, GPI_GPII + 0x9c, 1);
+	sy_wr(sy.gpi, GPI_GPII + 0x108, 1);
+	sy_wr(sy.gpi, GPI_GPII + 0x120, 0xf);
+	sy_wr(sy.gpi, GPI_GPII + 0x188, 0);
+	sy_wr(sy.gpi, GPI_GPII + 0x18c, 0);
+	sy_wr(sy.gpi, GPI_GPII + 0x400, 0);
+	sy_wr(sy.gpi, GPI_GPII + 0x404, 0);
+	sy_wr(sy.gpi, GPI_GPII + 0x180, 1);
+	sy_wr(sy.gpi, GPI_GPII + 0x200, 0);
+	if (!sy_gpi_cmd(0x10, 0, GPI_EV, 1)) {
+		return EIO;
+	}
+	sy_wr(sy.gpi, GPI_EV + 0x00, 0x10010002u);
+	sy_wr(sy.gpi, GPI_EV + 0x04, SY_EVRING * 16);
+	sy_wr(sy.gpi, GPI_EV + 0x08, lo + SY_EV_OFF);
+	sy_wr(sy.gpi, GPI_EV + 0x0c, hi);
+	sy_wr(sy.gpi, GPI_EVDB + 4, hi);
+	for (uint32_t o = 0x20; o <= 0x34; o += 4) {
+		sy_wr(sy.gpi, GPI_EV + o, 0);
+	}
+	sy.evrp = 0;
+	sy_wr(sy.gpi, GPI_EVDB, lo + SY_EV_OFF + SY_EVRING * 16 - 16);
+	for (unsigned k = 0; k < 2; k++) {
+		if (!sy_gpi_cmd(0x08, k, GPI_CH(k), 1)) {
+			return EIO;
+		}
+		sy_wr(sy.gpi, GPI_CH(k) + 0x00, k ? 0x10000002u : 0x1000000au);
+		sy_wr(sy.gpi, GPI_CH(k) + 0x04, SY_RING * 16);
+		sy_wr(sy.gpi, GPI_CH(k) + 0x08, lo + SY_RING_OFF(k));
+		sy_wr(sy.gpi, GPI_CH(k) + 0x0c, hi);
+		sy_wr(sy.gpi, GPI_CHDB(k) + 4, hi);
+		/* SCRATCH_0: pair channel, protocol 1 (SPI), SE 0. fuxi writes 0x14
+		 * here because its engine is SE 4 (FUXI:294); ours is SE0. */
+		sy_wr(sy.gpi, GPI_CH(k) + 0x60, k ? 0x00000010u : 0x00010010u);
+		sy_wr(sy.gpi, GPI_CH(k) + 0x64, 0);
+		sy_wr(sy.gpi, GPI_CH(k) + 0x68, 0);
+		sy_wr(sy.gpi, GPI_CH(k) + 0x6c, 0);
+		sy_wr(sy.gpi, GPI_CH(k) + 0x5c, 1);
+		sy.wp[k] = 0;
+	}
+	for (unsigned k = 0; k < 2; k++) {
+		if (!sy_gpi_cmd(0x08, (1u << 24) | k, GPI_CH(k), 2)) {
+			return EIO;
+		}
+	}
+	return 0;
+}
+
+/*
+ * SE0 bring-up. The common part is geni_se_init plus the SMMU/DMA page set-up of
+ * PAND:493-555. The SPI half is myron's, whose driver is the one that works on
+ * this phone (GeniSpi.c:74-148): word length and packing are written here, chip
+ * select stays with the engine (TRANS_CFG CS toggle clear, demux line 0),
+ * CPHA/CPOL 0, and the clock goes to SE_CLK_SEL / SER_M_CLK_CFG. The data path
+ * defaults to the serial engine's own DMA master (GeniSpi.c:113-118), which is
+ * what myron uses because TZ leaves SE0's FIFO interface disabled; the wrapper 4
+ * GPI DMA of pandora (PAND:493-520) stays reachable with songyuan_ftsdma=0.
+ */
+static int
+sy_se_init(void)
+{
+	int err;
+	sy.wrapper = ml_io_map(SY_QUP_WRAPPER_PA, SY_QUP_WRAPPER_SIZE);
+	if (!sy.wrapper) {
+		printf("SONGYUAN TOUCH: no QUP wrapper mapping\n");
+		return ENOMEM;
+	}
+	if ((err = sy_geni_info())) {
+		return err;
+	}
+	if (sy_rd(sy.se, SE_STATUS) & 1u) {
+		printf("SONGYUAN TOUCH: SE0 busy (status %#x)\n", sy_rd(sy.se, SE_STATUS));
+		return EBUSY;
+	}
+	if (sy.path != 2) {
+		/* GeniSpi.c:74-121 verbatim, then the SPI half (:98-107, 68-72, 139-148).
+		 * The top-level SE_IRQ_EN is left enabled as myron's driver leaves it, so
+		 * the status registers are visible to the poll. */
+		sy_wr(sy.se, SE_GSI_EVENT_EN, 0);
+		sy_wr(sy.se, SE_M_IRQ_CLR, 0xffffffffu);
+		sy_wr(sy.se, SE_S_IRQ_CLR, 0xffffffffu);
+		sy_wr(sy.se, SE_DMA_TX_CLR, 0xffffffffu);
+		sy_wr(sy.se, SE_DMA_RX_CLR, 0xffffffffu);
+		sy_wr(sy.se, SE_IRQ_EN, 0xffffffffu);
+		sy_wr(sy.se, SE_CGC_CTRL, sy_rd(sy.se, SE_CGC_CTRL) | 0x7fu);
+		sy_wr(sy.se, SE_DMA_GENERAL_CFG, sy_rd(sy.se, SE_DMA_GENERAL_CFG) | 0xfu);
+		sy_wr(sy.se, SE_OUTPUT_CTRL, 0x7fu);
+		sy_wr(sy.se, SE_FORCE_DEFAULT, 1);
+		sy_wr(sy.se, SE_IRQ_EN, sy_rd(sy.se, SE_IRQ_EN) | 0xfu);
+		sy_wr(sy.se, SE_DMA_MODE, sy_rd(sy.se, SE_DMA_MODE) & ~1u);
+		sy_wr(sy.se, SE_GSI_EVENT_EN, 0);
+		if (sy.fifo_depth >= 4) {
+			sy_wr(sy.se, SE_RX_WM, sy.fifo_depth - 3);
+			sy_wr(sy.se, SE_RX_RFR_WM, sy.fifo_depth - 2);
+		}
+		sy_wr(sy.se, SE_M_IRQ_EN, sy_rd(sy.se, SE_M_IRQ_EN) | SE_M_COMMON_IRQ_EN);
+		sy_wr(sy.se, SE_S_IRQ_EN, sy_rd(sy.se, SE_S_IRQ_EN) | SE_S_COMMON_IRQ_EN);
+		/* geni_spi_init's FIFO-mode selection, then geni_spi_setup(0, CS0). */
+		sy_wr(sy.se, SE_M_IRQ_CLR, 0xffffffffu);
+		sy_wr(sy.se, SE_S_IRQ_CLR, 0xffffffffu);
+		sy_wr(sy.se, SE_DMA_TX_CLR, 0xffffffffu);
+		sy_wr(sy.se, SE_DMA_RX_CLR, 0xffffffffu);
+		sy_wr(sy.se, SE_M_IRQ_EN, sy_rd(sy.se, SE_M_IRQ_EN) |
+		    (SE_M_CMD_DONE | SE_M_TX_FIFO_WATERMARK | SE_M_RX_FIFO_WATERMARK |
+		    SE_M_RX_FIFO_LAST));
+		sy_wr(sy.se, SE_DMA_MODE, sy_rd(sy.se, SE_DMA_MODE) & ~1u);
+		sy_wr(sy.se, SE_SPI_LOOPBACK, sy.loopback ? 1u : 0u);
+		sy_wr(sy.se, SE_SPI_DEMUX_SEL, 0);	/* chip select 0, the DT's one */
+		sy_wr(sy.se, SE_SPI_CPHA, (sy.spi_mode & 1u) ? SE_SPI_CPHA_BIT : 0u);
+		sy_wr(sy.se, SE_SPI_CPOL, (sy.spi_mode & 2u) ? SE_SPI_CPOL_BIT : 0u);
+		sy_wr(sy.se, SE_SPI_DEMUX_INV, 0);
+		sy_wr(sy.se, SE_SPI_TRANS_CFG, sy_rd(sy.se, SE_SPI_TRANS_CFG) &
+		    ~SE_SPI_CS_TOGGLE);
+		sy_geni_word_len();
+		sy_geni_clock();
+		sy_engine_select(sy.path);
+	} else {
+		/* PAND:504-520 unchanged: geni_se_select_mode(GENI_GPI_DMA). */
+		sy_wr(sy.se, SE_GSI_EVENT_EN, 0);
+		sy_wr(sy.se, SE_M_IRQ_CLR, 0xffffffffu);
+		sy_wr(sy.se, SE_S_IRQ_CLR, 0xffffffffu);
+		sy_wr(sy.se, SE_DMA_TX_CLR, 0xffffffffu);
+		sy_wr(sy.se, SE_DMA_RX_CLR, 0xffffffffu);
+		sy_wr(sy.se, SE_CGC_CTRL, sy_rd(sy.se, SE_CGC_CTRL) | 0x7fu);
+		sy_wr(sy.se, SE_DMA_GENERAL_CFG, sy_rd(sy.se, SE_DMA_GENERAL_CFG) | 0xfu);
+		sy_wr(sy.se, SE_OUTPUT_CTRL, 0x7fu);
+		sy_wr(sy.se, SE_FORCE_DEFAULT, 1);
+		sy_wr(sy.se, SE_IRQ_EN, 0);
+		sy_wr(sy.se, SE_M_IRQ_EN, sy_rd(sy.se, SE_M_IRQ_EN) &
+		    ~(SE_M_CMD_DONE | SE_M_RX_FIFO_WATERMARK | SE_M_RX_FIFO_LAST |
+		    SE_M_TX_FIFO_WATERMARK));
+		sy_wr(sy.se, SE_S_IRQ_EN, sy_rd(sy.se, SE_S_IRQ_EN) & ~1u);
+		sy_wr(sy.se, SE_DMA_MODE, 1);
+		sy_wr(sy.se, SE_GSI_EVENT_EN, sy_rd(sy.se, SE_GSI_EVENT_EN) | 0xfu);
+	}
+	sy.smmu = ml_io_map(SY_SMMU_PA, 0x1000);
+	if (!sy.smmu) {
+		printf("SONGYUAN TOUCH: no SMMU mapping\n");
+		return ENOMEM;
+	}
+	if (sy.path == 2) {
+		sy.gpi = ml_io_map(SY_GPI_PA, SY_GPI_SIZE);
+		if (!sy.gpi) {
+			printf("SONGYUAN TOUCH: no GPI mapping\n");
+			return ENOMEM;
+		}
+	}
+	if ((err = sy_smmu_setup())) {
+		return err;
+	}
+	if (kmem_alloc_contig(kernel_map, &sy.dma, SY_DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SONGYUAN TOUCH: no DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)sy.dma);
+	if (!pn) {
+		printf("SONGYUAN TOUCH: DMA page has no physical address\n");
+		return ENOMEM;
+	}
+	sy.dma_pa = ptoa_64(pn);
+	if (sy.dma_pa + SY_DMA_SIZE > (1ULL << 36)) {
+		printf("SONGYUAN TOUCH: DMA at %#llx is outside the SMMU's 36-bit range\n",
+		    sy.dma_pa);
+		return ENOMEM;
+	}
+	if (sy.path == 2) {
+		printf("SONGYUAN TOUCH: GPII %u before: ch0 %#x ch1 %#x ev %#x\n", SY_GPII,
+		    sy_rd(sy.gpi, GPI_CH(0)), sy_rd(sy.gpi, GPI_CH(1)), sy_rd(sy.gpi, GPI_EV));
+		if ((err = sy_gpi_init())) {
+			return err;
+		}
+	}
+	printf("SONGYUAN TOUCH: SE0 SPI over %s, DMA page %#llx, DFS level %u, "
+	    "div %u = %u Hz (if_disable %#x)\n",
+	    sy.path == 0 ? "SE DMA" : sy.path == 1 ? "FIFO/PIO" : "GPII 1", sy.dma_pa,
+	    sy.level, sy.path == 2 ? sy.spi_div : sy.se_clk_div,
+	    sy.path == 2 ? sy.actual_hz :
+	    19200000u / (sy.se_clk_div ? sy.se_clk_div : 1),
+	    sy_rd(sy.se, SE_IF_DISABLE));
+	sy_geni_dump("after SE set-up");
+	return 0;
+}
+
+/* ---- TRE ring and transfers ------------------------------------------------------ */
+
+static void
+sy_tre(unsigned k, uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3)
+{
+	uint32_t off = SY_RING_OFF(k) + 16 * sy.wp[k];
+	volatile uint32_t *t = (volatile uint32_t *)(sy.dma + off);
+	t[0] = d0;
+	t[1] = d1;
+	t[2] = d2;
+	t[3] = d3;
+	sy_dma_sync(off, 16);
+	sy.wp[k] = (sy.wp[k] + 1) % SY_RING;
+}
+
+static void
+sy_ring_db(unsigned k)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_wr(sy.gpi, GPI_CHDB(k), (uint32_t)sy.dma_pa + SY_RING_OFF(k) + 16 * sy.wp[k]);
+}
+
+/* PAND:587-621: drain events until end-of-transfer (code 2) has come from every
+ * channel in want. */
+static int
+sy_gpi_wait(unsigned want)
+{
+	unsigned seen = 0;
+	for (unsigned us = 0; us < 50000; us++) {
+		uint32_t hw = sy_rd(sy.gpi, GPI_EV + 0x10);
+		bool bad = false;
+		while (hw != (uint32_t)sy.dma_pa + SY_EV_OFF + 16 * sy.evrp) {
+			uint32_t off = SY_EV_OFF + 16 * sy.evrp;
+			sy_dma_sync(off, 16);
+			volatile uint32_t *e = (volatile uint32_t *)(sy.dma + off);
+			uint32_t d2 = e[2], d3 = e[3];
+			sy.evrp = (sy.evrp + 1) % SY_EVRING;
+			unsigned code = d2 >> 24, type = (d3 >> 16) & 0xff, ch = d3 >> 24;
+			if (code == 16 || type == 0xff || ch >= 2) {
+				bad = true;
+				printf("SONGYUAN TOUCH: GPI event %#x %#x\n", d2, d3);
+			} else if (type == 0x22 && code == 2) {
+				seen |= 1u << ch;
+			}
+		}
+		sy_wr(sy.gpi, GPI_EVDB, (uint32_t)sy.dma_pa + SY_EV_OFF +
+		    16 * ((sy.evrp + SY_EVRING - 1) % SY_EVRING));
+		sy_wr(sy.gpi, GPI_GPII + 0xc0, 1);
+		if (bad) {
+			return EIO;
+		}
+		if ((seen & want) == want) {
+			return 0;
+		}
+		delay(1);
+	}
+	return ETIMEDOUT;
+}
+
+/*
+ * Chip select, when songyuan_ftsvariant bit 4 asks for manual control: GPIO 51 as
+ * a TLMM output (qup4_se0_l3 driven by the pin mux, not the serial engine), low
+ * for the frame and released to the engine afterwards. This answers "is the chip
+ * selected at all" without a rebuild.
+ */
+static void
+sy_cs(bool assert)
+{
+	if (assert) {
+		sy_gpio(51, 0, 0, 6, 0, false);		/* function 0, output, level low */
+		delay(2);
+	} else {
+		delay(2);
+		sy_gpio(51, 0, 0, 6, 1, false);		/* level high first */
+		delay(2);
+		sy_gpio(51, SY_FUNC_QUP4_SE0, 3, 6, -1, false);	/* back to the SE */
+	}
+}
+
+/* Hex of a frame: what the engine was given and what it brought back. */
+static void
+sy_hex(const char *tag, const uint8_t *p, unsigned n)
+{
+	printf("%s", tag);
+	for (unsigned i = 0; i < n && i < 24; i++) {
+		printf(" %02x", p[i]);
+	}
+	if (n > 24) {
+		printf(" ..");
+	}
+}
+
+/*
+ * Chip select with the engine's own commands, as Linux's FIFO path does it:
+ * SPI_CS_ASSERT = 8 and SPI_CS_DEASSERT = 9 are M_CMD opcodes, and the transfer
+ * command then carries FRAGMENTATION (bit 2) so the engine does not touch CS
+ * itself (spi-geni-qcom.c:63-69, 287-331, 906; the driver only registers a
+ * set_cs callback for FIFO mode, "for dma (gsi) mode, the gsi will set cs based
+ * on params passed in TRE", :1145-1151). Variant bit 9 selects this.
+ */
+static int
+sy_cs_cmd(bool assert)
+{
+	sy_wr(sy.se, SE_M_IRQ_CLR, 0xffffffffu);
+	sy_wr(sy.se, SE_M_CMD0, (assert ? 8u : 9u) << SE_M_CMD0_OPCODE_SHIFT);
+	return sy_geni_wait(SE_M_CMD_DONE, 20000);
+}
+
+/*
+ * Program and poll one command of the SE's DMA master (GeniSpi.c:219-293).
+ * tx/rx select the directions; cmd_word is the fully shifted SE_GENI_M_CMD0
+ * value (permission: TX_RX for one full-duplex command, TX_ONLY|fragmentation
+ * then RX_ONLY for the TX-then-RX variant). 0 when every requested done bit
+ * arrived, EIO on an error bit, ETIMEDOUT at the poll limit.
+ */
+static int
+sy_dma_run(bool tx, bool rx, unsigned n, uint32_t cmd_word, bool *tdone, bool *rdone)
+{
+	uint32_t lo = (uint32_t)sy.dma_pa, hi = (uint32_t)(sy.dma_pa >> 32);
+	int err = 0;
+	*tdone = !tx;
+	*rdone = !rx;
+	sy_wr(sy.se, SE_M_IRQ_CLR, 0xffffffffu);
+	sy_wr(sy.se, SE_DMA_TX_CLR, 0xffffffffu);
+	sy_wr(sy.se, SE_DMA_RX_CLR, 0xffffffffu);
+	if (tx) {
+		sy_wr(sy.se, SE_SPI_TX_LEN, n);
+	}
+	if (rx) {
+		sy_wr(sy.se, SE_SPI_RX_LEN, n);
+	}
+	sy_wr(sy.se, SE_M_CMD0, cmd_word);
+	if (rx) {
+		sy_wr(sy.se, SE_DMA_RX_IRQ_EN_SET, SE_DMA_DONE | SE_DMA_EOT | SE_DMA_AHB_ERR);
+		sy_wr(sy.se, SE_DMA_RX_PTR_L, lo + SY_RXB_OFF);
+		sy_wr(sy.se, SE_DMA_RX_PTR_H, hi);
+		sy_wr(sy.se, SE_DMA_RX_ATTR, 0);
+		sy_wr(sy.se, SE_DMA_RX_LEN, n);
+	}
+	if (tx) {
+		sy_wr(sy.se, SE_DMA_TX_IRQ_EN_SET, SE_DMA_DONE | SE_DMA_EOT | SE_DMA_AHB_ERR);
+		sy_wr(sy.se, SE_DMA_TX_PTR_L, lo + SY_TXB_OFF);
+		sy_wr(sy.se, SE_DMA_TX_PTR_H, hi);
+		sy_wr(sy.se, SE_DMA_TX_ATTR, SE_DMA_TX_ATTR_EOT_BUF);
+		sy_wr(sy.se, SE_DMA_TX_LEN, n);
+	}
+	for (unsigned i = 0; i < 200000; i++) {
+		uint32_t ts = sy_rd(sy.se, SE_DMA_TX_IRQ_STAT);
+		uint32_t rs = sy_rd(sy.se, SE_DMA_RX_IRQ_STAT);
+		uint32_t ms = sy_rd(sy.se, SE_M_IRQ);
+		if (ts) {
+			sy_wr(sy.se, SE_DMA_TX_CLR, ts);
+		}
+		if (rs) {
+			sy_wr(sy.se, SE_DMA_RX_CLR, rs);
+		}
+		if (ms) {
+			sy_wr(sy.se, SE_M_IRQ_CLR, ms);
+		}
+		if ((ts | rs) & SE_DMA_AHB_ERR) {
+			err = EIO;
+			break;
+		}
+		if (ms & SE_M_ERRORS) {
+			err = EIO;
+			break;
+		}
+		if (tx && (ts & SE_DMA_DONE)) {
+			*tdone = true;
+		}
+		if (rx && (rs & SE_DMA_DONE)) {
+			*rdone = true;
+		}
+		if (*tdone && *rdone) {
+			break;
+		}
+		delay(1);
+	}
+	sy.se_tx_in = sy_rd(sy.se, SE_DMA_TX_LEN_IN);
+	sy.se_rx_in = sy_rd(sy.se, SE_DMA_RX_LEN_IN);
+	if (!err && !(*tdone && *rdone)) {
+		err = ETIMEDOUT;
+	}
+	return err;
+}
+
+/*
+ * One frame through the serial engine's own DMA master (GeniSpi.c:219-293). Both
+ * directions always carry n bytes, TX from SY_TXB_OFF and RX into SY_RXB_OFF of
+ * the DMA page. The RX buffer starts as a 0x5a canary, so bytes the engine did
+ * not write show up as 0x5a in the log instead of looking like data.
+ */
+static int
+sy_spi_dma(const uint8_t *tx, uint8_t *rx, unsigned n)
+{
+	uint8_t *txb = (uint8_t *)(sy.dma + SY_TXB_OFF), *rxb = (uint8_t *)(sy.dma + SY_RXB_OFF);
+	bool tdone = false, rdone = false;
+	int err;
+
+	if (tx) {
+		memcpy(txb, tx, n);
+	} else {
+		memset(txb, 0, n);
+	}
+	memset(rxb, 0x5a, n);
+	clean_dcache64((addr64_t)(sy.dma_pa + SY_TXB_OFF), n, 1);	/* the engine reads our bytes */
+	flush_dcache64((addr64_t)(sy.dma_pa + SY_RXB_OFF), n, 1);	/* no stale line may win */
+	if (sy.cs_cmds && sy_cs_cmd(true)) {
+		printf("SONGYUAN TOUCH: SPI CS assert command failed\n");
+		return EIO;
+	}
+	if (sy.tx_then_rx) {
+		/* First the header out with the chip select held (fragmentation = bit 2),
+		 * then a read-only command that clocks the answer in. */
+		err = sy_dma_run(true, false, n,
+		    SE_M_CMD_TX_ONLY << SE_M_CMD0_OPCODE_SHIFT | (1u << 2), &tdone, &rdone);
+		if (!err) {
+			err = sy_dma_run(false, true, n,
+			    SE_M_CMD_RX_ONLY << SE_M_CMD0_OPCODE_SHIFT, &tdone, &rdone);
+		}
+	} else {
+		err = sy_dma_run(true, true, n,
+		    SE_M_CMD_TX_RX << SE_M_CMD0_OPCODE_SHIFT | (sy.cs_cmds ? (1u << 2) : 0u),
+		    &tdone, &rdone);
+	}
+	if (sy.cs_cmds) {
+		(void)sy_cs_cmd(false);
+	}
+	if (!err) {
+		flush_dcache64((addr64_t)(sy.dma_pa + SY_RXB_OFF), n, 1);
+		if (rx) {
+			memcpy(rx, rxb, n);
+		}
+		return 0;
+	}
+	if (++sy.dma_errors <= 8 || sy.dbg) {
+		printf("SONGYUAN TOUCH: SPI SE-DMA failed %d (n %u, done tx %d rx %d, len_in %u/%u): "
+		    "m_cmd0=%#x m_irq=%#x m_irq_en=%#x status=%#x dma tx_irq=%#x rx_irq=%#x "
+		    "rx_attr=%#x fifo tx=%#x rx=%#x\n", err, n, tdone, rdone, sy.se_tx_in,
+		    sy.se_rx_in, sy_rd(sy.se, SE_M_CMD0), sy_rd(sy.se, SE_M_IRQ),
+		    sy_rd(sy.se, SE_M_IRQ_EN), sy_rd(sy.se, SE_STATUS),
+		    sy_rd(sy.se, SE_DMA_TX_IRQ_STAT), sy_rd(sy.se, SE_DMA_RX_IRQ_STAT),
+		    sy_rd(sy.se, SE_DMA_RX_ATTR), sy_rd(sy.se, SE_TX_STATUS),
+		    sy_rd(sy.se, SE_RX_STATUS));
+		sy_geni_dump("failed transfer");
+	}
+	sy_geni_recover();
+	sy_wr(sy.se, SE_DMA_TX_FSM_RST, 1);
+	sy_wr(sy.se, SE_DMA_RX_FSM_RST, 1);
+	if (sy.dma_errors >= 40) {
+		sy.dead = true;
+	}
+	return err;
+}
+
+/* GeniSpi.c:156-174: fill the TX FIFO from what is left. True while more remains. */
+static bool
+sy_fifo_tx(const uint8_t *tx, unsigned len, unsigned *rem, unsigned bpw)
+{
+	unsigned words = sy.fifo_depth >= 2 ? sy.fifo_depth - 1u : 1u;
+	unsigned max = words * bpw, i = 0;
+	const uint8_t *p = tx + (len - *rem);
+
+	if (*rem < max) {
+		max = *rem;
+	}
+	while (i < max) {
+		uint32_t word = 0;
+		unsigned k = max - i < bpw ? max - i : bpw;
+		for (unsigned j = 0; j < k; j++) {
+			word |= (uint32_t)p[i++] << (8 * j);
+		}
+		sy_wr(sy.se, SE_TX_FIFO, word);
+	}
+	*rem -= max;
+	if (!*rem) {
+		sy_wr(sy.se, SE_TX_WM, 0);
+		return false;
+	}
+	return true;
+}
+
+/* GeniSpi.c:176-197: drain the RX FIFO into what is left of the frame. */
+static void
+sy_fifo_rx(uint8_t *rx, unsigned len, unsigned *rem, unsigned bpw)
+{
+	uint32_t st = sy_rd(sy.se, SE_RX_STATUS);
+	unsigned bytes = (st & 0x1ffffffu) * bpw, i = 0;
+	uint8_t *p = rx + (len - *rem);
+	if (st & (1u << 31)) {
+		unsigned valid = (st >> 28) & 7u;
+		if (valid && valid < 4) {
+			bytes -= bpw - valid;
+		}
+	}
+	if (*rem < bytes) {
+		bytes = *rem;
+	}
+	while (i < bytes) {
+		uint32_t word = sy_rd(sy.se, SE_RX_FIFO);
+		unsigned k = bytes - i < bpw ? bytes - i : bpw;
+		for (unsigned j = 0; j < k; j++) {
+			p[i++] = (uint8_t)(word >> (8 * j));
+		}
+	}
+	*rem -= bytes;
+}
+
+/*
+ * One frame in FIFO/PIO mode (GeniSpi.c:295-348, the non-DMA branch): variant
+ * bits 1:0 = 1. The engine's FIFO interface is disabled by TZ, so this is the
+ * hypothesis "the FIFO still works and DMA was the problem"; it shows the raw
+ * bytes the engine shifts in.
+ */
+static int
+sy_spi_fifo(const uint8_t *tx, uint8_t *rx, unsigned n)
+{
+	unsigned bpw = sy.fifo_bits >= 8 ? sy.fifo_bits / 8 : 4u;
+	unsigned tx_rem = tx ? n : 0, rx_rem = rx ? n : 0;
+	uint32_t cmd = 0;
+	int err = ETIMEDOUT;
+
+	if (bpw == 0) {
+		bpw = 4;
+	}
+	if (tx) {
+		cmd |= SE_M_CMD_TX_ONLY;
+	}
+	if (rx) {
+		cmd |= SE_M_CMD_RX_ONLY;
+	}
+	if (cmd == (SE_M_CMD_TX_ONLY | SE_M_CMD_RX_ONLY)) {
+		cmd = SE_M_CMD_TX_RX;
+	}
+	sy_wr(sy.se, SE_M_IRQ_CLR, 0xffffffffu);
+	if (sy.cs_cmds && sy_cs_cmd(true)) {
+		printf("SONGYUAN TOUCH: SPI FIFO CS assert command failed\n");
+		return EIO;
+	}
+	if (tx) {
+		sy_wr(sy.se, SE_SPI_TX_LEN, n);
+	}
+	if (rx) {
+		sy_wr(sy.se, SE_SPI_RX_LEN, n);
+	}
+	sy_wr(sy.se, SE_M_CMD0,
+	    (cmd << SE_M_CMD0_OPCODE_SHIFT) | (sy.cs_cmds ? (1u << 2) : 0u));
+	if (tx && sy_fifo_tx(tx, n, &tx_rem, bpw)) {
+		sy_wr(sy.se, SE_TX_WM, 1);
+	}
+	/* Did the FIFO writes land? A TX FIFO status of 0 right after 10 bytes were
+	 * pushed into it means the CPU-side FIFO interface is dead (IF_DISABLE bit 0);
+	 * that is what decides whether FIFO mode is usable at all. */
+	if (sy.fifo_logs++ < 2 || sy.dbg) {
+		printf("SONGYUAN TOUCH: SPI FIFO[%u] n %u after prime: status=%#x m_irq=%#x "
+		    "tx_status=%#x rx_status=%#x cmd0=%#x if_disable=%#x\n", sy.fifo_logs, n,
+		    sy_rd(sy.se, SE_STATUS), sy_rd(sy.se, SE_M_IRQ),
+		    sy_rd(sy.se, SE_TX_STATUS), sy_rd(sy.se, SE_RX_STATUS),
+		    sy_rd(sy.se, SE_M_CMD0), sy_rd(sy.se, SE_IF_DISABLE));
+	}
+	for (unsigned i = 0; i < 200000; i++) {
+		uint32_t st = sy_rd(sy.se, SE_M_IRQ);
+		if (!st) {
+			delay(1);
+			continue;
+		}
+		sy_wr(sy.se, SE_M_IRQ_CLR, st);
+		if (st & SE_M_ERRORS) {
+			err = EIO;
+			break;
+		}
+		if (st & (SE_M_RX_FIFO_WATERMARK | SE_M_RX_FIFO_LAST)) {
+			sy_fifo_rx(rx, n, &rx_rem, bpw);
+		}
+		if ((st & SE_M_TX_FIFO_WATERMARK) && tx) {
+			(void)sy_fifo_tx(tx, n, &tx_rem, bpw);
+		}
+		if (st & SE_M_CMD_DONE) {
+			if (rx && rx_rem) {
+				sy_fifo_rx(rx, n, &rx_rem, bpw);
+			}
+			err = (tx_rem || rx_rem) ? EIO : 0;
+			if (tx_rem) {
+				sy_wr(sy.se, SE_TX_WM, 0);
+			}
+			break;
+		}
+		delay(1);
+	}
+	if (sy.cs_cmds) {
+		(void)sy_cs_cmd(false);
+	}
+	if (err) {
+		printf("SONGYUAN TOUCH: SPI FIFO failed %d (n %u, left tx %u rx %u): m_cmd0=%#x "
+		    "m_irq=%#x m_irq_en=%#x status=%#x fifo tx=%#x rx=%#x clk_sel=%#x m_clk=%#x\n",
+		    err, n, tx_rem, rx_rem, sy_rd(sy.se, SE_M_CMD0), sy_rd(sy.se, SE_M_IRQ),
+		    sy_rd(sy.se, SE_M_IRQ_EN), sy_rd(sy.se, SE_STATUS),
+		    sy_rd(sy.se, SE_TX_STATUS), sy_rd(sy.se, SE_RX_STATUS),
+		    sy_rd(sy.se, SE_CLK_SEL), sy_rd(sy.se, SE_M_CLK_CFG));
+	}
+	return err;
+}
+
+/*
+ * One full-duplex transfer through wrapper 4's GPI DMA (PAND:623-666), kept as
+ * the A/B path (variant bits 1:0 = 2). Both directions always carry n bytes: the
+ * FocalTech frame is one transaction of n bytes out and n bytes in, so tx is
+ * never NULL here (PAND sends 0xff when it is). CONFIG0 sets 8-bit words (8 - 4),
+ * TX/RX packing, mode 0, the DFS level and the divider; GO is full duplex (3)
+ * with the RX length; then the TX DMA.
+ */
+static int
+sy_spi_gpi(const uint8_t *tx, uint8_t *rx, unsigned n)
+{
+	uint8_t *txb = (uint8_t *)(sy.dma + SY_TXB_OFF), *rxb = (uint8_t *)(sy.dma + SY_RXB_OFF);
+	if (tx) {
+		memcpy(txb, tx, n);
+	} else {
+		memset(txb, 0xff, n);
+	}
+	sy_dma_sync(SY_TXB_OFF, n);
+	sy_dma_sync(SY_RXB_OFF, n);
+	uint32_t hi = (uint32_t)(sy.dma_pa >> 32);
+	sy_tre(1, (uint32_t)sy.dma_pa + SY_RXB_OFF, hi, n, 0x00100200u);
+	sy_tre(0, 0x03000004u, 0, (sy.level << 16) | sy.spi_div, 0x00220001u);
+	sy_tre(0, 3u, 0, n, 0x00200801u);
+	sy_tre(0, (uint32_t)sy.dma_pa + SY_TXB_OFF, hi, n, 0x00100200u);
+	sy_ring_db(1);
+	sy_ring_db(0);
+	int err = sy_gpi_wait(3u);
+	if (err) {
+		static unsigned fails;
+		if (fails++ < 10) {
+			printf("SONGYUAN TOUCH: SPI over GPI failed %d (n %u), ch0 %#x ch1 %#x err log %#x\n",
+			    err, n, sy_rd(sy.gpi, GPI_CH(0)), sy_rd(sy.gpi, GPI_CH(1)),
+			    sy_rd(sy.gpi, GPI_GPII + 0x200));
+		}
+		if (sy_gpi_init()) {
+			sy.dead = true;
+		}
+		return err;
+	}
+	sy_dma_sync(SY_RXB_OFF, n);
+	if (rx) {
+		memcpy(rx, rxb, n);
+	}
+	return 0;
+}
+
+/*
+ * One SPI frame. songyuan_ftsvariant bits 1:0 choose the engine: 0 the SE's own
+ * DMA master (myron's path, the default), 1 FIFO/PIO, 2 wrapper 4's GPI DMA
+ * (pandora's). Bit 4 drives chip select by hand around the frame. Every frame's
+ * TX and RX bytes are logged for the first few transfers and for every failure,
+ * so one boot shows which variant the chip answers.
+ */
+static int
+sy_spi(const uint8_t *tx, uint8_t *rx, unsigned n)
+{
+	int err;
+
+	if (sy.dead || n == 0 || n > SY_XFER_MAX) {
+		return EIO;
+	}
+	if (sy.dbg) {
+		sy_geni_dump("before transfer");
+	}
+	if (sy.manual_cs) {
+		sy_cs(true);
+	}
+	if (sy.path == 1) {
+		err = sy_spi_fifo(tx, rx, n);
+	} else if (sy.path == 2) {
+		err = sy_spi_gpi(tx, rx, n);
+	} else {
+		err = sy_spi_dma(tx, rx, n);
+	}
+	if (sy.manual_cs) {
+		sy_cs(false);
+	}
+	sy.spi_count++;
+	if (sy.dbg) {
+		sy_geni_dump("after transfer");
+	}
+	if (sy.dbg || err || sy.spi_count <= 8) {
+		printf("SONGYUAN TOUCH: SPI[%u] n %u err %d:", sy.spi_count, n, err);
+		sy_hex(" tx", tx, tx ? n : 0);
+		sy_hex(" rx", rx, rx ? n : 0);
+		printf(" m_irq=%#x dma tx=%#x rx=%#x len_in %u/%u\n", sy_rd(sy.se, SE_M_IRQ),
+		    sy_rd(sy.se, SE_DMA_TX_IRQ_STAT), sy_rd(sy.se, SE_DMA_RX_IRQ_STAT),
+		    sy.se_tx_in, sy.se_rx_in);
+	}
+	return err;
+}
+
+/*
+ * Engine self-test, before the chip is touched: with SE_SPI_LOOPBACK set the
+ * serial engine returns its own MOSI on MISO, so a frame whose RX equals TX
+ * proves the packing, clock, TX/RX DMA and the cache maintenance are right. This
+ * is what separates "our SE configuration is wrong" from "the chip does not
+ * answer": it runs on every boot and prints one line.
+ */
+static void
+sy_self_test(void)
+{
+	static const uint8_t tx[6] = {0xa5, 0x5a, 0x11, 0x22, 0x33, 0x44};
+	uint8_t rx[6];
+	bool dma_ok = false, fifo_ok = false;
+	unsigned saved;
+
+	if (sy.path == 2) {
+		printf("SONGYUAN TOUCH: engine self-test skipped on the GPI path\n");
+		return;
+	}
+	/* Same frame through both engine modes, each with the SE's loopback on, so the
+	 * result says which mode carries TX back on RX (and whether the SE DMA path
+	 * itself is the problem). FIFO is programmed here only for the test. */
+	saved = sy.path;
+	sy.path = 0;
+	sy_engine_select(0);
+	memset(rx, 0, sizeof(rx));
+	{
+		static const char *nm = "SE DMA";
+		int err;
+		bool same = true;
+		sy_wr(sy.se, SE_SPI_LOOPBACK, 1);
+		err = sy_spi_dma(tx, rx, sizeof(tx));
+		sy_wr(sy.se, SE_SPI_LOOPBACK, 0);
+		for (unsigned i = 0; i < sizeof(tx); i++) {
+			same = same && tx[i] == rx[i];
+		}
+		printf("SONGYUAN TOUCH: loopback %s err %d %s:", nm, err, same ? "RX==TX" : "RX!=TX");
+		sy_hex(" tx", tx, sizeof(tx));
+		sy_hex(" rx", rx, sizeof(rx));
+		printf("\n");
+		dma_ok = same;
+	}
+	sy.path = 1;
+	sy_engine_select(1);
+	memset(rx, 0, sizeof(rx));
+	{
+		int err;
+		bool same = true;
+		sy_wr(sy.se, SE_SPI_LOOPBACK, 1);
+		err = sy_spi_fifo(tx, rx, sizeof(tx));
+		sy_wr(sy.se, SE_SPI_LOOPBACK, 0);
+		for (unsigned i = 0; i < sizeof(tx); i++) {
+			same = same && tx[i] == rx[i];
+		}
+		printf("SONGYUAN TOUCH: loopback FIFO err %d %s:", err, same ? "RX==TX" : "RX!=TX");
+		sy_hex(" tx", tx, sizeof(tx));
+		sy_hex(" rx", rx, sizeof(rx));
+		printf("\n");
+		fifo_ok = same;
+	}
+	sy.path = saved;
+	sy_engine_select(sy.path);
+	if (!dma_ok && fifo_ok && sy.path == 0) {
+		printf("SONGYUAN TOUCH: SE DMA loopback is broken but FIFO/PIO loopback works; "
+		    "using the FIFO/PIO data path\n");
+		sy.path = 1;
+	}
+	sy_engine_select(sy.path);
+}
+
+/*
+ * The four SPI pads as plain TLMM inputs with each pull setting: a pad that the
+ * chip (or another block) drives reads the same with pull-up and pull-down, one
+ * that is floating follows the pull. This tells whether the chip drives MISO at
+ * all, and which of the four is the chip's output, without a scope.
+ */
+static void
+sy_pad_probe(void)
+{
+	static const unsigned pins[4] = {48, 49, 50, 51};
+	printf("SONGYUAN TOUCH: pads (up/down, swapped meaning 48=MOSI 49=MISO 50=CLK 51=CS):");
+	for (unsigned i = 0; i < 4; i++) {
+		uint32_t up, down;
+		sy_gpio(pins[i], 0, 3, 6, -1, false);	/* input, pull-up */
+		delay(50);
+		up = sy_rd(sy.tlmm, SY_GPIO(pins[i]) + 4) & 1u;
+		sy_gpio(pins[i], 0, 1, 6, -1, false);	/* input, pull-down */
+		delay(50);
+		down = sy_rd(sy.tlmm, SY_GPIO(pins[i]) + 4) & 1u;
+		printf(" %u=%u/%u", pins[i], up, down);
+	}
+	printf("\n");
+	sy_gpio(48, SY_FUNC_QUP4_SE0, 0, 6, -1, false);
+	sy_gpio(49, SY_FUNC_QUP4_SE0, 0, 6, -1, false);
+	sy_gpio(50, SY_FUNC_QUP4_SE0, 0, 4, -1, false);
+	sy_gpio(51, SY_FUNC_QUP4_SE0, 3, 6, -1, false);
+}
+
+
+/*
+ * SPI by hand on the four pads, with the serial engine out of the loop: the two
+ * data lanes are parameters, the clock is GPIO 50 and the chip select GPIO 51,
+ * mode 0, ~200 kHz, bits MSB first (the packing of the engine path is MSB first
+ * too). This is the "does the chip answer at all" test no GENI configuration can
+ * hide, and it runs both lane assignments: round 1 with GPIO 49 as MISO and GPIO
+ * 48 as MOSI, round 2 the other way (the redwood reference tries both directions
+ * as well; our engine log shows the RX bytes correlated with TX, which is what
+ * sampling the MOSI lane looks like).
+ * Each direction does the plain runtime-id read (0xA3) and, only if that does not
+ * answer, three boot-ROM rounds like fts_enter_into_boot @0x13d9c: reset low
+ * 1 ms -> high, 12 + 2*i ms, the bare one-byte command 0x55 ({55 00 00 00}, no
+ * data byte, no CRC), 12 ms, then read two bytes from 0x90, expect 58 83.
+ */
+static void
+sy_bb_byte(unsigned miso, unsigned mosi, const uint8_t out, uint8_t *in)
+{
+	uint8_t v = 0;
+	for (unsigned b = 0; b < 8; b++) {
+		sy_wr(sy.tlmm, SY_GPIO(mosi) + 4, ((out >> (7 - b)) & 1u) ? 2u : 0u);
+		delay(1);
+		sy_wr(sy.tlmm, SY_GPIO(50) + 4, 2);	/* clock high: sample */
+		delay(1);
+		v = (uint8_t)((v << 1) | (sy_rd(sy.tlmm, SY_GPIO(miso) + 4) & 1u));
+		sy_wr(sy.tlmm, SY_GPIO(50) + 4, 0);	/* clock low */
+		delay(1);
+	}
+	*in = v;
+}
+
+static void
+sy_bb_frame(unsigned miso, unsigned mosi, const uint8_t *tx, unsigned n, uint8_t *rx)
+{
+	sy_wr(sy.tlmm, SY_GPIO(51) + 4, 0);	/* chip select low */
+	delay(2);
+	for (unsigned i = 0; i < n; i++) {
+		sy_bb_byte(miso, mosi, tx[i], &rx[i]);
+	}
+	delay(2);
+	sy_wr(sy.tlmm, SY_GPIO(51) + 4, 2);	/* chip select high */
+	delay(150);				/* the 150 us the frame needs */
+}
+
+static void
+sy_bb_configure(unsigned miso, unsigned mosi)
+{
+	sy_gpio(miso, 0, 3, 4, -1, false);	/* MISO: input, pull-up */
+	sy_gpio(mosi, 0, 0, 4, 0, false);	/* MOSI: output low */
+	sy_gpio(50, 0, 0, 4, 0, false);		/* CLK: output low */
+	sy_gpio(51, 0, 3, 4, 1, false);		/* CS: output high */
+	delay(100);
+}
+
+/* One lane assignment. Returns true when the boot id (0x58 0x83) was read. */
+static bool
+sy_bb_direction(const char *tag, unsigned miso, unsigned mosi)
+{
+	static const uint8_t rd_a3[10] = {0xa3, 0xa0, 0x00, 0x01, 0, 0, 0, 0, 0, 0};
+	static const uint8_t cmd55[4] = {0x55, 0x00, 0x00, 0x00};	/* bare command */
+	static const uint8_t rd_rom[11] = {0x90, 0xa0, 0x00, 0x02, 0, 0, 0, 0, 0, 0, 0};
+	uint8_t rx[11], id[2] = {0, 0};
+	bool ok = false;
+
+	sy_bb_configure(miso, mosi);
+	memset(rx, 0, sizeof(rx));
+	sy_bb_frame(miso, mosi, rd_a3, sizeof(rd_a3), rx);
+	printf("SONGYUAN TOUCH: bit-bang[%s] read 0xA3:", tag);
+	sy_hex(" rx", rx, sizeof(rd_a3));
+	printf(" (status %02x, id at byte 7: %02x)\n", rx[3], rx[7]);
+	if (rx[7] == 0x00 || rx[7] == 0xff) {
+		for (unsigned i = 0; i < 3 && !ok; i++) {
+			sy_gpio(SY_RESET, 0, 0, 4, 0, false);	/* reset low 1 ms */
+			delay(1000);
+			sy_gpio(SY_RESET, 0, 0, 4, 1, false);	/* reset high */
+			sy_sleep(12 + i * 2);
+			memset(rx, 0, sizeof(rx));
+			sy_bb_frame(miso, mosi, cmd55, sizeof(cmd55), rx);
+			sy_sleep(12);
+			memset(rx, 0, sizeof(rx));
+			sy_bb_frame(miso, mosi, rd_rom, sizeof(rd_rom), rx);
+			id[0] = rx[7];
+			id[1] = rx[8];
+			printf("SONGYUAN TOUCH: bit-bang[%s] ROM round %u: id %02x %02x "
+			    "(want %02x %02x)\n", tag, i, id[0], id[1], SY_FTS_ID_A3,
+			    SY_FTS_ID_9F);
+			if (id[0] == SY_FTS_ID_A3 && id[1] == SY_FTS_ID_9F) {
+				ok = true;
+			}
+		}
+		printf("SONGYUAN TOUCH: bit-bang[%s] %s (engine out of the loop)\n", tag,
+		    ok ? "boot id matches" : "no boot id");
+	}
+	return ok;
+}
+
+static void
+sy_bitbang_probe(void)
+{
+	printf("SONGYUAN TOUCH: bit-bang SPI probe on GPIO 48-51 (~200 kHz, engine unused), "
+	    "both lane assignments\n");
+	/* First the swapped wiring (49 = MISO, 48 = MOSI), then the original. */
+	(void)sy_bb_direction("swapped", 49, 48);
+	(void)sy_bb_direction("original", 48, 49);
+	/* Back to qup4_se0 function 1 for the serial engine. */
+	sy_gpio(48, SY_FUNC_QUP4_SE0, 0, 6, -1, false);
+	sy_gpio(49, SY_FUNC_QUP4_SE0, 0, 6, -1, false);
+	sy_gpio(50, SY_FUNC_QUP4_SE0, 0, 4, -1, false);
+	sy_gpio(51, SY_FUNC_QUP4_SE0, 3, 6, -1, false);
+}
+
+/*
+ * Is the chip's firmware running? After reset a FocalTech controller streams
+ * frames and pulls its IRQ line low again and again (Android's dmesg shows a
+ * continuous THP stream after reset). Count the edges on GPIO 158 for ~20 ms: no
+ * edge at all means no running firmware, whatever the SPI does.
+ */
+static void
+sy_irq_activity(void)
+{
+	unsigned changes = 0, last;
+
+	last = sy_rd(sy.tlmm, SY_GPIO(SY_IRQ) + 4) & 1u;
+	for (unsigned i = 0; i < 2000; i++) {
+		unsigned now = sy_rd(sy.tlmm, SY_GPIO(SY_IRQ) + 4) & 1u;
+		if (now != last) {
+			changes++;
+			last = now;
+		}
+		delay(10);
+	}
+	printf("SONGYUAN TOUCH: IRQ GPIO %u: %u edge(s) in ~20 ms, level now %u\n",
+	    SY_IRQ, changes, last);
+}
+
+
+/* ---- FocalTech protocol ---------------------------------------------------------- */
+
+/* CRC-16/MCRF4XX (reflected 0x8408, init 0xffff), MYRON:104-109; the stock
+ * driver stores it little endian after the data (MYRONC:314). */
+static uint16_t
+sy_fts_crc(const uint8_t *p, unsigned n)
+{
+	uint16_t c = 0xffff;
+	while (n--) {
+		c ^= *p++;
+		for (unsigned b = 0; b < 8; ++b) {
+			c = (c & 1) ? (uint16_t)((c >> 1) ^ 0x8408) : (uint16_t)(c >> 1);
+		}
+	}
+	return c;
+}
+
+/*
+ * One frame: send it, then wait out the chip-select high gap (MYRONC:298 wants
+ * at least 150 us; delay(1) is a 1 ms tick).
+ */
+static int
+sy_fts_xfer(unsigned len)
+{
+	int err = sy_spi(sy.tx, sy.rx, len);
+	delay(SY_CS_HIGH_US);
+	return err;
+}
+
+/*
+ * Register read (MYRONC:305-319): {addr, read opcode, len hi, len lo, 0, 0, 0}
+ * then n bytes of data from byte 7 and a CRC-16/MCRF4XX over them, little
+ * endian, at bytes 7+n and 8+n. Status byte 3 must have 0xA0 clear. Three
+ * attempts. The read opcode is 0xa0 in myron's FT3683 frame, but the FT3685G may
+ * want another one, so songyuan_ftsvariant selects 0xa0, 0x80, 0xc0 or 0x00.
+ */
+static int
+sy_fts_read(uint8_t addr, uint8_t *out, unsigned n)
+{
+	if (n == 0 || n + SY_FTS_HDR + 2 > sizeof(sy.tx) || n + SY_FTS_HDR + 2 > sizeof(sy.rx)) {
+		return EINVAL;
+	}
+	unsigned len = n + SY_FTS_HDR + 2;
+	int err = EIO;
+	for (unsigned attempt = 0; attempt < SY_FTS_TRIES; attempt++) {
+		memset(sy.tx, 0, len);
+		sy.tx[0] = addr;
+		sy.tx[1] = (uint8_t)sy.read_opcode;
+		sy.tx[2] = (uint8_t)(n >> 8);
+		sy.tx[3] = (uint8_t)n;
+		if ((err = sy_fts_xfer(len))) {
+			continue;
+		}
+		if (sy.rx[3] & SY_FTS_STATUS) {
+			err = EIO;
+			if (sy.logs++ < 8) {
+				printf("SONGYUAN TOUCH: read %#x: status %#x\n", addr, sy.rx[3]);
+			}
+			continue;
+		}
+		uint16_t want = sy_fts_crc(sy.rx + SY_FTS_HDR, n);
+		uint16_t got = (uint16_t)(sy.rx[SY_FTS_HDR + n] |
+		    (sy.rx[SY_FTS_HDR + n + 1] << 8));
+		if (want != got) {
+			err = EIO;
+			if (sy.logs++ < 8) {
+				printf("SONGYUAN TOUCH: read %#x: CRC %#x want %#x\n", addr, got, want);
+			}
+			continue;
+		}
+		memcpy(out, sy.rx + SY_FTS_HDR, n);
+		return 0;
+	}
+	return err;
+}
+
+/*
+ * Register write (MYRONC:321-335; byte-for-byte the working redwood port's
+ * focaltech_write, redwood_focaltech_private.h:78-115): {addr, 0x00, len hi,
+ * len lo, 0, 0, 0} then the bytes; no CRC on writes. A bare command (n == 0) is
+ * the four header bytes only, which is also how the vendor's FTS writes an
+ * address-only command (focaltech_spi.c:213-221: the dummy bytes are added only
+ * when datalen > 0). The status byte is checked the same way.
+ */
+static int
+sy_fts_write(uint8_t addr, const uint8_t *data, unsigned n)
+{
+	unsigned len = n ? SY_FTS_HDR + n : 4;
+	if (n > sizeof(sy.tx) || len > sizeof(sy.tx) || len > sizeof(sy.rx)) {
+		return EINVAL;
+	}
+	int err = EIO;
+	for (unsigned attempt = 0; attempt < SY_FTS_TRIES; attempt++) {
+		memset(sy.tx, 0, len);
+		sy.tx[0] = addr;
+		sy.tx[1] = SY_FTS_WRITE;
+		sy.tx[2] = (uint8_t)(n >> 8);
+		sy.tx[3] = (uint8_t)n;
+		if (n) {
+			memcpy(sy.tx + SY_FTS_HDR, data, n);
+		}
+		if ((err = sy_fts_xfer(len))) {
+			continue;
+		}
+		if (sy.rx[3] & SY_FTS_STATUS) {
+			err = EIO;
+			if (sy.logs++ < 8) {
+				printf("SONGYUAN TOUCH: write %#x: status %#x\n", addr, sy.rx[3]);
+			}
+			continue;
+		}
+		return 0;
+	}
+	return err;
+}
+
+/*
+ * fts_reset_proc(hdelay), as the shipping module has it (fts3685_real.ko,
+ * fts_reset_proc @0xa1c, disassembly lines 0xa54-0xa84):
+ *   gpiod_direction_output_raw(reset, 0)
+ *   msleep(1)
+ *   gpiod_direction_output_raw(reset, 1)
+ *   if (hdelay) msleep(hdelay)
+ * Note the low pulse is 1 ms, not the 10 ms an older reference used.
+ */
+static void
+sy_fts_reset_proc(unsigned hdelay)
+{
+	sy_gpio(SY_RESET, 0, 0, 4, 0, false);	/* reset low */
+	delay(1000);				/* msleep(1) */
+	sy_gpio(SY_RESET, 0, 0, 4, 1, false);	/* reset high */
+	if (hdelay) {
+		sy_sleep(hdelay);
+	}
+}
+
+/* fts_system_reset: reset_proc(200), then the firmware boots. */
+static void
+sy_fts_reset(void)
+{
+	sy_fts_reset_proc(200);
+}
+
+/*
+ * Mux the touch pins: SPI 48-51 as qup4_se0 function 1 with the board data's
+ * drive and pull (MYRON:48-50), IRQ as an input with a pull-up (MYRON:51). Kept
+ * apart from the power sequence so the engine self-test can run with the pads on
+ * the serial engine (a pad-level loopback needs them) before the chip is up.
+ */
+static void
+sy_pins_config(void)
+{
+	sy_gpio(48, SY_FUNC_QUP4_SE0, 0, 6, -1, false);		/* MISO, 6 mA, no pull */
+	sy_gpio(49, SY_FUNC_QUP4_SE0, 0, 6, -1, false);		/* MOSI */
+	sy_gpio(50, SY_FUNC_QUP4_SE0, 0, 4, -1, false);		/* CLK, 4 mA */
+	sy_gpio(51, SY_FUNC_QUP4_SE0, 3, 6, -1, false);		/* CS, 6 mA, pull-up */
+	sy_gpio(SY_IRQ, 0, 3, 2, -1, false);			/* input, pull-up */
+}
+
+/*
+ * Power-on in the order the shipping module uses (fts3685_real.ko,
+ * fts_power_source_ctrl_simplify @0xa068, enable branch at 0xa09c-0xa104):
+ *   regulator_enable(avdd)  ->  gpiod_direction_output_raw(reset, 1)  ->
+ *   regulator_enable(iovdd)
+ * with no sleep between the three. avdd is the GPIO 117 fixed regulator and iovdd
+ * is the RPMh L4I_E0 rail (RPMh vote instead of regulator_enable), so:
+ * avdd high, reset high, iovdd vote, then one settle before the first read. The
+ * reset pulse itself is fts_reset_proc(0) inside the boot-ROM handshake.
+ */
+static void
+sy_power_on(bool vote)
+{
+	sy_pins_config();
+	sy_gpio(SY_AVDD, 0, 0, 4, 1, false);			/* avdd on */
+	printf("SONGYUAN TOUCH: power_on: avdd 117 asked high -> cfg=%#x io=%u\n",
+	    sy_rd(sy.tlmm, SY_GPIO(SY_AVDD)), sy_rd(sy.tlmm, SY_GPIO(SY_AVDD) + 4) & 3u);
+	sy_gpio(SY_RESET, 0, 0, 4, 1, false);			/* reset high */
+	printf("SONGYUAN TOUCH: power_on: reset 66 asked high -> cfg=%#x io=%u, avdd 117 cfg=%#x io=%u\n",
+	    sy_rd(sy.tlmm, SY_GPIO(SY_RESET)), sy_rd(sy.tlmm, SY_GPIO(SY_RESET) + 4) & 3u,
+	    sy_rd(sy.tlmm, SY_GPIO(SY_AVDD)), sy_rd(sy.tlmm, SY_GPIO(SY_AVDD) + 4) & 3u);
+	if (vote) {
+		int err = sy_rpmh_vote();			/* iovdd (L4I_E0) on */
+		printf("SONGYUAN TOUCH: RPMh: iovdd vote -> %d\n", err);
+	}
+	sy_sleep(100);			/* settle before the first read (vendor has none) */
+}
+
+/* Chip id (MYRONC:337-347): myron's FT3683 answered 0x36/0x83; songyuan's IC is
+ * the FT3685G (Android's focaltech_touch_3685g_1.ko) and its own dmesg
+ * fts_check_bootid reports "read boot id:0x58 0x83", which is the expectation
+ * here. The values are always logged with the expected pair, and a mismatch
+ * does not stop the driver. 0xA6 is the firmware version and only gets logged.
+ * Five tries, 200 ms apart. */
+static int
+sy_fts_chip_id(void)
+{
+	uint8_t a3 = 0, id9f = 0, fw = 0;
+	int r3 = EIO, r9f = EIO, rfw = EIO;
+	for (unsigned t = 1; t <= SY_FTS_ID_TRIES; t++) {
+		r3 = sy_fts_read(SY_FTS_ADDR_ID_A3, &a3, 1);
+		r9f = sy_fts_read(SY_FTS_ADDR_ID_9F, &id9f, 1);
+		if (!r3 && !r9f) {
+			break;   /* reads answered; FT3685G ids are logged and compared */
+		}
+		sy_sleep(200);
+	}
+	rfw = sy_fts_read(SY_FTS_ADDR_FW, &fw, 1);
+	printf("SONGYUAN TOUCH: chip id A3 %02x (err %d), 9F %02x (err %d), fw A6 %02x (err %d), "
+	    "want %02x/%02x (FT3685G boot id)\n", a3, r3, id9f, r9f, fw, rfw, SY_FTS_ID_A3,
+	    SY_FTS_ID_9F);
+	if (r3 || r9f) {
+		return ENODEV;
+	}
+	if (a3 != SY_FTS_ID_A3 || id9f != SY_FTS_ID_9F) {
+		printf("SONGYUAN TOUCH: chip ids %02x/%02x differ from the FT3685G boot id "
+		    "%02x/%02x (myron's FT3683 was 36/83); continuing\n", a3, id9f,
+		    SY_FTS_ID_A3, SY_FTS_ID_9F);
+	}
+	return 0;
+}
+
+/* 0x9E = 0 selects TIC mode, where the contacts come from 0x01 (MYRON:26,
+ * MYRONC:349-359): write, 1 ms, read back and compare; three attempts. */
+static int
+sy_fts_tic(void)
+{
+	static const uint8_t tic = SY_FTS_TIC_MODE;
+	uint8_t mode = 0xff;
+	int err = EIO;
+	for (unsigned t = 0; t < SY_FTS_TRIES; t++) {
+		err = sy_fts_write(SY_FTS_ADDR_TIC, &tic, 1);
+		delay(1000);		/* MyronTouch.cpp:354 waits 1 ms after the write; delay() is us */
+		if (!err) {
+			err = sy_fts_read(SY_FTS_ADDR_TIC, &mode, 1);
+		}
+		if (!err && mode == tic) {
+			printf("SONGYUAN TOUCH: TIC mode (0x9e=0) set\n");
+			return 0;
+		}
+	}
+	printf("SONGYUAN TOUCH: TIC mode failed (0x9e reads %02x, err %d)\n", mode, err);
+	return err ? err : EIO;
+}
+
+/* FTS raw units -> panel 1200x2608 -> presented 1125x2436, as data-a-live
+ * pandora_touch.c:1286-1304 does for its 1220x2656 panel; clamped to 1124/2435. */
+static int
+sy_scale(uint64_t v, unsigned per_panel, unsigned axis)
+{
+	uint64_t out = v * axis / per_panel;
+
+	return out >= axis ? (int)(axis - 1) : (int)out;
+}
+
+/*
+ * Points of a 0x01 frame (MYRON:111-116, 120-154): buf[1] low nibble = count,
+ * high nibble = layout. 2 = v2: 8-byte points from buf+4, X/Y in 1/16 pixel,
+ * every id below 10; 0 = v1: 6-byte points from buf+2, whole pixels, walked
+ * until an id of 10 or more, and dropped as a whole when a slot is down while
+ * the count is 0 (an all-zero frame reads exactly like that). For both, the
+ * event is p0 bits 7:6 (0 down, 1 up, 2 contact) and the id p2 bits 7:4.
+ */
+static unsigned
+sy_fts_decode(const uint8_t *f, int *ids, int *xs, int *ys)
+{
+	unsigned type = f[1] >> 4, reported = f[1] & 0xf, count = 0;
+
+	if (reported > SY_FINGERS) {
+		return 0;
+	}
+	if (type == 2) {
+		if (!reported) {
+			return 0;
+		}
+		for (unsigned i = 0; i < reported; i++) {
+			const uint8_t *p = f + 4 + 8 * i;
+			if ((p[2] >> 4) >= SY_FINGERS) {
+				return 0;
+			}
+		}
+		for (unsigned i = 0; i < reported; i++) {
+			const uint8_t *p = f + 4 + 8 * i;
+			unsigned event = p[0] >> 6;
+			if (event != 0 && event != 2) {
+				continue;
+			}
+			uint64_t x = ((uint64_t)(p[0] & 0xfu) << 12) |
+			    ((uint64_t)p[1] << 4) | (p[4] >> 4);
+			uint64_t y = ((uint64_t)(p[2] & 0xfu) << 12) |
+			    ((uint64_t)p[3] << 4) | (p[4] & 0xfu);
+			ids[count] = (int)(p[2] >> 4);
+			xs[count] = sy_scale(x, SY_PANEL_W * 16u, SY_LOGICAL_W);
+			ys[count] = sy_scale(y, SY_PANEL_H * 16u, SY_LOGICAL_H);
+			count++;
+		}
+	} else if (type == 0) {
+		for (unsigned i = 0; i < SY_FINGERS; i++) {
+			const uint8_t *p = f + 2 + 6 * i;
+			unsigned id = p[2] >> 4, event = p[0] >> 6;
+			if (id >= SY_FINGERS) {
+				break;
+			}
+			if (event != 0 && event != 2) {
+				continue;
+			}
+			if (!reported) {
+				return 0;
+			}
+			uint64_t x = ((uint64_t)(p[0] & 0xfu) << 8) | p[1];
+			uint64_t y = ((uint64_t)(p[2] & 0xfu) << 8) | p[3];
+			ids[count] = (int)id;
+			xs[count] = sy_scale(x, SY_PANEL_W, SY_LOGICAL_W);
+			ys[count] = sy_scale(y, SY_PANEL_H, SY_LOGICAL_H);
+			count++;
+		}
+	}
+	return count;
+}
+
+/* An all-ones header: the firmware restarted and is back in its default THP
+ * mode (MYRON:155-156). */
+static bool
+sy_frame_restarted(const uint8_t *f)
+{
+	return f[0] == 0xff && f[1] == 0xff;
+}
+
+/*
+ * Deliver to SweetHIDTouch: the contact id is the finger (0..9, as the tree's
+ * SWEET_TOUCH_FINGERS, 0058:20946), a release for every finger that was down
+ * and is not in this frame (FUXI:436-452, PAND:1289-1318). Coordinates are the
+ * presented display pixels 0..1124 x 0..2435 (pandora_touch.c:1286-1304).
+ * TODO(REPORT.md U1): the consumer in this tree must accept that axis space.
+ * SweetHIDTouch::touch() clamps to fPanelW/fPanelH (0058:21041, 0130:1420-1423),
+ * which PANDORA sets to the presented display; if songyuan's does the same,
+ * every point above 1079/2399 is clamped into the top-left corner.
+ */
+static void
+sy_report(unsigned count, const int *ids, const int *xs, const int *ys)
+{
+	uint32_t mask = 0;
+	for (unsigned i = 0; i < count; i++) {
+		if (ids[i] >= 0 && ids[i] < (int)SY_FINGERS) {
+			mask |= 1u << ids[i];
+		}
+	}
+	for (unsigned id = 0; id < SY_FINGERS; id++) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			for (unsigned i = 0; i < count; i++) {
+				if (ids[i] == (int)id) {
+					sy.x[id] = xs[i];
+					sy.y[id] = ys[i];
+					break;
+				}
+			}
+			sweet_hid_touch((int)id, 1, sy.x[id], sy.y[id]);
+		} else if (sy.active & bit) {
+			sweet_hid_touch((int)id, 0, sy.x[id], sy.y[id]);
+		}
+	}
+	sy.active = mask;
+}
+
+/* One 0x01 frame: read it (CRC inside sy_fts_read), catch a firmware restart,
+ * decode, deliver. */
+static int
+sy_fts_frame(void)
+{
+	int ids[SY_FINGERS], xs[SY_FINGERS], ys[SY_FINGERS];
+	int err = sy_fts_read(SY_FTS_ADDR_FRAME, sy.frame, SY_FTS_FRAME);
+	if (err) {
+		return err;
+	}
+	sy.frames++;
+	if (sy_frame_restarted(sy.frame)) {
+		/* The firmware restarted and streams THP frames again: take it
+		 * back to TIC (MYRONC:490-498). */
+		sy.restarts++;
+		printf("SONGYUAN TOUCH: firmware restart (all-ones header), TIC mode again -> %d\n",
+		    sy_fts_tic());
+		if (sy.active) {
+			sy_report(0, NULL, NULL, NULL);
+		}
+		return 0;
+	}
+	unsigned type = sy.frame[1] >> 4;
+	if (type == 0) {
+		sy.type_v1++;
+	} else if (type == 2) {
+		sy.type_v2++;
+	}
+	if (sy.logged_frames < 4) {
+		sy.logged_frames++;
+		printf("SONGYUAN TOUCH: frame %u (%u):", sy.frames, SY_FTS_FRAME);
+		for (unsigned i = 0; i < SY_FTS_FRAME; i++) {
+			printf(" %02x", sy.frame[i]);
+			if ((i % 21) == 20) {
+				printf("\n");
+			}
+		}
+		printf("\n");
+	}
+	unsigned count = sy_fts_decode(sy.frame, ids, xs, ys);
+	if (count) {
+		sy.touch_frames++;
+		if (sy.touch_frames <= 10) {
+			printf("SONGYUAN TOUCH: %u contact(s), id %d at %d,%d of %u x %u\n",
+			    count, ids[0], xs[0], ys[0], SY_LOGICAL_W - 1, SY_LOGICAL_H - 1);
+		}
+	}
+	if ((sy.frames % 500u) == 0) {
+		printf("SONGYUAN TOUCH: %u frames (%u with contacts: v1 %u, v2 %u), %u restarts, "
+		    "%u errors\n", sy.frames, sy.touch_frames, sy.type_v1, sy.type_v2,
+		    sy.restarts, sy.errors);
+	}
+	if (count || sy.last_count) {
+		sy_report(count, ids, xs, ys);
+	}
+	sy.last_count = count;
+	return 0;
+}
+
+/*
+ * fts_enter_into_boot, exactly as the shipping module has it (fts3685_real.ko,
+ * fts_enter_into_boot @0x13d9c, disassembly lines 0x13dfc-0x13ea0):
+ *
+ *   w23 = 0x55                                     ; one-byte write buffer
+ *   for (i = 0; i < 30; i++) {                     ; cmp w19,#0x1e
+ *       fts_reset_proc(0)                          ; low 1 ms -> high, no wait
+ *       msleep(12 + i * 2)                         ; x22 += 2 each round
+ *       for (k = 0; k < 3; k++) {                  ; three tries per round
+ *           fts_write(&0x55, 1)                    ; {55 00 00 00}: datalen 0
+ *           msleep(12)
+ *           if (fts_check_bootid() == 0) -> done   ; fts_check_bootid @0x139bc:
+ *                                                  ; read 0x90, 2 bytes, must be
+ *                                                  ; {0x58, 0x83}
+ *       }
+ *   }
+ *
+ * Note what this is NOT: the generic FocalTech sources send {0x55, 0xAA} as a
+ * write of data byte 0xAA to register 0x55; this Xiaomi module writes the bare
+ * one-byte command 0x55 (a 4-byte frame with no data byte and no CRC), and it
+ * never sends 0xAA.
+ * Returns true when fts_check_bootid's condition held.
+ */
+static bool
+sy_fts_enter_boot(uint8_t *hi, uint8_t *lo)
+{
+	uint8_t id[2] = {0, 0};
+	bool ok = false;
+	int w = 0, r = 0;
+
+	*hi = 0;
+	*lo = 0;
+	for (unsigned i = 0; i < 30 && !ok; i++) {
+		sy_fts_reset_proc(0);
+		sy_sleep(12 + i * 2);
+		for (unsigned k = 0; k < 3; k++) {
+			w = sy_fts_write(0x55, NULL, 0);	/* bare command 0x55 */
+			if (w) {
+				continue;
+			}
+			delay(12000);				/* msleep(12) */
+			r = sy_fts_read(0x90, id, 2);
+			if (!r && id[0] == SY_FTS_ID_A3 && id[1] == SY_FTS_ID_9F) {
+				ok = true;
+				break;
+			}
+		}
+		/* Every round is logged, and a failed transfer never ends the loop: the
+		 * vendor code runs all 30 rounds x 3 tries. */
+		printf("SONGYUAN TOUCH: boot-RAM round %u: id %02x %02x (want %02x %02x, "
+		    "write %d read %d)\n", i, id[0], id[1], SY_FTS_ID_A3, SY_FTS_ID_9F, w, r);
+	}
+	*hi = id[0];
+	*lo = id[1];
+	if (ok) {
+		printf("SONGYUAN TOUCH: boot id %02x %02x (boot id check pass)\n", id[0], id[1]);
+	} else {
+		printf("SONGYUAN TOUCH: no valid boot id after 30 rounds, last %02x %02x "
+		    "(want %02x %02x)\n", id[0], id[1], SY_FTS_ID_A3, SY_FTS_ID_9F);
+	}
+	return ok;
+}
+
+/*
+ * Firmware download, following the shipping module's own code:
+ *
+ * fts_dpram_write (@0x148e8), disassembly 0x14a34-0x14b18:
+ *   base address = 0 when the caller passes flag bit 0 set (0xd00000 for the
+ *   dpram stage); block size 0x7ff0 = 32752 bytes, block count = ceil(len/32768)
+ *   (so 153276 bytes = 5 blocks: 4 x 32752 + 22268, exactly the Android dmesg's
+ *   "num:5 remainder:22268"); per block
+ *       write {0xAD, a2, a1, a0}      ; register 0xAD, 3-byte big-endian address
+ *       write {0xAE, data...}         ; register 0xAE, the block's bytes
+ *   The vendor then calls fts_ecc_check (@0x14c1c) on each block.
+ *
+ * fts_ecc_check (@0x14c1c), disassembly 0x14cd0-0x14f28:
+ *   CRC-16/Kermit (0x8408, init 0xffff) over the block; write the 7-byte frame
+ *   {0xCC, off24, len24} (both 24-bit big-endian: block offset and block
+ *   length), msleep(2), then read 2 bytes from 0xCD and compare them big-endian
+ *   with the CRC, and read 2 bytes from 0xCE (a chip status/version byte).
+ *
+ * Then the boot ROM is told to start the image with the bare 0x08 command
+ * (FTS_ROMBOOT_CMD_START_APP, visible in fts_fw_download @0x12800).
+ *
+ * Our transfer path is limited to SY_XFER_MAX (4096) bytes per frame, so the
+ * 0xAE data frames are sent in 4000-byte pieces, each preceded by its own 0xAD
+ * address: the same set-address/write-data interface, just more frames.
+ */
+#define SY_FW_CHUNK	4000u
+static uint8_t sy_fw_tx[SY_FW_CHUNK + 8], sy_fw_rx[SY_FW_CHUNK + 8];
+
+/* One long data frame: {addr, 0x00, len hi, len lo, 0,0,0, data...}. */
+static int
+sy_fts_bulk_write(uint8_t addr, const uint8_t *data, unsigned n)
+{
+	unsigned len = 7 + n;
+	int err = EIO;
+
+	if (n == 0 || len > sizeof(sy_fw_tx) || len > SY_XFER_MAX) {
+		return EINVAL;
+	}
+	for (unsigned attempt = 0; attempt < SY_FTS_TRIES; attempt++) {
+		memset(sy_fw_tx, 0, len);
+		sy_fw_tx[0] = addr;
+		sy_fw_tx[1] = SY_FTS_WRITE;
+		sy_fw_tx[2] = (uint8_t)(n >> 8);
+		sy_fw_tx[3] = (uint8_t)n;
+		memcpy(sy_fw_tx + 7, data, n);
+		if ((err = sy_spi(sy_fw_tx, sy_fw_rx, len))) {
+			continue;
+		}
+		if (sy_fw_rx[3] & SY_FTS_STATUS) {
+			err = EIO;
+			continue;
+		}
+		return 0;
+	}
+	return err;
+}
+
+/* The whole image: 0xAD address + 0xAE data in SY_FW_CHUNK pieces. */
+static int
+sy_fts_pram_write(void)
+{
+	unsigned total = sizeof(sy_fts_fw), chunks = 0, off = 0;
+	int err;
+
+	printf("SONGYUAN TOUCH: PRAM download: %u bytes in %u-byte frames\n", total,
+	    SY_FW_CHUNK);
+	for (; off < total; off += SY_FW_CHUNK) {
+		unsigned n = total - off < SY_FW_CHUNK ? total - off : SY_FW_CHUNK;
+		uint8_t a[3] = {(uint8_t)(off >> 16), (uint8_t)(off >> 8), (uint8_t)off};
+		if ((err = sy_fts_bulk_write(0xad, a, 3))) {
+			printf("SONGYUAN TOUCH: PRAM address %#x failed %d\n", off, err);
+			return err;
+		}
+		if ((err = sy_fts_bulk_write(0xae, sy_fts_fw + off, n))) {
+			printf("SONGYUAN TOUCH: PRAM data at %#x (%u bytes) failed %d\n",
+			    off, n, err);
+			return err;
+		}
+		chunks++;
+	}
+	printf("SONGYUAN TOUCH: PRAM download done: %u bytes, %u frames\n", total, chunks);
+	return 0;
+}
+
+/* CRC + the 0xCC/0xCD/0xCE exchange of fts_ecc_check. Diagnostic, not fatal. */
+static void
+sy_fts_ecc_check(void)
+{
+	unsigned total = sizeof(sy_fts_fw);
+	uint8_t cmd[6], crc_in[2] = {0, 0}, st[2] = {0, 0};
+	uint16_t crc = sy_fts_crc(sy_fts_fw, total);
+	unsigned chip_crc;
+	int w, r1, r2;
+
+	/* off24 = 0, len24 = total (single ECC block: total < 0x40000). */
+	cmd[0] = (uint8_t)(0 >> 16);
+	cmd[1] = (uint8_t)(0 >> 8);
+	cmd[2] = 0;
+	cmd[3] = (uint8_t)(total >> 16);
+	cmd[4] = (uint8_t)(total >> 8);
+	cmd[5] = (uint8_t)total;
+	w = sy_fts_bulk_write(0xcc, cmd, sizeof(cmd));
+	delay(2000);			/* fts_msleep(2) in fts_ecc_check */
+	r1 = sy_fts_read(0xcd, crc_in, 2);
+	chip_crc = (unsigned)((crc_in[0] << 8) | crc_in[1]);
+	r2 = sy_fts_read(0xce, st, 2);
+	printf("SONGYUAN TOUCH: ECC check: write %d, CRC ours %#x chip %#x (read %d), "
+	    "status %02x %02x (read %d)\n", w, crc, chip_crc, r1, st[0], st[1], r2);
+}
+
+/* Boot-ROM handshake, PRAM download, ECC and the 0x08 start. */
+static int
+sy_fts_fw_load(bool download)
+{
+	int err;
+
+	if (download && (err = sy_fts_pram_write())) {
+		printf("SONGYUAN TOUCH: firmware download failed %d\n", err);
+		return err;
+	}
+	if (download) {
+		sy_fts_ecc_check();
+	}
+	err = sy_fts_write(0x08, NULL, 0);	/* FTS_ROMBOOT_CMD_START_APP */
+	printf("SONGYUAN TOUCH: start app (0x08) -> %d\n", err);
+	if (err) {
+		return err;
+	}
+	sy_sleep(200);				/* the application firmware boots */
+	return 0;
+}
+
+/*
+ * The chip did not answer the normal chip-id read. Instead of one reboot per
+ * variant, try the plausible SPI configurations in one boot and print the table:
+ * engine (SE DMA / FIFO) x chip select (automatic / engine CS commands) x SPI mode
+ * 0..3. On the first set whose 0xA3 and 0x9F reads both complete with a plausible
+ * non-0x00/0xFF pair the driver keeps that set and carries on, so this boot can
+ * still bring the panel up.
+ */
+static void
+sy_probe_matrix(void)
+{
+	static const char *eng[2] = {"SE DMA", "FIFO"};
+	uint8_t id[2];
+	unsigned saved_path = sy.path, saved_mode = sy.spi_mode;
+	bool saved_cs = sy.cs_cmds, found = false;
+
+	for (unsigned e = 0; e < 2 && !found; e++) {
+		for (unsigned c = 0; c < 2 && !found; c++) {
+			for (unsigned m = 0; m < 4 && !found; m++) {
+				int ra, rb;
+				sy.path = e;
+				sy.cs_cmds = c != 0;
+				sy.spi_mode = m;
+				sy_wr(sy.se, SE_SPI_CPHA, (m & 1u) ? SE_SPI_CPHA_BIT : 0u);
+				sy_wr(sy.se, SE_SPI_CPOL, (m & 2u) ? SE_SPI_CPOL_BIT : 0u);
+				sy_engine_select(e);
+				id[0] = id[1] = 0;
+				ra = sy_fts_read(SY_FTS_ADDR_ID_A3, &id[0], 1);
+				rb = sy_fts_read(SY_FTS_ADDR_ID_9F, &id[1], 1);
+				printf("SONGYUAN TOUCH: probe %s cs=%s mode %u: 0xA3 err %d id %02x, "
+				    "0x9F err %d id %02x\n", eng[e], c ? "cmd" : "auto", m, ra,
+				    id[0], rb, id[1]);
+				if ((sy_rd(sy.se, SE_STATUS) & 1u) || (sy_rd(sy.se, SE_M_IRQ) & SE_M_ERRORS)) {
+					sy_geni_recover();
+					sy_wr(sy.se, SE_DMA_TX_FSM_RST, 1);
+					sy_wr(sy.se, SE_DMA_RX_FSM_RST, 1);
+				}
+				if (!ra && !rb && id[0] != 0x00 && id[0] != 0xff &&
+				    id[1] != 0x00 && id[1] != 0xff) {
+					found = true;
+					printf("SONGYUAN TOUCH: probe found a working set: %s, "
+					    "cs=%s, mode %u, id %02x %02x\n", eng[e],
+					    c ? "cmd" : "auto", m, id[0], id[1]);
+				}
+			}
+		}
+	}
+	if (!found) {
+		sy.path = saved_path;
+		sy.spi_mode = saved_mode;
+		sy.cs_cmds = saved_cs;
+		sy_wr(sy.se, SE_SPI_CPHA, (saved_mode & 1u) ? SE_SPI_CPHA_BIT : 0u);
+		sy_wr(sy.se, SE_SPI_CPOL, (saved_mode & 2u) ? SE_SPI_CPOL_BIT : 0u);
+		sy_engine_select(sy.path);
+		printf("SONGYUAN TOUCH: probe matrix found no answer "
+		    "(check IRQ level, power, reset, Android dmesg)\n");
+	}
+}
+
+/*
+ * Identify and TIC after power-on, in the order the shipping module uses:
+ * fts_get_ic_information first reads the runtime id 0xA3/0x9F five times 200 ms
+ * apart; when that fails the chip is in its boot ROM, fts_enter_into_boot runs
+ * the 30-round handshake (below), and once the boot id checks out the host writes
+ * the bare 0x08 command (FTS_ROMBOOT_CMD_START_APP) so the boot ROM jumps to the
+ * application firmware; after that the runtime id must answer, otherwise the
+ * flash image is not usable and a PRAM download would be needed.
+ * Android's log on this phone shows exactly that path: "fts_enter_into_boot:
+ * enter into boot environment", "fts_check_bootid: read boot id:0x58 0x83",
+ * "boot id check pass".
+ */
+static int
+sy_fts_setup(void)
+{
+	uint8_t hi = 0, lo = 0;
+	int err;
+
+	if (!(err = sy_fts_chip_id())) {
+		return sy_fts_tic();	/* firmware already running (warm boot) */
+	}
+	if (sy_fts_enter_boot(&hi, &lo)) {
+		/* The boot ROM is listening; download the application firmware into
+		 * PRAM (unless songyuan_ftsfw=0), verify its CRC, then start it. */
+		err = sy_fts_fw_load(sy.fw_load);
+		if (!err) {
+			for (unsigned t = 0; t < 3; t++) {
+				if (!(err = sy_fts_chip_id())) {
+					printf("SONGYUAN TOUCH: firmware started (attempt %u)\n",
+					    t + 1);
+					return sy_fts_tic();
+				}
+				sy_sleep(100);
+			}
+			printf("SONGYUAN TOUCH: runtime id still invalid after the download; "
+			    "check the ECC/start log above\n");
+		}
+	} else {
+		printf("SONGYUAN TOUCH: chip did not enter its boot ROM\n");
+	}
+	sy_probe_matrix();	/* one boot, every plausible SPI configuration */
+	if ((err = sy_fts_chip_id())) {
+		return err;
+	}
+	return sy_fts_tic();
+}
+
+/* fts_system_reset, then identify and TIC: what runs again when the bus lost
+ * step (PAND:1640-1647 resets the IC after 20 bad frames). */
+static int
+sy_fts_start(void)
+{
+	sy_fts_reset();
+	return sy_fts_setup();
+}
+
+/* ---- thread -------------------------------------------------------------------- */
+
+static void
+sy_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 5;
+	unsigned hz = SY_SPI_HZ;
+	unsigned rpmh = 1;
+	unsigned dma = 1;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("songyuan_ftsdelay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("songyuan_ftsrpmh", &rpmh, sizeof(rpmh));
+	(void)PE_parse_boot_argn("songyuan_ftsdma", &dma, sizeof(dma));
+	(void)PE_parse_boot_argn("songyuan_ftsdbg", &sy.dbg, sizeof(sy.dbg));
+	(void)PE_parse_boot_argn("songyuan_ftsvariant", &sy.variant, sizeof(sy.variant));
+	{
+		unsigned fw = 1;
+		(void)PE_parse_boot_argn("songyuan_ftsfw", &fw, sizeof(fw));
+		sy.fw_load = fw != 0;
+	}
+	/*
+	 * One build, several hypotheses (see the header): the transfer engine, the
+	 * read opcode, the chip-select owner, CPHA/CPOL, "TX then RX" and a loopback
+	 * self-test. The FTS frame itself (7-byte header, data, CRC-16) does not
+	 * change; only sy_fts_read's opcode does.
+	 */
+	sy.path = sy.variant & 3u;
+	if (!dma && sy.path == 0) {
+		sy.path = 2;		/* legacy switch: songyuan_ftsdma=0 = GPI DMA */
+	}
+	sy.use_se_dma = sy.path == 0;
+	sy.read_opcode = (sy.variant >> 2) & 3u;
+	sy.read_opcode = sy.read_opcode == 0 ? 0xa0u : sy.read_opcode == 1 ? 0x80u :
+	    sy.read_opcode == 2 ? 0xc0u : 0x00u;
+	sy.manual_cs = (sy.variant & (1u << 4)) != 0;
+	sy.spi_mode = (sy.variant >> 5) & 3u;
+	sy.tx_then_rx = (sy.variant & (1u << 7)) != 0;
+	sy.loopback = (sy.variant & (1u << 8)) != 0;
+	sy.cs_cmds = (sy.variant & (1u << 9)) != 0;
+	if (sy.path == 2 && (sy.spi_mode || sy.loopback || sy.tx_then_rx)) {
+		printf("SONGYUAN TOUCH: mode/loopback/tx-then-rx are the myron paths' knobs; "
+		    "ignored on the GPI path\n");
+	}
+	if (PE_parse_boot_argn("songyuan_ftshz", &hz, sizeof(hz)) &&
+	    (hz < SY_SPI_HZ_MIN || hz > SY_SPI_HZ_MAX)) {
+		printf("SONGYUAN TOUCH: songyuan_ftshz=%u outside %u..%u, keeping %u\n", hz,
+		    SY_SPI_HZ_MIN, SY_SPI_HZ_MAX, SY_SPI_HZ);
+		hz = SY_SPI_HZ;
+	}
+	sy_set_hz(hz);
+	printf("SONGYUAN TOUCH: starting in %u s, SPI %u Hz (div %u, %u Hz), iovdd vote %s, "
+	    "path %s, variant %#x (opcode %#x, manual CS %d, mode %u, tx-then-rx %d, loopback %d), "
+	    "debug %u\n", delay_s, sy.hz, sy.spi_div, sy.actual_hz,
+	    rpmh ? "on" : "off (songyuan_ftsrpmh=0)",
+	    sy.path == 0 ? "SE DMA (myron)" : sy.path == 1 ? "FIFO/PIO" : "GPI DMA (pandora)",
+	    sy.variant, sy.read_opcode, sy.manual_cs, sy.spi_mode, sy.tx_then_rx, sy.loopback,
+	    sy.dbg);
+	sy_sleep(delay_s * 1000u);
+	sy.gcc = ml_io_map(SY_GCC_PA, 0x1f0000);
+	sy.tlmm = ml_io_map(SY_TLMM_PA, 0xa0000);
+	sy.se = ml_io_map(SY_SE_PA, SY_SE_SIZE);
+	if (!sy.gcc || !sy.tlmm || !sy.se) {
+		printf("SONGYUAN TOUCH: no GCC/TLMM/SE mapping\n");
+		goto out;
+	}
+	sy_clock_dump("before");
+	int err;
+	if ((err = sy_clocks())) {
+		printf("SONGYUAN TOUCH: clocks failed %d\n", err);
+		goto out;
+	}
+	sy_clock_dump("after");
+	if ((err = sy_se_init())) {
+		printf("SONGYUAN TOUCH: engine set-up failed %d\n", err);
+		goto out;
+	}
+	sy_pins_dump("stock (boot chain, before any write)");	/* shows the EGPIO bits */
+	sy_pins_config();	/* pads on the serial engine before the loopback test */
+	sy_pins_dump("before");
+	sy_power_on(rpmh != 0);
+	printf("SONGYUAN TOUCH: after power_on (avdd 117 high, reset 66 high): reset cfg=%#x io=%u, "
+	    "avdd cfg=%#x io=%u, irq 158 cfg=%#x io=%u\n",
+	    sy_rd(sy.tlmm, SY_GPIO(SY_RESET)), sy_rd(sy.tlmm, SY_GPIO(SY_RESET) + 4) & 3u,
+	    sy_rd(sy.tlmm, SY_GPIO(SY_AVDD)), sy_rd(sy.tlmm, SY_GPIO(SY_AVDD) + 4) & 3u,
+	    sy_rd(sy.tlmm, SY_GPIO(SY_IRQ)), sy_rd(sy.tlmm, SY_GPIO(SY_IRQ) + 4) & 3u);
+	sy_pins_dump("after power_on");
+	sy_pad_probe();		/* are the pads driven, and by whom, with the chip powered */
+	sy_irq_activity();	/* does the chip's firmware pull IRQ at all */
+	sy_bitbang_probe();	/* the same frames by hand, engine unused */
+	sy_self_test();		/* engine loopback, after the chip-level probes */
+	if ((err = sy_fts_setup())) {
+		printf("SONGYUAN TOUCH: FTS start failed %d\n", err);
+		sy_pins_dump("after failed start");
+		goto out;
+	}
+	sy_pins_dump("after reset");
+	printf("SONGYUAN TOUCH: running, polling GPIO %u\n", SY_IRQ);
+	uint64_t active_abs, idle_abs, next = mach_absolute_time();
+	nanoseconds_to_absolutetime(4 * NSEC_PER_MSEC, &active_abs);
+	nanoseconds_to_absolutetime(8 * NSEC_PER_MSEC, &idle_abs);
+	unsigned idle = 0;
+	for (;;) {
+		/* Low while the chip holds a frame and until it is read (MYRON:46). */
+		bool ready = !(sy_rd(sy.tlmm, SY_GPIO(SY_IRQ) + 4) & 1u);
+		unsigned got = 0;
+		while (ready && got < 4) {
+			if (sy_fts_frame()) {
+				if ((++sy.errors % 100u) == 1) {
+					printf("SONGYUAN TOUCH: frame error (%u total)\n", sy.errors);
+				}
+				if (sy.active) {
+					sy_report(0, NULL, NULL, NULL);
+				}
+				/* Out of step with the chip: reset it after 20 bad frames
+				 * (PAND:1640-1647). */
+				if (++sy.bad >= 20) {
+					sy.bad = 0;
+					printf("SONGYUAN TOUCH: IC reset after errors -> %d\n",
+					    sy_fts_start());
+				}
+				break;
+			}
+			sy.bad = 0;
+			got++;
+			ready = !(sy_rd(sy.tlmm, SY_GPIO(SY_IRQ) + 4) & 1u);
+		}
+		if (!got) {
+			/* ~100 ms idle: one frame anyway, to catch a firmware restart
+			 * (MYRONC:482-483). */
+			if (++idle >= SY_IDLE_POLLS) {
+				idle = 0;
+				if (sy_fts_frame()) {
+					sy.errors++;
+				}
+			}
+		} else {
+			idle = 0;
+		}
+		if (sy.dead) {
+			break;
+		}
+		uint64_t period = (sy.active || got) ? active_abs : idle_abs;
+		next += period;
+		uint64_t now = mach_absolute_time();
+		if (next <= now) {
+			next = now + period;
+		}
+		sy_sleep_until(next);
+	}
+out:
+	printf("SONGYUAN TOUCH: stopped\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+songyuan_touch_init(void)
+{
+	thread_t thread;
+	int enabled = 0;
+	if (sy.started) {
+		return;
+	}
+	sy.started = true;
+	(void)PE_parse_boot_argn("songyuan_fts", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SONGYUAN TOUCH: off (songyuan_fts=1 to enable)\n");
+		return;
+	}
+	if (kernel_thread_start_priority(sy_thread, NULL, SY_PRIORITY, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SONGYUAN TOUCH: no thread\n");
+	}
+}
+#endif /* SONGYUAN || PANDORA */
