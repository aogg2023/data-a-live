+#define SE_DMA_RX_LEN	0xd3cu
+#define SE_DMA_RX_IRQ_STAT 0xd40u
+#define SE_DMA_RX_IRQ_EN_SET 0xd4cu
+#define SE_DMA_RX_LEN_IN 0xd54u
+#define SE_DMA_RX_FSM_RST 0xd58u
+#define SE_SER_CLK_EN	(1u << 0)
+#define SE_CLK_DIV_SHIFT 4
+#define SE_CLK_DIV_MAX	0xfffu
