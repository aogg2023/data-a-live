+/* 0338: apply the mode a files.txt line gives to a file that already exists. vnode_open with
+ * O_CREAT only uses the mode when it creates the file, so a file written by an earlier boot keeps
+ * its old mode; the mobile user's preference domains have to be readable by the daemons (0644),
+ * otherwise Setup/SpringBoard never see the tweaks (root-owned 0600 is unreadable to mobile). */
+static int
+pf_setmode(const char *path, int mode, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int error = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & 07777);
+	error = vnode_setattr(vp, &va, ctx);
+	(void)vnode_close(vp, FREAD, ctx);
+	return error;
+}
