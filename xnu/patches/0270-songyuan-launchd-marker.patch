--- a/bsd/dev/pandora_files.c
+++ b/bsd/dev/pandora_files.c
@@ -349,7 +349,16 @@
 	memcpy(buf + at, entry, sizeof(entry) - 1);
 	int newlen = size + (int)sizeof(entry) - 1;
 	error = pf_write_mem(path, buf, newlen, 0644, ctx);
-	printf("PANDORA FILES: migfix %s: %d bytes -> %d, write %d\n", path, size, newlen, error);
+	/* 0269 v2: launchd's modern override loader only trusts the disabled list when the empty
+	 * "disabled.migrated" marker exists (the myron/sheng ports seed exactly this pair; without the
+	 * marker launchd ignores the list and still starts the disabled jobs). */
+	static const char *const marker = "/private/var/db/com.apple.xpc.launchd/disabled.migrated";
+	vnode_t mp = NULLVP;
+	int merror = vnode_open(marker, FWRITE | O_CREAT, 0644, 0, &mp, ctx);
+	if (!merror) {
+		vnode_close(mp, FWRITE, ctx);
+	}
+	printf("PANDORA FILES: migfix %s: %d bytes -> %d, write %d, marker %d\n", path, size, newlen, error, merror);
 	kfree_data(buf, (vm_size_t)size + sizeof(entry));
 }
 
