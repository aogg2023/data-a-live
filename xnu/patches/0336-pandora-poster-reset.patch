+/* 0336: PosterBoard inherits a data store from the migrated donor data volume
+ * (/private/var/mobile/Library/Application Support/PRBPosterExtensionDataStore: an empty
+ * 59/{Extensions,GalleryCache} tree plus its preferences). On such a partial store PosterBoard's
+ * first-time switcher setup hits NSAssert(!_stateLock_switcherConfiguration) and traps. With
+ * pandora_poster_reset=1 remove the inherited store (its empty directories, then its preferences)
+ * so PosterBoard starts from a clean state. Does nothing by default. */
+static void
+pf_reset_poster(vfs_context_t ctx)
+{
+	int on = 0;
+	static const char *const dirs[] = {
+		"/private/var/mobile/Library/Application Support/PRBPosterExtensionDataStore/59/Extensions",
+		"/private/var/mobile/Library/Application Support/PRBPosterExtensionDataStore/59/GalleryCache",
+		"/private/var/mobile/Library/Application Support/PRBPosterExtensionDataStore/59",
+		"/private/var/mobile/Library/Application Support/PRBPosterExtensionDataStore",
+	};
+	static const char *const files[] = {
+		"/private/var/mobile/Library/Preferences/com.apple.PosterBoard.plist",
+		"/private/var/mobile/Library/Preferences/com.apple.PosterBoard.unprotectedUserDefaults.plist",
+	};
+	(void)ctx;
+	(void)PE_parse_boot_argn("pandora_poster_reset", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(dirs) / sizeof(dirs[0]); i++) {
+		int error = pandora_rmdir(dirs[i]);
+		printf("PANDORA POSTER RESET: rmdir %s: %d\n", dirs[i], error);
+	}
+	for (unsigned i = 0; i < sizeof(files) / sizeof(files[0]); i++) {
+		int error = pandora_unlink(files[i]);
+		printf("PANDORA POSTER RESET: unlink %s: %d\n", files[i], error);
+	}
+}
+
