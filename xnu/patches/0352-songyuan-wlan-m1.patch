--- /dev/null
+++ b/bsd/dev/songyuan_wlan.c
@@ -0,0 +1,688 @@
+/*
+ * SONGYUAN WLAN, M1: bring up PCIe root complex 0 and read the WCN786x
+ * (17cb:110e) that sits behind it.
+ *
+ * Boot-arg songyuan_wlan=N, 0 (default) does nothing:
+ *   1  map the register windows and dump the state the boot chain left
+ *   2  vote the card's supplies through RPMh, drive PERST/WLAN_EN low
+ *   3  power domains, reference and branch clocks
+ *   4  the PHY sequence from the phone's own device tree
+ *   5  root port header, PERST release, LTSSM, the link
+ *   6  ECAM/iATU and the endpoint's vendor/device words (the M1 exit criterion)
+ * Anything >= 1 also runs the earlier steps. Every constant here has its source:
+ *   - device tree: E:\songyuan\dl\live.dtb (reg/ranges/GPIO/SID/PHY sequence)
+ *   - official same-SoC kernel: OnePlusOSS/android_kernel_oneplus_sm8850,
+ *     gcc-canoe.c, tcsrcc-canoe.c, drivers/pci/controller/pci-msm.c
+ *   - official cnss2/pci-msm-drv decompiled for SM8850 (nubia tree)
+ *   - the port's own working RPMh/TLMM code (songyuan_touch.c, same phone)
+ *   - reference XNU implementation: k90 mhi_pcie_power.c/mhi_pcie.c (WCN7850)
+ * Nothing is written before the state it depends on has been read and printed.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+
+#include "songyuan_wlan_phy_seq.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern kern_return_t kernel_thread_start_priority(thread_continue_t, void *, integer_t, thread_t *);
+void songyuan_wlan_init(void);
+
+/* ---- windows (live DT /soc/pcie@1c00000 reg, reg-names) ---- */
+#define SY_PARF_PA	0x01c00000UL	/* "parf", 0x3000 */
+#define SY_PARF_SIZE	0x00003000UL
+#define SY_PHY_PA	0x01c06000UL	/* "phy", 0x2000 */
+#define SY_PHY_SIZE	0x00002000UL
+#define SY_DBI_PA	0x40000000UL	/* "dm_core", ELBI at +0xf20 */
+#define SY_DBI_SIZE	0x00002000UL
+#define SY_IATU_PA	0x410000000UL	/* "iatu", 0x1000 (separate region on this SoC) */
+#define SY_IATU_SIZE	0x00001000UL
+#define SY_CONF_PA	0x40100000UL	/* ECAM: dbi + 1 MiB, pci-msm.c cfg0_ecam_base */
+#define SY_CONF_SIZE	0x00001000UL
+#define SY_PCIE_SM_PA	0x01d07000UL	/* "pcie_sm", 0x7000 */
+#define SY_PCIE_SM_SIZE	0x00007000UL
+#define SY_GCC_PA	0x00100000UL	/* /soc/clock-controller@100000 */
+#define SY_GCC_SIZE	0x001f4200UL
+#define SY_TLMM_PA	0x0f100000UL	/* port-proven pin window (songyuan_touch.c) */
+#define SY_TLMM_SIZE	0x00102000UL
+#define SY_TCSR_PA	0x01fd5000UL	/* /soc/clock-controller@1fd5044 qcom,canoe-tcsrcc */
+#define SY_TCSR_SIZE	0x00001000UL
+#define SY_TCSR_CLKREF	0x00000044UL	/* node start 0x1fd5044, tcsr_pcie_0_clkref_en reg 0 */
+#define SY_RSC_PA	0x18920000UL	/* /soc/rsc@18900000 drv-2 */
+#define SY_RSC_SIZE	0x00010000UL
+#define SY_CMDDB_PA	0x81c60000UL	/* /reserved-memory/aop_cmd_db_region */
+#define SY_CMDDB_SIZE	0x00020000UL
+
+/* ---- GCC (gcc-canoe.c) ---- */
+#define GCC_GDSC_PCIE	0x0006b004UL	/* gcc_pcie_0_gdsc.gdscr */
+#define GCC_GDSC_PHY	0x0006c000UL	/* gcc_pcie_0_phy_gdsc.gdscr */
+#define GCC_GDSC_CFG	0x00000004UL
+#define GDSC_PWR_ON	0x80000000UL
+#define GDSC_SW_COLLAPSE 0x00000001UL
+#define GDSC_PWR_UP_DONE 0x00010000UL
+#define GCC_BCR_PCIE	0x0006b000UL	/* pcie_0 core reset (vendor gcc-canoe BCR page) */
+#define GCC_BCR_PHY	0x0006c01cUL	/* pcie_0 phy reset */
+#define GCC_VOTE_RSCC	0x00052010UL	/* pcie_rscc cfg_ahb / xo votes */
+#define GCC_VOTE_BRANCH	0x00052008UL	/* slv_axi mstr_axi cfg_ahb aux q2a cnoc_sf + pipe */
+#define GCC_VOTE_BRANCH2 0x00052000UL	/* aggre_noc ddrss_sf phy_rchng */
+#define GCC_AUX_RCG	0x0006b094UL	/* gcc_pcie_0_aux_clk_src */
+#define GCC_RCHNG_RCG	0x0006b078UL	/* gcc_pcie_0_phy_rchng_clk_src */
+#define GCC_PIPE_MUX	0x0006b090UL	/* gcc_pcie_0_pipe_clk_src */
+#define GCC_SLV_AXI	0x0006b020UL	/* branch halt registers */
+#define GCC_MSTR_AXI	0x0006b030UL
+#define GCC_CFG_AHB	0x0006b040UL
+#define GCC_AUX		0x0006b044UL
+#define GCC_PIPE	0x0006b064UL
+#define GCC_Q2A		0x0006b01cUL
+#define GCC_CNOC_SF	0x00010058UL
+#define CBCR_CLK_OFF	0x80000000UL
+#define RCG_ROOT_EN	0x00000002UL
+#define RCG_ROOT_OFF	0x80000000UL
+#define RCG_UPDATE	0x00000001UL
+
+/* ---- PCIe controller (pci-msm.c) ---- */
+#define PARF_LTSSM	0x000001b0UL
+#define PARF_LTSSM_EN	0x00000100UL
+#define PARF_SYS_CTRL	0x00000000UL
+#define PARF_PHY_CTRL	0x00000040UL
+#define PARF_DEVICE_TYPE 0x00001000UL
+#define PARF_DBI_BASE	0x00000350UL
+#define PARF_ATU_BASE	0x00000634UL
+#define PARF_CLKREQ_SEL	0x00002c48UL	/* qcom,pcie-clkreq-offset */
+#define PARF_ECAM_BASE	0x00000380UL
+#define PARF_ECAM_BLOCKER 0x04000000UL
+#define DBI_LINKCTRLSTATUS 0x00000080UL
+#define LINK_ACTIVE	0x20000000UL
+#define PHY_STATUS	0x00000414UL	/* qcom,phy-status-offset, bit qcom,phy-status-bit=7 */
+#define PHY_STATUS_BIT	0x00000080UL
+#define PHY_SW_RESET	0x00001400UL	/* last two entries of the DT sequence */
+#define PHY_START	0x00001444UL
+
+/* ---- iATU (pci-msm.c msm_pcie_iatu_config_shift) ---- */
+#define IATU_REGION(n)	(0x200UL * (n))
+#define IATU_CTRL1(n)	(IATU_REGION(n) + 0x00UL)
+#define IATU_CTRL2(n)	(IATU_REGION(n) + 0x04UL)
+#define IATU_LBAR(n)	(IATU_REGION(n) + 0x08UL)
+#define IATU_UBAR(n)	(IATU_REGION(n) + 0x0cUL)
+#define IATU_LAR(n)	(IATU_REGION(n) + 0x10UL)
+#define IATU_ENABLE	0x80000000UL
+#define IATU_CFG_SHIFT	0x10000000UL
+#define IATU_TYPE_CFG0	0x04UL
+
+/* ---- TLMM (port-proven layout: CTL pull[1:0] func[5:2] drive[8:6] OE[9]) ---- */
+#define PIN_CTL(n)	(SY_TLMM_PA + 0x1000UL * (n))
+#define PIN_IO(n)	(PIN_CTL(n) + 4UL)
+#define PIN_WLAN_EN	16UL
+#define PIN_SW_CTRL	18UL
+#define PIN_WLAN_SW_CTRL 19UL
+#define PIN_PERST	102UL
+#define PIN_CLKREQ	103UL
+#define PIN_WAKE	104UL
+#define CTL_OUT_LOW_2MA	0x201UL
+#define CTL_OUT_LOW_8MA	0x2c1UL
+#define CTL_CLKREQ_FUNC	0x007UL
+#define CTL_IN_PULL_UP	0x003UL
+#define IO_HIGH		0x2UL
+
+#if defined(PANDORA) || defined(SONGYUAN)
+
+static vm_offset_t parf, phy, dbi, iatu, conf, pcie_sm, gcc, tlmm, tcsr, rsc, cmddb;
+static unsigned sy_step;
+
+static uint32_t
+sy_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static void
+sy_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+}
+
+static void
+sy_usleep(unsigned us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static bool
+sy_poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t value, unsigned step_us,
+    unsigned limit_us, const char *what)
+{
+	unsigned waited = 0;
+
+	for (;;) {
+		if ((sy_rd(base, off) & mask) == value) {
+			return true;
+		}
+		if (waited >= limit_us) {
+			printf("SONGYUAN WLAN: %s did not happen in %u us (%#x)\n", what, limit_us,
+			    sy_rd(base, off));
+			return false;
+		}
+		sy_usleep(step_us);
+		waited += step_us;
+	}
+}
+
+/* ---- RPMh: command database and one TCS of apps RSC DRV-2 ---------------------- */
+
+struct sy_cmddb_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct sy_cmddb_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct sy_cmddb_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct sy_cmddb_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+#define RSC_TCS_BASE	(0x0d00UL + 2UL * 0x02a0UL)	/* set 2, rpmh-rsc v3 layout */
+#define TCS_WAIT	(RSC_TCS_BASE + 0x20UL)
+#define TCS_CONTROL	(RSC_TCS_BASE + 0x24UL)
+#define TCS_STATUS	(RSC_TCS_BASE + 0x28UL)
+#define TCS_ENABLE	(RSC_TCS_BASE + 0x2cUL)
+#define TCS_MSGID(n)	(RSC_TCS_BASE + 0x34UL + 24UL * (n))
+#define TCS_ADDR(n)	(TCS_MSGID(n) + 4UL)
+#define TCS_DATA(n)	(TCS_MSGID(n) + 8UL)
+#define TCS_BIT		(1UL << 2)
+#define RSC_IRQ_EN	0x0d00UL
+#define RSC_IRQ_STATUS	0x0d04UL
+#define RSC_IRQ_CLEAR	0x0d08UL
+#define TCS_CONTROL_ENABLE (1UL << 16)
+#define TCS_CONTROL_TRIGGER (1UL << 24)
+#define MSGID_WRITE_RESPONSE 0x10108UL
+#define VRM_VOLTAGE	0UL
+#define VRM_ENABLE	4UL
+#define VRM_MODE	8UL
+#define VRM_MODE_LDO_HPM 7UL
+#define VRM_CLOCK_ENABLE 4UL
+#define CMD_DB_VRM	4UL
+
+static uint32_t
+sy_rpmh_address(const char *name)
+{
+	const struct sy_cmddb_header *db = (const struct sy_cmddb_header *)cmddb;
+	char id[8] = { 0 };
+
+	if (db->magic[0] != 0xdb || db->magic[1] != 0x30 || db->magic[2] != 0x03 ||
+	    db->magic[3] != 0x0c) {
+		printf("SONGYUAN WLAN: command database magic is %02x%02x%02x%02x\n",
+		    db->magic[3], db->magic[2], db->magic[1], db->magic[0]);
+		return 0;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct sy_cmddb_slave *slave = &db->slave[s];
+		const struct sy_cmddb_entry *entry;
+
+		if (slave->id == 0 || slave->header_offset >= SY_CMDDB_SIZE - 0x1000 ||
+		    slave->count > 512) {
+			continue;
+		}
+		entry = (const struct sy_cmddb_entry *)(db->data + slave->header_offset);
+		for (unsigned i = 0; i < slave->count; i++) {
+			if (memcmp(entry[i].id, id, sizeof(id)) == 0) {
+				return entry[i].address;
+			}
+		}
+	}
+	return 0;
+}
+
+static uint32_t
+sy_rpmh_vrm(const char *name)
+{
+	static char lower[9], upper[9];
+	uint32_t addr = sy_rpmh_address(name);
+
+	if (addr != 0) {
+		return addr;
+	}
+	for (unsigned i = 0; i < 8 && name[i]; i++) {
+		char c = name[i];
+		lower[i] = (c >= 'A' && c <= 'Z') ? (char)(c - 'A' + 'a') : c;
+		upper[i] = (c >= 'a' && c <= 'z') ? (char)(c - 'a' + 'A') : c;
+	}
+	lower[8] = upper[8] = 0;
+	addr = sy_rpmh_address(lower);
+	if (addr == 0) {
+		addr = sy_rpmh_address(upper);
+	}
+	return addr;
+}
+
+static bool
+sy_rpmh_write(const uint32_t *address, const uint32_t *data, unsigned count)
+{
+	uint32_t mask = (1UL << count) - 1;
+
+	if (sy_rd(rsc, TCS_STATUS) == 0 || (sy_rd(rsc, TCS_CONTROL) & TCS_CONTROL_TRIGGER) != 0) {
+		printf("SONGYUAN WLAN: RPMh set 2 busy (status %#x control %#x)\n",
+		    sy_rd(rsc, TCS_STATUS), sy_rd(rsc, TCS_CONTROL));
+		return false;
+	}
+	sy_wr(rsc, TCS_CONTROL, 0);
+	sy_wr(rsc, RSC_IRQ_CLEAR, TCS_BIT);
+	for (unsigned i = 0; i < count; i++) {
+		sy_wr(rsc, TCS_MSGID(i), MSGID_WRITE_RESPONSE);
+		sy_wr(rsc, TCS_ADDR(i), address[i]);
+		sy_wr(rsc, TCS_DATA(i), data[i]);
+	}
+	sy_wr(rsc, TCS_WAIT, mask);
+	sy_wr(rsc, TCS_ENABLE, mask);
+	sy_wr(rsc, RSC_IRQ_EN, sy_rd(rsc, RSC_IRQ_EN) | TCS_BIT);
+	sy_wr(rsc, TCS_CONTROL, TCS_CONTROL_ENABLE);
+	sy_wr(rsc, TCS_CONTROL, TCS_CONTROL_ENABLE | TCS_CONTROL_TRIGGER);
+	bool done = sy_poll(rsc, RSC_IRQ_STATUS, TCS_BIT, TCS_BIT, 100, 200000, "the RPMh completion");
+	sy_wr(rsc, TCS_CONTROL, 0);
+	sy_wr(rsc, TCS_ENABLE, 0);
+	sy_wr(rsc, TCS_WAIT, 0);
+	sy_wr(rsc, RSC_IRQ_CLEAR, TCS_BIT);
+	sy_wr(rsc, RSC_IRQ_EN, sy_rd(rsc, RSC_IRQ_EN) & ~TCS_BIT);
+	return done;
+}
+
+/* The card's seven rails: live DT vdd-wlan-*-supply -> rpmh-regulator node ->
+ * qcom,resource-name and qcom,init-voltage; min/max are the regulator's range. */
+struct sy_supply {
+	const char *name, *what;
+	uint32_t mv, min_uv, max_uv;
+	bool ldo;
+};
+static const struct sy_supply sy_supplies[] = {
+	{ "s1j_e1", "vdd-wlan-cx (S1J, pmh0104 S1)", 852, 400000, 1000000, false },
+	{ "s2j_e1", "vdd-wlan-dig (S2J, pmh0104 S2)", 852, 500000, 1100000, false },
+	{ "l3g_e0", "vdd-wlan-io12 (L3G, pmh0110 G L3)", 1200, 1200000, 1200000, true },
+	{ "l2g_e0", "vdd-wlan-aon (L2G, pmh0110 G L2)", 1800, 1800000, 1800000, true },
+	{ "s8f_e0", "vdd-wlan-rfa1 (S8F, pmh0110 F S8)", 1856, 1800000, 2000000, false },
+	{ "s7f_e0", "vdd-wlan-rfa2 (S7F, pmh0110 F S7)", 1256, 1224000, 1372000, false },
+	{ "l3k_e1", "vdd-wlan-ant-share (L3K, pmr735d L3)", 1200, 1200000, 1200000, true },
+};
+
+static bool
+sy_supplies_on(void)
+{
+	uint32_t found[ARRAY_SIZE(sy_supplies)];
+	bool all = true;
+
+	for (unsigned i = 0; i < ARRAY_SIZE(sy_supplies); i++) {
+		found[i] = sy_rpmh_vrm(sy_supplies[i].name);
+		printf("SONGYUAN WLAN: %s for %s at RPMh %#x\n", sy_supplies[i].name,
+		    sy_supplies[i].what, found[i]);
+		if (found[i] == 0 || (found[i] >> 16 & 0xf) != CMD_DB_VRM) {
+			all = false;
+		}
+	}
+	if (!all) {
+		printf("SONGYUAN WLAN: a supply is missing or not a regulator; nothing is voted\n");
+		return false;
+	}
+	for (unsigned i = 0; i < ARRAY_SIZE(sy_supplies); i++) {
+		const struct sy_supply *s = &sy_supplies[i];
+		uint32_t address[3] = { found[i] + VRM_VOLTAGE, found[i] + VRM_ENABLE,
+		    found[i] + VRM_MODE };
+		uint32_t data[3] = { s->mv, 1, VRM_MODE_LDO_HPM };
+
+		if (s->mv * 1000 < s->min_uv || s->mv * 1000 > s->max_uv) {
+			printf("SONGYUAN WLAN: %u mV for %s is outside %u-%u uV\n", s->mv,
+			    s->name, s->min_uv, s->max_uv);
+			return false;
+		}
+		if (!sy_rpmh_write(address, data, s->ldo ? 3 : 2)) {
+			printf("SONGYUAN WLAN: the vote for %s was not confirmed\n", s->name);
+			return false;
+		}
+		printf("SONGYUAN WLAN: %s on at %u mV\n", s->name, s->mv);
+	}
+	return true;
+}
+
+/* ---- power domains and clocks -------------------------------------------------- */
+
+static bool
+sy_gdsc_on(uint32_t gdscr, const char *name)
+{
+	if (sy_rd(gcc, gdscr) & GDSC_PWR_ON) {
+		printf("SONGYUAN WLAN: %s already on (%#x)\n", name, sy_rd(gcc, gdscr));
+		return true;
+	}
+	sy_wr(gcc, gdscr, sy_rd(gcc, gdscr) & ~GDSC_SW_COLLAPSE);
+	return sy_poll(gcc, gdscr + GCC_GDSC_CFG, GDSC_PWR_UP_DONE, GDSC_PWR_UP_DONE, 50, 2000,
+	    name);
+}
+
+static bool
+sy_rcg_set(uint32_t rcg, uint32_t cfg, const char *name)
+{
+	sy_wr(gcc, rcg, sy_rd(gcc, rcg) | RCG_ROOT_EN);
+	if (!sy_poll(gcc, rcg, RCG_ROOT_OFF, 0, 10, 500, name)) {
+		return false;
+	}
+	sy_wr(gcc, rcg + 4, cfg);
+	sy_wr(gcc, rcg, sy_rd(gcc, rcg) | RCG_UPDATE);
+	if (!sy_poll(gcc, rcg, RCG_UPDATE, 0, 10, 500, name)) {
+		return false;
+	}
+	sy_wr(gcc, rcg, sy_rd(gcc, rcg) & ~RCG_ROOT_EN);
+	return true;
+}
+
+static bool
+sy_clocks_on(void)
+{
+	static const uint32_t branches[] = {
+		GCC_SLV_AXI, GCC_MSTR_AXI, GCC_CFG_AHB, GCC_AUX, GCC_Q2A, GCC_CNOC_SF
+	};
+
+	sy_wr(gcc, GCC_VOTE_RSCC, sy_rd(gcc, GCC_VOTE_RSCC) | (1UL << 20) | (1UL << 21));
+	if (!sy_gdsc_on(GCC_GDSC_PCIE, "root complex 0's power domain") ||
+	    !sy_gdsc_on(GCC_GDSC_PHY, "the PHY's power domain")) {
+		return false;
+	}
+	/* aux: bi_tcxo (parent 0 in gcc_parent_map_6), no divider -> 19.2 MHz */
+	if (!sy_rcg_set(GCC_AUX_RCG, 0x000, "aux at 19.2 MHz")) {
+		return false;
+	}
+	sy_wr(tcsr, SY_TCSR_CLKREF, sy_rd(tcsr, SY_TCSR_CLKREF) | 1);
+	sy_usleep(10);
+	sy_wr(gcc, GCC_VOTE_BRANCH, sy_rd(gcc, GCC_VOTE_BRANCH) | 0x2f);	/* without pipe (bit4) */
+	sy_wr(gcc, GCC_VOTE_BRANCH2, sy_rd(gcc, GCC_VOTE_BRANCH2) |
+	    (1UL << 12) | (1UL << 19) | (1UL << 22));
+	for (unsigned i = 0; i < ARRAY_SIZE(branches); i++) {
+		if (!sy_poll(gcc, branches[i], CBCR_CLK_OFF, 0, 10, 1000, "a PCIe clock branch")) {
+			printf("SONGYUAN WLAN: branch at GCC %#x stays off\n", branches[i]);
+			return false;
+		}
+	}
+	printf("SONGYUAN WLAN: domains on; aux, reference and branch clocks running\n");
+	return true;
+}
+
+/* ---- pins (port-proven TLMM CTL layout) ---------------------------------------- */
+
+static void
+sy_pin_out(uint32_t pin, uint32_t ctl)
+{
+	*(volatile uint32_t *)(tlmm + (pin * 0x1000UL) + 4UL) = 0;
+	*(volatile uint32_t *)(tlmm + (pin * 0x1000UL)) = ctl;
+}
+
+static void
+sy_pin_level(uint32_t pin, uint32_t level)
+{
+	*(volatile uint32_t *)(tlmm + (pin * 0x1000UL) + 4UL) = level;
+}
+
+static void
+sy_pin_ctl(uint32_t pin, uint32_t ctl)
+{
+	*(volatile uint32_t *)(tlmm + (pin * 0x1000UL)) = ctl;
+}
+
+/* ---- PARF, PHY, root port, link ------------------------------------------------ */
+
+static void
+sy_parf_setup(void)
+{
+	sy_wr(parf, PARF_DEVICE_TYPE, 0x4);			/* root complex */
+	sy_wr(parf, PARF_PHY_CTRL, sy_rd(parf, PARF_PHY_CTRL) & ~1UL);
+	sy_wr(parf, PARF_DBI_BASE, (uint32_t)SY_DBI_PA);
+	sy_wr(parf, PARF_DBI_BASE + 4, 0);
+	sy_wr(parf, PARF_ATU_BASE, (uint32_t)SY_IATU_PA);
+	sy_wr(parf, PARF_ATU_BASE + 4, 0);
+	sy_wr(parf, PARF_SYS_CTRL, sy_rd(parf, PARF_SYS_CTRL) & ~(1UL << 29));
+	sy_wr(parf, 0x174, sy_rd(parf, 0x174) | (1UL << 4));	/* MHI_CLOCK_RESET_CTRL bypass */
+	sy_wr(parf, 0x020, sy_rd(parf, 0x020) & ~(1UL << 5));	/* PM_CTRL: no L1 entry */
+	sy_wr(parf, 0x1a8, sy_rd(parf, 0x1a8) | (1UL << 31));	/* AXI_MSTR_WR_ADDR_HALT */
+	sy_wr(parf, PARF_CLKREQ_SEL, sy_rd(parf, PARF_CLKREQ_SEL) & ~1UL);
+	printf("SONGYUAN WLAN: PARF glue set (device type, DBI/ATU base, L1 policy)\n");
+}
+
+static bool
+sy_phy_start(void)
+{
+	for (unsigned i = 0; i < ARRAY_SIZE(sy_phy_seq); i++) {
+		sy_wr(phy, sy_phy_seq[i][0], sy_phy_seq[i][1]);
+	}
+	sy_wr(gcc, GCC_PIPE_MUX, sy_rd(gcc, GCC_PIPE_MUX) & ~3UL);	/* PHY pipe */
+	sy_wr(gcc, GCC_VOTE_BRANCH, sy_rd(gcc, GCC_VOTE_BRANCH) | (1UL << 4));
+	if (!sy_poll(gcc, GCC_PIPE, CBCR_CLK_OFF, 0, 10, 1000, "the pipe clock")) {
+		return false;
+	}
+	sy_wr(phy, PHY_SW_RESET, 0);
+	sy_wr(phy, PHY_START, 3);
+	sy_usleep(1200);
+	if (!sy_poll(phy, PHY_STATUS, PHY_STATUS_BIT, 0, 200, 20000, "the PHY's PHYSTATUS")) {
+		return false;
+	}
+	printf("SONGYUAN WLAN: PHY started (%u writes), pipe clock running\n",
+	    (unsigned)ARRAY_SIZE(sy_phy_seq));
+	return true;
+}
+
+static void
+sy_root_port_setup(void)
+{
+	sy_wr(dbi, 0x8bc, sy_rd(dbi, 0x8bc) | 1);		/* DBI RO write enable */
+	sy_wr(dbi, 0x10, 0x4);					/* BAR0: 64-bit memory */
+	sy_wr(dbi, 0x14, 0);
+	sy_wr(dbi, 0x3c, (sy_rd(dbi, 0x3c) & 0xffff00ffUL) | 0x100);
+	sy_wr(dbi, 0x18, (sy_rd(dbi, 0x18) & 0xff000000UL) | 0x00ff0100UL);	/* bus 0/1..255 */
+	sy_wr(dbi, 0x04, sy_rd(dbi, 0x04) | 0x107);
+	sy_wr(dbi, 0x08, (sy_rd(dbi, 0x08) & 0x0000ffffUL) | (0x0604UL << 16));	/* class bridge */
+	sy_wr(dbi, 0xa0, (sy_rd(dbi, 0xa0) & ~0xfUL) | 1);	/* target link speed Gen1 */
+	sy_wr(dbi, 0x8bc, sy_rd(dbi, 0x8bc) & ~1UL);
+}
+
+static bool
+sy_link_wait(void)
+{
+	unsigned ltssm = sy_rd(parf, PARF_LTSSM) & 0x3f;
+
+	printf("SONGYUAN WLAN: LTSSM before enable %#x\n", ltssm);
+	sy_wr(parf, PARF_LTSSM, sy_rd(parf, PARF_LTSSM) | PARF_LTSSM_EN);
+	for (unsigned i = 0; i < 500; i++) {
+		uint32_t status = sy_rd(dbi, DBI_LINKCTRLSTATUS);
+		ltssm = sy_rd(parf, PARF_LTSSM) & 0x3f;
+
+		if ((status & LINK_ACTIVE) && ltssm == 0x11) {
+			printf("SONGYUAN WLAN: link up: LTSSM %#x, link status %#x (%u ms)\n",
+			    ltssm, status, i * 10);
+			return true;
+		}
+		sy_usleep(10000);
+	}
+	printf("SONGYUAN WLAN: link did not come up; LTSSM %#x, link status %#x\n",
+	    sy_rd(parf, PARF_LTSSM) & 0x3f, sy_rd(dbi, DBI_LINKCTRLSTATUS));
+	return false;
+}
+
+static void
+sy_iatu_ecam(void)
+{
+	sy_wr(iatu, IATU_CTRL2(0), 0);
+	sy_wr(iatu, IATU_CTRL1(0), IATU_TYPE_CFG0);
+	sy_wr(iatu, IATU_LBAR(0), (uint32_t)SY_CONF_PA);
+	sy_wr(iatu, IATU_UBAR(0), 0);
+	sy_wr(iatu, IATU_LAR(0), (uint32_t)(SY_CONF_PA + 0xfffff));
+	sy_wr(iatu, IATU_CTRL2(0), IATU_ENABLE | IATU_CFG_SHIFT);
+	printf("SONGYUAN WLAN: ECAM window %#lx via iATU region 0 (CFG0, cfg-shift)\n",
+	    (unsigned long)SY_CONF_PA);
+}
+
+static bool
+sy_config_read(void)
+{
+	uint32_t id = sy_rd(conf, 0);
+
+	printf("SONGYUAN WLAN: endpoint config[0] = %#x -> vendor %#x device %#x\n", id,
+	    id & 0xffff, id >> 16);
+	if ((id & 0xffff) == 0x17cb && (id >> 16) == 0x110e) {
+		return true;
+	}
+	return false;
+}
+
+/* ---- the run ------------------------------------------------------------------- */
+
+static void
+sy_dump_state(void)
+{
+	printf("SONGYUAN WLAN: state: pcie0 gdsc %#x/%#x phy gdsc %#x/%#x\n",
+	    sy_rd(gcc, GCC_GDSC_PCIE), sy_rd(gcc, GCC_GDSC_PCIE + 4),
+	    sy_rd(gcc, GCC_GDSC_PHY), sy_rd(gcc, GCC_GDSC_PHY + 4));
+	printf("SONGYUAN WLAN: state: votes br %#x br2 %#x rscc %#x aux-halt %#x pipe-halt %#x\n",
+	    sy_rd(gcc, GCC_VOTE_BRANCH), sy_rd(gcc, GCC_VOTE_BRANCH2),
+	    sy_rd(gcc, GCC_VOTE_RSCC), sy_rd(gcc, GCC_AUX), sy_rd(gcc, GCC_PIPE));
+	printf("SONGYUAN WLAN: state: clkref %#x parf sys %#x ltssm %#x phy%#x %#x\n",
+	    sy_rd(tcsr, SY_TCSR_CLKREF), sy_rd(parf, PARF_SYS_CTRL), sy_rd(parf, PARF_LTSSM),
+	    PHY_STATUS, sy_rd(phy, PHY_STATUS));
+	printf("SONGYUAN WLAN: state: dbi reglen %#x ver %#x bhi %#x bhie %#x ctrl %#x status %#x\n",
+	    sy_rd(dbi, 0x00), sy_rd(dbi, 0x08), sy_rd(dbi, 0x28), sy_rd(dbi, 0x2c),
+	    sy_rd(dbi, 0x38), sy_rd(dbi, 0x48));
+	printf("SONGYUAN WLAN: state: link status %#x\n", sy_rd(dbi, DBI_LINKCTRLSTATUS));
+}
+
+static void
+sy_run(void)
+{
+	bool ok;
+
+	printf("SONGYUAN WLAN: step %u: mapping windows\n", sy_step);
+	parf = ml_io_map(SY_PARF_PA, SY_PARF_SIZE);
+	phy = ml_io_map(SY_PHY_PA, SY_PHY_SIZE);
+	dbi = ml_io_map(SY_DBI_PA, SY_DBI_SIZE);
+	iatu = ml_io_map(SY_IATU_PA, SY_IATU_SIZE);
+	conf = ml_io_map(SY_CONF_PA, SY_CONF_SIZE);
+	pcie_sm = ml_io_map(SY_PCIE_SM_PA, SY_PCIE_SM_SIZE);
+	gcc = ml_io_map(SY_GCC_PA, SY_GCC_SIZE);
+	tlmm = ml_io_map(SY_TLMM_PA, SY_TLMM_SIZE);
+	tcsr = ml_io_map(SY_TCSR_PA, SY_TCSR_SIZE);
+	rsc = ml_io_map(SY_RSC_PA, SY_RSC_SIZE);
+	cmddb = ml_io_map_wcomb(SY_CMDDB_PA, SY_CMDDB_SIZE);
+	if (!parf || !phy || !dbi || !iatu || !conf || !pcie_sm || !gcc || !tlmm || !tcsr ||
+	    !rsc || !cmddb) {
+		printf("SONGYUAN WLAN: a window cannot be mapped\n");
+		return;
+	}
+	printf("SONGYUAN WLAN: windows mapped\n");
+	sy_dump_state();
+	if (sy_step < 2) {
+		return;
+	}
+
+	printf("SONGYUAN WLAN: step %u: PERST and WLAN_EN low, supplies\n", sy_step);
+	sy_pin_out(PIN_PERST, CTL_OUT_LOW_2MA);
+	sy_pin_out(PIN_WLAN_EN, CTL_OUT_LOW_8MA);
+	if (!sy_supplies_on()) {
+		return;
+	}
+
+	printf("SONGYUAN WLAN: step %u: clocks\n", sy_step);
+	if (!sy_clocks_on()) {
+		return;
+	}
+	printf("SONGYUAN WLAN: step %u: resets and PARF\n", sy_step);
+	sy_wr(gcc, GCC_BCR_PCIE, sy_rd(gcc, GCC_BCR_PCIE) | 1);
+	sy_wr(gcc, GCC_BCR_PHY, sy_rd(gcc, GCC_BCR_PHY) | 1);
+	sy_usleep(1000);
+	sy_wr(gcc, GCC_BCR_PHY, sy_rd(gcc, GCC_BCR_PHY) & ~1UL);
+	sy_wr(gcc, GCC_BCR_PCIE, sy_rd(gcc, GCC_BCR_PCIE) & ~1UL);
+	sy_usleep(1000);
+	sy_parf_setup();
+	if (sy_step < 4) {
+		return;
+	}
+
+	printf("SONGYUAN WLAN: step %u: the PHY\n", sy_step);
+	if (!sy_phy_start()) {
+		return;
+	}
+	if (sy_step < 5) {
+		return;
+	}
+
+	printf("SONGYUAN WLAN: step %u: the card's enable, root port, PERST release\n", sy_step);
+	sy_pin_level(PIN_WLAN_EN, IO_HIGH);
+	delay_for_interval(50, NSEC_PER_MSEC);
+	sy_pin_ctl(PIN_CLKREQ, CTL_CLKREQ_FUNC);
+	sy_pin_ctl(PIN_WAKE, CTL_IN_PULL_UP);
+	printf("SONGYUAN WLAN: sw-ctrl pins read %u %u\n",
+	    (unsigned)(*(volatile uint32_t *)(tlmm + 18 * 0x1000UL + 4UL) & 1),
+	    (unsigned)(*(volatile uint32_t *)(tlmm + 19 * 0x1000UL + 4UL) & 1));
+	sy_root_port_setup();
+	delay_for_interval(50, NSEC_PER_MSEC);
+	sy_pin_level(PIN_PERST, IO_HIGH);
+	ok = sy_link_wait();
+	if (!ok) {
+		return;
+	}
+	if (sy_step < 6) {
+		return;
+	}
+
+	printf("SONGYUAN WLAN: step %u: ECAM and the endpoint\n", sy_step);
+	sy_iatu_ecam();
+	if (sy_config_read()) {
+		printf("SONGYUAN WLAN: M1 DONE: 17cb:110e answers on PCIe0\n");
+	} else {
+		printf("SONGYUAN WLAN: ECAM read did not return the endpoint\n");
+	}
+}
+
+static void
+sy_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	printf("SONGYUAN WLAN: thread, step %u\n", sy_step);
+	delay_for_interval(2000, NSEC_PER_MSEC);
+	sy_run();
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+songyuan_wlan_init(void)
+{
+	int step = 0;
+
+	if (!PE_parse_boot_argn("songyuan_wlan", &step, sizeof(step)) || step <= 0) {
+		return;
+	}
+	sy_step = (unsigned)step;
+	thread_t th;
+
+	if (kernel_thread_start_priority((thread_continue_t)sy_thread, NULL, 80, &th) ==
+	    KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
+
+#else /* !PANDORA && !SONGYUAN: nothing to wire on other boards */
+
+void
+songyuan_wlan_init(void)
+{
+}
+
+#endif
