+/*
+ * 2021-pandora-dataprotect: data protection classes on a volume without content
+ * protection. This port boots an HFS+ root whose mount has MNT_CPROTECT clear, so
+ * the file system keeps no class a caller sets and reports 0 for everything. A
+ * daemon that sets a class and reads it back therefore never sees it; PosterBoard
+ * creates its poster data store with NSFileProtectionNone (class D), reads the class
+ * back as missing, judges the store not viable and then traps in the first-time
+ * switcher setup. On a writable mount without content protection we keep the class a
+ * caller sets in an extended attribute and report class D (what an unencrypted file
+ * is) when there is none. Nothing is encrypted either way. Boot-arg
+ * sweetdataprotect=0 turns this off (default on).
+ */
+#define SWEET_DATAPROTECT_XATTR "com.pandora.dataprotect-class"
+#define SWEET_DATAPROTECT_CLASS_D 4
+
+static int
+sweet_dataprotect_emulated(vnode_t vp)
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		uint32_t value = 1;
+		(void)PE_parse_boot_argn("sweetdataprotect", &value, sizeof(value));
+		enabled = value != 0;
+	}
+	mount_t mp = vnode_mount(vp);
+	return enabled && mp != NULL && !(vfs_flags(mp) & MNT_CPROTECT) && !vfs_isrdonly(mp) &&
+	       (vnode_isreg(vp) || vnode_isdir(vp));
+}
+
+static void
+sweet_dataprotect_getattr(vnode_t vp, struct vnode_attr *vap, vfs_context_t ctx)
+{
+	uint32_t class = 0;
+	size_t size = sizeof(class);
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+	if (uio == NULL) {
+		return;
+	}
+	uio_addiov(uio, CAST_USER_ADDR_T(&class), sizeof(class));
+	if (vn_getxattr(vp, SWEET_DATAPROTECT_XATTR, uio, &size, XATTR_NOSECURITY, ctx) != 0 || class == 0 || class > 7) {
+		class = SWEET_DATAPROTECT_CLASS_D;
+	}
+	uio_free(uio);
+	vap->va_dataprotect_class = class;
+	VATTR_SET_SUPPORTED(vap, va_dataprotect_class);
+}
+
+/* Keep the class asked for and take it out of what the file system is asked to set
+ * (which would only drop it). */
+static void
+sweet_dataprotect_setattr(vnode_t vp, struct vnode_attr *vap, vfs_context_t ctx)
+{
+	uint32_t class = vap->va_dataprotect_class;
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+	if (uio == NULL) {
+		return;
+	}
+	uio_addiov(uio, CAST_USER_ADDR_T(&class), sizeof(class));
+	if (vn_setxattr(vp, SWEET_DATAPROTECT_XATTR, uio, XATTR_NOSECURITY, ctx) == 0) {
+		VATTR_SET_SUPPORTED(vap, va_dataprotect_class);
+		VATTR_CLEAR_ACTIVE(vap, va_dataprotect_class);
+	}
+	uio_free(uio);
+}
+
