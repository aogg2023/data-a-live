 }
+
+/* 0341: remove a whole directory tree through the VFS. pandora_rmdir (0336) only removes empty
+ * directories, so a PosterBoard store that a previous boot already populated could not be reset;
+ * this walks it with VNOP_READDIR and removes every entry bottom up. */
+int pandora_rmrf(const char *path);
+
+static int
+pandora_rmrf_walk(vnode_t vp, const char *path)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	UIO_STACKBUF(uio_buf, 1);
+	char *dbuf;
+	off_t loff = 0;
+	int error = 0;
+
+	/* Directory bytes and child paths sit on the heap. A 4096-byte buffer
+	 * plus PATH_MAX on every recursive frame overflowed the 16KB kernel
+	 * stack while deleting AppPlaceholders (ioslog_k11). */
+	dbuf = kalloc_data(4096, Z_WAITOK);
+	if (dbuf == NULL) {
+		return ENOMEM;
+	}
+	for (;;) {
+		uio_t auio = uio_createwithbuffer(1, loff, UIO_SYSSPACE, UIO_READ,
+		    &uio_buf[0], sizeof(uio_buf));
+		int eofflag = 0, numdirent = 0;
+		unsigned used, at;
+
+		if (auio == NULL) {
+			error = ENOMEM;
+			break;
+		}
+		uio_addiov(auio, (uint64_t)(uintptr_t)dbuf, 4096);
+		error = VNOP_READDIR(vp, auio, 0, &eofflag, &numdirent, ctx);
+		if (error) {
+			break;
+		}
+		used = (unsigned)(4096 - uio_resid(auio));
+		loff = uio_offset(auio);
+		if (used == 0) {
+			break;
+		}
+		/* HFS records are STD_DIRENT_LEN, not sizeof(struct dirent). */
+		for (at = 0; at + 8 <= used; ) {
+			struct dirent *dp = (struct dirent *)(void *)(dbuf + at);
+			char *sub;
+			int n;
+
+			if (dp->d_reclen < 12 || at + dp->d_reclen > used) {
+				break;
+			}
+			if (strcmp(dp->d_name, ".") != 0 && strcmp(dp->d_name, "..") != 0) {
+				sub = kalloc_data(1024, Z_WAITOK);
+				if (sub == NULL) {
+					error = ENOMEM;
+					break;
+				}
+				n = snprintf(sub, 1024, "%s/%s", path, dp->d_name);
+				if (n > 0 && n < 1024) {
+					(void)pandora_rmrf(sub);
+				}
+				kfree_data(sub, 1024);
+			}
+			at += dp->d_reclen;
+		}
+		if (error || eofflag) {
+			break;
+		}
+	}
+	kfree_data(dbuf, 4096);
+	return error;
+}
+
+int
+pandora_rmrf(const char *path)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+
+	if (vnode_lookup(path, 0, &vp, ctx) != 0) {
+		return ENOENT;
+	}
+	if (vp->v_type != VDIR) {
+		vnode_put(vp);
+		return pandora_unlink(path);
+	}
+	(void)pandora_rmrf_walk(vp, path);
+	vnode_put(vp);
+	return pandora_rmdir(path);
+}
 #endif /* PANDORA */
