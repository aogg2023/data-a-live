+/* 0271: mount() of a kernel-resolved block device (pandora GPU cache volume). mount_common()
+ * otherwise expects a user-space device path; this flag says the data argument is a kernel
+ * "char **" pointing at a kernel string, and that the file system gets no mount arguments
+ * (hfs_mount accepts NULL data and uses the device vnode mount_common opened). */
+#define KERNEL_MOUNT_PANDORADEV 0x800
 #include <sys/proc_internal.h>
 #include <sys/kauth.h>
 #include <sys/uio_internal.h>
