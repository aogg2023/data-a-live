+/*
+ * 0271: mount a file system from a kernel thread on a block device we created (the GPU cache
+ * volume). The device path is resolved in kernel space, and the file system gets a zeroed mount
+ * arguments block (hfs_mount rejects a NULL block as "this is the root mount").
+ */
+int
+pandora_mount_hfs(const char *dev, const char *mnt)
+{
+	static char hfs_args[1024];   /* zeroed: defaults for uid/gid/mask/journal */
+	int error;
+	char *pair[2];
+
+	pair[0] = __DECONST(char *, dev);
+	pair[1] = hfs_args;
+	{
+		/* 0271 diagnostics: what does the block device report and return at the volume header? */
+		vnode_t dvp = NULLVP;
+		vfs_context_t dctx = vfs_context_kernel();
+		if (vnode_lookup(dev, 0, &dvp, dctx) == 0) {
+			int bs = 0, wr = 0;
+			uint64_t bc = 0;
+			buf_t bp = NULL;
+			VNOP_IOCTL(dvp, DKIOCGETBLOCKSIZE, (caddr_t)&bs, 0, dctx);
+			VNOP_IOCTL(dvp, DKIOCGETBLOCKCOUNT, (caddr_t)&bc, 0, dctx);
+			VNOP_IOCTL(dvp, DKIOCISWRITABLE, (caddr_t)&wr, 0, dctx);
+			int br = buf_meta_bread(dvp, bs ? (1024 / bs) : 2, 512, NOCRED, &bp);
+			if (br == 0) {
+				unsigned char *p = (unsigned char *)buf_dataptr(bp);
+				printf("PANDORA CACHE: dev %s vtype %d bs %d count %llu wr %d vh %02x%02x%02x%02x blocksize %08x total %08x free %08x\n",
+				    dev, dvp->v_type, bs, bc, wr, p[0], p[1], p[2], p[3],
+				    (p[40] << 24) | (p[41] << 16) | (p[42] << 8) | p[43],
+				    (p[44] << 24) | (p[45] << 16) | (p[46] << 8) | p[47],
+				    (p[48] << 24) | (p[49] << 16) | (p[50] << 8) | p[51]);
+				buf_brelse(bp);
+			} else {
+				printf("PANDORA CACHE: dev %s vh read %d\n", dev, br);
+			}
+			vnode_put(dvp);
+		} else {
+			printf("PANDORA CACHE: vnode_lookup %s failed\n", dev);
+		}
+	}
+	error = kernel_mount("hfs", NULLVP, NULLVP, mnt, (void *)pair, 0,
+	    MNT_DONTBROWSE, KERNEL_MOUNT_PANDORADEV, vfs_context_kernel());
+	if (error) {
+		printf("PANDORA CACHE: kernel_mount(hfs) %s on %s failed %d\n", dev, mnt, error);
+	}
+	return error;
+}
