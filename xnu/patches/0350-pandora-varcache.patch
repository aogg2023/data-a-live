+
+/* Read-only: list every valid SMR so the operator can see which SIDs exist and
+ * which bank each points at. No writes here. */
+static void
+sy_smmu_dump(void)
+{
+	uint32_t banks = sy_id1 & 0xffu, streams = sy_id0 & 0xffu;
+	unsigned i, shown = 0;
+
+	if (!sy_smmu_va || !streams || !banks)
+		return;
+	printf("PANDORA WLAN: SMMU table: streams %u banks %u\n", streams, banks);
+	for (i = 0; i < streams && shown < 36; i++) {
+		uint32_t smr = sy_rd(sy_smmu_va, 0x800 + 4 * i);
+		uint32_t s2cr = sy_rd(sy_smmu_va, 0xc00 + 4 * i);
+
+		if (!(smr & 0x80000000u))
+			continue;
+		printf("PANDORA WLAN: SMMU table[%u]: smr %#x id %#x mask %#x s2cr %#x type %u bank %u\n",
+		    i, smr, smr & 0x7fffu, (smr >> 16) & 0x7fffu, s2cr, (s2cr >> 16) & 3u, s2cr & 0xffu);
+		shown++;
+	}
+	sy_log_sync();
+}
+
+static void
+sy_smmu_bank_scan(void)
+{
+	uint32_t banks = sy_id1 & 0xffu, pages = 2u << ((sy_id1 >> 28) & 7u);
+	uint32_t shift = (sy_id1 >> 31) ? 16u : 12u;
+	unsigned i, shown = 0;
+
+	if (!sy_smmu_va || !banks)
+		return;
+	printf("PANDORA WLAN: SMMU bank scan: %u banks, iova base %#x\n", banks, SY_IOVA_BASE);
+	for (i = 0; i < banks && shown < 24; i++) {
+		vm_offset_t cbv = ml_io_map(0x15000000UL + ((vm_offset_t)pages + i) * (1u << shift), 0x1000);
+		uint32_t sctlr, fsr, far_lo, far_hi;
+
+		if (!cbv)
+			continue;
+		sctlr = sy_rd(cbv, 0x00);
+		fsr = sy_rd(cbv, 0x58);
+		if (!(sctlr & 1u) && !(fsr & 0xc00001feu) && !(fsr & 0x600u))
+			continue;
+		far_lo = sy_rd(cbv, 0x60);
+		far_hi = sy_rd(cbv, 0x64);
+		printf("PANDORA WLAN: SMMU bank[%u]: sctlr %#x fsr %#x far %#x:%#x%s\n",
+		    i, sctlr, fsr, far_hi, far_lo,
+		    ((far_hi == 0 && far_lo == SY_IOVA_BASE) ? "  <- our IOVA" : ""));
+		shown++;
+	}
+	if (!shown)
+		printf("PANDORA WLAN: SMMU bank scan: every bank idle (no request entered the SMMU)\n");
+	sy_log_sync();
+}
+
+
+static void
+sy_bhi_bhie(void)
+{
+	uint64_t fo = 0, fs = 0, iova = SY_IOVA_MAP;
+	uint32_t i, seg = SY_SBL_SIZE, n, ts, st;
+	uint64_t *vec;
+
+	if (!sy_bar_va || !sy_sbl_va || !sy_buf_size || !sy_bhi_off) {
+		printf("PANDORA WLAN: BHIe: missing state\n");
+		return;
+	}
+	if (sy_fw_find("amss20.bin", &fo, &fs) || fs <= SY_SBL_SIZE) {
+		printf("PANDORA WLAN: BHIe: firmware not usable\n");
+		return;
+	}
+	n = (uint32_t)((fs - SY_SBL_SIZE + seg - 1) / seg) + 1;   /* + vector table */
+	if (n > 16 || (uint64_t)n * 16 > 0x1000) {
+		printf("PANDORA WLAN: BHIe: too many segments %u\n", n);
+		return;
+	}
+	if (pandora_fw_read(fo + SY_SBL_SIZE, (void *)(sy_sbl_va + SY_SBL_SIZE),
+	    (vm_size_t)(fs - SY_SBL_SIZE))) {
+		printf("PANDORA WLAN: BHIe: image read failed\n");
+		return;
+	}
+	vec = (uint64_t *)(sy_sbl_va + SY_FW_BUF - 0x1000);
+	for (i = 0; i + 1 < n; i++) {
+		vec[2 * i] = iova + SY_SBL_SIZE + (uint64_t)i * seg;
+		vec[2 * i + 1] = (i + 2 == n) ? (fs - SY_SBL_SIZE - (uint64_t)i * seg) : seg;
+	}
+	/* BHIe registers are at bar0 + BHIEOFF (0x224 here), not at BHIOFF. */
+	if (!sy_bhie_off) {
+		printf("PANDORA WLAN: BHIe: bad BHIEOFF\n");
+		return;
+	}
+	{
+		uint32_t ee = 0;
+		unsigned w;
+
+		for (w = 0; w < 2000; w++) {
+			ee = sy_rd(sy_bar_va, sy_bhi_off + 0x28);
+			if (ee == 1)	/* SBL runs: the rest of the image can be sent */
+				break;
+			delay(1000);
+		}
+		printf("PANDORA WLAN: BHIe: execenv %#x after %u ms (1 = SBL)\n", ee, w);
+		if (ee != 1) {
+			printf("PANDORA WLAN: BHIe: device is not in SBL; not sending the image\n");
+			return;
+		}
+	}
+	/* The rest of the image and the vector table were written through the cached
+	 * mapping, so clean them out before the endpoint reads them. */
+	for (i = 0; i < (SY_FW_BUF >> 12); i++)
+		flush_dcache64(sy_pa(sy_sbl_va + ((vm_offset_t)i << 12)), (unsigned)PAGE_SIZE, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_wr(sy_bar_va, sy_bhie_off + 0x2c, (uint32_t)(iova + SY_FW_BUF - 0x1000));
+	sy_wr(sy_bar_va, sy_bhie_off + 0x30, 0);
+	sy_wr(sy_bar_va, sy_bhie_off + 0x34, (n - 1) * 16);
+	sy_wr(sy_bar_va, sy_bhie_off + 0x3c, 0x1234u);		/* sequence only (bits 29:0) */
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("PANDORA WLAN: BHIe: bhie %#x vec %#llx n %u segs %u size %u ee %#x addr %#x/%#x size %#x db %#x\n",
+	    sy_bhie_off, (unsigned long long)(iova + SY_FW_BUF - 0x1000), n, n - 1, (n - 1) * 16,
+	    sy_rd(sy_bar_va, sy_bhi_off + 0x28),
+	    sy_rd(sy_bar_va, sy_bhie_off + 0x2c), sy_rd(sy_bar_va, sy_bhie_off + 0x30),
+	    sy_rd(sy_bar_va, sy_bhie_off + 0x34), sy_rd(sy_bar_va, sy_bhie_off + 0x3c));
+	ts = 0;
+	for (i = 0; i < 2000; i++) {
+		ts = sy_rd(sy_bar_va, sy_bhie_off + 0x44);
+		if ((ts >> 30) == 2 || ((ts >> 30) == 3 && ts != 0xffffffffu))
+			break;
+		delay(1000);
+	}
+	printf("PANDORA WLAN: BHIe result: txvecstatus %#x code %u seq %#x after %u ms\n",
+	    ts, ts >> 30, ts & 0x3fffffffu, i);
+	if ((ts >> 30) != 2) {
+		printf("PANDORA WLAN: BHIe failed; keeping the failure for the next stage\n");
+		return;
+	}
+	{
+		uint32_t c = sy_rd(sy_bar_va, 0x38);
+		uint32_t ee;
+
+		for (i = 0; i < 2000; i++) {
+			ee = sy_rd(sy_bar_va, sy_bhi_off + 0x28);
+			if (ee == 2)	/* AMSS */
+				break;
+			delay(1000);
+		}
+		printf("PANDORA WLAN: BHIe EE after load: %#x after %u ms (2 = AMSS)\n", ee, i);
+		if (ee != 2) {
+			printf("PANDORA WLAN: BHIe: AMSS did not start; leaving MHI state untouched\n");
+			return;
+		}
+		if (sy_bhie_clear) {
+			sy_wr(sy_bar_va, sy_bhie_off + 0x3c, 0);
+			sy_wr(sy_bar_va, sy_bhie_off + 0x44, 0);
+			printf("PANDORA WLAN: BHIe doorbell/status cleared (experiment)\n");
+		}
+		if (sy_m0_mode == 1) {
+			sy_wr(sy_bar_va, 0x38, (c & ~(0xffu << 8)) | (2u << 8));
+			__asm__ volatile("dsb sy" ::: "memory");
+			printf("PANDORA WLAN: MHI M0 written immediately (mode 1)\n");
+		} else if (sy_m0_mode == 2) {
+			delay(500000);
+			c = sy_rd(sy_bar_va, 0x38);
+			sy_wr(sy_bar_va, 0x38, (c & ~(0xffu << 8)) | (2u << 8));
+			__asm__ volatile("dsb sy" ::: "memory");
+			printf("PANDORA WLAN: MHI M0 written after 500 ms (mode 2)\n");
+		} else {
+			printf("PANDORA WLAN: MHI M0 not rewritten after AMSS (mode 0); ctrl %#x status %#x\n",
+			    sy_rd(sy_bar_va, 0x38), sy_rd(sy_bar_va, 0x48));
+		}
+		sy_keep_alive = 1;
+		sy_mhi_state_trace("after-amss", 2000);
+		sy_mhi_m0_ok = (((sy_rd(sy_bar_va, 0x48) >> 8) & 0xffu) == 2);
+		printf("PANDORA WLAN: MHI M0 observe: state %u %s\n",
+		    (sy_rd(sy_bar_va, 0x48) >> 8) & 0xffu,
+		    sy_mhi_m0_ok ? "(M0)" : "(NOT M0)");
+	}
+}
+
+static void
+sy_mhi_ready(void)
+{
+	uint32_t v;
+	unsigned i;
+
+	if (!sy_bar_va) {
+		printf("PANDORA WLAN: MHI: no BAR0\n");
+		return;
+	}
+	for (i = 0; i < 200; i++) {
+		v = sy_rd(sy_bar_va, 0x38);
+		if (!(v & 0x2u))
+			break;
+		sy_usleep(25000);
+	}
+	for (i = 0; i < 200; i++) {
+		v = sy_rd(sy_bar_va, 0x48);
+		if (v & 1u)
+			break;
+		sy_usleep(25000);
+	}
+	v = sy_rd(sy_bar_va, 0x48);
+	printf("PANDORA WLAN: MHI ready poll: ctrl %#x status %#x (state %u ready %u)\n",
+	    sy_rd(sy_bar_va, 0x38), v, (v >> 8) & 0xff, v & 1);
+	if (v & 1u)
+		printf("PANDORA WLAN: MHI READY reached; M0 is set in stage 17 "
+		    "after context/mmio init (official pm.c order)\n");
+}
+
+
+/* The MHI structures and receive buffers are ordinary cached pages and the
+ * endpoint writes them without snooping. This tree has no invalidate_dcache64
+ * (caches_internal.h only declares flush_dcache64), so the device-written pages
+ * get write-combined aliases, mapped one page at a time because the buffer pages
+ * need not be physically contiguous. */
+static vm_offset_t sy_mhi_uc[0x10];
+
+static vm_offset_t
+sy_mhi_ucva(uint32_t off)
+{
+	unsigned pg = off >> 12;
+
+	if (pg >= sizeof(sy_mhi_uc) / sizeof(sy_mhi_uc[0]) || !sy_mhi_uc[pg])
+		return 0;
+	return sy_mhi_uc[pg] + (off & 0xfffu);
+}
+
+static void
+sy_mhi_map_uc(vm_offset_t pg_va)
+{
+	unsigned i;
+
+	for (i = 0; i < sizeof(sy_mhi_uc) / sizeof(sy_mhi_uc[0]); i++) {
+		if (!sy_mhi_uc[i])
+			sy_mhi_uc[i] = ml_io_map_unmappable(
+			    (vm_offset_t)sy_pa(pg_va + ((vm_offset_t)i << 12)),
+			    PAGE_SIZE, VM_WIMG_WCOMB);
+	}
+	printf("PANDORA WLAN: MHI: %u write-combined page aliases for the 0xc000-byte context/ring/buffer region\n",
+	    (unsigned)(sizeof(sy_mhi_uc) / sizeof(sy_mhi_uc[0])));
+}
+
+/* ---- M5b-1: MHI mission-mode contexts and channels ------------------------------
+ * Channel and event layout from mainline ath12k mhi.c v6.6
+ * (ath12k_mhi_config_wcn7850): 128 channels, 2 event rings; the QMI/QRTR transport
+ * is "IPCR" on channels 20 (UL) and 21 (DL), both on event ring 1; LOOPBACK uses
+ * channels 0/1 on event ring 0. Context records are 44 (0x2c) bytes, ring elements
+ * 16 bytes. Rings and buffers live in the already mapped window at IOVA 0xb07c0000. */
+#define SY_MHI_CH_CTX	0x0000u
+#define SY_MHI_EV_CTX	0x1700u
+#define SY_MHI_CMD_CTX	0x1800u
+#define SY_MHI_ER0	0x1900u
+#define SY_MHI_ER0_LEN	512u
+#define SY_MHI_ER1	0x1b00u
+#define SY_MHI_ER1_LEN	4096u
+#define SY_MHI_CMD_R	0x2b00u
+#define SY_MHI_CMD_LEN	2048u
+#define SY_MHI_CH0_R	0x3300u
+#define SY_MHI_CH1_R	0x3500u
+#define SY_MHI_CH20_R	0x3700u
+#define SY_MHI_CH21_R	0x3b00u
+#define SY_MHI_DL_BUF	0x4000u
+#define SY_DMA_TO_DEV	1u
+#define SY_DMA_FROM_DEV	2u
+#define SY_MHI_DL_NBUF	8
+
+static const struct sy_mhi_chan_desc {
+	uint32_t num, els, er, dir, ring;
+} sy_mhi_desc[] = {
+	{ 0, 32, 0, SY_DMA_TO_DEV, SY_MHI_CH0_R },
+	{ 1, 32, 0, SY_DMA_FROM_DEV, SY_MHI_CH1_R },
+	{ 20, 64, 1, SY_DMA_TO_DEV, SY_MHI_CH20_R },
+	{ 21, 64, 1, SY_DMA_FROM_DEV, SY_MHI_CH21_R },
+};
+
+/* MHISTATE = M0 in MHICTRL[15:8]. Poll MHISTATUS[15:8] up to 200 ms. */
+static void
+sy_mhi_set_m0(const char *when)
+{
+	uint32_t c, st;
+	unsigned i;
+
+	if (!sy_bar_va)
+		return;
+	c = sy_rd(sy_bar_va, 0x38);
+	sy_wr(sy_bar_va, 0x38, (c & ~(0xffu << 8)) | (2u << 8));
+	__asm__ volatile("dsb sy" ::: "memory");
+	st = 0;
+	for (i = 0; i < 200; i++) {
+		st = sy_rd(sy_bar_va, 0x48);
+		if (((st >> 8) & 0xffu) == 2)
+			break;
+		delay(1000);	/* 1 ms */
+	}
+	printf("PANDORA WLAN: MHI M0 %s: ctrl %#x -> %#x status %#x state %u after %u ms\n",
+	    when, c, sy_rd(sy_bar_va, 0x38), st, (st >> 8) & 0xffu, i);
+	sy_log_sync();
+}
+
+static void
+sy_mhi_init(void)
+{
+	vm_offset_t pg_va, c;
+	uint64_t pg, rbase;
+	uint32_t cfg, i, erdb;
+
+	if (!sy_bar_va || !sy_sbl_va || sy_buf_size < 0x800000) {
+		printf("PANDORA WLAN: MHI init: buffer too small/absent (%#x)\n", sy_buf_size);
+		return;
+	}
+	(void)sy_mem_setup();
+	pg_va = sy_sbl_va + 0x7C0000;
+	pg = SY_IOVA_MAP + 0x7C0000;
+	sy_mhi_map_uc(pg_va);
+	memset((void *)pg_va, 0, 0xc000);
+
+	/* channel contexts: index = channel number, 44 bytes each */
+	for (i = 0; i < sizeof(sy_mhi_desc) / sizeof(sy_mhi_desc[0]); i++) {
+		const struct sy_mhi_chan_desc *d = &sy_mhi_desc[i];
+		uint32_t rlen = d->els * 16u;
+
+		rbase = pg + d->ring;
+		c = pg_va + SY_MHI_CH_CTX + d->num * 0x2cu;
+		sy_wr(c, 0x00, (2u << 8) | 1u);	/* chcfg: enabled, MHI_DB_BRST_DISABLE */
+		sy_wr(c, 0x04, d->dir);			/* chtype = direction */
+		sy_wr(c, 0x08, d->er);			/* event ring index */
+		sy_wr(c, 0x0c, (uint32_t)rbase);
+		sy_wr(c, 0x10, (uint32_t)(rbase >> 32));
+		sy_wr(c, 0x14, rlen);			/* rlen low */
+		sy_wr(c, 0x18, 0);
+		sy_wr(c, 0x1c, (uint32_t)rbase);	/* rp */
+		sy_wr(c, 0x20, (uint32_t)(rbase >> 32));
+		sy_wr(c, 0x24, (uint32_t)rbase);	/* wp */
+		sy_wr(c, 0x28, (uint32_t)(rbase >> 32));
+	}
+	/* event contexts: ring 0 = 32 elements/irq 1, ring 1 = 256/irq 2, 1 ms */
+	{
+		static const uint32_t el[2] = { 32, 256 };
+		static const uint32_t irq[2] = { 1, 2 };
+		static const uint32_t rlen[2] = { SY_MHI_ER0_LEN, SY_MHI_ER1_LEN };
+		static const uint32_t roff[2] = { SY_MHI_ER0, SY_MHI_ER1 };
+
+		for (i = 0; i < 2; i++) {
+			rbase = pg + roff[i];
+			c = pg_va + SY_MHI_EV_CTX + i * 0x2cu;
+			sy_wr(c, 0x00, i ? (1u << 16) : 0);	/* intmod ms */
+			sy_wr(c, 0x04, 1);			/* ertype valid */
+			sy_wr(c, 0x08, irq[i]);			/* msivec */
+			sy_wr(c, 0x0c, (uint32_t)rbase);
+			sy_wr(c, 0x10, (uint32_t)(rbase >> 32));
+			sy_wr(c, 0x14, rlen[i]);
+			sy_wr(c, 0x18, 0);
+			sy_wr(c, 0x1c, (uint32_t)rbase);		/* rp */
+			sy_wr(c, 0x20, (uint32_t)(rbase >> 32));
+			sy_wr(c, 0x24, (uint32_t)(rbase + rlen[i] - 16u));	/* wp: one slot reserved */
+			sy_wr(c, 0x28, (uint32_t)((rbase + rlen[i] - 16u) >> 32));
+			(void)el;
+		}
+	}
+	/* command ring context */
+	rbase = pg + SY_MHI_CMD_R;
+	c = pg_va + SY_MHI_CMD_CTX;
+	sy_wr(c, 0x00, 0); sy_wr(c, 0x04, 0); sy_wr(c, 0x08, 0);
+	sy_wr(c, 0x0c, (uint32_t)rbase); sy_wr(c, 0x10, (uint32_t)(rbase >> 32));
+	sy_wr(c, 0x14, SY_MHI_CMD_LEN); sy_wr(c, 0x18, 0);
+	sy_wr(c, 0x1c, (uint32_t)rbase); sy_wr(c, 0x20, (uint32_t)(rbase >> 32));
+	sy_wr(c, 0x24, (uint32_t)rbase); sy_wr(c, 0x28, (uint32_t)(rbase >> 32));
+	for (i = 0; i < 12; i++)	/* contexts and rings: 0x7c0000..0x7cc000 */
+		flush_dcache64(sy_pa(pg_va + ((vm_offset_t)i << 12)), (unsigned)PAGE_SIZE, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	sy_wr(sy_bar_va, 0x5c, (uint32_t)(pg >> 32)); sy_wr(sy_bar_va, 0x58, (uint32_t)pg);
+	sy_wr(sy_bar_va, 0x64, (uint32_t)((pg + SY_MHI_EV_CTX) >> 32));
+	sy_wr(sy_bar_va, 0x60, (uint32_t)(pg + SY_MHI_EV_CTX));
+	sy_wr(sy_bar_va, 0x6c, (uint32_t)((pg + SY_MHI_CMD_CTX) >> 32));
+	sy_wr(sy_bar_va, 0x68, (uint32_t)(pg + SY_MHI_CMD_CTX));
+	/* with S1 translation the control/data windows must be the mapped IOVA range */
+	sy_wr(sy_bar_va, 0x84, 0u);
+	sy_wr(sy_bar_va, 0x80, 0u);
+	sy_wr(sy_bar_va, 0x9c, 0u);
+	sy_wr(sy_bar_va, 0x98, 0u);
+	sy_wr(sy_bar_va, 0x8c, 0u);
+	sy_wr(sy_bar_va, 0x88, 0xffffffffu);
+	sy_wr(sy_bar_va, 0xa4, 0u);
+	sy_wr(sy_bar_va, 0xa0, 0xffffffffu);
+	cfg = sy_rd(sy_bar_va, 0x10);
+	cfg &= ~((0xffu << 16) | (0xffu << 24));
+	cfg |= (2u << 16);			/* NER = 2, NHWER = 0 */
+	sy_wr(sy_bar_va, 0x10, cfg);
+	/* Linux pm.c:239-251 and sheng WifiProbe.cpp:460-478 publish
+	 * wp = base+len-16 and ring ERDB with that address before M0.
+	 * ioslog_k7 left wp at the ring base and skipped the doorbell;
+	 * the M0 poll then read MHISTATUS 0xff05, state 255. */
+	erdb = sy_rd(sy_bar_va, 0x20) & 0xffffu;
+	if (erdb && erdb + 16 <= 0x1000) {
+		uint64_t e0 = pg + SY_MHI_ER0 + SY_MHI_ER0_LEN - 16u;
+		uint64_t e1 = pg + SY_MHI_ER1 + SY_MHI_ER1_LEN - 16u;
+
+		sy_wr(sy_bar_va, erdb, (uint32_t)e0); sy_wr(sy_bar_va, erdb + 4, (uint32_t)(e0 >> 32));
+		sy_wr(sy_bar_va, erdb + 8, (uint32_t)e1); sy_wr(sy_bar_va, erdb + 12, (uint32_t)(e1 >> 32));
+		printf("PANDORA WLAN: MHI ERDB %#x wp0 %#llx wp1 %#llx (songyuan_erdb=%d)\n",
+		    erdb, (unsigned long long)e0, (unsigned long long)e1, sy_erdb_init);
+	} else {
+		printf("PANDORA WLAN: MHI ERDB offset %#x not usable\n", erdb);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("PANDORA WLAN: MHI ctx: iova %#llx ch[%u %u %u %u] ev[%u %u] "
+	    "er0 %#llx er1 %#llx cmd %#llx chdb %#x erdb %#x\n",
+	    (unsigned long long)pg, sy_mhi_desc[0].num, sy_mhi_desc[1].num,
+	    sy_mhi_desc[2].num, sy_mhi_desc[3].num, 32u, 256u,
+	    (unsigned long long)(pg + SY_MHI_ER0), (unsigned long long)(pg + SY_MHI_ER1),
+	    (unsigned long long)(pg + SY_MHI_CMD_R), sy_rd(sy_bar_va, 0x18) & 0xffffu, erdb);
+	/* Linux mhi_ready_state_transition() writes M0 here, before
+	 * mhi_download_amss_image(). ioslog_k6 left MHICTRL at 0; 50 ms after
+	 * EXECENV became AMSS the device raised SYS_ERR and EXECENV 3 (RDDM). */
+	sy_mhi_set_m0("before BHIe");
+	printf("PANDORA WLAN: MHI init done (contexts + channels; M0 before BHIe)\n");
+}
+
+/* START channels 20 and 21 before any channel doorbell. Linux
+ * mhi_prepare_channel (ref_mhi_main.c:1433-1455) sends MHI_CMD_START_CHAN
+ * and waits for completion code 1. The phone QRTR client
+ * (q_net_qrtr_mhi.c:109-136) prepares IPCR before queueing DL buffers.
+ * ioslog_k9 rang CHDB for channels 1 and 21 with no START; 32 ms later
+ * ring 0 posted state 255. Channel 1 is LOOPBACK and is not doorbell'd. */
+static void
+sy_mhi_chan_start(void)
+{
+	vm_offset_t pg_va, c;
+	uint64_t pg, buf, tre;
+	uint32_t chdb, i, n, dl;
+
+	if (!sy_bar_va || !sy_sbl_va) {
+		printf("PANDORA WLAN: MHI chan: no BAR0/buffer\n");
+		return;
+	}
+	chdb = sy_rd(sy_bar_va, 0x18) & 0xffffu;
+	if (!chdb || chdb + 8 * 128 > 0x1000) {
+		printf("PANDORA WLAN: MHI chan: bad CHDBOFF %#x\n", chdb);
+		return;
+	}
+	pg_va = sy_sbl_va + 0x7C0000;
+	pg = SY_IOVA_MAP + 0x7C0000;
+	if (!sy_mhi_ipcr_start()) {
+		printf("PANDORA WLAN: MHI chan: START failed, no CHDB\n");
+		sy_log_sync();
+		return;
+	}
+	for (i = 0, dl = 0; i < sizeof(sy_mhi_desc) / sizeof(sy_mhi_desc[0]); i++) {
+		const struct sy_mhi_chan_desc *d = &sy_mhi_desc[i];
+		uint32_t ring = d->ring;
+		uint64_t wp;
+
+		if (d->num != 21)
+			continue;			/* only IPCR DL; not LOOPBACK ch 1 */
+		for (n = 0; n < SY_MHI_DL_NBUF; n++) {
+			buf = pg + SY_MHI_DL_BUF + ((uint64_t)(dl * SY_MHI_DL_NBUF + n) << 11);
+			tre = pg_va + ring + (n << 4);
+			sy_wr(tre, 0, (uint32_t)buf);
+			sy_wr(tre, 4, (uint32_t)(buf >> 32));
+			sy_wr(tre, 8, 0x800u);		/* dword0: length */
+			sy_wr(tre, 12, (2u << 16) | (1u << 9));	/* xfer, MHI_EOT */
+		}
+		wp = pg + ring + ((uint64_t)SY_MHI_DL_NBUF << 4);
+		c = pg_va + SY_MHI_CH_CTX + d->num * 0x2cu;
+		sy_wr(c, 0x24, (uint32_t)wp); sy_wr(c, 0x28, (uint32_t)(wp >> 32));
+		for (n = 0; n < 2; n++)
+			flush_dcache64(sy_pa(pg_va + ring + (n << 12)), (unsigned)PAGE_SIZE, TRUE);
+		flush_dcache64(sy_pa(pg_va + SY_MHI_CH_CTX + d->num * 0x2cu), (unsigned)PAGE_SIZE, TRUE);
+		__asm__ volatile("dsb sy" ::: "memory");
+		sy_wr(sy_bar_va, chdb + 8 * d->num, (uint32_t)wp);
+		sy_wr(sy_bar_va, chdb + 8 * d->num + 4, (uint32_t)(wp >> 32));
+		printf("PANDORA WLAN: MHI chan %u DL: %u buffers, wp %#llx, doorbell %#x\n",
+		    d->num, SY_MHI_DL_NBUF, (unsigned long long)wp, chdb + 8 * d->num);
+		dl++;
+	}
+	sy_mhi_dl_posted = SY_MHI_DL_NBUF;
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_log_sync();
+}
+
+/* Poll event ring 1 (IPCR and data) and print what the device sends, including the
+ * QRTR header of channel 21 transfers, so the QMI handshake can be built from real
+ * traffic instead of guesses. */
+/* The endpoint updates the event context's *rp* field with its producer index.
+ * The host's published *wp* is a credit, not the host read index: it starts at
+ * base+len-16 and advances one element per consumed event
+ * (mhi_recycle_ev_ring_element). After a batch the host rings ERDB with that wp.
+ * A transfer event's ptr names the TRE in the channel ring, not the data buffer;
+ * the buffer address is inside that TRE. */
+static uint32_t sy_mhi_hi[2];	/* host element index per event ring */
+/* Published event-ring wp. Starts at len-16 (sy_mhi_init) and advances one
+ * element per consumed event, wrapping to 0. Linux mhi_recycle_ev_ring_element
+ * (ref_mhi_main.c:557-563). Publishing wp == the device rp leaves no slot. */
+static uint32_t sy_mhi_wp_off[2] = {
+	SY_MHI_ER0_LEN - 16u, SY_MHI_ER1_LEN - 16u
+};
+/* Command ring cursor. sy_mhi_init leaves the command wp at the ring base and
+ * is called once, so this starts at 0. MHI_CMD_START_CHAN is 0x12
+ * (ref_mhi_common.h:137-142). Completion code 1 is MHI_EV_CC_SUCCESS. */
+static uint32_t sy_mhi_cmd_hi;
+static uint32_t sy_mhi_cmd_wait_ch = 0xffffffffu;
+static uint64_t sy_mhi_cmd_wait_tre;
+static int sy_mhi_cmd_code;
+static int sy_mhi_ipcr_ok;
+
+static void
+sy_mhi_ev_walk(unsigned idx, unsigned *shown)
+{
+	static const uint32_t roff[2] = { SY_MHI_ER0, SY_MHI_ER1 };
+	static const uint32_t rlen[2] = { SY_MHI_ER0_LEN, SY_MHI_ER1_LEN };
+	vm_offset_t evc;
+	uint64_t pg, base;
+	uint32_t dev, hi, erdb, n;
+
+	if (idx > 1)
+		return;
+	pg = SY_IOVA_MAP + 0x7C0000;
+	base = pg + roff[idx];
+	evc = sy_sbl_va + 0x7C0000 + SY_MHI_EV_CTX + idx * 0x2cu;
+	erdb = sy_rd(sy_bar_va, 0x20) & 0xffffu;
+	{
+		vm_offset_t u = sy_mhi_ucva(SY_MHI_EV_CTX + idx * 0x2c + 0x1c);
+
+		dev = u ? sy_rd(u, 0) : (uint32_t)base;
+	}
+	if (dev < (uint32_t)base || dev >= (uint32_t)(base + rlen[idx]))
+		return;
+	hi = sy_mhi_hi[idx];
+	for (n = 0; n < rlen[idx] / 16 && (uint32_t)(base + hi) != dev; n++) {
+		vm_offset_t e = sy_mhi_ucva(roff[idx] + hi);
+		uint64_t ptr;
+		uint32_t d0, d1, type;
+
+		if (!e)
+			break;
+		ptr = (uint64_t)sy_rd(e, 0) | ((uint64_t)sy_rd(e, 4) << 32);
+		d0 = sy_rd(e, 8); d1 = sy_rd(e, 12);
+		type = (d1 >> 16) & 0xffu;
+		if (type == 0x21) {		/* command completion; not under the print cap */
+			uint32_t ch = d1 >> 24, code = d0 >> 24;
+
+			printf("PANDORA WLAN: MHI cmd completion ch %u code %u tre %#llx\n",
+			    ch, code, (unsigned long long)ptr);
+			if (sy_mhi_cmd_code < 0 && ch == sy_mhi_cmd_wait_ch &&
+			    ptr == sy_mhi_cmd_wait_tre)
+				sy_mhi_cmd_code = (int)code;
+		} else if (*shown < 24) {
+			if (type == 2) {		/* transfer event */
+				uint32_t ch = d1 >> 24, code = d0 >> 24, len = d0 & 0xffffu;
+
+				printf("PANDORA WLAN: MHI xfer ev: ch %u code %u len %u tre %#llx\n",
+				    ch, code, len, (unsigned long long)ptr);
+				if (code == 2 && ch < 128) {
+					unsigned di;
+
+					for (di = 0; di < sizeof(sy_mhi_desc) / sizeof(sy_mhi_desc[0]); di++) {
+						const struct sy_mhi_chan_desc *d = &sy_mhi_desc[di];
+						uint32_t troff;
+						vm_offset_t t;
+						uint64_t buf;
+						uint32_t plen = len ? len : 0x800u;
+
+						if (d->num != ch || d->dir != SY_DMA_FROM_DEV)
+							continue;
+						if (ptr < pg + d->ring || ptr >= pg + d->ring + d->els * 16u)
+							break;
+						troff = (uint32_t)(ptr - (pg + d->ring));
+						t = sy_mhi_ucva(d->ring + troff);
+						if (!t)
+							break;
+						buf = (uint64_t)sy_rd(t, 0) | ((uint64_t)sy_rd(t, 4) << 32);
+						if (buf < SY_IOVA_MAP || buf + 64 > SY_IOVA_MAP + SY_FW_BUF)
+							break;
+						{
+							uint32_t poff = (uint32_t)(buf - SY_IOVA_MAP);
+							vm_offset_t va = sy_mhi_ucva(poff);
+							uint32_t *q;
+
+							if (!va)
+								va = sy_sbl_va + (vm_offset_t)poff;
+							q = (uint32_t *)va;
+							if (sy_wlfw_on && len >= 32)
+								sy_wlfw_rx((const uint8_t *)va, len);
+							printf("PANDORA WLAN: ch %u rx %u B from %#llx: "
+							    "qrtr ver %#x size %u src %u/%u dst %u/%u "
+							    "first %#x %#x %#x %#x\n",
+							    ch, plen, (unsigned long long)buf,
+							    sy_rd(va, 0), sy_rd(va, 16), sy_rd(va, 4), sy_rd(va, 8),
+							    sy_rd(va, 20), sy_rd(va, 24), q[7], q[8], q[9], q[10]);
+						}
+						break;
+					}
+				}
+			} else if (type == 0x20) {	/* state change */
+				printf("PANDORA WLAN: MHI state ev: %u\n", d0 >> 24);
+			} else if (type == 0x40) {	/* EE event */
+				printf("PANDORA WLAN: MHI EE ev: %u\n", d0 >> 24);
+			} else {
+				printf("PANDORA WLAN: MHI ev type %#x d0 %#x d1 %#x\n", type, d0, d1);
+			}
+			(*shown)++;
+		}
+		hi += 16;
+		if (hi >= rlen[idx])
+			hi = 0;
+		sy_mhi_hi[idx] = hi;
+		sy_mhi_wp_off[idx] += 16u;
+		if (sy_mhi_wp_off[idx] >= rlen[idx])
+			sy_mhi_wp_off[idx] = 0;
+		sy_wr(evc, 0x24, (uint32_t)(base + sy_mhi_wp_off[idx]));
+		sy_wr(evc, 0x28, (uint32_t)((base + sy_mhi_wp_off[idx]) >> 32));
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	flush_dcache64(sy_pa(evc), (unsigned)PAGE_SIZE, TRUE);
+	if (n && erdb && erdb + 16 <= 0x1000) {
+		uint64_t wp = base + sy_mhi_wp_off[idx];
+
+		sy_wr(sy_bar_va, erdb + 8 * idx, (uint32_t)wp);
+		sy_wr(sy_bar_va, erdb + 8 * idx + 4, (uint32_t)(wp >> 32));
+		printf("PANDORA WLAN: MHI ERDB recycle ring %u dev %#x wp %#llx\n",
+		    idx, dev, (unsigned long long)wp);
+	}
+}
+
+/* One MHI_CMD_START_CHAN (0x12) on the primary command ring, then CRDB
+ * at BAR+0x70. ref_mhi_main.c:1294-1308 writes the TRE; :124-132 rings
+ * the doorbell with the command-context wp. Timeout is ath12k's 2000 ms. */
+static int
+sy_mhi_cmd_start(uint32_t chan)
+{
+	vm_offset_t pg_va, tre, ctx;
+	uint64_t pg, tre_iova, wp;
+	uint32_t i, els;
+
+	if (!sy_bar_va || !sy_sbl_va)
+		return 0;
+	pg_va = sy_sbl_va + 0x7C0000;
+	pg = SY_IOVA_MAP + 0x7C0000;
+	els = SY_MHI_CMD_LEN / 16u;
+	tre_iova = pg + SY_MHI_CMD_R + (uint64_t)sy_mhi_cmd_hi * 16u;
+	tre = pg_va + SY_MHI_CMD_R + (vm_offset_t)sy_mhi_cmd_hi * 16u;
+	sy_wr(tre, 0, 0);
+	sy_wr(tre, 4, 0);
+	sy_wr(tre, 8, 0);
+	sy_wr(tre, 12, (chan << 24) | (0x12u << 16));
+	sy_mhi_cmd_hi = (sy_mhi_cmd_hi + 1u) % els;
+	wp = pg + SY_MHI_CMD_R + (uint64_t)sy_mhi_cmd_hi * 16u;
+	ctx = pg_va + SY_MHI_CMD_CTX;
+	sy_wr(ctx, 0x24, (uint32_t)wp);
+	sy_wr(ctx, 0x28, (uint32_t)(wp >> 32));
+	flush_dcache64(sy_pa(tre & ~(vm_offset_t)(PAGE_SIZE - 1)), (unsigned)PAGE_SIZE, TRUE);
+	flush_dcache64(sy_pa(ctx), (unsigned)PAGE_SIZE, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_mhi_cmd_wait_ch = chan;
+	sy_mhi_cmd_wait_tre = tre_iova;
+	sy_mhi_cmd_code = -1;
+	sy_wr(sy_bar_va, 0x70, (uint32_t)wp);
+	sy_wr(sy_bar_va, 0x74, (uint32_t)(wp >> 32));
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (i = 0; i < 2000 && sy_mhi_cmd_code < 0; i++) {
+		unsigned shown = 0;
+		uint32_t st = sy_rd(sy_bar_va, 0x48);
+
+		sy_mhi_ev_walk(0, &shown);
+		sy_mhi_ev_walk(1, &shown);
+		if (((st >> 8) & 0xffu) == 255)
+			break;
+		if (sy_mhi_cmd_code < 0)
+			delay(1000);
+	}
+	printf("PANDORA WLAN: MHI START ch %u code %d after %u ms status %#x\n",
+	    chan, sy_mhi_cmd_code, i, sy_rd(sy_bar_va, 0x48));
+	sy_mhi_cmd_wait_ch = 0xffffffffu;
+	sy_mhi_cmd_wait_tre = 0;
+	sy_log_sync();
+	return sy_mhi_cmd_code == 1;
+}
+
+static int
+sy_mhi_ipcr_start(void)
+{
+	if (!sy_mhi_cmd_start(20))
+		return 0;
+	if (!sy_mhi_cmd_start(21))
+		return 0;
+	sy_mhi_ipcr_ok = 1;
+	return 1;
+}
+
+static void
+sy_mhi_poll(void)
+{
+	uint32_t k, erdb, chdb;
+	unsigned shown = 0;
+
+	if (!sy_bar_va || !sy_sbl_va) {
+		printf("PANDORA WLAN: MHI poll: no BAR0/buffer\n");
+		return;
+	}
+	erdb = sy_rd(sy_bar_va, 0x20) & 0xffffu;
+	chdb = sy_rd(sy_bar_va, 0x18) & 0xffffu;
+	for (k = 0; k < 5000; k++) {
+		sy_mhi_ev_walk(0, &shown);
+		sy_mhi_ev_walk(1, &shown);
+		if (k % 1000 == 999)
+			printf("PANDORA WLAN: MHI poll %u ms: state %u ee %#x events %u\n",
+			    (k + 1), (sy_rd(sy_bar_va, 0x48) >> 8) & 0xff,
+			    sy_rd(sy_bar_va, sy_bhi_off + 0x28), shown);
+		delay(1000);
+	}
+	printf("PANDORA WLAN: MHI poll done: %u events, chdb %#x erdb %#x\n",
+	    shown, chdb, erdb);
+	sy_log_sync();
+}
