+extern int pandora_mkdir(const char *path, int mode);   /* bsd/vfs/vfs_syscalls.c (0185) */
+
+/* True when the path exists. The cache volume's HFS root carries .journal and .journal_info_block,
+ * which is also how cv_seed_skeleton() proves the mount landed before it writes anything. */
+static int
+cv_exists(const char *path)
+{
+	vnode_t vp = NULLVP;
+
+	if (vnode_open(path, FREAD, 0, 0, &vp, vfs_context_kernel()) != 0) {
+		return 0;
+	}
+	(void)vnode_close(vp, FREAD, vfs_context_kernel());
+	return 1;
+}
+
+static void
+cv_seed_skeleton(void)
+{
+	int on = 1;
+	unsigned made = 0, same = 0, failed = 0;
+
+	(void)PE_parse_boot_argn("pandora_varcache", &on, sizeof(on));
+	if (!on) {
+		printf("PANDORA CACHE: pandora_varcache=0, skeleton not seeded\n");
+		return;
+	}
+	if (!cv_exists(CV_MOUNT "/.journal_info_block")) {
+		printf("PANDORA CACHE: no cache volume on " CV_MOUNT ", skeleton not seeded\n");
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(cv_skeleton) / sizeof(cv_skeleton[0]); i++) {
+		int error = pandora_mkdir(cv_skeleton[i], 0755);
+		if (error == 0) {
+			made++;
+		} else if (error == EEXIST) {
+			same++;
+		} else {
+			failed++;
+			printf("PANDORA CACHE: skeleton %s: %d\n", cv_skeleton[i], error);
+		}
+	}
+	printf("PANDORA CACHE: skeleton %u made, %u existing, %u failed\n", made, same, failed);
+}
 
