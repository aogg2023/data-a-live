+static int
+cv_prefs_write(const char *path, const uint8_t *data, size_t len)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	int error, resid = 0;
+
+	error = vnode_lookup(path, 0, &vp, ctx);
+	if (error != 0) {
+		return error;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)data, (int)len, 0, UIO_SYSSPACE, IO_SYNC,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	if (error == 0 && resid != 0) {
+		error = EIO;
+	}
+	if (error == 0) {
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_data_size, (off_t)len);
+		VATTR_SET(&va, va_uid, 501);
+		VATTR_SET(&va, va_gid, 501);
+		VATTR_SET(&va, va_mode, S_IFREG | 0644);
+		error = vnode_setattr(vp, &va, ctx);
+	}
+	vnode_put(vp);
+	return error;
+}
