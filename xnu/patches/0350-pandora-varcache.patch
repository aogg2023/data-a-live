+/* ---- RPMh: command database and one TCS of apps RSC DRV-2 ---------------------- */
+
+struct sy_cmddb_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct sy_cmddb_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct sy_cmddb_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct sy_cmddb_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+#define RSC_TCS_BASE	(0x0d00UL + 2UL * 0x02a0UL)	/* set 2, rpmh-rsc v3 layout */
+#define TCS_WAIT	(RSC_TCS_BASE + 0x20UL)
+#define TCS_CONTROL	(RSC_TCS_BASE + 0x24UL)
+#define TCS_STATUS	(RSC_TCS_BASE + 0x28UL)
+#define TCS_ENABLE	(RSC_TCS_BASE + 0x2cUL)
+#define TCS_MSGID(n)	(RSC_TCS_BASE + 0x34UL + 24UL * (n))
+#define TCS_ADDR(n)	(TCS_MSGID(n) + 4UL)
+#define TCS_DATA(n)	(TCS_MSGID(n) + 8UL)
+#define TCS_BIT		(1UL << 2)
+#define RSC_IRQ_EN	0x0d00UL
+#define RSC_IRQ_STATUS	0x0d04UL
+#define RSC_IRQ_CLEAR	0x0d08UL
+#define TCS_CONTROL_ENABLE (1UL << 16)
+#define TCS_CONTROL_TRIGGER (1UL << 24)
+#define MSGID_WRITE_RESPONSE 0x10108UL
+#define VRM_VOLTAGE	0UL
+#define VRM_ENABLE	4UL
+#define VRM_MODE	8UL
+#define VRM_MODE_LDO_HPM 7UL
+#define VRM_CLOCK_ENABLE 4UL
+#define CMD_DB_VRM	4UL
+
+static uint32_t
+sy_rpmh_address(const char *name)
+{
+	const struct sy_cmddb_header *db = (const struct sy_cmddb_header *)cmddb;
+	char id[8] = { 0 };
+
+	if (db->magic[0] != 0xdb || db->magic[1] != 0x30 || db->magic[2] != 0x03 ||
+	    db->magic[3] != 0x0c) {
+		printf("PANDORA WLAN: command database magic is %02x%02x%02x%02x\n",
+		    db->magic[3], db->magic[2], db->magic[1], db->magic[0]);
+		return 0;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct sy_cmddb_slave *slave = &db->slave[s];
+		const struct sy_cmddb_entry *entry;
+
+		if (slave->id == 0 || slave->header_offset >= SY_CMDDB_SIZE - 0x1000 ||
+		    slave->count > 512) {
+			continue;
+		}
+		entry = (const struct sy_cmddb_entry *)(db->data + slave->header_offset);
+		for (unsigned i = 0; i < slave->count; i++) {
+			if (memcmp(entry[i].id, id, sizeof(id)) == 0) {
+				return entry[i].address;
+			}
+		}
+	}
+	return 0;
+}
+
+static uint32_t
+sy_rpmh_vrm(const char *name)
+{
+	static char lower[9], upper[9];
+	uint32_t addr = sy_rpmh_address(name);
+
+	if (addr != 0) {
+		return addr;
+	}
+	for (unsigned i = 0; i < 8 && name[i]; i++) {
+		char c = name[i];
+		lower[i] = (c >= 'A' && c <= 'Z') ? (char)(c - 'A' + 'a') : c;
+		upper[i] = (c >= 'a' && c <= 'z') ? (char)(c - 'a' + 'A') : c;
+	}
+	lower[8] = upper[8] = 0;
+	addr = sy_rpmh_address(lower);
+	if (addr == 0) {
+		addr = sy_rpmh_address(upper);
+	}
+	return addr;
+}
+
+static bool
+sy_rpmh_write(const uint32_t *address, const uint32_t *data, unsigned count)
+{
+	uint32_t mask = (1UL << count) - 1;
+
+	if (sy_rd(rsc, TCS_STATUS) == 0 || (sy_rd(rsc, TCS_CONTROL) & TCS_CONTROL_TRIGGER) != 0) {
+		printf("PANDORA WLAN: RPMh set 2 busy (status %#x control %#x)\n",
+		    sy_rd(rsc, TCS_STATUS), sy_rd(rsc, TCS_CONTROL));
+		return false;
+	}
+	sy_wr(rsc, TCS_CONTROL, 0);
+	sy_wr(rsc, RSC_IRQ_CLEAR, TCS_BIT);
+	for (unsigned i = 0; i < count; i++) {
+		sy_wr(rsc, TCS_MSGID(i), MSGID_WRITE_RESPONSE);
+		sy_wr(rsc, TCS_ADDR(i), address[i]);
+		sy_wr(rsc, TCS_DATA(i), data[i]);
+	}
+	sy_wr(rsc, TCS_WAIT, mask);
+	sy_wr(rsc, TCS_ENABLE, mask);
+	sy_wr(rsc, RSC_IRQ_EN, sy_rd(rsc, RSC_IRQ_EN) | TCS_BIT);
+	sy_wr(rsc, TCS_CONTROL, TCS_CONTROL_ENABLE);
+	sy_wr(rsc, TCS_CONTROL, TCS_CONTROL_ENABLE | TCS_CONTROL_TRIGGER);
+	bool done = sy_poll(rsc, RSC_IRQ_STATUS, TCS_BIT, TCS_BIT, 100, 200000, "the RPMh completion");
+	sy_wr(rsc, TCS_CONTROL, 0);
+	sy_wr(rsc, TCS_ENABLE, 0);
+	sy_wr(rsc, TCS_WAIT, 0);
+	sy_wr(rsc, RSC_IRQ_CLEAR, TCS_BIT);
+	sy_wr(rsc, RSC_IRQ_EN, sy_rd(rsc, RSC_IRQ_EN) & ~TCS_BIT);
+	return done;
+}
