+/* Map a second IOVA window (32 MiB) to the provisioned buffer and remember it for
+ * respond_mem. Called once, after the stage-1 tables exist. */
+static int
+sy_mem_setup(void)
+{
+	unsigned i;
+	uint64_t pa;
+	kern_return_t kr;
+
+	if (sy_mem_va)
+		return 0;
+	if (!sy_l2 || !sy_l3) {
+		printf("PANDORA WLAN: MEM: page tables absent\n");
+		return 1;
+	}
+	kr = kmem_alloc(kernel_map, &sy_mem_va, SY_MEM_SIZE,
+	    KMA_DATA | KMA_ZERO | KMA_NOPAGEWAIT, VM_KERN_MEMORY_IOKIT);
+	if (kr != KERN_SUCCESS) {
+		printf("PANDORA WLAN: MEM: 32 MiB buffer allocation failed %d\n", kr);
+		sy_mem_va = 0;
+		return 1;
+	}
+	kr = kmem_alloc(kernel_map, &sy_mem_l3, 0x10000,
+	    KMA_DATA | KMA_ZERO | KMA_NOPAGEWAIT, VM_KERN_MEMORY_IOKIT);
+	if (kr != KERN_SUCCESS) {
+		printf("PANDORA WLAN: MEM: L3 tables allocation failed %d\n", kr);
+		return 1;
+	}
+	for (i = 0; i < (SY_MEM_SIZE >> 21); i++)
+		((uint64_t *)sy_l2)[(((SY_MEM_IOVA >> 21) + i) & 511)] =
+		    sy_pa(sy_mem_l3 + ((vm_offset_t)i << 12)) | 3ull;
+	for (i = 0; i < (SY_MEM_SIZE >> 12); i++) {
+		pa = sy_pa(sy_mem_va + ((vm_offset_t)i << 12));
+		((uint64_t *)(sy_mem_l3 + (((vm_offset_t)i >> 9) << 12)))[i & 0x1ff] =
+		    (pa & 0x0000fffffffff000ull) | 0x0060000000000e43ull;
+	}
+	for (i = 0; i < 16; i++)
+		flush_dcache64(sy_pa(sy_mem_l3 + ((vm_offset_t)i << 12)),
+		    (unsigned)PAGE_SIZE, TRUE);
+	flush_dcache64(sy_pa(sy_l2), (unsigned)PAGE_SIZE, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("PANDORA WLAN: MEM: %u MiB at iova %#x (va %#lx l3 %#lx)\n",
+	    SY_MEM_SIZE >> 20, (unsigned)SY_MEM_IOVA, (unsigned long)sy_mem_va,
+	    (unsigned long)sy_mem_l3);
+	sy_log_sync();
+	return 0;
+}
+
+/* ---- M5a: QMI / QRTR / WLFW framing ---------------------------------------------
+ * Wire formats from the official sources now stored locally:
+ *  - QRTR v1 header (net/qrtr/af_qrtr.c): version, type, src_node, src_port,
+ *    confirm_rx, size, dst_node, dst_port - eight little-endian u32, 32 bytes;
+ *    type values and QRTR_PROTO_VER_1=1 from include/uapi/linux/qrtr.h.
+ *  - QMI header: type(1), transaction(2 LE), message id(2 LE), length(2 LE).
+ *  - WLFW message ids and TLV types/sizes from ath12k/qmi.c v6.6
+ *    (qmi_wlanfw_*_req_msg_v01_ei element tables, 31 of them) and the
+ *    builders ath12k_qmi_host_cap_send / ath12k_qmi_respond_fw_mem_request.
+ * Everything here is offline-testable (songyuan_qmi=1) before a transport exists. */
+#define SY_QRTR_PROTO_VER_1 1u
+#define SY_QRTR_TYPE_DATA 1u
+#define SY_QRTR_TYPE_HELLO 2u
+#define SY_QRTR_TYPE_NEW_SERVER 4u
+#define SY_QRTR_TYPE_NEW_LOOKUP 10u
+#define SY_QRTR_PORT_CTRL 0xfffffffeu
+#define SY_QRTR_NODE_BCAST 0xffffffffu
+
+#define SY_QMI_WLFW_IND_REGISTER_REQ 0x0020
+#define SY_QMI_WLFW_FW_READY_IND 0x0021
+#define SY_QMI_WLFW_BDF_DOWNLOAD_REQ 0x0025
+#define SY_QMI_WLFW_HOST_CAP_REQ 0x0034
+#define SY_QMI_WLFW_REQUEST_MEM_IND 0x0035
+#define SY_QMI_WLFW_RESPOND_MEM_REQ 0x0036
+#define SY_QMI_WLFW_FW_MEM_READY_IND 0x0037
+#define SY_QMI_WLFW_M3_INFO_REQ 0x003c
+
+#define SY_WLFW_MEM_TYPE_DDR 1u
+#define SY_WLFW_MEM_TYPE_BDF 2u
+#define SY_WLFW_MEM_TYPE_M3 3u
+#define SY_WLFW_MEM_TYPE_CAL 4u
+#define SY_WLFW_HOST_CSTATE_BIT 0x04u
+#define SY_WLFW_SLEEP_CLOCK_INTERNAL_BIT 0x02u
+#define SY_WLFW_PLATFORM_CAP_GLOBAL_RESET 0x08u
+#define SY_WLFW_FEATURE_LIST 0x18ull	/* BIT(CNSS_QDSS_CFG_MISS)|BIT(CNSS_PCIE_PERST_NO_PULL) */
+
+struct sy_qrtr_hdr {
+	uint32_t version, type, src_node, src_port, confirm_rx, size, dst_node, dst_port;
+};
+
+struct sy_wlfw_seg {
+	uint64_t addr;
+	uint32_t size;
+	uint32_t type;
+};
+
+static uint8_t sy_qmi_tx[2048];
+static struct sy_wlfw_seg sy_wlfw_mem[52];
+static unsigned sy_wlfw_mem_n;
+
+static unsigned
+sy_qmi_hdr(uint8_t *b, uint8_t kind, uint16_t txn, uint16_t msgid)
+{
+	b[0] = kind;
+	b[1] = (uint8_t)txn; b[2] = (uint8_t)(txn >> 8);
+	b[3] = (uint8_t)msgid; b[4] = (uint8_t)(msgid >> 8);
+	b[5] = 0; b[6] = 0;
+	return 7;
+}
+
+static unsigned
+sy_qmi_finish(uint8_t *b, unsigned at)
+{
+	b[5] = (uint8_t)(at - 7);
+	b[6] = (uint8_t)((at - 7) >> 8);
+	return at;
+}
+
+static unsigned
+sy_qmi_tlv_hdr(uint8_t *b, unsigned at, uint8_t type, uint16_t len)
+{
+	b[at] = type;
+	b[at + 1] = (uint8_t)len;
+	b[at + 2] = (uint8_t)(len >> 8);
+	return at + 3;
+}
+
+static unsigned
+sy_qmi_tlv_u8(uint8_t *b, unsigned at, uint8_t type, uint8_t v)
+{
+	at = sy_qmi_tlv_hdr(b, at, type, 1);
+	b[at++] = v;
+	return at;
+}
+
+static unsigned
+sy_qmi_tlv_u32(uint8_t *b, unsigned at, uint8_t type, uint32_t v)
+{
+	at = sy_qmi_tlv_hdr(b, at, type, 4);
+	b[at++] = (uint8_t)v; b[at++] = (uint8_t)(v >> 8);
+	b[at++] = (uint8_t)(v >> 16); b[at++] = (uint8_t)(v >> 24);
+	return at;
+}
+
+static unsigned
+sy_qmi_tlv_u64(uint8_t *b, unsigned at, uint8_t type, uint64_t v)
+{
+	unsigned i;
+
+	at = sy_qmi_tlv_hdr(b, at, type, 8);
+	for (i = 0; i < 8; i++)
+		b[at++] = (uint8_t)(v >> (8 * i));
+	return at;
+}
+
+/* host_cap: values from ath12k_qmi_host_cap_send for the WCN7850 hw params
+ * (internal_sleep_clock = true, qmi_cnss_feature_bitmap = BIT(3)|BIT(4)). */
+static unsigned
+sy_wlfw_host_cap(uint8_t *b, uint16_t txn)
+{
+	unsigned at = sy_qmi_hdr(b, 0x00, txn, SY_QMI_WLFW_HOST_CAP_REQ);
+
+	at = sy_qmi_tlv_u32(b, at, 0x10, 1);			/* num_clients */
+	at = sy_qmi_tlv_u8(b, at, 0x13,				/* nm_modem */
+	    SY_WLFW_HOST_CSTATE_BIT | SY_WLFW_SLEEP_CLOCK_INTERNAL_BIT |
+	    SY_WLFW_PLATFORM_CAP_GLOBAL_RESET);
+	at = sy_qmi_tlv_u8(b, at, 0x14, 1);			/* bdf_support */
+	at = sy_qmi_tlv_u8(b, at, 0x16, 1);			/* m3_support */
+	at = sy_qmi_tlv_u8(b, at, 0x17, 1);			/* m3_cache_support */
+	at = sy_qmi_tlv_u8(b, at, 0x1a, 0);			/* cal_done */
+	at = sy_qmi_tlv_u8(b, at, 0x1c, 0);			/* mem_cfg_mode: default */
+	at = sy_qmi_tlv_u64(b, at, 0x27, SY_WLFW_FEATURE_LIST);
+	return sy_qmi_finish(b, at);
+}
+
+/* ath12k_qmi_fw_ind_register_send (ath12k_v66/qmi.c:1999-2028) marks only
+ * these fields valid. ath12k_qmi_event_server_arrive (qmi.c:2784-2795)
+ * sends this before host_cap. */
+static unsigned
+sy_wlfw_ind_register(uint8_t *b, uint16_t txn)
+{
+	unsigned at = sy_qmi_hdr(b, 0x00, txn, SY_QMI_WLFW_IND_REGISTER_REQ);
+
+	at = sy_qmi_tlv_u8(b, at, 0x10, 1);	/* fw_ready */
+	at = sy_qmi_tlv_u32(b, at, 0x15, 0x4b4e454c);	/* client id */
+	at = sy_qmi_tlv_u8(b, at, 0x16, 1);	/* request mem */
+	at = sy_qmi_tlv_u8(b, at, 0x17, 1);	/* fw mem ready */
+	at = sy_qmi_tlv_u8(b, at, 0x18, 1);	/* fw init done */
+	at = sy_qmi_tlv_u8(b, at, 0x1b, 1);	/* cal done */
+	return sy_qmi_finish(b, at);
+}
+
+/* respond_mem: TLV 0x01 is a 1-byte segment count followed by 17-byte records
+ * {addr u64, size u32, type u32, restore u8} (qmi_wlanfw_mem_seg_resp_s_v01). */
+static unsigned
+sy_wlfw_respond_mem(uint8_t *b, uint16_t txn, const struct sy_wlfw_seg *seg, unsigned n)
+{
+	unsigned at = sy_qmi_hdr(b, 0x00, txn, SY_QMI_WLFW_RESPOND_MEM_REQ);
+	unsigned i;
+
+	if (n > 255)
+		n = 255;
+	at = sy_qmi_tlv_hdr(b, at, 0x01, (uint16_t)(1 + 17 * n));
+	b[at++] = (uint8_t)n;
+	for (i = 0; i < n; i++) {
+		unsigned k;
+
+		for (k = 0; k < 8; k++)
+			b[at++] = (uint8_t)(seg[i].addr >> (8 * k));
+		for (k = 0; k < 4; k++)
+			b[at++] = (uint8_t)(seg[i].size >> (8 * k));
+		for (k = 0; k < 4; k++)
+			b[at++] = (uint8_t)(seg[i].type >> (8 * k));
+		b[at++] = 0;	/* restore */
+	}
+	return sy_qmi_finish(b, at);
+}
+
+static unsigned
+sy_wlfw_m3_info(uint8_t *b, uint16_t txn, uint64_t addr, uint32_t size)
+{
+	unsigned at = sy_qmi_hdr(b, 0x00, txn, SY_QMI_WLFW_M3_INFO_REQ);
+
+	at = sy_qmi_tlv_u64(b, at, 0x01, addr);
+	at = sy_qmi_tlv_u32(b, at, 0x02, size);
+	return sy_qmi_finish(b, at);
+}
+
+/* bdf_download: 0x01 valid, 0x10 file_id, 0x11 total_size, 0x12 seg_id,
+ * 0x13 length(u16)+bytes, 0x14 end, 0x15 bdf_type. */
+static unsigned
+sy_wlfw_bdf_download(uint8_t *b, uint16_t txn, uint8_t file_id, uint32_t total,
+    uint32_t seg_id, const uint8_t *data, uint16_t len, uint8_t end, uint8_t bdf_type)
+{
+	unsigned at = sy_qmi_hdr(b, 0x00, txn, SY_QMI_WLFW_BDF_DOWNLOAD_REQ);
+
+	at = sy_qmi_tlv_u8(b, at, 0x01, 1);
+	at = sy_qmi_tlv_hdr(b, at, 0x10, 4);
+	b[at++] = file_id; b[at++] = 0; b[at++] = 0; b[at++] = 0;
+	at = sy_qmi_tlv_u32(b, at, 0x11, total);
+	at = sy_qmi_tlv_u32(b, at, 0x12, seg_id);
+	if (len) {
+		unsigned i;
+
+		at = sy_qmi_tlv_hdr(b, at, 0x13, (uint16_t)(2 + len));
+		b[at++] = (uint8_t)len; b[at++] = (uint8_t)(len >> 8);
+		for (i = 0; i < len; i++)
+			b[at++] = data[i];
+	}
+	at = sy_qmi_tlv_u8(b, at, 0x14, end);
+	at = sy_qmi_tlv_u8(b, at, 0x15, bdf_type);
+	return sy_qmi_finish(b, at);
+}
+
+/* QRTR data frame: 32-byte v1 header (version, type, src/dst node and port). */
+static void
+sy_put32le(uint8_t *b, unsigned at, uint32_t v)
+{
+	b[at] = (uint8_t)v; b[at + 1] = (uint8_t)(v >> 8);
+	b[at + 2] = (uint8_t)(v >> 16); b[at + 3] = (uint8_t)(v >> 24);
+}
+
+/* QRTR v1 frame: eight little-endian u32 fields (version, type, src node/port,
+ * confirm_rx, size, dst node/port), then the payload. */
+static unsigned
+sy_qrtr_frame(uint8_t *b, uint32_t type, uint32_t src_node, uint32_t src_port,
+    uint32_t dst_node, uint32_t dst_port, const uint8_t *payload, unsigned len)
+{
+	sy_put32le(b, 0, SY_QRTR_PROTO_VER_1);
+	sy_put32le(b, 4, type);
+	sy_put32le(b, 8, src_node);
+	sy_put32le(b, 12, src_port);
+	sy_put32le(b, 16, 0);			/* confirm_rx */
+	sy_put32le(b, 20, len);
+	sy_put32le(b, 24, dst_node);
+	sy_put32le(b, 28, dst_port);
+	if (payload && len)
+		memcpy(b + 32, payload, len);
+	return 32 + len;
+}
+
+/* Parse request_mem_ind: TLV 0x01 = count then mem_seg_s records
+ * {size u32, type u32, mem_cfg_len u32, mem_cfg[2] {offset u64, size u32, secure u8}}. */
+static unsigned
+sy_wlfw_parse_request_mem(const uint8_t *b, unsigned len)
+{
+	unsigned at = 7, found = 0;
+
+	sy_wlfw_mem_n = 0;
+	while (at + 3 <= len) {
+		uint8_t type = b[at];
+		uint16_t tlen = (uint16_t)(b[at + 1] | (b[at + 2] << 8));
+		unsigned v = at + 3, i;
+
+		if (v + tlen > len)
+			break;
+		if (type == 0x01 && tlen >= 1) {
+			unsigned n = b[v];
+
+			v++;
+			for (i = 0; i < n && sy_wlfw_mem_n < (sizeof(sy_wlfw_mem) / sizeof(sy_wlfw_mem[0])); i++) {
+				uint32_t sz, mt, mc, k;
+
+				if (v + 12 > at + 3 + tlen)
+					break;
+				sz = (uint32_t)(b[v] | (b[v + 1] << 8) | (b[v + 2] << 16) | (b[v + 3] << 24));
+				v += 4;
+				mt = (uint32_t)(b[v] | (b[v + 1] << 8) | (b[v + 2] << 16) | (b[v + 3] << 24));
+				v += 4;
+				mc = (uint32_t)(b[v] | (b[v + 1] << 8) | (b[v + 2] << 16) | (b[v + 3] << 24));
+				v += 4;
+				for (k = 0; k < mc; k++)		/* mem_cfg records are 13 bytes */
+					v += 13;
+				if (v > at + 3 + tlen)
+					break;
+				sy_wlfw_mem[sy_wlfw_mem_n].addr = 0;
+				sy_wlfw_mem[sy_wlfw_mem_n].size = sz;
+				sy_wlfw_mem[sy_wlfw_mem_n].type = mt;
+				sy_wlfw_mem_n++;
+				found++;
+			}
+		}
+		at = (unsigned)(at + 3) + tlen;
+	}
+	return found;
+}
+
+/* Offline self-test: every encoder is checked against its expected byte layout and
+ * a synthetic request_mem_ind is decoded. */
+static void
+sy_m5a_selftest(void)
+{
+	unsigned total = 0, bad = 0, n;
+	uint8_t frame[256];
+	static const uint8_t bdf_data[4] = { 0x7f, 0x45, 0x4c, 0x46 };
+
+	n = sy_wlfw_host_cap(sy_qmi_tx, 0x1234);
+	total++;
+	if (n < 7 || sy_qmi_tx[0] != 0 || sy_qmi_tx[3] != 0x34 || sy_qmi_tx[4] != 0 ||
+	    (sy_qmi_tx[5] | (sy_qmi_tx[6] << 8)) != n - 7 ||
+	    memcmp(sy_qmi_tx + 7, "\x10\x04\x00\x01\x00\x00", 6) != 0)
+		bad++;
+	n = sy_wlfw_ind_register(sy_qmi_tx, 0x1235);
+	total++;
+	if (n < 7 || sy_qmi_tx[3] != 0x20 || (sy_qmi_tx[5] | (sy_qmi_tx[6] << 8)) != n - 7)
+		bad++;
+	{
+		struct sy_wlfw_seg seg[2];
+
+		seg[0].addr = 0x90d00000ull; seg[0].size = 0x100000; seg[0].type = SY_WLFW_MEM_TYPE_DDR;
+		seg[1].addr = 0x90e00000ull; seg[1].size = 0x200000; seg[1].type = SY_WLFW_MEM_TYPE_BDF;
+		n = sy_wlfw_respond_mem(sy_qmi_tx, 0x1236, seg, 2);
+		total++;
+		if (n != 7 + 3 + 1 + 2 * 17 || sy_qmi_tx[7] != 0x01 ||
+		    sy_qmi_tx[8] != (uint8_t)(1 + 34) || sy_qmi_tx[10] != 2)
+			bad++;
+	}
+	n = sy_wlfw_m3_info(sy_qmi_tx, 0x1237, 0x91000000ull, 0x4000);
+	total++;
+	if (n != 7 + (3 + 8) + (3 + 4) || sy_qmi_tx[3] != 0x3c)
+		bad++;
+	n = sy_wlfw_bdf_download(sy_qmi_tx, 0x1238, 0, 4, 0, bdf_data, 4, 1, 0);
+	total++;
+	if (n < 7 || sy_qmi_tx[3] != 0x25 || sy_qmi_tx[5] == 0)
+		bad++;
+	{
+		uint8_t ind[64];
+		unsigned at = sy_qmi_hdr(ind, 0x04, 0x1, SY_QMI_WLFW_REQUEST_MEM_IND);
+
+		at = sy_qmi_tlv_hdr(ind, at, 0x01, (uint16_t)(1 + 12 + 13));
+		ind[at++] = 1;					/* one segment */
+		ind[at++] = 0x00; ind[at++] = 0x00; ind[at++] = 0x10; ind[at++] = 0x00;	/* size 1 MiB */
+		ind[at++] = 1; ind[at++] = 0; ind[at++] = 0; ind[at++] = 0;		/* type DDR */
+		ind[at++] = 1; ind[at++] = 0; ind[at++] = 0; ind[at++] = 0;		/* mem_cfg_len 1 */
+		for (n = 0; n < 13; n++)
+			ind[at++] = 0;
+		sy_qmi_finish(ind, at);
+		total++;
+		if (sy_wlfw_parse_request_mem(ind, at) != 1 || sy_wlfw_mem_n != 1 ||
+		    sy_wlfw_mem[0].size != 0x100000 || sy_wlfw_mem[0].type != SY_WLFW_MEM_TYPE_DDR)
+			bad++;
+	}
+	total++;
+	if (sizeof(struct sy_qrtr_hdr) != 32) {
+		bad++;
+	} else {
+		n = sy_qrtr_frame(frame, SY_QRTR_TYPE_DATA, 0, 0x1234, 7, 0x5678, sy_qmi_tx, 16);
+		if (n != 48 || frame[0] != 1 || frame[4] != SY_QRTR_TYPE_DATA || frame[20] != 16 ||
+		    frame[12] != 0x34 || frame[13] != 0x12)
+			bad++;
+	}
+	printf("PANDORA WLAN: QMI/QRTR/WLFW self-test: %u checks, %u failed -> %s\n",
+	    total, bad, bad ? "FAIL" : "PASS");
+	sy_log_sync();
+}
+
+/* ---- M5b-2 transport and WLFW sequence -------------------------------------------
+ * QRTR control/DATA frames go out on MHI channel 20 (IPCR UL) and come back on
+ * channel 21 (IPCR DL, event ring 1). Control packet layout is qrtr_ctrl_pkt from
+ * include/uapi/linux/qrtr.h (cmd + service/instance/node/port). The WLFW service is
+ * id 0x45, instance 1 for WCN7850 (ath12k hw.c qmi_service_ins_id), so a NEW_LOOKUP
+ * for it learns the firmware node and port; after that QMI/WLFW messages are DATA
+ * frames. The memory flow follows ath12k_qmi_respond_fw_mem_request: a request that
+ * cannot be served is answered with zero segments ("delayed"), which firmware
+ * follows with smaller requests. */
+#define SY_WLFW_SERVICE_ID 0x45u
+#define SY_WLFW_SERVICE_INS 1u
+#define SY_WLFW_QRTR_PORT 0x4000u	/* the host port this driver speaks from */
+#define SY_WLFW_TX_OFF 0xC000u		/* one 4 KiB transmit buffer in the MHI region */
+#define SY_WLFW_TX_IOVA (SY_IOVA_MAP + 0x7C0000 + SY_WLFW_TX_OFF)
+#define SY_WLFW_TX_MAX 8192u
+
+#define SY_QRTR_CMD_HELLO 2u
+#define SY_QRTR_CMD_NEW_SERVER 4u
+#define SY_QRTR_CMD_NEW_LOOKUP 10u
+
+static uint16_t sy_wlfw_txn = 0x100;
+static uint32_t sy_wlfw_ul_wp;
+static uint32_t sy_wlfw_node, sy_wlfw_port;
+static unsigned sy_wlfw_state;
+static int sy_wlfw_cap_sent;
+static uint8_t sy_wlfw_txbuf[SY_WLFW_TX_MAX];
+static uint8_t sy_bdf_buf[6144];
+static uint8_t sy_bdf_msg[7168];
+static void sy_wlfw_bdf_send(const char *, uint8_t);
+static void sy_wlfw_m3_send(void);
+/* sy_wlfw_rx() calls this before its definition; C99 rejects implicit
+ * declarations (CI run 42737773853 hit exactly this in pandora_cachevol.c). */
+static int sy_wlfw_response(const uint8_t *, unsigned, uint16_t);
+
+static void
+sy_mhi_ctx_publish(uint32_t chan, uint32_t ring_off, uint32_t wp_idx)
+{
+	uint64_t base = SY_IOVA_MAP + 0x7C0000 + ring_off;
+	uint32_t chdb = sy_rd(sy_bar_va, 0x18) & 0xffffu;
+	vm_offset_t ctx;
+	uint64_t wp;
+
+	ctx = sy_sbl_va + 0x7C0000 + SY_MHI_CH_CTX + chan * 0x2cu;
+	wp = base + (uint64_t)wp_idx * 16u;
+	sy_wr(ctx, 0x24, (uint32_t)wp);
+	sy_wr(ctx, 0x28, (uint32_t)(wp >> 32));
+	flush_dcache64(sy_pa(ctx), (unsigned)PAGE_SIZE, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_wr(sy_bar_va, chdb + 8 * chan, (uint32_t)wp);
+	sy_wr(sy_bar_va, chdb + 8 * chan + 4, (uint32_t)(wp >> 32));
+}
+
+/* Send one frame on an IPCR channel: copy it to the transmit buffer, post a TRE and
+ * ring the channel doorbell with the new write pointer. */
+static int
+sy_mhi_send(uint32_t chan, const void *data, uint32_t len)
+{
+	vm_offset_t pg_va, ring_va, tre;
+	uint64_t ring_io;
+	uint32_t i, els = 0, ring_off = 0;
+
+	if (!sy_bar_va || !sy_sbl_va || len == 0 || len > SY_WLFW_TX_MAX)
+		return -1;
+	if (!sy_mhi_ipcr_ok) {
+		printf("PANDORA WLAN: MHI tx ch %u deferred, IPCR not started\n", chan);
+		return -1;
+	}
+	for (i = 0; i < sizeof(sy_mhi_desc) / sizeof(sy_mhi_desc[0]); i++) {
+		if (sy_mhi_desc[i].num == chan) {
+			els = sy_mhi_desc[i].els;
+			ring_off = sy_mhi_desc[i].ring;
+			break;
+		}
+	}
+	if (!els)
+		return -1;
+	pg_va = sy_sbl_va + 0x7C0000;
+	ring_va = pg_va + ring_off;
+	ring_io = SY_IOVA_MAP + 0x7C0000 + ring_off;
+	memcpy(sy_wlfw_txbuf, data, len);
+	memcpy((void *)(pg_va + SY_WLFW_TX_OFF), sy_wlfw_txbuf, len);
+	flush_dcache64(sy_pa(pg_va + SY_WLFW_TX_OFF), (unsigned)PAGE_SIZE, TRUE);
+	tre = ring_va + (sy_wlfw_ul_wp << 4);
+	sy_wr(tre, 0, (uint32_t)SY_WLFW_TX_IOVA);
+	sy_wr(tre, 4, (uint32_t)(SY_WLFW_TX_IOVA >> 32));
+	sy_wr(tre, 8, len);
+	sy_wr(tre, 12, (2u << 16) | (1u << 9));		/* transfer, MHI_EOT */
+	flush_dcache64(sy_pa(ring_va), (unsigned)PAGE_SIZE, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_wlfw_ul_wp = (sy_wlfw_ul_wp + 1) % els;
+	sy_mhi_ctx_publish(chan, ring_off, sy_wlfw_ul_wp);
+	(void)ring_io;
+	printf("PANDORA WLAN: MHI tx ch %u %u B (seq %u)\n", chan, len, sy_wlfw_ul_wp);
+	return 0;
+}
+
+static unsigned
+sy_qrtr_ctrl(uint8_t *b, uint32_t type, uint32_t src_node, uint32_t src_port,
+    uint32_t dst_node, uint32_t dst_port, uint32_t a, uint32_t c, uint32_t d, uint32_t e)
+{
+	unsigned at = sy_qrtr_frame(b, type, src_node, src_port, dst_node, dst_port, NULL, 0);
+
+	/* qrtr_ctrl_pkt: cmd + {service, instance, node, port} little endian */
+	b[at + 0] = (uint8_t)type; b[at + 1] = 0; b[at + 2] = 0; b[at + 3] = 0;
+	b[at + 4] = (uint8_t)a; b[at + 5] = (uint8_t)(a >> 8); b[at + 6] = (uint8_t)(a >> 16); b[at + 7] = (uint8_t)(a >> 24);
+	b[at + 8] = (uint8_t)c; b[at + 9] = (uint8_t)(c >> 8); b[at + 10] = (uint8_t)(c >> 16); b[at + 11] = (uint8_t)(c >> 24);
+	b[at + 12] = (uint8_t)d; b[at + 13] = (uint8_t)(d >> 8); b[at + 14] = (uint8_t)(d >> 16); b[at + 15] = (uint8_t)(d >> 24);
+	b[at + 16] = (uint8_t)e; b[at + 17] = (uint8_t)(e >> 8); b[at + 18] = (uint8_t)(e >> 16); b[at + 19] = (uint8_t)(e >> 24);
+	/* the size field of the header covers the control payload */
+	b[20] = 20; b[21] = 0; b[22] = 0; b[23] = 0;
+	return at + 20;
+}
+
+/* Decode an incoming QRTR frame (from channel 21) and advance the WLFW sequence. */
+static void
+sy_wlfw_rx(const uint8_t *b, unsigned len)
+{
+	uint32_t type, src_node, src_port, size;
+	unsigned at;
+
+	if (len < 32)
+		return;
+	type = (uint32_t)(b[4] | (b[5] << 8) | (b[6] << 16) | (b[7] << 24));
+	src_node = (uint32_t)(b[8] | (b[9] << 8) | (b[10] << 16) | (b[11] << 24));
+	src_port = (uint32_t)(b[12] | (b[13] << 8) | (b[14] << 16) | (b[15] << 24));
+	size = (uint32_t)(b[20] | (b[21] << 8) | (b[22] << 16) | (b[23] << 24));
+	if (type == SY_QRTR_CMD_NEW_SERVER && size >= 20 && len >= 52) {
+		uint32_t service = (uint32_t)(b[36] | (b[37] << 8) | (b[38] << 16) | (b[39] << 24));
+		uint32_t node = (uint32_t)(b[44] | (b[45] << 8) | (b[46] << 16) | (b[47] << 24));
+		uint32_t port = (uint32_t)(b[48] | (b[49] << 8) | (b[50] << 16) | (b[51] << 24));
+
+		printf("PANDORA WLAN: QRTR NEW_SERVER service %#x node %u port %#x\n",
+		    service, node, port);
+		if (service == SY_WLFW_SERVICE_ID && !sy_wlfw_node) {
+			sy_wlfw_node = node;
+			sy_wlfw_port = port;
+			at = sy_wlfw_ind_register(sy_wlfw_txbuf, sy_wlfw_txn++);
+			{
+				uint8_t frame[2048];
+				unsigned fl = sy_qrtr_frame(frame, SY_QRTR_TYPE_DATA, 0,
+				    SY_WLFW_QRTR_PORT, sy_wlfw_node, sy_wlfw_port,
+				    sy_wlfw_txbuf, at);
+				(void)sy_mhi_send(20, frame, fl);
+			}
+		}
+		return;
+	}
+	if (type != SY_QRTR_TYPE_DATA || size < 7)
+		return;
+	{
+		unsigned q = 32;
+		uint16_t msgid = (uint16_t)(b[q + 3] | (b[q + 4] << 8));
+		uint16_t qlen = (uint16_t)(b[q + 5] | (b[q + 6] << 8));
+
+		printf("PANDORA WLAN: QRTR DATA from node %u port %#x: qmi msg %#x len %u\n",
+		    src_node, src_port, msgid, qlen);
+		if (msgid == SY_QMI_WLFW_REQUEST_MEM_IND) {
+			unsigned n = sy_wlfw_parse_request_mem(b + q, (unsigned)qlen + 7);
+			struct sy_wlfw_seg seg[16];
+			unsigned i, used = 0, ok = !!sy_mem_va;
+
+			printf("PANDORA WLAN: WLFW request_mem_ind: %u segments\n", n);
+			for (i = 0; i < n && i < 16; i++) {
+				uint32_t sz = (sy_wlfw_mem[i].size + 0xfffu) & ~0xfffu;
+
+				printf("PANDORA WLAN: WLFW mem seg %u type %u size %u\n",
+				    i, sy_wlfw_mem[i].type, sy_wlfw_mem[i].size);
+				if (!ok || used + sz > SY_MEM_SIZE)
+					ok = 0;
+				if (!ok)
+					break;
+				seg[i].addr = SY_MEM_IOVA + used;
+				seg[i].size = sz;
+				seg[i].type = sy_wlfw_mem[i].type;
+				used += sz;
+			}
+			if (!ok) {
+				/* fall back to the delayed answer: firmware re-asks smaller */
+				printf("PANDORA WLAN: WLFW mem: no room, answering delayed\n");
+				at = sy_wlfw_respond_mem(sy_wlfw_txbuf, sy_wlfw_txn++, NULL, 0);
+			} else {
+				sy_mem_used = used;
+				at = sy_wlfw_respond_mem(sy_wlfw_txbuf, sy_wlfw_txn++, seg,
+				    n < 16 ? n : 16);
+				printf("PANDORA WLAN: WLFW mem: %u segments, %u KiB at %#x\n",
+				    n, used >> 10, (unsigned)SY_MEM_IOVA);
+			}
+			{
+				uint8_t frame[2048];
+				unsigned fl = sy_qrtr_frame(frame, SY_QRTR_TYPE_DATA, 0,
+				    SY_WLFW_QRTR_PORT, src_node, src_port, sy_wlfw_txbuf, at);
+				(void)sy_mhi_send(20, frame, fl);
+			}
+			sy_wlfw_state = 2;
+		} else if (msgid == SY_QMI_WLFW_FW_MEM_READY_IND) {
+			printf("PANDORA WLAN: WLFW fw_mem_ready: downloading board data\n");
+			sy_wlfw_bdf_send("bd_songyuan.elf", 1);	/* BDF ELF */
+			sy_wlfw_bdf_send("regdb_xiaomi.bin", 4);	/* REGDB */
+			sy_wlfw_m3_send();
+		} else if (msgid == SY_QMI_WLFW_FW_READY_IND) {
+			printf("PANDORA WLAN: WLFW FW READY (state %u)\n", sy_wlfw_state);
+			sy_wlfw_state = 3;
+		} else if (msgid == SY_QMI_WLFW_IND_REGISTER_REQ) {
+			if (sy_wlfw_response(b + q, (unsigned)qlen + 7, msgid) == 0 &&
+			    !sy_wlfw_cap_sent) {
+				uint8_t frame[2048];
+				unsigned fl;
+
+				sy_wlfw_cap_sent = 1;
+				at = sy_wlfw_host_cap(sy_wlfw_txbuf, sy_wlfw_txn++);
+				fl = sy_qrtr_frame(frame, SY_QRTR_TYPE_DATA, 0,
+				    SY_WLFW_QRTR_PORT, src_node, src_port,
+				    sy_wlfw_txbuf, at);
+				(void)sy_mhi_send(20, frame, fl);
+				sy_wlfw_state = 1;
+			}
+		} else if (msgid == SY_QMI_WLFW_HOST_CAP_REQ || msgid == SY_QMI_WLFW_BDF_DOWNLOAD_REQ ||
+		    msgid == SY_QMI_WLFW_M3_INFO_REQ) {
+			sy_wlfw_response(b + q, (unsigned)qlen + 7, msgid);
+		} else if (msgid == 0x0022 || msgid == 0x0023) {
+			/* D1: QMI_WLANFW_WLAN_MODE_REQ (0x22) / WLAN_CFG_REQ (0x23) */
+			printf("PANDORA WLAN: WLFW wlan %s response\n",
+			    msgid == 0x0022 ? "mode" : "cfg");
+			sy_wlfw_response(b + q, (unsigned)qlen + 7, msgid);
+		}
+	}
+}
+
+/* Stage 20: learn the firmware QRTR address for the WLFW service and start the
+ * handshake; receive processing happens from the event ring walk. */
+static void
+sy_wlfw_run(void)
+{
+	uint8_t frame[256];
+	unsigned fl;
+
+	if (!sy_bar_va || !sy_sbl_va)
+		return;
+	if (!sy_mhi_ipcr_ok) {
+		printf("PANDORA WLAN: WLFW: deferred, IPCR START did not complete\n");
+		sy_log_sync();
+		return;
+	}
+	fl = sy_qrtr_ctrl(frame, SY_QRTR_CMD_HELLO, 0, 0, 1, SY_QRTR_PORT_CTRL, 0, 0, 0, 0);
+	(void)sy_mhi_send(20, frame, fl);
+	fl = sy_qrtr_ctrl(frame, SY_QRTR_CMD_NEW_LOOKUP, 0, SY_WLFW_QRTR_PORT, 1,
+	    SY_QRTR_PORT_CTRL, SY_WLFW_SERVICE_ID, SY_WLFW_SERVICE_INS, 0, 0);
+	(void)sy_mhi_send(20, frame, fl);
+	printf("PANDORA WLAN: WLFW: hello + lookup for service %#x sent\n",
+	    SY_WLFW_SERVICE_ID);
+	sy_log_sync();
+}
+
+
+/* Send one firmware file through QMI_WLANFW_BDF_DOWNLOAD_REQ_V01 (0x25) in
+ * 6144-byte fragments, last fragment end=1 (ath12k qmi.c element table). */
+static void
+sy_wlfw_bdf_send(const char *name, uint8_t bdf_type)
+{
+	uint64_t fo = 0, fs = 0;
+	uint32_t segs, i;
+
+	if (!sy_mem_va || !sy_wlfw_node)
+		return;
+	if (sy_fw_find(name, &fo, &fs) != 0) {
+		printf("PANDORA WLAN: WLFW bdf %s: not in the pack\n", name);
+		return;
+	}
+	segs = (uint32_t)((fs + 6143) / 6144);
+	printf("PANDORA WLAN: WLFW bdf %s: %llu B, %u fragments, type %u\n",
+	    name, (unsigned long long)fs, segs, bdf_type);
+	for (i = 0; i < segs; i++) {
+		uint32_t off = i * 6144;
+		uint32_t len = (uint32_t)((fs - off) > 6144 ? 6144 : (fs - off));
+		unsigned qlen, fl;
+
+		if (pandora_fw_read(fo + off, sy_bdf_buf, len)) {
+			printf("PANDORA WLAN: WLFW bdf read failed at %u\n", off);
+			return;
+		}
+		memset(sy_bdf_msg, 0, sizeof(sy_bdf_msg));
+		qlen = sy_wlfw_bdf_download(sy_bdf_msg, sy_wlfw_txn++, 0,
+		    (uint32_t)fs, i, sy_bdf_buf, (uint16_t)len,
+		    (i + 1 == segs) ? 1 : 0, bdf_type);
+		fl = sy_qrtr_frame(sy_wlfw_txbuf, SY_QRTR_TYPE_DATA, 0,
+		    SY_WLFW_QRTR_PORT, sy_wlfw_node, sy_wlfw_port, sy_bdf_msg, qlen);
+		(void)sy_mhi_send(20, sy_wlfw_txbuf, fl);
+		printf("PANDORA WLAN: WLFW bdf %u/%u: off %u len %u end %u\n",
+		    i + 1, segs, off, len, (i + 1 == segs));
+		if ((i & 3) == 3)
+			sy_log_sync();
+	}
+}
+
+/* QMI_WLANFW_M3_INFO_REQ_V01 (0x3C): describe the M3 region handed out by
+ * respond_mem (type 3). */
+static void
+sy_wlfw_m3_send(void)
+{
+	unsigned i, qlen, fl;
+
+	for (i = 0; i < sy_wlfw_mem_n; i++) {
+		if (sy_wlfw_mem[i].type != SY_WLFW_MEM_TYPE_M3)
+			continue;
+		qlen = sy_wlfw_m3_info(sy_wlfw_txbuf, sy_wlfw_txn++,
+		    SY_MEM_IOVA, sy_wlfw_mem[i].size);
+		fl = sy_qrtr_frame(sy_bdf_msg, SY_QRTR_TYPE_DATA, 0,
+		    SY_WLFW_QRTR_PORT, sy_wlfw_node, sy_wlfw_port,
+		    sy_wlfw_txbuf, qlen);
+		(void)sy_mhi_send(20, sy_bdf_msg, fl);
+		printf("PANDORA WLAN: WLFW m3_info: addr %#x size %u\n",
+		    (unsigned)SY_MEM_IOVA, sy_wlfw_mem[i].size);
+		return;
+	}
+	printf("PANDORA WLAN: WLFW m3_info: no M3 segment from respond_mem\n");
+}
+
+/* QMI response: TLV 0x02 carries result (u16) and error (u16). */
+static int
+sy_wlfw_response(const uint8_t *b, unsigned len, uint16_t msgid)
+{
+	unsigned at = 7;
+
+	while (at + 3 <= len) {
+		uint8_t type = b[at];
+		uint16_t tl = (uint16_t)(b[at + 1] | (b[at + 2] << 8));
+
+		if (type == 0x02 && tl >= 4 && at + 7 <= len) {
+			unsigned result = (unsigned)(b[at + 3] | (b[at + 4] << 8));
+			unsigned error = (unsigned)(b[at + 5] | (b[at + 6] << 8));
+
+			printf("PANDORA WLAN: WLFW resp msg %#x: result %u error %u\n",
+			    msgid, result, error);
+			if (msgid == SY_QMI_WLFW_HOST_CAP_REQ && result == 0)
+				printf("PANDORA WLAN: WLFW host_cap accepted\n");
+			if (msgid == SY_QMI_WLFW_IND_REGISTER_REQ && result == 0)
+				printf("PANDORA WLAN: WLFW ind_register accepted\n");
+			return (int)result;
+		}
+		at = at + 3 + tl;
+	}
+	printf("PANDORA WLAN: WLFW resp msg %#x: no result TLV\n", msgid);
+	return -1;
+}
