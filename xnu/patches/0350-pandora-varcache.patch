+static void
+sy_log_sync(void)
+{
+	static int on = -1;
+
+	if (on < 0) {
+		int v = 1;
+
+		(void)PE_parse_boot_argn("songyuan_logsync", &v, sizeof(v));
+		on = v ? 1 : 0;
+		printf("PANDORA WLAN: log sync %s (songyuan_logsync=%d)\n", on ? "on" : "off", on);
+	}
+	if (on)
+		(void)pandora_log_sync();
+}
