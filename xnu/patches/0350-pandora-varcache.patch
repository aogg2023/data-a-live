+/* RPMh clock/single-command vote: cmd-db entry for a non-VRM resource (e.g. "rf_clk"). */
+static int
+sy_rpmh_lookup_clock(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	unsigned matches = 0;
+
+	for (unsigned i = 0; i < 8 && res[i]; i++)
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	for (unsigned i = 0; i < 8; i++) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = sy_cmddb16(h);
+		if (!slave)
+			break;
+		uint32_t entries = SY_CMDDB_HEADER + sy_cmddb16(h + 2);
+		unsigned count = sy_cmddb16(h + 6);
+		if ((entries & 3u) || entries + count * SY_CMDDB_ENTRY > SY_CMDDB_SIZE) {
+			printf("PANDORA WLAN: cmd-db slave header %u malformed\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; j++) {
+			uint32_t e = entries + SY_CMDDB_ENTRY * j;
+			if (sy_rd(sy_cmddb, e) != key[0] || sy_rd(sy_cmddb, e + 4) != key[1])
+				continue;
+			uint32_t addr = sy_rd(sy_cmddb, e + 16);
+			printf("PANDORA WLAN: cmd-db %s addr=%#x slave=%u\n", res, addr, slave);
+			if (slave == 4 && !(addr & 15u)) {
+				*address = addr;
+				matches++;
+			}
+		}
+	}
+	if (matches != 1) {
+		printf("PANDORA WLAN: cmd-db %s: %u matches; not voting\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+/* One ACTIVE TCS command on the PCIe set (TCS2); the clock level is the data word. */
+static int
+sy_rpmh_vote1(const char *res, uint32_t addr_off, uint32_t data)
+{
+	const struct sy_rpmh_layout *L = &sy_rpmh_v3;
+	uint32_t id, address = 0, b, bit;
+	unsigned major;
+	bool done = false;
+	int rc;
+
+	if (!sy_rsc || !sy_cmddb) {
+		sy_rsc = ml_io_map(SY_RSC_PA, SY_RSC_SIZE);
+		sy_cmddb = ml_io_map(SY_CMDDB_PA, SY_CMDDB_SIZE);
+		if (!sy_rsc || !sy_cmddb) {
+			printf("PANDORA WLAN: RPMh: RSC/cmd-db mapping failed\n");
+			return ENOMEM;
+		}
+	}
+	id = sy_rd(sy_rsc, 0);
+	major = (id >> 16) & 0xffu;
+	if (major < 3) {
+		printf("PANDORA WLAN: RPMh: RSC v%u: no 3.0 layout for %s\n", major, res);
+		return ENODEV;
+	}
+	rc = sy_rpmh_lookup_clock(res, &address);
+	if (rc)
+		return rc;
+	address += addr_off;	/* clk-rpmh: res_addr = cmd-db addr + CLK_RPMH_VRM_EN_OFFSET(4) */
+	b = SY_TCS_OFF + 2 * SY_TCS_STRIDE;
+	bit = 1u << 2;
+	if (sy_rd(sy_rsc, b + L->control) != 0 || sy_rd(sy_rsc, b + L->enable) != 0 ||
+	    sy_rd(sy_rsc, b + L->wait) != 0) {
+		printf("PANDORA WLAN: RPMh: TCS2 busy; %s not voted\n", res);
+		return EBUSY;
+	}
+	sy_wr(sy_rsc, b + L->control, 0);
+	sy_wr(sy_rsc, SY_TCS_OFF + 8, bit);
+	if (!sy_rpmh_sync(b + L->msgid, SY_RPMH_WRITE) ||
+	    !sy_rpmh_sync(b + L->addr, address) ||
+	    !sy_rpmh_sync(b + L->data, data)) {
+		printf("PANDORA WLAN: RPMh: %s command write failed\n", res);
+		return EIO;
+	}
+	if (!sy_rpmh_sync(b + L->wait, 1) || !sy_rpmh_sync(b + L->enable, 1)) {
+		printf("PANDORA WLAN: RPMh: %s arm failed\n", res);
+		return EIO;
+	}
+	sy_wr(sy_rsc, SY_TCS_OFF, sy_rd(sy_rsc, SY_TCS_OFF) | bit);
+	sy_wr(sy_rsc, b + L->control, SY_RPMH_AMC);
+	sy_wr(sy_rsc, b + L->control, SY_RPMH_AMC | SY_RPMH_TRIGGER);
+	for (unsigned us = 0; us < 10000 && !done; us++) {
+		done = ((sy_rd(sy_rsc, SY_TCS_OFF + 4) & bit) != 0) &&
+		    sy_rd(sy_rsc, b + L->status) != 0;
+		if (!done)
+			delay(1);
+	}
+	printf("PANDORA WLAN: RPMh: %s addr %#x data %u on TCS2 done=%d irq=%#x status=%#x\n",
+	    res, address, data, done, sy_rd(sy_rsc, SY_TCS_OFF + 4),
+	    sy_rd(sy_rsc, b + L->status));
+	return done ? 0 : ETIMEDOUT;
+}
+
+static bool
+sy_supplies_on(void)
+{
+	for (unsigned i = 0; i < SY_SUPPLY_N; i++) {
+		const struct sy_supply *s = &sy_supplies[i];
+		int rc;
+
+		printf("PANDORA WLAN: voting %s (%s) at %u mV%s\n", s->name, s->what,
+		    s->mv, s->ldo ? " LDO" : " SMPS");
+		if (s->mv * 1000 < s->min_uv || s->mv * 1000 > s->max_uv) {
+			printf("PANDORA WLAN: %u mV for %s is outside %u-%u uV\n", s->mv,
+			    s->name, s->min_uv, s->max_uv);
+			return false;
+		}
+		rc = sy_rpmh_vote_res(s->name, s->mv, s->ldo ? 7 : 0, s->ldo);
+		if (rc != 0) {
+			printf("PANDORA WLAN: the vote for %s failed (%d)\n", s->name, rc);
+			return false;
+		}
+		printf("PANDORA WLAN: %s on at %u mV\n", s->name, s->mv);
+	}
+	/* cnss-peach node: clocks = <&rsc_clk 6> "rf_clk" and wcal-pbs-supply; both are
+	 * RPMh resources the vendor cnss driver enables, and both were missing here. */
+	{
+		int rfclk = 1, wcal = 1;
+
+		(void)PE_parse_boot_argn("songyuan_rfclk", &rfclk, sizeof(rfclk));
+		if (rfclk) {
+			/* clk-rpmh.c canoe table: [RPMH_RF_CLK1] = clk_rpmh_c1a_e0_div1, defined as
+			 * DEFINE_CLK_RPMH_VRM(c1a_e0, _div1, "C1A_E0", 1) - the cmd-db resource name is
+			 * UPPERCASE "C1A_E0"; the DT consumer name is "rf_clk". Enable word at +4, data 1. */
+			printf("PANDORA WLAN: voting rf_clk (RPMh VRM clock C1A_E0 +4, data 1)\n");
+			if (sy_rpmh_vote1("C1A_E0", 4, 1) != 0)
+				printf("PANDORA WLAN: the rf_clk vote failed\n");
+		}
+		(void)wcal;
+	}
+	return true;
+}
+
+/* ---- power domains and clocks -------------------------------------------------- */
+
+static bool
+sy_gdsc_on(uint32_t gdscr, uint32_t vote_bit, const char *name)
+{
+	/* gcc-canoe.c: both PCIe GDSCs are VOTABLE; 0x5214c BIT(0) collapses the root
+	 * complex's domain and BIT(2) the PHY's (1 = collapse). Clear the vote first, poll
+	 * the power-up bit, then fall back to the domain's own switch. Read PWR_ON back so
+	 * the log proves the domain is really powered. */
+	sy_gcc_wr(0x5214c, sy_gcc_rd(0x5214c) & ~vote_bit);
+	if (!sy_gcc_poll(gdscr + GCC_GDSC_CFG, GDSC_PWR_UP_DONE, GDSC_PWR_UP_DONE, 50, 2000,
+	    name)) {
+		sy_gcc_wr(gdscr, sy_gcc_rd(gdscr) & ~GDSC_SW_COLLAPSE);
+		if (!sy_gcc_poll(gdscr + GCC_GDSC_CFG, GDSC_PWR_UP_DONE, GDSC_PWR_UP_DONE, 50,
+		    2000, name)) {
+			return false;
+		}
+	}
+	printf("PANDORA WLAN: %s on: gdscr %#x cfg %#x collapse %#x power_on %u\n", name,
+	    sy_gcc_rd(gdscr), sy_gcc_rd(gdscr + 4), sy_gcc_rd(0x5214c),
+	    (sy_gcc_rd(gdscr) & GDSC_PWR_ON) ? 1u : 0u);
+	return true;
+}
+
+static bool
+sy_rcg_set(uint32_t rcg, uint32_t cfg, const char *name)
+{
+	sy_gcc_wr(rcg, sy_gcc_rd(rcg) | RCG_ROOT_EN);
+	if (!sy_gcc_poll(rcg, RCG_ROOT_OFF, 0, 10, 500, name)) {
+		return false;
+	}
+	sy_gcc_wr(rcg + 4, cfg);
+	sy_gcc_wr(rcg, sy_gcc_rd(rcg) | RCG_UPDATE);
+	if (!sy_gcc_poll(rcg, RCG_UPDATE, 0, 10, 500, name)) {
+		return false;
+	}
+	sy_gcc_wr(rcg, sy_gcc_rd(rcg) & ~RCG_ROOT_EN);
+	return true;
+}
+
+static bool
+sy_clocks_on(void)
+{
+	static const uint32_t branches[] = {
+		GCC_SLV_AXI, GCC_MSTR_AXI, GCC_CFG_AHB, GCC_AUX, GCC_Q2A, GCC_CNOC_SF
+	};
+
+	if (!sy_gdsc_on(GCC_GDSC_PCIE, 1UL << 0, "root complex 0's power domain") ||
+	    !sy_gdsc_on(GCC_GDSC_PHY, 1UL << 2, "the PHY's power domain")) {
+		return false;
+	}
+	/* aux: bi_tcxo (parent 0 in gcc_parent_map_6), no divider -> 19.2 MHz */
+	if (!sy_rcg_set(GCC_AUX_RCG, 0x000, "aux at 19.2 MHz")) {
+		return false;
+	}
+	/* gcc-canoe gcc_pcie_0_phy_rchng_clk_src: 100 MHz = P_GCC_GPLL0_OUT_EVEN(6) /3 */
+	if (!sy_rcg_set(GCC_RCHNG_RCG, 0x602, "rchng at 100 MHz")) {
+		printf("PANDORA WLAN: the rchng RCG did not lock\n");
+	}
+	sy_wr(tcsr, SY_TCSR_CLKREF, sy_rd(tcsr, SY_TCSR_CLKREF) | 1);
+	sy_usleep(10);
+	/* gcc-canoe/like the local driver's clk_init: switch the pipe clock source to the PHY
+	 * before the clocks are enabled (clk_set_parent(pipe_clk_mux, pipe_clk_ext_src)). */
+	sy_gcc_wr(GCC_PIPE_MUX, sy_gcc_rd(GCC_PIPE_MUX) & ~3UL);
+	printf("PANDORA WLAN: pipe mux %#x (PHY pipe source)\n", sy_gcc_rd(GCC_PIPE_MUX));
+	sy_gcc_wr(GCC_VOTE_BRANCH, sy_gcc_rd(GCC_VOTE_BRANCH) | 0x6f);	/* slv/mstr/cfg/aux/q2a/cnoc_sf, pipe added with the PHY */
+	/* Local gcc-canoe.c, verified against the live DT: bit 20 is
+	 * gcc_cfg_noc_pcie_anoc_ahb_clk (enable_reg 0x52000, HALT_SKIP). Without it
+	 * the PCIe anoc (its QTB/BCM voter block) is not clocked: register access and
+	 * link training still work, but the endpoint's DMA is dropped by the NoC,
+	 * which is exactly the "BHI fails, no SMMU fault anywhere" symptom. */
+	sy_gcc_wr(GCC_VOTE_BRANCH2, sy_gcc_rd(GCC_VOTE_BRANCH2) |
+	    (1UL << 12) | (1UL << 19) | (1UL << 20) | (1UL << 22));
+	sy_gcc_wr(0x52018, sy_gcc_rd(0x52018) | (1UL << 31));	/* gcc_pcie_0_phy_aux_clk */
+	for (unsigned i = 0; i < (sizeof(branches) / sizeof(branches[0])); i++) {
+		if (!sy_gcc_poll(branches[i], CBCR_CLK_OFF, 0, 10, 1000, "a PCIe clock branch")) {
+			printf("PANDORA WLAN: branch at GCC %#x stays off\n", branches[i]);
+			return false;
+		}
+	}
+	/* Completeness audit: print the exact masks this driver relies on so a missing
+	 * clock bit is visible in every boot log (the 2026-11-09 ANOC AHB omission was
+	 * invisible for 20+ builds because only "domains on" was printed). */
+	printf("PANDORA WLAN: clock audit: GCC 0x52008 %#x (want bits 0-3,5,6; pipe 4 with the PHY) "
+	    "0x52000 %#x (want bits 12,19,20,22) 0x52018 %#x (want bit 31)\n",
+	    sy_gcc_rd(GCC_VOTE_BRANCH), sy_gcc_rd(GCC_VOTE_BRANCH2), sy_gcc_rd(0x52018));
+	printf("PANDORA WLAN: domains on; aux, reference and branch clocks running\n");
+	return true;
+}
+
+/* ---- pins (port-proven TLMM CTL layout) ---------------------------------------- */
+
+/* TLMM CTL low bits: pull [1:0], func [5:2], drive [8:6], OE [9]; EGPIO present [11],
+ * enable [12]. The port's proven sy_gpio() keeps everything above the low mask and mirrors
+ * ENABLE from whatever PRESENT the boot chain left, so the pad is never re-purposed. */
+static vm_offset_t
+sy_pin_reg(uint32_t pin, uint32_t add)
+{
+	if (pin >= 16 && pin <= 19) {
+		return tlmm_low + (pin - 16) * 0x1000UL + add;
+	}
+	return tlmm + (pin - 102) * 0x1000UL + add;
+}
+
+static void
+sy_pin_ctl(uint32_t pin, uint32_t low)
+{
+	vm_offset_t ctl = sy_pin_reg(pin, 0);
+	uint32_t old = *(volatile uint32_t *)ctl;
+	uint32_t value = (old & ~(0x3ffu | (1u << 12))) | (low & 0x3ffu);
+
+	if (old & (1u << 11)) {
+		value |= (1u << 12);
+	}
+	*(volatile uint32_t *)ctl = value;
+}
+
+static void
+sy_pin_level(uint32_t pin, uint32_t level)
+{
+	*(volatile uint32_t *)sy_pin_reg(pin, 4) = level;
+}
+
+static void
+sy_pin_out(uint32_t pin, uint32_t low)
+{
+	sy_pin_level(pin, 0);	/* level before the output enable, so the pin never glitches */
+	sy_pin_ctl(pin, low);
+}
+
+/* ---- PARF, PHY, root port, link ------------------------------------------------ */
+
+static void
+sy_sm_state(const char *when)
+{
+	printf("PANDORA WLAN: CESTA %s: start %#x state %#x %#x %#x %#x %#x %#x\n", when,
+	    sy_rd(pcism, SY_SM_START_OFF), sy_rd(pcism, SY_SM_DBG0),
+	    sy_rd(pcism, SY_SM_DBG0 + 8), sy_rd(pcism, SY_SM_DBG0 + 0x10),
+	    sy_rd(pcism, SY_SM_DBG0 + 0x18), sy_rd(pcism, SY_SM_DBG0 + 0x40),
+	    sy_rd(pcism, SY_SM_DBG0 + 0x50));
+}
+
+static void
+sy_sm_load(void)
+{
+	uint32_t probe = sy_rd(pcism, SY_SM_START_OFF);
+
+	sy_sm_state("before load");
+	if (probe == 0xffffffffUL) {
+		printf("PANDORA WLAN: CESTA does not answer (start %#x); not touching it\n", probe);
+		return;
+	}
+	/* pci-msm-drv.pcie_sm_regs=0x1D07000,0x1040,0x1048,0x3000,0x1: clear instance 0's
+	 * PWR_CTRL/PWR_MASK overrides before loading the sequence, as msm_pcie_cesta_load_sm_seq
+	 * does. */
+	sy_wr(pcism, SY_SM_PWR_CTRL, 0);
+	sy_wr(pcism, SY_SM_PWR_MASK, 0);
+	for (unsigned i = 0; i < sizeof(sy_sm_seq) / sizeof(sy_sm_seq[0]); i++) {
+		sy_wr(pcism, 4 * i, sy_sm_seq[i]);
+	}
+	for (unsigned i = 0; i < sizeof(sy_sm_branch) / sizeof(sy_sm_branch[0]); i++) {
+		sy_wr(pcism, SY_SM_BRANCH_OFF + 4 * i, sy_sm_branch[i]);
+	}
+	sy_wr(pcism, SY_SM_START_OFF, sy_rd(pcism, SY_SM_START_OFF) | 1);
+	sy_sm_state("after load+start");
+}
+
+static void
+sy_parf_setup(void)
+{
+	sy_wr(parf, PARF_DEVICE_TYPE, 0x4);			/* root complex */
+	sy_wr(parf, PARF_PHY_CTRL, sy_rd(parf, PARF_PHY_CTRL) & ~1UL);
+	sy_wr(parf, PARF_DBI_BASE, (uint32_t)SY_DBI_PA);
+	sy_wr(parf, PARF_DBI_BASE + 4, (uint32_t)(SY_DBI_PA >> 32));
+	sy_wr(parf, PARF_ATU_BASE, (uint32_t)SY_IATU_PA);
+	sy_wr(parf, PARF_ATU_BASE + 4, (uint32_t)(SY_IATU_PA >> 32));
+	/* Upstream pcie-qcom (2.7.0+ IP) qcom_pcie_avoid_dbi_atu_mirroring(): write U64_MAX to
+	 * PARF_SLV_ADDR_SPACE_SIZE/_HI so the PARF stops mirroring DBI and ATU every 16 MiB;
+	 * the DBI/ATU base registers written above then place both blocks at their DT addresses.
+	 * (The old 0 / 0x80000000 values are the legacy pci-msm programming; the new IP needs
+	 * U64_MAX.)
+	 * https://lore.kernel.org/all/8877e1f7-bbb6-49e9-a30c-0ae8e40bf5dd@quicinc.com/T/#t */
+	sy_wr(parf, PARF_SLV_SPACE_SIZE, 0xffffffffUL);
+	sy_wr(parf, PARF_SLV_SPACE_SIZE + 4, 0xffffffffUL);
+	sy_wr(parf, PARF_SYS_CTRL, 0x365e);	/* pci-msm.c msm_pcie_enable_link */
+	sy_wr(parf, 0x174, sy_rd(parf, 0x174) | (1UL << 4));	/* MHI_CLOCK_RESET_CTRL bypass */
+	sy_wr(parf, 0x020, sy_rd(parf, 0x020) & ~(1UL << 5));	/* PM_CTRL: no L1 entry */
+	sy_wr(parf, 0x1a8, sy_rd(parf, 0x1a8) | (1UL << 31));	/* AXI_MSTR_WR_ADDR_HALT */
+	sy_wr(parf, PARF_CLKREQ_SEL, sy_rd(parf, PARF_CLKREQ_SEL) & ~1UL);
+	printf("PANDORA WLAN: PARF glue set (device type, DBI/ATU base, SLV window, L1 policy)\n");
+	/* The DBI read is deferred to after the PHY: the vendor driver never accesses DBI
+	 * before pcie_phy_init() and the pipe clock are up. */
+}
+
+static bool
+sy_phy_start(void)
+{
+	/* pci-msm.c pcie_phy_init: the device tree sequence is written in order (its last
+	 * entries are the PCS SW_RESET and START_CONTROL writes), the PHY is given time to
+	 * stabilise, then the pipe clock is enabled and PHYSTATUS is awaited (bit set = the
+	 * PHY is not ready). */
+	for (unsigned i = 0; i < SY_PHY_ROWS; i++) {
+		sy_wr(phy, sy_phy_seq[i][0], sy_phy_seq[i][1]);
+	}
+	sy_usleep(1000);
+	/* pci-msm.c pcie_phy_init order: the pipe clock is selected and enabled only
+	 * after the PHY sequence, then the pipe interface gets an assert/deassert reset
+	 * (1 ms) before PHYSTATUS is awaited. gcc-canoe has no dedicated pipe reset, so
+	 * the pipe side of that reset uses PCIE_0_PHY_NOCSR_COM_PHY_BCR (0x6c028); the
+	 * live DT has no "pcie_0_phy_pipe_reset" property either. */
+	sy_gcc_wr(GCC_PIPE_MUX, sy_gcc_rd(GCC_PIPE_MUX) & ~3UL);
+	sy_gcc_wr(GCC_VOTE_BRANCH, sy_gcc_rd(GCC_VOTE_BRANCH) | (1UL << 4));
+	sy_gcc_wr(GCC_BCR_PHY_NOCSR, sy_gcc_rd(GCC_BCR_PHY_NOCSR) | 1);
+	sy_usleep(1000);
+	sy_gcc_wr(GCC_BCR_PHY_NOCSR, sy_gcc_rd(GCC_BCR_PHY_NOCSR) & ~1UL);
+	printf("PANDORA WLAN: pipe source %#x, pipe reset bcr %#x, pipe branch %#x\n",
+	    sy_gcc_rd(GCC_PIPE_MUX), sy_gcc_rd(GCC_BCR_PHY_NOCSR), sy_gcc_rd(GCC_PIPE));
+	if (!sy_poll(phy, PHY_STATUS, PHY_STATUS_BIT, 0, 200, 200000, "the PHY's PHYSTATUS")) {
+		return false;
+	}
+	printf("PANDORA WLAN: PHY started (%u writes), pipe branch %#x\n",
+	    (unsigned)SY_PHY_ROWS, sy_gcc_rd(GCC_PIPE));
+	return true;
+}
+
+static void
+sy_diag_regs(const char *when)
+{
+	printf("PANDORA WLAN: %s: parf dev-type %#x sys %#x l1 %#x slv_lo %#x slv_hi %#x atu_lo %#x atu_hi %#x int_mask %#x int2 %#x\n",
+	    when, sy_rd(parf, PARF_DEVICE_TYPE), sy_rd(parf, PARF_SYS_CTRL),
+	    sy_rd(parf, 0x020), sy_rd(parf, 0x358), sy_rd(parf, 0x35c),
+	    sy_rd(parf, 0x634), sy_rd(parf, 0x638), sy_rd(parf, 0x22c), sy_rd(parf, 0x50c));
+	printf("PANDORA WLAN: %s: gcc aux-halt %#x rchng-halt %#x pipe-halt %#x; dbi %#x\n",
+	    when, sy_gcc_rd(GCC_AUX), sy_gcc_rd(0x6b074), sy_gcc_rd(GCC_PIPE), sy_rd(dbi, 0));
+}
+
+static void
+sy_iatu_ecam(void)
+{
+	sy_wr(iatu, IATU_CTRL2(0), 0);
+	sy_wr(iatu, IATU_CTRL1(0), IATU_TYPE_CFG0);
+	sy_wr(iatu, IATU_LBAR(0), (uint32_t)SY_CONF_PA);
+	sy_wr(iatu, IATU_UBAR(0), (uint32_t)(SY_CONF_PA >> 32));
+	sy_wr(iatu, IATU_LAR(0), (uint32_t)(SY_CONF_PA + 0xfffff));
+	sy_wr(iatu, IATU_CTRL2(0), IATU_ENABLE | IATU_CFG_SHIFT);
+	/* pci-msm.c: the cfg0 window is the ECAM for bus 1 (endpoint); root port config is DBI. */
+	
+	/* pci-msm.c msm_pcie_iatu_setup_ecam_blocker: point ECAM at the DBI base and block
+	 * every function of bus 0 except the root port's own config space. */
+	sy_wr(parf, PARF_ECAM_BASE, (uint32_t)SY_DBI_PA);
+	sy_wr(parf, PARF_ECAM_BASE + 4, (uint32_t)(SY_DBI_PA >> 32));
+	sy_wr(parf, 0x360, (uint32_t)SY_DBI_PA + 0x1000);	/* BLOCK_SLV_AXI_WR_BASE */
+	sy_wr(parf, 0x364, (uint32_t)(SY_DBI_PA >> 32));
+	sy_wr(parf, 0x370, (uint32_t)SY_DBI_PA + 0x1000);	/* BLOCK_SLV_AXI_RD_BASE */
+	sy_wr(parf, 0x374, (uint32_t)(SY_DBI_PA >> 32));
+	sy_wr(parf, 0x368, (uint32_t)SY_DBI_PA + 0xfffff);	/* WR limit */
+	sy_wr(parf, 0x36c, (uint32_t)(SY_DBI_PA >> 32));
+	sy_wr(parf, 0x378, (uint32_t)SY_DBI_PA + 0xfffff);	/* RD limit */
+	sy_wr(parf, 0x37c, (uint32_t)(SY_DBI_PA >> 32));
+	sy_wr(parf, PARF_SYS_CTRL, sy_rd(parf, PARF_SYS_CTRL) | 0x04000000);	/* PCIE_ECAM_BLOCKER_EN */
+	printf("PANDORA WLAN: ECAM bus1 window %#lx via iATU0 (CFG0); root port id (DBI) %#x, endpoint id %#x\n",
+	    (unsigned long)SY_CONF_PA, sy_rd(dbi, 0), sy_rd(conf, 0));
+	printf("PANDORA WLAN: iATU0 readback: ctrl1 %#x ctrl2 %#x lbar %#x ubar %#x lar %#x\n",
+	    sy_rd(iatu, IATU_CTRL1(0)), sy_rd(iatu, IATU_CTRL2(0)), sy_rd(iatu, IATU_LBAR(0)),
+	    sy_rd(iatu, IATU_UBAR(0)), sy_rd(iatu, IATU_LAR(0)));
+}
+
+/* Size BAR0 the way the PCI core does: disable decode, write all ones to the whole
+ * (64-bit) BAR, read the mask, restore. M1 kernel_25 showed the old 32-bit-only path
+ * returning size 0xffffffff00200000; the endpoint's BAR0 is a 64-bit memory BAR. */
+static uint64_t
+sy_bar0_size(uint32_t *type, bool *is64)
+{
+	uint32_t cmd = sy_rd(conf, SY_EP_CONF + 0x04);
+	uint32_t lo = sy_rd(conf, SY_EP_CONF + 0x10);
+	uint32_t hi = sy_rd(conf, SY_EP_CONF + 0x14);
+	uint64_t mask;
+
+	*type = lo & 0xfUL;
+	*is64 = (lo & 0x6UL) == 0x4UL;	/* PCI BAR encoding: bits[2:1]=10 -> 64-bit mem */
+	sy_wr(conf, SY_EP_CONF + 0x04, cmd & ~0x6UL);	/* memory decode + bus master off while sizing */
+	sy_usleep(1000);
+	sy_wr(conf, SY_EP_CONF + 0x10, 0xffffffffUL);
+	if (*is64)
+		sy_wr(conf, SY_EP_CONF + 0x14, 0xffffffffUL);
+	mask = (uint64_t)sy_rd(conf, SY_EP_CONF + 0x10);
+	if (*is64) {
+		mask |= (uint64_t)sy_rd(conf, SY_EP_CONF + 0x14) << 32;
+	} else {
+		mask &= 0xffffffffULL;		/* 32-bit BAR: the high word is not part of it */
+	}
+	sy_wr(conf, SY_EP_CONF + 0x10, lo);
+	if (*is64)
+		sy_wr(conf, SY_EP_CONF + 0x14, hi);
+	sy_wr(conf, SY_EP_CONF + 0x04, cmd);
+	if (!mask || mask == 0xffffffffffffffffULL || mask == 0xffffffffUL) {
+		return 0;
+	}
+	return ~(mask & ~0xfULL) + 1ULL;
+}
+
+static bool
+sy_config_read(void)
+{
+	uint32_t rc = sy_rd(dbi, 0);
+	uint32_t pm_state = 0xffffffffUL;	/* PMCSR power state seen by the PCI enable block */		/* root port config lives at the DBI base */
+	uint32_t ep = sy_rd(conf, 0);		/* cfg0 ECAM window = bus 1 device 0 function 0 */
+
+	printf("PANDORA WLAN: config: root port (bus 0) id %#x, endpoint (bus 1) id %#x\n", rc, ep);
+	printf("PANDORA WLAN: endpoint config[0] = %#x -> vendor %#x device %#x\n", ep,
+	    ep & 0xffff, ep >> 16);
+	if ((ep & 0xffff) != 0x17cb || (ep >> 16) != 0x110e) {
+		return false;
+	}
+	{
+		uint32_t bar_type = 0;
+		bool bar64 = false;
+		uint64_t bar_size = sy_bar0_size(&bar_type, &bar64);
+
+		printf("PANDORA WLAN: M1 endpoint found; BAR0 raw %#x/%#x type %#x 64bit %u size %#llx\n",
+		    sy_rd(conf, SY_EP_CONF + 0x10), sy_rd(conf, SY_EP_CONF + 0x14), bar_type, bar64 ? 1u : 0u,
+		    (unsigned long long)bar_size);
+	}
+	/* M2: assign BAR0 0x40400000 / BAR2 0x40300000 (Android golden addresses) and reach
+	 * BAR0 through iATU region 1, then dump the first MHI/BHI words read-only. */
+	{
+	/* saved so the endpoint's original command register can be restored afterwards */
+	uint32_t pci_cmd = sy_rd(conf, SY_EP_CONF + 0x04);
+	{
+		int bar_on = 0;	/* BAR assign + BAR0 read stay off until CFG1 is proven */
+		(void)PE_parse_boot_argn("songyuan_bar", &bar_on, sizeof(bar_on));
+		if (!bar_on && sy_step < 7) {
+			printf("PANDORA WLAN: M2 BAR test skipped (songyuan_bar=0, sy_step=%d); windows verified only\n",
+			    sy_step);
+			return true;
+		}
+	}
+	sy_wr(conf, SY_EP_CONF + 0x10, (uint32_t)SY_BAR0_PA | 0x4UL);	/* 64-bit mem BAR, address part */
+	sy_wr(conf, SY_EP_CONF + 0x14, (uint32_t)(SY_BAR0_PA >> 32));
+	sy_wr(conf, SY_EP_CONF + 0x04, sy_rd(conf, SY_EP_CONF + 0x04) | 0x2UL);	/* memory space decode on */
+	sy_usleep(1000);
+	{
+		/* Standard PCI enable, which the Linux PCI core does for the vendor driver:
+		 * walk the capability list for the PM capability, put the endpoint in D0
+		 * (PMCSR state 0), then set Command = Memory Space | Bus Master (0x6). */
+		uint32_t status = (sy_rd(conf, SY_EP_CONF + 0x04) >> 16) & 0xffffUL;
+		uint32_t cap = 0, pm_cap = 0, pmcsr_off = 0, pmcsr0, pmcsr1, cmd0, cmd1;
+		unsigned i, sh;
+
+		cmd0 = sy_rd(conf, SY_EP_CONF + 0x04) & 0xffffUL;
+		if (status & 0x10UL) {
+			cap = sy_rd(conf, SY_EP_CONF + 0x34) & 0xffUL;
+			for (i = 0; i < 32 && cap >= 0x40 && cap < 0xff; i++) {
+				uint32_t hdr = sy_rd(conf, SY_EP_CONF + (cap & ~3UL));
+				sh = (cap & 3UL) * 8UL;
+				if (((hdr >> sh) & 0xffUL) == 0x01UL) {
+					pm_cap = cap;
+					break;
+				}
+				cap = (hdr >> (sh + 8UL)) & 0xffUL;
+			}
+		}
+		pmcsr0 = 0xffffffffUL;
+		if (pm_cap) {
+			pmcsr_off = pm_cap + 4UL;
+			uint32_t v = sy_rd(conf, SY_EP_CONF + (pmcsr_off & ~3UL));
+			sh = (pmcsr_off & 3UL) * 8UL;
+			pmcsr0 = (v >> sh) & 0xffffUL;
+			if ((pmcsr0 & 3UL) != 0) {
+				*(volatile uint16_t *)(conf + SY_EP_CONF + pmcsr_off) =
+				    (uint16_t)(pmcsr0 & ~3UL);	/* D0 */
+				sy_usleep(1000);
+			}
+			uint32_t v2 = sy_rd(conf, SY_EP_CONF + (pmcsr_off & ~3UL));
+			pmcsr1 = (v2 >> sh) & 0xffffUL;		/* 0 = D0 */
+			pm_state = pmcsr1;
+		} else {
+			pmcsr1 = 0xffffffffUL;
+		}
+		*(volatile uint16_t *)(conf + SY_EP_CONF + 0x04) =
+		    (uint16_t)(cmd0 | 0x2UL);	/* memory only; bus master at MHI (plan L240) */
+		{
+			unsigned w;
+
+			for (w = 0; w < 20 && !(sy_rd(conf, SY_EP_CONF + 0x04) & 0x2UL); w++)
+				sy_usleep(1000);
+		}
+		cmd1 = sy_rd(conf, SY_EP_CONF + 0x04) & 0xffffUL;
+		printf("PANDORA WLAN: PCI enable: pm cap %#x pmcsr %#x -> %#x; cmd %#x -> %#x\n",
+		    pm_cap, pmcsr0, pmcsr1, cmd0, cmd1);
+	}
+	/* The root port only forwards memory TLPs that fall inside its Type1 memory
+	 * base/limit window (DBI 0x20); Linux' enumeration programs it (the working k90
+	 * port does the same in assign_bar0(): wr(dm_core + 0x20, ...)). Also give the
+	 * bridge its bus numbers (DBI 0x18: primary 0, secondary 1, subordinate 1). */
+	sy_wr(dbi, 0x18, 0x00010100UL);
+	sy_wr(dbi, 0x20, ((uint32_t)(SY_BAR0_PA + SY_BAR0_SIZE - 1) & 0xfff00000UL) |
+	    (((uint32_t)SY_BAR0_PA >> 16) & 0xfff0UL));
+	printf("PANDORA WLAN: root port window: dbi18 %#x dbi20 %#x (BAR0 %#x..%#x)\n",
+	    sy_rd(dbi, 0x18), sy_rd(dbi, 0x20), (uint32_t)SY_BAR0_PA,
+	    (uint32_t)(SY_BAR0_PA + SY_BAR0_SIZE - 1));
+	sy_wr(conf, SY_EP_CONF + 0x18, (uint32_t)SY_BAR2_PA | 0x4UL);	/* BAR2: 64-bit mem, 32 KiB */
+	sy_wr(conf, SY_EP_CONF + 0x1c, (uint32_t)(SY_BAR2_PA >> 32));
+	printf("PANDORA WLAN: BAR0 assigned: config10 %#x/%#x, BAR2: config18 %#x/%#x, cmd %#x status %#x\n",
+	    sy_rd(conf, SY_EP_CONF + 0x10), sy_rd(conf, SY_EP_CONF + 0x14),
+	    sy_rd(conf, SY_EP_CONF + 0x18), sy_rd(conf, SY_EP_CONF + 0x1c),
+	    sy_rd(conf, SY_EP_CONF + 0x04) & 0xffffUL,
+	    (sy_rd(conf, SY_EP_CONF + 0x04) >> 16) & 0xffffUL);
+	sy_wr(iatu, IATU_CTRL2(1), 0);
+	sy_wr(iatu, IATU_CTRL1(1), IATU_TYPE_MEM);
+	sy_wr(iatu, IATU_LBAR(1), (uint32_t)SY_MEM_BASE);
+	sy_wr(iatu, IATU_UBAR(1), (uint32_t)(SY_MEM_BASE >> 32));
+	sy_wr(iatu, IATU_LAR(1), (uint32_t)(SY_MEM_BASE + SY_MEM_SIZE - 1));
+	sy_wr(iatu, IATU_LTAR(1), (uint32_t)SY_MEM_BASE);	/* identity: host==pci */
+	sy_wr(iatu, IATU_LTAR_HI(1), (uint32_t)(SY_BAR0_PA >> 32));
+	sy_wr(iatu, IATU_CTRL2(1), 0x80000000UL);
+	printf("PANDORA WLAN: iATU1 readback: ctrl1 %#x ctrl2 %#x lbar %#x ubar %#x lar %#x ltar %#x/%#x\n",
+	    sy_rd(iatu, IATU_CTRL1(1)), sy_rd(iatu, IATU_CTRL2(1)), sy_rd(iatu, IATU_LBAR(1)),
+	    sy_rd(iatu, IATU_UBAR(1)), sy_rd(iatu, IATU_LAR(1)), sy_rd(iatu, IATU_LTAR(1)),
+	    sy_rd(iatu, IATU_LTAR_HI(1)));
+	/* Is the iATU we program (DT "iatu", 0x410000000) the same instance the
+	 * hardware uses? The same-card fuxi port and the K90 port both access the
+	 * ATU registers at DBI + 0x1000. Print both aliases read-only. */
+	{
+		uint32_t a0[7], b0[7], a1[7], b1[7];
+		unsigned i;
+
+		for (i = 0; i < 7; i++) {
+			a0[i] = sy_rd(iatu, IATU_REGION(0) + 4 * i);
+			b0[i] = sy_rd(dbi, 0x1000 + IATU_REGION(0) + 4 * i);
+			a1[i] = sy_rd(iatu, IATU_REGION(1) + 4 * i);
+			b1[i] = sy_rd(dbi, 0x1000 + IATU_REGION(1) + 4 * i);
+		}
+		printf("PANDORA WLAN: ATU@iatu_r0:     %#x %#x %#x %#x %#x %#x %#x\n",
+		    a0[0], a0[1], a0[2], a0[3], a0[4], a0[5], a0[6]);
+		printf("PANDORA WLAN: ATU@dbi+1000_r0: %#x %#x %#x %#x %#x %#x %#x\n",
+		    b0[0], b0[1], b0[2], b0[3], b0[4], b0[5], b0[6]);
+		printf("PANDORA WLAN: ATU@iatu_r1:     %#x %#x %#x %#x %#x %#x %#x\n",
+		    a1[0], a1[1], a1[2], a1[3], a1[4], a1[5], a1[6]);
+		printf("PANDORA WLAN: ATU@dbi+1000_r1: %#x %#x %#x %#x %#x %#x %#x\n",
+		    b1[0], b1[1], b1[2], b1[3], b1[4], b1[5], b1[6]);
+	}
+	{
+		int bar_read = 0;	/* the BAR0 read itself stays opt-in this round */
+		(void)PE_parse_boot_argn("songyuan_barread", &bar_read, sizeof(bar_read));
+		if (!bar_read && sy_step < 8) {
+			printf("PANDORA WLAN: BAR0 read skipped (songyuan_barread=0, sy_step=%d); ATU aliases dumped\n",
+			    sy_step);
+			return true;
+		}
+	}
+	if ((pm_state & 3UL) != 0 || !(sy_rd(conf, SY_EP_CONF + 0x04) & 0x2UL)) {
+		printf("PANDORA WLAN: PCI enable incomplete (pm state %#x, cmd %#x); "
+		    "skipping the BAR0 read\n", pm_state, sy_rd(conf, SY_EP_CONF + 0x04) & 0xffffUL);
+		return true;
+	}
+	{
+		/* plan L240: map only the head we read; 4 KiB page, one word first */
+		vm_offset_t mem = ml_io_map(SY_BAR0_PA, 0x1000);
+
+		sy_bar_va = mem;
+		if (!mem) {
+			printf("PANDORA WLAN: BAR0 page mapping failed\n");
+			return true;
+		}
+		printf("PANDORA WLAN: BAR0 %#llx word0 (MHI_REGLEN) %#x\n",
+		    (unsigned long long)SY_BAR0_PA, sy_rd(mem, 0));
+		if (sy_step >= 8) {
+			uint32_t ver = sy_rd(mem, 0x08), cfg = sy_rd(mem, 0x10);
+			uint32_t chdb = sy_rd(mem, 0x18), erdb = sy_rd(mem, 0x20);
+			uint32_t bhio = sy_rd(mem, 0x28), bhie = sy_rd(mem, 0x2c);
+			uint32_t ctrl = sy_rd(mem, 0x38), st = sy_rd(mem, 0x48);
+
+			printf("PANDORA WLAN: MHI: ver %#x (major %u minor %u) cfg %#x chdb %#x erdb %#x "
+			    "bhio %#x bhie %#x ctrl %#x status %#x state %u syserr %u\n",
+			    ver, ver & 0xffff, ver >> 16, cfg, chdb, erdb, bhio, bhie, ctrl, st,
+			    (st >> 8) & 0xff, (st >> 2) & 1);
+			if (bhio && (bhio & 3u) == 0 && bhio + 0x40u <= 0x1000u) {
+				printf("PANDORA WLAN: BHI: version %#x/%#x execenv %#x status %#x errcode %#x "
+				    "errdbg %#x/%#x/%#x\n",
+				    sy_rd(mem, bhio + 0x00), sy_rd(mem, bhio + 0x04),
+				    sy_rd(mem, bhio + 0x28), sy_rd(mem, bhio + 0x2c),
+				    sy_rd(mem, bhio + 0x30), sy_rd(mem, bhio + 0x34),
+				    sy_rd(mem, bhio + 0x38), sy_rd(mem, bhio + 0x3c));
+			} else {
+				printf("PANDORA WLAN: BHI: BHIOFF %#x not in the first 4 KiB page\n", bhio);
+			}
+		}
+		if (sy_step >= 9) {
+			uint64_t fo = 0, fs = 0;
+
+			if (sy_fw_find("amss20.bin", &fo, &fs) == 0) {
+				uint8_t h[16];
+				unsigned k;
+
+				(void)pandora_fw_read(fo, h, sizeof(h));
+				printf("PANDORA WLAN: fw amss20.bin off %#llx size %#llx magic %#x %#x %#x %#x\n",
+				    (unsigned long long)fo, (unsigned long long)fs,
+				    (unsigned)h[0] << 24 | (unsigned)h[1] << 16 | (unsigned)h[2] << 8 | h[3],
+				    (unsigned)h[4] << 24 | (unsigned)h[5] << 16 | (unsigned)h[6] << 8 | h[7],
+				    (unsigned)h[8] << 24 | (unsigned)h[9] << 16 | (unsigned)h[10] << 8 | h[11],
+				    (unsigned)h[12] << 24 | (unsigned)h[13] << 16 | (unsigned)h[14] << 8 | h[15]);
+			} else {
+				printf("PANDORA WLAN: fw amss20.bin not found in the pinned pack\n");
+			}
+		}
+		if (sy_step >= 10) {
+			uint64_t fo = 0, fs = 0;
+
+			if (sy_fw_find("amss20.bin", &fo, &fs) == 0) {
+				uint8_t h[64];
+				uint32_t entry_lo = 0, entry_hi = 0;
+				unsigned i;
+
+				if (pandora_fw_read(fo, h, sizeof(h)) == 0) {
+					for (i = 0; i < 4; i++) {
+						entry_lo |= (uint32_t)h[24 + i] << (8 * i);
+						entry_hi |= (uint32_t)h[28 + i] << (8 * i);
+					}
+					printf("PANDORA WLAN: fw ELF magic %c%c%c%c class %u data %u type %u mach %u "
+					    "entry %#x%08x size %#llx (expect 0x6fa8c0, pack size off by %#llx)\n",
+					    h[1], h[2], h[3], h[4], h[4], h[5], h[16] | h[17] << 8,
+					    h[18] | h[19] << 8, entry_hi, entry_lo,
+					    (unsigned long long)fs,
+					    (unsigned long long)(fs - (uint64_t)0x6fa8c0));
+				}
+			}
+		}
+		if (sy_step >= 11) {
+			vm_offset_t smmu = ml_io_map(0x15000000UL, 0x1000);
+
+			{
+				unsigned e;
+
+				for (e = 0; e < 8; e++)
+					printf("PANDORA WLAN: PARF SID[%#x] %#x %#x %#x %#x\n",
+					    0x2000 + e * 0x10, sy_rd(parf, 0x2000 + e * 0x10),
+					    sy_rd(parf, 0x2004 + e * 0x10), sy_rd(parf, 0x2008 + e * 0x10),
+					    sy_rd(parf, 0x200c + e * 0x10));
+				printf("PANDORA WLAN: PARF bypass[0x2c00] %#x [0x2c04] %#x\n",
+				    sy_rd(parf, 0x2c00), sy_rd(parf, 0x2c04));
+		}
+		if (sy_step >= 12) {
+			/* SID table init, same order as the local driver's msm_pcie_config_sid():
+			 * clear the bypass bit, zero the 256 x 4-byte table, then write the
+			 * endpoint entry (PARF 0x2000 + 4*SID) with the plan's value. */
+			uint32_t byp = sy_rd(parf, 0x2c00);
+			unsigned e;
+
+			sy_wr(parf, 0x2c00, byp & ~1u);
+			printf("PANDORA WLAN: SID init: bypass %#x -> %#x\n", byp, sy_rd(parf, 0x2c00));
+			for (e = 0; e < 256; e++)
+				sy_wr(parf, 0x2000 + 4 * e, 0);
+			sy_wr(parf, 0x2054, 0x01000100UL);
+			printf("PANDORA WLAN: SID init: [0x2054] readback %#x (expect 0x1000100)\n",
+			    sy_rd(parf, 0x2054));
+			for (e = 0; e < 4; e++)
+				printf("PANDORA WLAN: SID init: [%#x] %#x %#x %#x %#x\n",
+				    0x2048 + e * 0x10, sy_rd(parf, 0x2048 + e * 0x10),
+				    sy_rd(parf, 0x204c + e * 0x10), sy_rd(parf, 0x2050 + e * 0x10),
+				    sy_rd(parf, 0x2054 + e * 0x10));
+			}
+		if (sy_step >= 13) {
+			sy_buf_alloc();
+			sy_smmu_probe();
+		}
+		if (sy_step >= 14) {
+			sy_smmu_dump();
+			(void)sy_smmu_install();
+			sy_smmu_dump();
+			sy_icc_vote();
+		}
+		if (sy_step >= 15) {
+			sy_bhi_sbl();
+		}
+		if (sy_step >= 16 && sy_sbl_ok) {
+			sy_mhi_ready();
+		}
+		if (sy_step >= 17 && sy_sbl_ok) {
+			sy_mhi_init();
+		}
+		if (sy_step >= 18 && sy_sbl_ok) {
+			sy_bhi_bhie();
+		}
+		if (sy_step >= 19 && sy_sbl_ok && sy_keep_alive && (sy_mhi_m0_ok || sy_chan_force)) {
+			sy_mhi_chan_start();
+		}
+		if (sy_step >= 20 && sy_sbl_ok && sy_keep_alive && sy_wlfw_on && (sy_mhi_m0_ok || sy_chan_force)) {
+			sy_wlfw_run();
+			sy_mhi_poll();
+		}
+
+		/* stage 21: D1 - CE transport, HTC connect, WMI_INIT/WMI_READY.
+		 * The WLFW FW_READY wait runs inside sy_ce_run(), because sy_wlfw_state is
+		 * declared later in this file (C needs a declaration before the use). */
+		if (sy_step >= 21 && sy_sbl_ok && sy_keep_alive && sy_wlfw_on &&
+		    (sy_mhi_m0_ok || sy_chan_force)) {
+			sy_ce_run();	/* D1: CE + HTC + WMI */
+		}
+
+		/* stage 22: D2 - WMI after READY: hw mode, pdev params, vdev, scan,
+		 * and the connection commands up to VDEV_START.  sy_d2_run() checks
+		 * sy_wmi_ready itself because that flag is declared further down. */
+		if (sy_step >= 22 && sy_sbl_ok && sy_keep_alive && sy_wlfw_on &&
+		    (sy_mhi_m0_ok || sy_chan_force)) {
+			sy_d2_run();	/* D2: WMI after READY */
+		}
+		/* stage 23: D3 - HTT peer-map (the service itself is connected
+		 * in D1, before SETUP_COMPLETE) plus assoc, peer assoc, vdev up. */
+		if (sy_step >= 23 && sy_sbl_ok && sy_keep_alive && sy_wlfw_on &&
+		    (sy_mhi_m0_ok || sy_chan_force)) {
+			sy_d3_run();
+		}
+		/* stage 24: E - TCL/REO/WBM rings, RXDMA via HTT, buffers.
+		 * CE pipes stay the D1 rings; their device addresses match
+		 * hw_srng_table_peach. */
+		if (sy_step >= 24 && sy_sbl_ok && sy_keep_alive && sy_wlfw_on &&
+		    (sy_mhi_m0_ok || sy_chan_force)) {
+			sy_e_run();
+		}
+		/* stage 25 is sy_f_service() in sy_thread, after en0 is attached.
+		 * sy_run() returns before sy_net_attach(), so the data loop cannot
+		 * start here. */
+			if (smmu) {
+				printf("PANDORA WLAN: SMMU IDR0 %#x IDR1 %#x IDR2 %#x CR0 %#x\n",
+				    sy_rd(smmu, 0x00), sy_rd(smmu, 0x04), sy_rd(smmu, 0x08), sy_rd(smmu, 0x20));
+			} else {
+				printf("PANDORA WLAN: SMMU 0x15000000 mapping failed\n");
+			}
+		}
+	}
+	sy_wr(conf, SY_EP_CONF + 0x04, pci_cmd);	/* restore the endpoint's command register */
+	}
+	return true;
+}
+
+/* Locate a file in the pinned firmware pack (PANDFW01: u32 count, entries of
+ * {char name[48]; u64 offset; u64 size} at blk+16; names are basenames). */
+static int
+sy_fw_find(const char *name, uint64_t *off, uint64_t *size)
+{
+	uint8_t blk[4096];
+	uint32_t n = 0;
+	unsigned i, k;
+
+	if (pandora_fw_read(0, blk, sizeof(blk)))
+		return -1;
+	if (blk[0] != 'P' || blk[1] != 'A' || blk[2] != 'N' || blk[3] != 'D' ||
+	    blk[4] != 'F' || blk[5] != 'W' || blk[6] != '0' || blk[7] != '1')
+		return -1;
+	for (i = 0; i < 4; i++)
+		n |= (uint32_t)blk[8 + i] << (8 * i);
+	if (!n || n > 63)
+		return -1;
+	{
+		unsigned nl = 0;
+
+		while (name[nl] && nl < 47)
+			nl++;
+		for (i = 0; i < n; i++) {
+			const uint8_t *e = blk + 16 + i * 64;
+			uint64_t eo = 0, es = 0;
+
+			for (k = 0; k < nl; k++) {
+				if (e[k] != (uint8_t)name[k])
+					break;
+			}
+			if (k != nl || e[nl] != 0)
+				continue;
+			for (k = 0; k < 8; k++) {
+				eo |= (uint64_t)e[48 + k] << (8 * k);
+				es |= (uint64_t)e[56 + k] << (8 * k);
+			}
+			*off = eo;
+			*size = es;
+			return 0;
+		}
+	}
+	return -1;
+}
+
+/* Stage 13: read-only SMMU stream/CB selection (same layout as the working
+ * same-card port: SMR at GR0+0x800, S2CR at GR0+0xc00, CBs after GR1) plus the
+ * 32 MiB cnss_wlan_region-style DMA pool, all below 4 GiB. No SMMU writes yet. */
+
+
+static void
+sy_smmu_probe(void)
+{
+	vm_offset_t s = ml_io_map(0x15000000UL, 0x1000);
+	uint32_t cr0, id0, id1, id2, smr, s2cr;
+	unsigned streams, banks, shift, pages, ns2, i;
+	unsigned slot = ~0u;
+
+	if (!s) {
+		printf("PANDORA WLAN: SMMU probe: GR0 map failed\n");
+		return;
+	}
+	cr0 = sy_rd(s, 0x00); id0 = sy_rd(s, 0x20);
+	id1 = sy_rd(s, 0x24); id2 = sy_rd(s, 0x28);
+	streams = id0 & 0xff; banks = id1 & 0xff;
+	shift = (id1 >> 31) ? 16 : 12;
+	pages = 2u << ((id1 >> 28) & 7);
+	sy_pages = pages;
+	ns2 = (id1 >> 16) & 0xff;
+	printf("PANDORA WLAN: SMMU probe: cr0 %#x id0 %#x id1 %#x id2 %#x -> streams %u banks %u "
+	    "shift %u pages %u ns2 %u\n", cr0, id0, id1, id2, streams, banks, shift, pages, ns2);
+	sy_log_sync();
+	if ((cr0 & 0x401u) != 0x400u || !streams || streams > 128 || !banks || banks > 128 ||
+	    ns2 >= banks)
+		return;
+	for (i = 0; i < streams && slot == ~0u; i++) {
+		smr = sy_rd(s, 0x800 + 4 * i);
+		s2cr = sy_rd(s, 0xc00 + 4 * i);
+		if (!(smr & 0x80000000u) && (((s2cr >> 16) & 3) == 1 || ((s2cr >> 16) & 3) == 2))
+			slot = i;
+	}
+	if (slot == ~0u) {
+		printf("PANDORA WLAN: SMMU probe: no free stream slot\n");
+		return;
+	}
+	sy_smmu_va = s; sy_smmu_slot = slot;
+	sy_cr0 = cr0; sy_id0 = id0; sy_id1 = id1; sy_id2 = id2;
+	printf("PANDORA WLAN: SMMU probe: slot %u (bank chosen at install)\n", slot);
+	sy_log_sync();
+}
+
+/* Stage 14: build an identity 4 KiB page table for the DMA pool (IOVA =
+ * 0xB0000000, DT cnss_pci0 partition window 2) and install it on the free
+ * stream slot/context bank found by sy_smmu_probe(); order mirrors the working
+ * same-card port (SCTLR off, CBA2R/CBAR, TCR2/TCR, TTBR0, MAIR, SCTLR on,
+ * S2CR then SMR, TLBI + sync). Every write is read back. */
+static uint64_t
+sy_pa(vm_offset_t va)
+{
+	return ptoa_64(pmap_find_phys(kernel_pmap, va));
+}
+
+static int
+sy_pt_build(void)
+{
+	unsigned i, l3s;
+	uint64_t pa;
+	kern_return_t kr;
+
+	if (!sy_sbl_va || !sy_buf_size) {
+		printf("PANDORA WLAN: PT: no buffer\n");
+		return 1;
+	}
+	kr = kmem_alloc(kernel_map, &sy_l1, 0x2000,
+	    KMA_DATA | KMA_ZERO | KMA_NOPAGEWAIT, VM_KERN_MEMORY_IOKIT);
+	if (kr != KERN_SUCCESS) {
+		printf("PANDORA WLAN: PT: L1/L2 alloc failed %d\n", kr);
+		return 1;
+	}
+	sy_l2 = sy_l1 + 0x1000;
+	l3s = (sy_buf_size + 0x1fffffu) >> 21;
+	if (l3s > 16)
+		l3s = 16;
+	kr = kmem_alloc(kernel_map, &sy_l3, 0x10000,
+	    KMA_DATA | KMA_ZERO | KMA_NOPAGEWAIT, VM_KERN_MEMORY_IOKIT);
+	if (kr != KERN_SUCCESS) {
+		printf("PANDORA WLAN: PT: L3 alloc failed %d\n", kr);
+		return 2;
+	}
+	((uint64_t *)sy_l1)[(SY_IOVA_BASE >> 30) & 511] = sy_pa(sy_l2) | 3ull;
+	for (i = 0; i < l3s; i++)
+		((uint64_t *)sy_l2)[(((SY_IOVA_BASE >> 21) + i) & 511)] =
+		    sy_pa(sy_l3 + (i << 12)) | 3ull;
+	for (i = 0; i < (sy_buf_size >> 12); i++) {
+		pa = sy_pa(sy_sbl_va + ((vm_offset_t)i << 12));
+		((uint64_t *)(sy_l3 + ((i >> 9) << 12)))[i & 0x1ff] =
+		    (pa & 0x0000fffffffff000ull) | 0x0060000000000e43ull;
+	}
+	for (i = 0; i < (0x2000u >> 12); i++)
+		flush_dcache64(sy_pa(sy_l1 + (i << 12)), (unsigned)PAGE_SIZE, TRUE);
+	for (i = 0; i < (0x10000u >> 12); i++)
+		flush_dcache64(sy_pa(sy_l3 + (i << 12)), (unsigned)PAGE_SIZE, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("PANDORA WLAN: PT: iova %#x size %#x l1 %#lx root %#llx l3s %u\n",
+	    SY_IOVA_BASE, sy_buf_size, (unsigned long)sy_l1,
+	    (unsigned long long)sy_pa(sy_l1), l3s);
+	sy_log_sync();
+	return 0;
+}
+
+static int
+sy_smmu_install(void)
+{
+	uint32_t id0, id1, id2, cr0, v, sctlr, tcr2, smr, s2cr;
+	uint32_t shift, pages, ns2, banks, streams, ext, ps;
+	unsigned slot = ~0u, cb = ~0u, i, j, first = ~0u;
+	uint32_t old_smr = 0, old_s2cr = 0, new_smr, new_s2cr;
+	uint64_t ttbr, asid = 0, tt0, tt1;
+	uint8_t used[128];
+	uint64_t used_asid[256];
+	vm_offset_t gr1, cbp = 0, t;
+
+	if (!sy_smmu_va || !sy_sbl_va || !sy_buf_size) {
+		printf("PANDORA WLAN: SMMU install: missing probe/buffer\n");
+		return 1;
+	}
+	id0 = sy_id0; id1 = sy_id1; id2 = sy_id2; cr0 = sy_cr0;
+	streams = id0 & 0xffu; banks = id1 & 0xffu; ext = (cr0 >> 3) & 1u;
+	shift = (id1 >> 31) ? 16u : 12u;
+	pages = 2u << ((id1 >> 28) & 7u);
+	ns2 = (id1 >> 16) & 0xffu;
+	ps = (id2 & 15u) < ((id2 >> 4) & 15u) ? (id2 & 15u) : ((id2 >> 4) & 15u);
+	if (!streams || !banks || streams > 128u || banks > 128u || ns2 >= banks) {
+		printf("PANDORA WLAN: SMMU install: bad geometry %u/%u ns2 %u\n", streams, banks, ns2);
+		return 2;
+	}
+	gr1 = ml_io_map(0x15000000UL + (1u << shift), 0x1000);
+	if (!gr1) {
+		printf("PANDORA WLAN: SMMU install: GR1 map failed\n");
+		return 3;
+	}
+	for (i = 0; i < 128u; i++)
+		used[i] = 0;
+	for (i = 0; i < 256u; i++)
+		used_asid[i] = 0;
+	/* Exact QcomUsbDomainInstall scan(): the first free stream slot, every bank
+	 * referenced by an ACTIVE stream (s2cr & 0xff is the bank index), and a hard
+	 * error if another stream already covers our SID 0x1401. */
+	for (i = 0; i < streams; i++) {
+		smr = sy_rd(sy_smmu_va, 0x800 + 4 * i);
+		s2cr = sy_rd(sy_smmu_va, 0xc00 + 4 * i);
+		if (ext ? !(s2cr & (1u << 10)) : !(smr & 0x80000000u)) {
+			if (first == ~0u) {
+				first = i;
+				old_smr = smr;
+				old_s2cr = s2cr;
+			}
+			continue;
+		}
+		if ((s2cr & 0xffu) < banks)
+			used[s2cr & 0xffu] = 1;
+		{
+			uint32_t mask = (smr >> 16) & (ext ? 0xffffu : 0x7fffu);
+			uint32_t id = smr & (ext ? 0xffffu : 0x7fffu);
+
+			if ((0x1401u & ~mask) == (id & ~mask)) {
+				printf("PANDORA WLAN: SMMU install: SID 0x1401 already covered by stream %u "
+				    "(smr %#x s2cr %#x)\n", i, smr, s2cr);
+				return 8;
+			}
+		}
+	}
+	if (first == ~0u) {
+		printf("PANDORA WLAN: SMMU install: no free stream slot\n");
+		return 4;
+	}
+	slot = first;
+	printf("PANDORA WLAN: SMMU install: slot %u free (old smr %#x s2cr %#x)\n",
+	    slot, old_smr, old_s2cr);
+	/* GR1 pass: S2CR-referenced banks and the ASIDs of configured banks. */
+	for (i = 0; i < banks; i++) {
+		t = ml_io_map(0x15000000UL + (1u << shift) + 4u * i, 0x1000);
+		if (!t)
+			continue;
+		v = sy_rd(t, 0);
+		if (((v >> 16) & 3u) == 3u && ((v >> 8) & 0xffu) < banks)
+			used[(v >> 8) & 0xffu] = 1;
+		if (((v >> 16) & 3u) == 0u)
+			continue;
+		t = ml_io_map(0x15000000UL + ((vm_offset_t)pages + i) * (1u << shift), 0x1000);
+		if (!t)
+			continue;
+		tt0 = ((uint64_t)sy_rd(t, 0x24) << 32) | sy_rd(t, 0x20);
+		tt1 = ((uint64_t)sy_rd(t, 0x2c) << 32) | sy_rd(t, 0x28);
+		used_asid[2 * i] = tt0 >> 48;
+		used_asid[2 * i + 1] = tt1 >> 48;
+	}
+	/* Bank: first unreferenced, disabled bank whose FSR is idle (fsr_idle). */
+	for (i = ns2; i < banks; i++) {
+		if (used[i])
+			continue;
+		t = ml_io_map(0x15000000UL + ((vm_offset_t)pages + i) * (1u << shift), 0x1000);
+		if (!t)
+			continue;
+		if (sy_rd(t, 0) & 1u)
+			continue;
+		v = sy_rd(t, 0x58);
+		if (!(v & 0xc00001feu) && !(v & (~(0xc00001feu | 0x600u)))) {
+			cb = i;
+			cbp = t;
+			break;
+		}
+	}
+	if (cb == ~0u) {
+		printf("PANDORA WLAN: SMMU install: no free bank (slot %u)\n", slot);
+		return 5;
+	}
+	/* ASID: 0xff00 down while unused by any configured bank. */
+	for (i = 0xff00u; i > 0xfd00u; i--) {
+		for (j = 0; j < 2 * banks; j++) {
+			if (used_asid[j] == i)
+				break;
+		}
+		if (j == 2 * banks) {
+			asid = i;
+			break;
+		}
+	}
+	if (!asid)
+		return 6;
+	new_smr = ext ? 0x1401u : (0x80000000u | 0x1401u);
+	new_s2cr = cb | (ext << 10);
+	sctlr = sy_rd(cbp, 0x00);
+	tcr2 = sy_rd(cbp, 0x10);
+	sy_smmu_slot = slot;
+	sy_smmu_cb = cb;
+	sy_cb_va = cbp;
+	sy_gr1_va = gr1;
+	printf("PANDORA WLAN: SMMU install: start slot %u bank %u asid %#llx old sctlr %#x tcr2 %#x\n",
+	    slot, cb, (unsigned long long)asid, sctlr, tcr2);
+	sy_log_sync();
+	if (sctlr & 1u) {
+		printf("PANDORA WLAN: SMMU install: bank %u busy\n", cb);
+		return 7;
+	}
+	if (sy_pt_build())
+		return 9;
+	ttbr = sy_pa(sy_l1) | (asid << 48);
+	printf("PANDORA WLAN: SMMU install: cfg start ttbr %#llx (lemonade-exact CB image)\n",
+	    (unsigned long long)ttbr);
+	sy_log_sync();
+	/* Values copied from the locally proven WCN7850/QCA6490 port
+	 * (ref/hackios-xnu-kernel bsd/dev/lemonade_wifi.c): Normal non-cacheable
+	 * MAIR index0, outer-shareable, SCTLR 0x1127. The PCIe master rejects
+	 * cacheable transactions, and the earlier WB mapping was never proven. */
+	sy_wr(cbp, 0x00, 0);                                  /* SCTLR.M=0 while configuring */
+	sy_wr(gr1, 0x800 + 4 * cb, 1);                        /* CBA2R: VA64 */
+	sy_wr(gr1, 4 * cb, 0x1f300);                          /* CBAR: S1 trans/S2 bypass */
+	sy_wr(cbp, 0x10, 0x38011u);                           /* TCR2: SEP=7, AS=1, PASIZE=36 */
+	/* This phone's apps-smmu reports IAS/OAS = 36 bit (ID2 0x5211; the working GPU
+	 * context on the same SMMU uses T0SZ=32). The lemonade image's T0SZ=25 (39-bit
+	 * VA) exceeds the hardware input size; use the same shape as the GPU context. */
+	sy_wr(cbp, 0x30, 0x80802020u);                        /* TCR: EAE, EPD1, TG0=4K, SH0=2, T0SZ=32 */
+	sy_wr(cbp, 0x24, (uint32_t)(ttbr >> 32));
+	sy_wr(cbp, 0x20, (uint32_t)ttbr);
+	sy_wr(cbp, 0x28, 0);
+	sy_wr(cbp, 0x2c, 0);
+	sy_wr(cbp, 0x38, 0xff44u);                            /* MAIR0: idx0 NC (0x44), idx1 WB (0xff) */
+	sy_wr(cbp, 0x3c, 0);                                  /* MAIR1 */
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("PANDORA WLAN: SMMU install: cfg written sctlr %#x tcr %#x tcr2 %#x cbar %#x\n",
+	    sy_rd(cbp, 0x00), sy_rd(cbp, 0x30), sy_rd(cbp, 0x10), sy_rd(gr1, 4 * cb));
+	sy_log_sync();
+	printf("PANDORA WLAN: SMMU install: tlbi start (CB local)\n");
+	sy_log_sync();
+	sy_wr(cbp, 0x610, (uint32_t)asid);                    /* TLBI (CB local) */
+	sy_wr(cbp, 0x7f0, 0xffffffffu);
+	for (i = 0; i < 100u; i++) {
+		if (sy_rd(cbp, 0x7f4) & 1u)
+			break;
+		sy_usleep(1000);
+	}
+	printf("PANDORA WLAN: SMMU install: sync %#x\n", sy_rd(cbp, 0x7f4));
+	sy_log_sync();
+	sy_wr(cbp, 0x00, 0x167u);                             /* SCTLR: M|TRE|AFE|CFRE|CFIE|HUPCF (GPU context) */
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_wr(sy_smmu_va, 0xc00 + 4 * slot, new_s2cr);        /* S2CR: S1 translate */
+	sy_wr(sy_smmu_va, 0x800 + 4 * slot, 0x1401u);         /* SMR raw */
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_wr(sy_smmu_va, 0x800 + 4 * slot, new_smr);         /* SMR valid */
+	__asm__ volatile("dsb sy" ::: "memory");
+	smr = sy_rd(sy_smmu_va, 0x800 + 4 * slot);
+	v = sy_rd(cbp, 0x58);
+
+	printf("PANDORA WLAN: SMMU installed: slot %u bank %u asid %#llx iova %#x sctlr %#x "
+	    "tcr %#x tcr2 %#x mair0 %#x cbar %#x smr %#x s2cr %#x fsr %#x\n", slot, cb,
+	    (unsigned long long)asid, SY_IOVA_BASE, sy_rd(cbp, 0x00), sy_rd(cbp, 0x30),
+	    sy_rd(cbp, 0x10), sy_rd(cbp, 0x38), sy_rd(gr1, 4 * cb), smr,
+	    sy_rd(sy_smmu_va, 0xc00 + 4 * slot), v);
+	sy_log_sync();
+	return 0;
+}
+
+/* Stage 15: BHI SBL delivery. Sequence from the same-card port: bus master +
+ * INTx off, INTVEC/STATUS cleared, IMGADDR/IMGSIZE written and verified,
+ * cache cleaned, then the image doorbell; poll BHI_STATUS[31:30] (2 ok, 3 err).
+ * Any mismatch stops here with the values printed; nothing panics. */
+static void
+sy_buf_alloc(void)
+{
+	/* The WCN7850's BHI/coherent DMA path is a 32-bit-address client: the Android
+	 * ath12k driver sets dma_set_coherent_mask(DMA_BIT_MASK(32)) and the canoe WLAN
+	 * device tree reserves its DMA pool with alloc-ranges <0 0xffffffff>. Asking
+	 * kmem_alloc_contig for pages below 4 GiB (max_pnum = 0xfffff) is therefore
+	 * required, not optional: a buffer at 0x9_xxxxxxx makes the boot loader read a
+	 * truncated address and reject the image. Try the big pack first, then smaller
+	 * sizes, and verify the physical address before using it. */
+	static const vm_size_t want[] = { SY_FW_BUF, 0x400000, 0x200000, SY_SBL_SIZE };
+	kern_return_t kr = KERN_FAILURE;
+	unsigned i;
+
+	if (sy_sbl_va)
+		return;
+	for (i = 0; i < sizeof(want) / sizeof(want[0]); i++) {
+		sy_sbl_va = 0;
+		sy_buf_size = want[i];
+		kr = kmem_alloc_contig(kernel_map, &sy_sbl_va, want[i], PAGE_MASK,
+		    0, 0xfffff, KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT);
+		if (kr == KERN_SUCCESS && sy_sbl_va)
+			break;
+		printf("PANDORA WLAN: BHI: %#lx-byte <4 GiB contig failed %d\n",
+		    (unsigned long)want[i], kr);
+	}
+	if (kr != KERN_SUCCESS || !sy_sbl_va) {
+		/* This port owns no RAM below 4 GiB: the ADT window starts at 0x1_00000000
+		 * (see docs REUSE-MATRIX/WIFI-2026-11-01). The 32-bit coherent limit is
+		 * satisfied through the translating CB instead (32-bit IOVA 0xB0000000,
+		 * SMMU OAS 36 bit), so fall back to any contiguous pages. */
+		sy_sbl_va = 0;
+		printf("PANDORA WLAN: BHI: no <4 GiB contig buffer (XNU RAM starts above 4 GiB); "
+		    "falling back to a translated IOVA over any pages\n");
+		sy_buf_size = SY_FW_BUF;
+		kr = kmem_alloc_contig(kernel_map, &sy_sbl_va, SY_FW_BUF, PAGE_MASK,
+		    0, 0, KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT);
+		if (kr != KERN_SUCCESS || !sy_sbl_va) {
+			sy_sbl_va = 0;
+			sy_buf_size = 0;
+			printf("PANDORA WLAN: BHI: no contiguous buffer at all (%d)\n", kr);
+			return;
+		}
+	}
+	sy_sbl_pa = sy_pa(sy_sbl_va);
+	/* Proven pattern from the locally working WCN port (lemonade_wifi.c): the device
+	 * must read what a write-combined alias of the same physical pages holds; a
+	 * cached write plus flush was never proven there and the boot loader kept
+	 * rejecting the image with no SMMU fault. */
+	/* The permanent io_submap is only 8 MiB (lemonade_wifi.c:486): mapping this
+	 * alias with ml_io_map_wcomb made kmem_alloc(8 MiB) fail inside ml_io_map and
+	 * panicked. Use the kernel_map mapping the proven port uses, and only the bytes
+	 * the image actually needs. */
+	sy_sbl_wc = ml_io_map_unmappable((vm_offset_t)sy_sbl_pa, SY_SBL_SIZE, VM_WIMG_WCOMB);
+	printf("PANDORA WLAN: BHI: write-combined alias %#lx of pa %#llx\n",
+	    (unsigned long)sy_sbl_wc, (unsigned long long)sy_sbl_pa);
+	printf("PANDORA WLAN: BHI: buffer va %#lx pa %#llx size %#x (%s 4 GiB)\n",
+	    (unsigned long)sy_sbl_va, (unsigned long long)sy_sbl_pa, sy_buf_size,
+	    sy_sbl_pa < 0x100000000ull ? "below" : "ABOVE");
+	if (sy_sbl_pa >= 0x100000000ull)
+		printf("PANDORA WLAN: BHI: WARNING physical address outside the 32-bit range\n");
+	sy_log_sync();
+}
+
+
+
+/* Configure one more context bank with the same tables as the installed one and
+ * point the PCIe stream at it. Used by the one-boot matrix after a failed BHI. */
+static void
+sy_smmu_cfg_bank(uint32_t bank, uint32_t slot)
+{
+	vm_offset_t bva;
+	uint64_t ttbr;
+	unsigned i;
+
+	if (!sy_l1 || !sy_gr1_va || !sy_smmu_va || !sy_pages || bank >= (sy_id1 & 0xff))
+		return;
+	bva = ml_io_map(0x15000000UL + ((vm_offset_t)sy_pages + bank) * 0x1000UL, 0x1000);
+	if (!bva)
+		return;
+	if (sy_rd(bva, 0x00) & 1u) {
+		printf("PANDORA WLAN: bank %u in use, not retried\n", bank);
+		return;
+	}
+	ttbr = sy_pa(sy_l1) | (0xff00ull << 48);
+	sy_wr(bva, 0x00, 0);
+	sy_wr(sy_gr1_va, 0x800 + 4 * bank, 1);
+	sy_wr(sy_gr1_va, 4 * bank, 0x1f300);
+	sy_wr(bva, 0x10, 0x38011u);
+	sy_wr(bva, 0x30, 0x80802020u);
+	sy_wr(bva, 0x24, (uint32_t)(ttbr >> 32));
+	sy_wr(bva, 0x20, (uint32_t)ttbr);
+	sy_wr(bva, 0x28, 0);
+	sy_wr(bva, 0x2c, 0);
+	sy_wr(bva, 0x38, 0xff44u);
+	sy_wr(bva, 0x3c, 0);
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_wr(bva, 0x610, 0xffffffffu);
+	sy_wr(bva, 0x7f0, 0xffffffffu);
+	for (i = 0; i < 100u && (sy_rd(bva, 0x7f4) & 1u); i++)
+		delay(1000);
+	sy_wr(bva, 0x00, 0x167u);
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_wr(sy_smmu_va, 0xc00 + 4 * slot, bank);
+	sy_wr(sy_smmu_va, 0x800 + 4 * slot, 0x80001401u);
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("PANDORA WLAN: bank %u configured: sctlr %#x tcr %#x tcr2 %#x cbar %#x; "
+	    "s2cr %#x smr %#x\n", bank, sy_rd(bva, 0x00), sy_rd(bva, 0x30), sy_rd(bva, 0x10),
+	    sy_rd(sy_gr1_va, 4 * bank), sy_rd(sy_smmu_va, 0xc00 + 4 * slot),
+	    sy_rd(sy_smmu_va, 0x800 + 4 * slot));
+	sy_log_sync();
+}
+
+/* ---- experiment helpers (boot-arg songyuan_bhi2=1) -------------------------------
+ * Kept ahead of their callers: the buffer-allocation rewrite once removed this block
+ * and the build failed with "use of undeclared identifier 'sy_bhi2'". The local gate
+ * now refuses a tree where the uses exist without these definitions.
+ */
+static int sy_bhi2 = -1;
+
+static uint32_t
+sy_bhi_try(uint32_t bhio, const char *tag, uint64_t addr, uint32_t ivec)
+{
+	uint32_t st = 0, ee = 0;
+	unsigned i;
+
+	printf("PANDORA WLAN: EXP %s: addr %#llx ivec %#x\n", tag,
+	    (unsigned long long)addr, ivec);
+	sy_wr(sy_bar_va, bhio + 0x20, ivec);
+	sy_wr(sy_bar_va, bhio + 0x2c, 0);
+	sy_wr(sy_bar_va, bhio + 0x08, (uint32_t)addr);
+	sy_wr(sy_bar_va, bhio + 0x0c, (uint32_t)(addr >> 32));
+	sy_wr(sy_bar_va, bhio + 0x10, SY_SBL_SIZE);
+	sy_wr(sy_bar_va, bhio + 0x18, 0x1a2b3c4d);
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("PANDORA WLAN: EXP %s: readback %#x:%08x size %#x txdb %#x\n", tag,
+	    sy_rd(sy_bar_va, bhio + 0x0c), sy_rd(sy_bar_va, bhio + 0x08),
+	    sy_rd(sy_bar_va, bhio + 0x10), sy_rd(sy_bar_va, bhio + 0x18));
+	for (i = 0; i < 2000; i++) {
+		st = sy_rd(sy_bar_va, bhio + 0x2c);
+		ee = sy_rd(sy_bar_va, bhio + 0x28);
+		if (i < 10 || i % 200 == 0)
+			printf("PANDORA WLAN: EXP %s poll %u ms: status %#x ee %#x errcode %#x\n",
+			    tag, i, st, ee, sy_rd(sy_bar_va, bhio + 0x30));
+		if ((st >> 30) == 2 || ((st >> 30) == 3 && st != 0xffffffffu))
+			break;
+		delay(1000);
+	}
+	printf("PANDORA WLAN: EXP %s result: status %#x code %u ee %#x errcode %#x errdbg %#x/%#x/%#x\n",
+	    tag, st, st >> 30, ee, sy_rd(sy_bar_va, bhio + 0x30),
+	    sy_rd(sy_bar_va, bhio + 0x34), sy_rd(sy_bar_va, bhio + 0x38),
+	    sy_rd(sy_bar_va, bhio + 0x3c));
+	sy_log_sync();
+	return st;
+}
+
+static void
+sy_mhi_reset(void)
+{
+	unsigned i;
+
+	sy_wr(sy_bar_va, 0x38, 2);		/* MHI_CTRL RESET */
+	for (i = 0; i < 100 && (sy_rd(sy_bar_va, 0x38) & 2u); i++)
+		delay(1000);
+	printf("PANDORA WLAN: EXP: MHI reset done, ctrl %#x status %#x ee %#x\n",
+	    sy_rd(sy_bar_va, 0x38), sy_rd(sy_bar_va, 0x48), sy_rd(sy_bar_va, sy_bhi_off + 0x28));
+	sy_log_sync();
+}
+
+static void
+sy_pte_walk(void)
+{
+	uint64_t *l1, *l3, e1, e2, e3;
+	uint32_t i, j;
+
+	if (!sy_l1 || !sy_l3 || !sy_sbl_va)
+		return;
+	l1 = (uint64_t *)sy_l1;
+	l3 = (uint64_t *)sy_l3;
+	e1 = l1[(SY_IOVA_BASE >> 30) & 511];
+	e2 = ((uint64_t *)sy_l2)[(SY_IOVA_BASE >> 21) & 511];
+	printf("PANDORA WLAN: PT walk: l1[%u] %#llx l2[%u] %#llx sbl pa %#llx\n",
+	    (SY_IOVA_BASE >> 30) & 511, (unsigned long long)e1,
+	    (SY_IOVA_BASE >> 21) & 511, (unsigned long long)e2,
+	    (unsigned long long)sy_pa(sy_sbl_va));
+	for (i = 0; i < 2; i++) {
+		uint64_t idx = ((SY_IOVA_BASE & 0x1fffff) >> 12) + i;
+
+		e3 = l3[idx];
+		printf("PANDORA WLAN: PT walk: l3[%u] %#llx -> pa %#llx (sbl va+%#x pa %#llx)\n",
+		    (uint32_t)idx, (unsigned long long)e3,
+		    (unsigned long long)(e3 & 0x0000fffffffff000ull), i * 0x1000,
+		    (unsigned long long)sy_pa(sy_sbl_va + i * 0x1000));
+	}
+	j = ((SY_SBL_SIZE - 0x1000) >> 12);
+	printf("PANDORA WLAN: PT walk: last l3[%u] %#llx -> pa %#llx (sbl va+%#x pa %#llx)\n",
+	    j, (unsigned long long)l3[j], (unsigned long long)(l3[j] & 0x0000fffffffff000ull),
+	    j * 0x1000, (unsigned long long)sy_pa(sy_sbl_va + ((vm_offset_t)j << 12)));
+	sy_log_sync();
+}
+
+
+/* Endpoint PCIe/MSI setup before firmware load, copied from the locally working
+ * WCN7850 port (UniXNU-sheng WifiProbe.cpp, endpointLinkSetup):
+ *  - the PCI Express capability's link control ASPM bits are cleared, because the
+ *    load must not idle the link;
+ *  - the MSI capability is enabled with a valid DMA sink address, because the
+ *    endpoint raises its transfer-complete/ready events as MSI writes. With the
+ *    capability unprogrammed those writes have no target and the boot loader ends
+ *    in its fatal error state after reading the image (no SMMU fault at all). */
+static void
+sy_endpoint_link_setup(uint64_t sink)
+{
+	uint32_t cap, w, ctrl;
+	unsigned guard;
+
+	if (!conf)
+		return;
+	cap = (uint32_t)(*(volatile uint8_t *)(conf + SY_EP_CONF + 0x34) & 0xfc);
+	for (guard = 0; cap >= 0x40 && guard < 48; guard++) {
+		w = sy_rd(conf, SY_EP_CONF + cap);
+		{
+			uint32_t id = w & 0xff, next = (w >> 8) & 0xff;
+
+			if (id == 0x10) {
+				uint32_t lc = sy_rd(conf, SY_EP_CONF + cap + 0x10);
+
+				printf("PANDORA WLAN: endpoint PCIe cap %#x: link ctrl %#x -> %#x (ASPM off)\n",
+				    cap, lc, lc & ~3u);
+				sy_wr(conf, SY_EP_CONF + cap + 0x10, lc & ~3u);
+			} else if (id == 0x05) {
+				bool is64 = (w >> 16) & 0x80;
+
+				if (is64) {
+					sy_wr(conf, SY_EP_CONF + cap + 4, (uint32_t)sink);
+					sy_wr(conf, SY_EP_CONF + cap + 8, (uint32_t)(sink >> 32));
+					sy_wr(conf, SY_EP_CONF + cap + 0xc, 0);
+				} else {
+					sy_wr(conf, SY_EP_CONF + cap + 4, (uint32_t)sink);
+					sy_wr(conf, SY_EP_CONF + cap + 8, 0);
+				}
+				ctrl = (w & 0xffffu) | ((((w >> 16) & ~0x70u) | 0x20u | 1u) << 16);
+				sy_wr(conf, SY_EP_CONF + cap, ctrl);
+				printf("PANDORA WLAN: endpoint MSI cap %#x: addr %#llx/%u data 0 ctrl %#x -> %#x\n",
+				    cap, (unsigned long long)sink, is64 ? 64 : 32,
+				    w, sy_rd(conf, SY_EP_CONF + cap));
+			}
+			if (!next)
+				break;
+			cap = next;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_log_sync();
+}
+
+static void
+sy_bhi_sbl(void)
+{
+	uint32_t bhio, cmd, hi, lo, size, ivec, st, ee;
+	uint64_t fo = 0, fs = 0;
+	vm_offset_t off;
+	unsigned i;
+
+	if (!sy_bar_va) {
+		printf("PANDORA WLAN: BHI: missing BAR0 mapping\n");
+		return;
+	}
+	if (!sy_guard)
+		(void)PE_parse_boot_argn("songyuan_guard", &sy_guard, sizeof(sy_guard));
+	bhio = sy_rd(sy_bar_va, 0x28);
+	sy_bhi_off = bhio;
+	sy_bhie_off = sy_rd(sy_bar_va, 0x2c);
+	if (sy_bhie_off < 0x40 || sy_bhie_off > 0x3fc0 || (sy_bhie_off & 3))
+		sy_bhie_off = 0;
+	if (bhio < 0x40 || bhio > 0x3fc0 || (bhio & 3)) {
+		printf("PANDORA WLAN: BHI: bad BHIOFF %#x\n", bhio);
+		return;
+	}
+	if (!sy_sbl_va || !sy_buf_size) {
+		printf("PANDORA WLAN: BHI: no buffer (allocation failed); skipping image load\n");
+		return;
+	}
+	if (sy_fw_find("amss20.bin", &fo, &fs) || fs < SY_SBL_SIZE) {
+		printf("PANDORA WLAN: BHI: firmware not usable (size %#llx)\n", (unsigned long long)fs);
+		return;
+	}
+	if (sy_sbl_wc) {
+		if (pandora_fw_read(fo, (void *)sy_sbl_wc, SY_SBL_SIZE)) {
+			printf("PANDORA WLAN: BHI: SBL read (WC alias) failed\n");
+			return;
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+		printf("PANDORA WLAN: BHI: image written through the write-combined alias\n");
+	} else {
+		if (pandora_fw_read(fo, (void *)sy_sbl_va, SY_SBL_SIZE)) {
+			printf("PANDORA WLAN: BHI: SBL read failed\n");
+			return;
+		}
+		for (off = 0; off < SY_SBL_SIZE; off += PAGE_SIZE)
+			flush_dcache64(sy_pa(sy_sbl_va + off), (unsigned)PAGE_SIZE, TRUE);
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	cmd = sy_rd(conf, SY_EP_CONF + 0x04) & 0xffff;
+	sy_wr(conf, SY_EP_CONF + 0x04, cmd | 0x404);
+	printf("PANDORA WLAN: BHI: ep cmd %#x -> %#x; bhio %#x sbl %#lx iova %#x\n",
+	    cmd, sy_rd(conf, SY_EP_CONF + 0x04) & 0xffff, bhio,
+	    (unsigned long)SY_SBL_SIZE, SY_IOVA_BASE);
+	sy_log_sync();
+
+	/* Vendor pci-msm.c link-enable order, checked against the live DT:
+	 *  - the root port's command register gets memory + bus-master (the endpoint's
+	 *    own command register is set below);
+	 *  - PARF 0x4A0 bit0 (AXI_MSTR_WR_NS_BDF_HALT) is cleared because the DT has no
+	 *    qcom,bdf-change-halt-en; if a boot chain left it set, the endpoint's
+	 *    writes are halted silently (exactly our "no SMMU fault" signature).
+	 */
+	{
+		uint32_t rp = sy_rd(dbi, 0x04);
+		uint32_t bdf = sy_rd(parf, 0x4a0);
+
+		sy_wr(dbi, 0x04, rp | 0x6);		/* MEM | MASTER */
+		sy_wr(parf, 0x4a0, bdf & ~1u);		/* NS BDF halt off (vendor default) */
+		printf("PANDORA WLAN: BHI: root port cmd %#x -> %#x; parf 0x4a0 %#x -> %#x; "
+		    "0x1a8 %#x 0x174 %#x\n", rp, sy_rd(dbi, 0x04), bdf, sy_rd(parf, 0x4a0),
+		    sy_rd(parf, 0x1a8), sy_rd(parf, 0x174));
+		sy_log_sync();
+	}
+
+	sy_endpoint_link_setup((uint64_t)SY_IOVA_BASE + 0x7FE000);
+	/* MSI sink: the last free page of the mapped window, outside the SBL and
+	 * AMSS image bytes and outside the MHI context/ring region */
+	sy_wr(sy_bar_va, bhio + 0x20, 0);          /* INTVEC */
+	sy_wr(sy_bar_va, bhio + 0x2c, 0);          /* STATUS clear */
+	sy_wr(sy_bar_va, bhio + 0x08, SY_IOVA_BASE);            /* IMGADDR lo (IOVA) */
+	sy_wr(sy_bar_va, bhio + 0x0c, 0);                      /* IMGADDR hi */
+	sy_wr(sy_bar_va, bhio + 0x10, SY_SBL_SIZE);           /* IMGSIZE */
+	__asm__ volatile("dsb sy" ::: "memory");
+	hi = sy_rd(sy_bar_va, bhio + 0x0c); lo = sy_rd(sy_bar_va, bhio + 0x08);
+	size = sy_rd(sy_bar_va, bhio + 0x10); ivec = sy_rd(sy_bar_va, bhio + 0x20);
+	st = sy_rd(sy_bar_va, bhio + 0x2c);   ee = sy_rd(sy_bar_va, bhio + 0x28);
+	printf("PANDORA WLAN: BHI preflight: %#x:%08x size %#x ivec %#x status %#x ee %#x\n",
+	    hi, lo, size, ivec, st, ee);
+	sy_log_sync();
+	if (sy_guard) {
+		uint64_t guard = SY_IOVA_BASE + sy_buf_size;
+		uint32_t v = 0, fsr = 0, far_lo = 0, far_hi = 0, gfsr = 0, sid = 0;
+		unsigned t, hit = 0;
+
+		sy_wr(sy_bar_va, bhio + 0x2c, 0);
+		sy_wr(sy_bar_va, bhio + 0x08, (uint32_t)guard);
+		sy_wr(sy_bar_va, bhio + 0x0c, (uint32_t)(guard >> 32));
+		sy_wr(sy_bar_va, bhio + 0x10, 0x1000);
+		sy_wr(sy_bar_va, bhio + 0x14, 0);
+		__asm__ volatile("dsb sy" ::: "memory");
+		printf("PANDORA WLAN: GUARD: asking PBL to read unmapped %#llx, 4096 bytes (mapping is %#x bytes)\n",
+		    (unsigned long long)guard, sy_buf_size);
+		sy_log_sync();
+		sy_wr(sy_bar_va, bhio + 0x18, 0x0badf00d);
+		for (t = 0; t < 400; t++) {
+			if (sy_cb_va)
+				fsr = sy_rd(sy_cb_va, 0x58);
+			gfsr = sy_rd(sy_smmu_va, 0x48);
+			v = sy_rd(sy_bar_va, bhio + 0x2c);
+			if ((fsr & 0xc00001feu) || gfsr || (v >> 30) == 3)
+				break;
+			sy_usleep(5000);
+		}
+		if (sy_cb_va) {
+			far_lo = sy_rd(sy_cb_va, 0x60);
+			far_hi = sy_rd(sy_cb_va, 0x64);
+		}
+		sid = sy_rd(sy_smmu_va, 0x1400 + 4 * sy_smmu_cb) & 0xffffu;
+		hit = (fsr & 0xc00001feu) ? 1 : 0;
+		printf("PANDORA WLAN: GUARD result: fault %u cb_fsr %#x far %#x:%#x gfsr %#x sid %#x bhi %#x\n",
+		    hit, fsr, far_hi, far_lo, gfsr, sid, v);
+		sy_log_sync();
+		return;
+	}
+	if (hi != 0 || lo != SY_IOVA_BASE ||
+	    size != SY_SBL_SIZE || ivec || st || ee) {
+		printf("PANDORA WLAN: BHI: preflight mismatch, doorbell not rung\n");
+		return;
+	}
+	{
+		volatile uint32_t *w = (volatile uint32_t *)(sy_sbl_wc ? sy_sbl_wc : sy_sbl_va);
+		uint32_t fsum = 0;
+		unsigned fi;
+
+		for (fi = 0; fi < 256; fi++)
+			fsum += w[fi];
+		printf("PANDORA WLAN: BHI: SBL head %08x %08x %08x %08x %08x %08x %08x %08x sum1k %08x\n",
+		    w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], fsum);
+		sy_log_sync();
+	}
+	{
+		int guard2 = 0;
+
+		(void)PE_parse_boot_argn("songyuan_guard2", &guard2, sizeof(guard2));
+		if (guard2 > 0) {
+		/* One-boot matrix, step 1: ask PBL to read an unmapped IOVA. A CB fault proves
+		 * that the endpoint's DMA is translated by our CB; silence means the stream never
+		 * reaches it. The MHI block is reset afterwards and the image registers restored. */
+		{
+			uint64_t g = SY_IOVA_BASE + sy_buf_size + 0x4000;
+			uint32_t f = 0, gg = 0, v = 0;
+			unsigned t;
+
+			sy_wr(sy_bar_va, bhio + 0x20, 0);
+			sy_wr(sy_bar_va, bhio + 0x2c, 0);
+			sy_wr(sy_bar_va, bhio + 0x08, (uint32_t)g);
+			sy_wr(sy_bar_va, bhio + 0x0c, (uint32_t)(g >> 32));
+			sy_wr(sy_bar_va, bhio + 0x10, 0x1000);
+			__asm__ volatile("dsb sy" ::: "memory");
+			sy_wr(sy_bar_va, bhio + 0x18, 0x0badf00d);
+			for (t = 0; t < 200; t++) {
+				f = sy_cb_va ? sy_rd(sy_cb_va, 0x58) : 0;
+				gg = sy_smmu_va ? sy_rd(sy_smmu_va, 0x48) : 0;
+				v = sy_rd(sy_bar_va, bhio + 0x2c);
+				if ((f & 0xc00001feu) || gg || (v >> 30) == 3)
+					break;
+				delay(1000);
+			}
+			printf("PANDORA WLAN: GUARD: unmapped %#llx -> cb_fsr %#x gfsr %#x bhi %#x after %u ms\n",
+			    (unsigned long long)g, f, gg, v, t);
+			sy_log_sync();
+			sy_mhi_reset();
+			sy_wr(sy_bar_va, bhio + 0x20, 0);
+			sy_wr(sy_bar_va, bhio + 0x2c, 0);
+			sy_wr(sy_bar_va, bhio + 0x08, SY_IOVA_BASE);
+			sy_wr(sy_bar_va, bhio + 0x0c, 0);
+			sy_wr(sy_bar_va, bhio + 0x10, SY_SBL_SIZE);
+			__asm__ volatile("dsb sy" ::: "memory");
+		}
+		}
+	}
+	sy_wr(sy_bar_va, bhio + 0x18, 0x1234567);
+	printf("PANDORA WLAN: BHI: doorbell rung seq 0x1234567, polling\n");
+	sy_log_sync();
+	/* 0xffffffff means "the MHI block did not answer this read yet" (the boot loader
+	 * is starting), not an error status: sheng's MhiBoot.c treats it that way. Also poll
+	 * for the full 2 s: delay() is microseconds, so the earlier 300x10ms loop actually
+	 * gave up after ~40 ms and reported the transient state as the result. */
+	{
+		uint32_t last_st = st, last_ee = ee, shown = 0;
+
+		printf("PANDORA WLAN: BHI: imgaddr %#x/%#x size %#x txdb %#x intvec %#x (readback)\n",
+		    sy_rd(sy_bar_va, bhio + 0x08), sy_rd(sy_bar_va, bhio + 0x0c),
+		    sy_rd(sy_bar_va, bhio + 0x10), sy_rd(sy_bar_va, bhio + 0x18),
+		    sy_rd(sy_bar_va, bhio + 0x20));
+		sy_log_sync();
+		for (i = 0; i < 2000; i++) {
+			st = sy_rd(sy_bar_va, bhio + 0x2c);
+			ee = sy_rd(sy_bar_va, bhio + 0x28);
+			if (i < 30 || st != last_st || ee != last_ee) {
+				if (shown < 60) {
+					printf("PANDORA WLAN: BHI poll %u ms: status %#x code %u ee %#x "
+					    "errcode %#x mhi %#x\n", i, st, st >> 30, ee,
+					    sy_rd(sy_bar_va, bhio + 0x30), sy_rd(sy_bar_va, 0x48));
+					sy_log_sync();
+				}
+				shown++;
+				last_st = st; last_ee = ee;
+			}
+			if ((st >> 30) == 2 || ((st >> 30) == 3 && st != 0xffffffffu))
+				break;
+			delay(1000);	/* 1 ms; delay() takes microseconds */
+		}
+	}
+	printf("PANDORA WLAN: BHI result: status %#x code %u ee %#x errcode %#x mhi %#x\n",
+	    st, st >> 30, ee, sy_rd(sy_bar_va, bhio + 0x30), sy_rd(sy_bar_va, 0x48));
+	sy_log_sync();
+	/* Device-side error detail: distinguish an SMMU translation fault (the device
+	 * DMA never reached our buffer) from an image rejection (BHI errdbg set). */
+	/* Hardware-level PCIe/ANOC error visibility (vendor pci-msm.c register names):
+	 * INT_ALL_STATUS/INT_ALL_2_STATUS and CORE_ERRORS show NoC/AXI faults that the
+	 * SMMU never sees because the transaction dies in the controller. */
+	printf("PANDORA WLAN: PARF diag: int_all %#x/%#x int_all2 %#x/%#x core_errors %#x "
+	    "ecam_block %#x parf_status %#x pm_stts %#x\n",
+	    sy_rd(parf, 0x224), sy_rd(parf, 0x22c), sy_rd(parf, 0x500), sy_rd(parf, 0x508),
+	    sy_rd(parf, 0x3c0), sy_rd(parf, 0x630), sy_rd(parf, 0x230), sy_rd(parf, 0x028));
+	sy_log_sync();
+	sy_pte_walk();
+	if (sy_bhi2 < 0)
+		(void)PE_parse_boot_argn("songyuan_bhi2", &sy_bhi2, sizeof(sy_bhi2));
+		(void)PE_parse_boot_argn("songyuan_wlfw", &sy_wlfw_on, sizeof(sy_wlfw_on));
+		(void)PE_parse_boot_argn("songyuan_m0mode", &sy_m0_mode, sizeof(sy_m0_mode));
+		(void)PE_parse_boot_argn("songyuan_bhie_clear", &sy_bhie_clear, sizeof(sy_bhie_clear));
+		(void)PE_parse_boot_argn("songyuan_chan_force", &sy_chan_force, sizeof(sy_chan_force));
+		(void)PE_parse_boot_argn("songyuan_erdb", &sy_erdb_init, sizeof(sy_erdb_init));
+	if (sy_bhi2 > 0 && !sy_guard) {
+		uint32_t s2cr_slot = 0xc00u + 4u * sy_smmu_slot;
+
+		/* A: bypass the stage-1 CB and give BHI the physical address. */
+		sy_mhi_reset();
+		sy_wr(sy_smmu_va, s2cr_slot, (1u << 16) | 0u);
+		sy_wr(sy_cb_va, 0x610, 0xffffffffu);
+		sy_wr(sy_cb_va, 0x7f0, 0xffffffffu);
+		__asm__ volatile("dsb sy" ::: "memory");
+		printf("PANDORA WLAN: EXP A: s2cr now %#x (bypass)\n", sy_rd(sy_smmu_va, s2cr_slot));
+		sy_log_sync();
+		(void)sy_bhi_try(sy_bhi_off, "A-bypass-phys", sy_sbl_pa, 0);
+		/* B: back to translating CB, but with a real INTVEC target. */
+		sy_mhi_reset();
+		sy_wr(sy_smmu_va, s2cr_slot, sy_smmu_cb | 0u);
+		sy_wr(sy_cb_va, 0x610, 0xffffffffu);
+		sy_wr(sy_cb_va, 0x7f0, 0xffffffffu);
+		__asm__ volatile("dsb sy" ::: "memory");
+		printf("PANDORA WLAN: EXP B: s2cr now %#x (translate, cb %u), ivec %#x\n",
+		    sy_rd(sy_smmu_va, s2cr_slot), sy_smmu_cb, (uint32_t)sy_sbl_pa);
+		sy_log_sync();
+		(void)sy_bhi_try(sy_bhi_off, "B-translate-ivec", SY_IOVA_BASE, (uint32_t)sy_sbl_pa);
+	}
+	if ((st >> 30) != 2 && sy_smmu_va && sy_gr1_va && (sy_id1 & 0xff) > 1) {
+		/* One-boot matrix, step 2: retry the same image on the last context bank
+		 * (the slot the plan reserves for the firmware-compatible bypass bank), in
+		 * case the bank the probe picked is not usable for host translation. */
+		uint32_t last = (sy_id1 & 0xff) - 1;
+
+		printf("PANDORA WLAN: retry on last bank %u\n", last);
+		sy_log_sync();
+		sy_mhi_reset();
+		sy_smmu_cfg_bank(last, sy_smmu_slot);
+		(void)sy_bhi_try(sy_bhi_off, "C-lastbank", SY_IOVA_BASE, 0);
+	}
+	sy_sbl_ok = ((st >> 30) == 2);
+	sy_smmu_bank_scan();
+	if (sy_smmu_va) {
+		uint32_t gfsr = sy_rd(sy_smmu_va, 0x48);
+		uint32_t fsr = sy_cb_va ? sy_rd(sy_cb_va, 0x58) : 0xffffffffu;
+		uint32_t far_lo = sy_cb_va ? sy_rd(sy_cb_va, 0x60) : 0xffffffffu;
+		uint32_t far_hi = sy_cb_va ? sy_rd(sy_cb_va, 0x64) : 0xffffffffu;
+
+		printf("PANDORA WLAN: BHI diag: smr %#x s2cr %#x cbar %#x tlbstatus %#x cb_fsr %#x "
+		    "far %#x:%#x gfsr %#x gfsynr %#x/%#x/%#x\n",
+		    sy_rd(sy_smmu_va, 0x800 + 4 * sy_smmu_slot),
+		    sy_rd(sy_smmu_va, 0xc00 + 4 * sy_smmu_slot),
+		    sy_gr1_va ? sy_rd(sy_gr1_va, 4 * sy_smmu_cb) : 0xffffffffu,
+		    sy_cb_va ? sy_rd(sy_cb_va, 0x7f4) : 0xffffffffu, fsr, far_hi, far_lo, gfsr,
+		    sy_rd(sy_smmu_va, 0x50), sy_rd(sy_smmu_va, 0x54), sy_rd(sy_smmu_va, 0x58));
+		sy_log_sync();
+	}
+	printf("PANDORA WLAN: BHI diag: parf sid[0x2054] %#x [0x2074] %#x bypass %#x/%#x; "
+	    "errdbg %#x/%#x/%#x numseg %#x serial %#x; dbi80 %#x dbi0 %#x\n",
+	    sy_rd(parf, 0x2054), sy_rd(parf, 0x2074), sy_rd(parf, 0x2c00), sy_rd(parf, 0x2c04),
+	    sy_rd(sy_bar_va, bhio + 0x34), sy_rd(sy_bar_va, bhio + 0x38),
+	    sy_rd(sy_bar_va, bhio + 0x3c), sy_rd(sy_bar_va, bhio + 0x48),
+	    sy_rd(sy_bar_va, bhio + 0x40), sy_rd(dbi, 0x80), sy_rd(dbi, 0));
+	sy_log_sync();
+}
+
+/* CRM D0: the power state vote the local driver's CESTA path sends before it resets
+ * the controller (pci-msm msm_pcie_enable_cesta -> crm_write_perf_ol + crm_write_pwr_states).
+ * Register offsets are pcie_crm_desc_v3's; the counts are from the phone's own CRM IPC log
+ * (5 power states, 2 PERF_OL VCDs, 16 BW_PT nodes). Without the vote the core never leaves
+ * reset: PARF answers while DBI and the config window stay all ones. */
+static bool
+sy_crm_d0(void)
+{
+	uint32_t update, ch, mask, busy = ~0U;
+	unsigned res, pwr, tries;
+
+	update = sy_rd(crm, SY_CRM_CHN_UPDATE);
+	if (!update)
+		ch = 0;
+	else if (update & 1)
+		ch = 1;
+	else if (update & 2)
+		ch = 0;
+	else {
+		printf("PANDORA WLAN: CRM: both channels busy (%#x)\n", update);
+		return false;
+	}
+	/* PERF_OL: resource 0 is this RC's VCD; states 0 and 1 carry D0's perf level,
+	 * the rest stay zero as the vendor's cache is zero filled. */
+	for (res = 0; res < SY_CRM_PERF_OL_RES; res++)
+		for (pwr = 0; pwr < SY_CRM_NUM_PWR; pwr++)
+			sy_wr(crm, SY_CRM_PWR_ST0 + pwr * 4 + ch * SY_CRM_PWR_CHN +
+			    res * SY_CRM_RES_DIST,
+			    (res == 0 && pwr < 2) ? SY_CRM_D0_PERF_LVL : 0);
+	/* Vendor crm-v2.c D0 only writes PERF_OL (two power states); BW_PT is not
+	 * touched for D0, so no zero flush is issued here either. */
+	sy_wr(crm, SY_CRM_CHN_UPDATE, 1U << ch);
+	mask = 1U << ch;
+	for (tries = 0; tries < 100; tries++) {
+		busy = sy_rd(crm, SY_CRM_CHN_BUSY) & mask;
+		if (busy == mask)
+			break;
+		sy_usleep(100);
+	}
+	printf("PANDORA WLAN: CRM D0: chn_update %#x channel %u: switch %s after %u tries (busy %#x)\n",
+	    update, ch, busy == mask ? "complete" : "timeout", tries + 1, busy);
+	return busy == mask;
+}
