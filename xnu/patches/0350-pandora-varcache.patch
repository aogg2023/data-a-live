+/* After the cache is mounted. ENOENT on a store file counts as already gone. */
+static void
+cv_stage_reset_ls(void)
+{
+	static const char *const names[] = {
+		"com.apple.LaunchServices-4035-v2.csstore",
+		"com.apple.LaunchServices-4035-v2.csstore-journal",
+		"SystemDataOnly-com.apple.LaunchServices-4035-v2.csstore",
+		"com.apple.LaunchServices.error",
+		"com.apple.LaunchServices.syncInterrupted",
+	};
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int bad = 0, saw = 0;
+	int mobilecal;
+
+	if (cv_dir_exists(CV_STAGED_LS_DONE)) {
+		printf("PANDORA STAGED: ls store kept, marker present\n");
+		return;
+	}
+	{
+		char cal[96];
+		snprintf(cal, sizeof(cal), "/Applications/%s", "MobileCal.app");
+		mobilecal = cv_staged_isdir(cal);
+	}
+	if (cv_staged_renamed == 0 && !mobilecal) {
+		printf("PANDORA STAGED: ls store kept, nothing moved\n");
+		return;
+	}
+	if (vnode_lookup(CV_STAGED_DAEMON, 0, &vp, ctx) == 0 && vp->v_type == VDIR) {
+		UIO_STACKBUF(uio_buf, 1);
+		char dbuf[4096];
+		char uuids[32][64];
+		unsigned nu = 0, ui;
+		off_t loff = 0;
+
+		for (;;) {
+			uio_t auio = uio_createwithbuffer(1, loff, UIO_SYSSPACE, UIO_READ,
+			    &uio_buf[0], sizeof(uio_buf));
+			int eofflag = 0, numdirent = 0, re;
+			unsigned used, at;
+
+			if (auio == NULL) {
+				bad = ENOMEM;
+				break;
+			}
+			uio_addiov(auio, (uint64_t)(uintptr_t)dbuf, sizeof(dbuf));
+			re = VNOP_READDIR(vp, auio, 0, &eofflag, &numdirent, ctx);
+			if (re) {
+				bad = re;
+				break;
+			}
+			used = (unsigned)(sizeof(dbuf) - uio_resid(auio));
+			loff = uio_offset(auio);
+			if (used == 0) {
+				break;
+			}
+			/* HFS records are STD_DIRENT_LEN, not sizeof(struct dirent). */
+			for (at = 0; at + 8 <= used; ) {
+				struct dirent *dp = (struct dirent *)(void *)(dbuf + at);
+
+				if (dp->d_reclen < 12 || at + dp->d_reclen > used) {
+					break;
+				}
+				if (dp->d_type == DT_DIR && strcmp(dp->d_name, ".") != 0 &&
+				    strcmp(dp->d_name, "..") != 0) {
+					if (nu >= 32) {
+						bad = E2BIG;
+					} else {
+						snprintf(uuids[nu], sizeof(uuids[nu]), "%s", dp->d_name);
+						nu++;
+					}
+				}
+				at += dp->d_reclen;
+			}
+			if (eofflag) {
+				break;
+			}
+		}
+		vnode_put(vp);
+		vp = NULLVP;
+		for (ui = 0; ui < nu; ui++) {
+			unsigned ni;
+
+			for (ni = 0; ni < sizeof(names) / sizeof(names[0]); ni++) {
+				char path[256];
+				int error;
+
+				snprintf(path, sizeof(path), "%s/%s/Library/Caches/%s",
+				    CV_STAGED_DAEMON, uuids[ui], names[ni]);
+				error = pandora_unlink(path);
+				printf("PANDORA STAGED: unlink %s %d\n", path, error);
+				saw++;
+				if (error != 0 && error != ENOENT) {
+					bad = error;
+				}
+			}
+		}
+	} else if (vp != NULLVP) {
+		vnode_put(vp);
+	}
+	if (cv_staged_all && !bad) {
+		int error = pandora_mkdir(CV_STAGED_LS_DONE, 0755);
+
+		printf("PANDORA STAGED: marker %d unlinks %d\n", error, saw);
+	} else {
+		printf("PANDORA STAGED: marker not written all %d bad %d unlinks %d\n",
+		    cv_staged_all, bad, saw);
+	}
+}
