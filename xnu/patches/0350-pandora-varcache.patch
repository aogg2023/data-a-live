+static int
+cv_prefs_write(const char *path, const uint8_t *data, size_t len)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	int error, resid = 0;
+
+	error = vnode_lookup(path, 0, &vp, ctx);
+	if (error != 0) {
+		return error;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)data, (int)len, 0, UIO_SYSSPACE, IO_SYNC,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	if (error == 0 && resid != 0) {
+		error = EIO;
+	}
+	if (error == 0) {
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_data_size, (off_t)len);
+		VATTR_SET(&va, va_uid, 501);
+		VATTR_SET(&va, va_gid, 501);
+		VATTR_SET(&va, va_mode, S_IFREG | 0644);
+		error = vnode_setattr(vp, &va, ctx);
+	}
+	vnode_put(vp);
+	return error;
+}
+
+static void
+cv_prefs_seed(const char *when)
+{
+	int e1 = cv_prefs_write("/private/var/mobile/Library/Preferences/com.apple.purplebuddy.plist",
+	    cv_seed_purplebuddy, sizeof(cv_seed_purplebuddy));
+	int e2 = cv_prefs_write("/private/var/mobile/Library/Preferences/com.apple.purplebuddy.notbackedup.plist",
+	    cv_seed_notbackedup, sizeof(cv_seed_notbackedup));
+
+	printf("PANDORA CACHE: setup state seeded (%s): purplebuddy %d, notbackedup %d\n", when, e1, e2);
+}
+
+static void
+cv_prefs_probe(const char *when)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	uint8_t head[24] = { 0 };
+
+	if (vnode_lookup("/private/var/mobile/Library/Preferences/com.apple.purplebuddy.plist", 0,
+	    &vp, ctx) != 0) {
+		printf("PANDORA CACHE: purplebuddy.plist absent (%s)\n", when);
+		return;
+	}
+	va.va_data_size = 0;
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	if (vnode_getattr(vp, &va, ctx) == 0 && va.va_data_size > 0 && va.va_data_size <= 4096) {
+		int resid = 0;
+		(void)vn_rdwr(UIO_READ, vp, (caddr_t)head, (int)MIN(sizeof(head), (size_t)va.va_data_size),
+		    0, UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	}
+	printf("PANDORA CACHE: purplebuddy.plist before seeding (%s): %lld bytes, head %02x%02x%02x%02x\n",
+	    when, (long long)va.va_data_size, head[0], head[1], head[2], head[3]);
+	vnode_put(vp);
 }
 
