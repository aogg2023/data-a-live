+/* Print the raw MHI state machine around AMSS boot. */
+static void
+sy_mhi_state_trace(const char *tag, unsigned ms)
+{
+	unsigned i, n = ms / 50 ? ms / 50 : 1;
+
+	for (i = 0; i < n; i++) {
+		uint32_t ctrl = sy_rd(sy_bar_va, 0x38);
+		uint32_t st = sy_rd(sy_bar_va, 0x48);
+		uint32_t ee = sy_rd(sy_bar_va, sy_bhi_off + 0x28);
+
+		printf("PANDORA WLAN: MHI trace %s %u ms: ctrl %#x status %#x (syserr %u state %u ready %u) ee %#x\n",
+		    tag, i * 50, ctrl, st, (st >> 2) & 1u, (st >> 8) & 0xffu, st & 1u, ee);
+		if (((st >> 8) & 0xffu) == 2)
+			return;
+		delay(50000);
+	}
+}
