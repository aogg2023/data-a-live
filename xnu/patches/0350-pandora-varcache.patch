+static vm_offset_t parf, phy, dbi, iatu, conf, pcism, gcc_low, gcc, tlmm_low, tlmm, tcsr, rsc, cmddb, crm;
+#define SY_PHY_ROWS (sizeof(sy_phy_seq) / sizeof(sy_phy_seq[0]))
+#define SY_SUPPLY_N (sizeof(sy_supplies) / sizeof(sy_supplies[0]))
+static unsigned sy_step;
+static int sy_link_up;	/* set only when DBI answers and LINK_ACTIVE is real */
+
+static uint32_t
+sy_gcc_rd(uint32_t off)
+{
+	if (off < 0x10000UL) {
+		return *(volatile uint32_t *)(gcc_low + off);
+	}
+	return *(volatile uint32_t *)(gcc + (off - 0x50000UL));
+}
+
+static void
+sy_gcc_wr(uint32_t off, uint32_t val)
+{
+	if (off < 0x10000UL) {
+		*(volatile uint32_t *)(gcc_low + off) = val;
+		return;
+	}
+	*(volatile uint32_t *)(gcc + (off - 0x50000UL)) = val;
+}
+
+
+static uint32_t
+sy_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static void
+sy_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+}
+
+static void
+sy_usleep(unsigned us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static bool
+sy_gcc_poll(uint32_t off, uint32_t mask, uint32_t value, unsigned step_us,
+    unsigned limit_us, const char *what)
+{
+	unsigned waited = 0;
+
+	for (;;) {
+		if ((sy_gcc_rd(off) & mask) == value) {
+			return true;
+		}
+		if (waited >= limit_us) {
+			printf("PANDORA WLAN: %s did not happen in %u us (%#x)\n", what, limit_us,
+			    sy_gcc_rd(off));
+			return false;
+		}
+		sy_usleep(step_us);
+		waited += step_us;
+	}
+}
+
+static bool
+sy_poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t value, unsigned step_us,
+    unsigned limit_us, const char *what)
+{
+	unsigned waited = 0;
+
+	for (;;) {
+		if ((sy_rd(base, off) & mask) == value) {
+			return true;
+		}
+		if (waited >= limit_us) {
+			printf("PANDORA WLAN: %s did not happen in %u us (%#x)\n", what, limit_us,
+			    sy_rd(base, off));
+			return false;
+		}
+		sy_usleep(step_us);
+		waited += step_us;
+	}
+}
