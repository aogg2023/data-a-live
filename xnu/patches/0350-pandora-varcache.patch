+extern int pandora_mkdir(const char *path, int mode);   /* bsd/vfs/vfs_syscalls.c (0185) */
+
+/* 0351: ownership/mode of each skeleton directory, read from the root volume before the mount. */
+struct cv_dirattr {
+	uint32_t uid;
+	uint32_t gid;
+	uint16_t mode;
+	uint8_t have;
+};
+
+static struct cv_dirattr cv_attr[CV_DIRS];
+static unsigned cv_captured;
+
+static unsigned
+cv_capture_attrs(void)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	unsigned got = 0;
+
+	for (unsigned i = 0; i < CV_DIRS; i++) {
+		vnode_t vp = NULLVP;
+		struct vnode_attr va;
+
+		if (vnode_lookup(cv_skeleton[i], 0, &vp, ctx) != 0) {
+			continue;
+		}
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_uid);
+		VATTR_WANTED(&va, va_gid);
+		VATTR_WANTED(&va, va_mode);
+		if (vnode_getattr(vp, &va, ctx) == 0) {
+			cv_attr[i].uid = (uint32_t)va.va_uid;
+			cv_attr[i].gid = (uint32_t)va.va_gid;
+			cv_attr[i].mode = (uint16_t)(va.va_mode & 07777);
+			cv_attr[i].have = 1;
+			got++;
+		}
+		vnode_put(vp);
+	}
+	return got;
+}
+
+static unsigned
+cv_apply_attrs(void)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	unsigned done = 0;
+
+	for (unsigned i = 0; i < CV_DIRS; i++) {
+		vnode_t vp = NULLVP;
+		struct vnode_attr va;
+
+		if (!cv_attr[i].have) {
+			continue;
+		}
+		if (vnode_lookup(cv_skeleton[i], 0, &vp, ctx) != 0) {
+			continue;
+		}
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_uid, cv_attr[i].uid);
+		VATTR_SET(&va, va_gid, cv_attr[i].gid);
+		VATTR_SET(&va, va_mode, cv_attr[i].mode);
+		if (vnode_setattr(vp, &va, ctx) == 0) {
+			done++;
+		}
+		vnode_put(vp);
+	}
+	return done;
+}
+
+/* Directory existence by lookup (vnode_open cannot be used for directories). */
+static int
+cv_dir_exists(const char *path)
+{
+	vnode_t vp = NULLVP;
+
+	if (vnode_lookup(path, 0, &vp, vfs_context_kernel()) != 0) {
+		return 0;
+	}
+	vnode_put(vp);
+	return 1;
+}
+
+static void
+cv_seed_skeleton(void)
+{
+	int on = 1;
+	unsigned made = 0, same = 0, failed = 0, applied;
+
+	(void)PE_parse_boot_argn("pandora_varcache", &on, sizeof(on));
+	if (!on) {
+		printf("PANDORA CACHE: pandora_varcache=0, skeleton not seeded\n");
+		return;
+	}
+	for (unsigned i = 0; i < CV_DIRS; i++) {
+		int error = pandora_mkdir(cv_skeleton[i], 0755);
+		if (error == 0) {
+			made++;
+		} else if (error == EEXIST) {
+			same++;
+		} else {
+			failed++;
+			printf("PANDORA CACHE: skeleton %s: %d\n", cv_skeleton[i], error);
+		}
+	}
+	applied = cv_apply_attrs();
+	printf("PANDORA CACHE: skeleton %u made, %u existing, %u failed, attributes %u/%u applied;"
