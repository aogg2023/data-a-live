+/* Read-only: enumerate the cmd-db entries (name[8] | addr | len). The PCIe ICC
+ * votes are RPMh BCM commands; the live DT names the voters "hlos" and
+ * "pcie_crm_hw_0", so their cmd-db addresses are what we need to send. */
+static void
+sy_cmddb_dump(void)
+{
+	unsigned i, shown = 0;
+
+	if (!sy_cmddb)
+		return;
+	for (i = 0; i < 0x400u && shown < 48u; i += 16u) {
+		char name[9];
+		unsigned k, printable = 1;
+		uint32_t addr, len;
+
+		for (k = 0; k < 8; k++) {
+			uint8_t c = *(volatile uint8_t *)(sy_cmddb + i + k);
+
+			name[k] = (c == 0) ? 0 : (char)c;
+			if (c && (c < 0x20 || c > 0x7e))
+				printable = 0;
+		}
+		name[8] = 0;
+		if (!printable || !name[0])
+			continue;
+		addr = sy_rd(sy_cmddb, i + 8);
+		len = sy_rd(sy_cmddb, i + 12);
+		printf("PANDORA WLAN: cmd-db[%u]: %-8s addr %#x len %#x\n", i / 16, name, addr, len);
+		shown++;
+	}
+	sy_log_sync();
+}
