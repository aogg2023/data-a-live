+/* ---- M6a: en0 (ifnet + Apple80211 ioctl surface) --------------------------------
+ * Ported from the locally working UniXNU-sheng WifiNet.cpp (same ifnet KPI, same
+ * Apple80211 command numbers). Off by default (songyuan_net=1): it publishes an
+ * interface so the system side can be checked while the radio stack is still being
+ * brought up.  The request table and the HTT data path are sy_f_ioctl() /
+ * sy_f_output() / sy_f_service() (stage 25). */
+#define SY_SIOCSA80211 0x802869c8UL
+#define SY_SIOCGA80211 0xc02869c9UL
+
+struct sy_apple80211req {
+	char if_name[16];
+	int32_t type;
+	int32_t val;
+	uint32_t len;
+	uint64_t data;
+};
+
+static errno_t
+sy_net_output(ifnet_t ifp, mbuf_t m)
+{
+	return sy_f_output(ifp, m);
+}
+
+static errno_t
+sy_net_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	(void)ifp;
+	return sy_f_ioctl(ifp, cmd, data);
+}
+
+static void
+sy_net_event(ifnet_t ifp, const struct kev_msg *msg)
+{
+	(void)ifp; (void)msg;
+}
+
+static int
+sy_net_attach(void)
+{
+	static const uint8_t mac[6] = { 0x02, 0x00, 0x00, 0x00, 0x01, 0x00 };
+	static const uint8_t bcast[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+	struct ifnet_init_eparams p;
+	errno_t e;
+
+	if (sy_ifp)
+		return 0;
+	memset(&p, 0, sizeof(p));
+	p.ver = IFNET_INIT_CURRENT_VERSION;
+	p.len = sizeof(p);
+	p.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO;
+	p.name = "en";
+	p.unit = 0;
+	p.family = IFNET_FAMILY_ETHERNET;
+	p.subfamily = IFNET_SUBFAMILY_WIFI;	/* so the stack treats en0 as Wi-Fi */
+	p.type = IFT_ETHER;
+	p.output = sy_net_output;
+	p.demux = ether_demux;
+	p.add_proto = ether_add_proto;
+	p.del_proto = ether_del_proto;
+	p.check_multi = ether_check_multi;
+	p.framer = ether_frameout;
+	p.ioctl = sy_net_ioctl;
+	p.event = sy_net_event;
+	p.broadcast_addr = bcast;
+	p.broadcast_len = 6;
+	e = ifnet_allocate_extended(&p, &sy_ifp);
+	if (e || !sy_ifp) {
+		printf("PANDORA WLAN: net: ifnet_allocate_extended %d\n", e);
+		return -1;
+	}
+	ifnet_set_mtu(sy_ifp, 1500);
+	ifnet_set_flags(sy_ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	ifnet_set_baudrate(sy_ifp, 54000000ULL);
+	ifnet_set_hdrlen(sy_ifp, 14);
+	ifnet_set_addrlen(sy_ifp, 6);
+	ifnet_set_eflags(sy_ifp, IFEF_ENQUEUE_MULTI, IFEF_ENQUEUE_MULTI);
+	e = ifnet_attach(sy_ifp, NULL);
+	if (e) {
+		printf("PANDORA WLAN: net: ifnet_attach %d\n", e);
+		ifnet_release(sy_ifp);
+		sy_ifp = NULL;
+		return -1;
+	}
+	ifnet_set_lladdr(sy_ifp, mac, 6);
+	(void)bpf_attach(sy_ifp, DLT_EN10MB, 14, NULL, NULL);
+	ifnet_set_flags(sy_ifp, IFF_UP, IFF_UP);
+	printf("PANDORA WLAN: net: en0 attached (%02x:%02x:%02x:%02x:%02x:%02x)\n",
+	    mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+	/* M6a-2: the IO80211 registry objects the wireless daemon looks for */
+	printf("PANDORA WLAN: net: IO80211 publish -> %d\n",
+	    pandora_80211_publish(mac, "en0"));
+	sy_log_sync();
+	return 0;
+}
