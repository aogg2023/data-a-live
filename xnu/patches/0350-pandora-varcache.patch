+static uint32_t
+sy_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static void
+sy_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+}
+
+static void
+sy_usleep(unsigned us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static bool
+sy_poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t value, unsigned step_us,
+    unsigned limit_us, const char *what)
+{
+	unsigned waited = 0;
+
+	for (;;) {
+		if ((sy_rd(base, off) & mask) == value) {
+			return true;
+		}
+		if (waited >= limit_us) {
+			printf("PANDORA WLAN: %s did not happen in %u us (%#x)\n", what, limit_us,
+			    sy_rd(base, off));
+			return false;
+		}
+		sy_usleep(step_us);
+		waited += step_us;
+	}
