+/* pandora_rmrf's readdir walk, but lchown instead of unlink. DT_DIR is entered.
+ * DT_LNK is chowned and not followed, so a link into /System stays a link. */
+static int
+cv_staged_lchown_tree(const char *path)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int error = pandora_lchown(path, 0, 0);
+	struct cv_sub {
+		char name[256];
+	} *subs;
+	char *dbuf;
+	unsigned nsub = 0, cap = 128, i;
+	const vm_size_t dsz = 4096;
+
+	if (vnode_lookup(path, 0, &vp, ctx) != 0 || vp->v_type != VDIR) {
+		if (vp != NULLVP) {
+			vnode_put(vp);
+		}
+		return error;
+	}
+	subs = kalloc_data(sizeof(*subs) * cap, Z_WAITOK);
+	dbuf = kalloc_data(dsz, Z_WAITOK);
+	if (subs == NULL || dbuf == NULL) {
+		if (subs) {
+			kfree_data(subs, sizeof(*subs) * cap);
+		}
+		if (dbuf) {
+			kfree_data(dbuf, dsz);
+		}
+		vnode_put(vp);
+		return ENOMEM;
+	}
+	{
+		UIO_STACKBUF(uio_buf, 1);
+		off_t loff = 0;
+
+		for (;;) {
+			uio_t auio = uio_createwithbuffer(1, loff, UIO_SYSSPACE, UIO_READ,
+			    &uio_buf[0], sizeof(uio_buf));
+			int eofflag = 0, numdirent = 0;
+			int re;
+			unsigned used, at;
+
+			if (auio == NULL) {
+				error = error ? error : ENOMEM;
+				break;
+			}
+			uio_addiov(auio, (uint64_t)(uintptr_t)dbuf, dsz);
+			re = VNOP_READDIR(vp, auio, 0, &eofflag, &numdirent, ctx);
+			if (re) {
+				error = error ? error : re;
+				break;
+			}
+			used = (unsigned)(dsz - uio_resid(auio));
+			loff = uio_offset(auio);
+			if (used == 0) {
+				break;
+			}
+			/* HFS records are STD_DIRENT_LEN, not sizeof(struct dirent). */
+			for (at = 0; at + 8 <= used; ) {
+				struct dirent *dp = (struct dirent *)(void *)(dbuf + at);
+
+				if (dp->d_reclen < 12 || at + dp->d_reclen > used) {
+					break;
+				}
+				if (strcmp(dp->d_name, ".") != 0 && strcmp(dp->d_name, "..") != 0) {
+					if (dp->d_type == DT_DIR) {
+						if (nsub < cap) {
+							snprintf(subs[nsub].name, sizeof(subs[nsub].name), "%s", dp->d_name);
+							nsub++;
+						} else if (!error) {
+							error = E2BIG;
+						}
+					} else {
+						char *child = kalloc_data(1024, Z_WAITOK);
+						int n = child ? snprintf(child, 1024, "%s/%s", path, dp->d_name) : -1;
+
+						if (!child || n < 0 || n >= 1024) {
+							error = error ? error : (child ? ENAMETOOLONG : ENOMEM);
+						} else {
+							int e = pandora_lchown(child, 0, 0);
+							if (e && !error) {
+								error = e;
+							}
+						}
+						if (child) {
+							kfree_data(child, 1024);
+						}
+					}
+				}
+				at += dp->d_reclen;
+			}
+			if (eofflag) {
+				break;
+			}
+		}
+	}
+	vnode_put(vp);
+	kfree_data(dbuf, dsz);
+	for (i = 0; i < nsub; i++) {
+		char *child = kalloc_data(1024, Z_WAITOK);
+		int n = child ? snprintf(child, 1024, "%s/%s", path, subs[i].name) : -1;
+		int e;
+
+		if (!child || n < 0 || n >= 1024) {
+			error = error ? error : (child ? ENAMETOOLONG : ENOMEM);
+			if (child) {
+				kfree_data(child, 1024);
+			}
+			continue;
+		}
+		e = cv_staged_lchown_tree(child);
+		kfree_data(child, 1024);
+		if (e && !error) {
+			error = e;
+		}
+	}
+	kfree_data(subs, sizeof(*subs) * cap);
+	return error;
+}
