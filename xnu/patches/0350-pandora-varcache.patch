+/* ---- CESTA state machine (live.dtb qcom,pcie-sm-seq / -branch-seq) ---- */
+static const uint32_t sy_sm_seq[] = {
+	0x1c018081UL, 0x70074002UL, 0x50028000UL, 0x28007003UL, 0x80804002UL,
+	0x70021c01UL, 0x18002802UL, 0x70005000UL, 0x10004000UL, 0x80814002UL,
+	0x18001c01UL, 0x1c018080UL, 0x00001000UL,
+};
+static const uint32_t sy_sm_branch[] = { 0x4UL, 0x1cUL, 0x24UL, 0x2cUL, 0UL, 0UL, 0UL };
+#define SY_SM_BRANCH_OFF	0x00001000UL
+#define SY_SM_PWR_CTRL		0x00001040UL	/* pci-msm-drv.pcie_sm_regs[1] */
+#define SY_SM_PWR_MASK		0x00001048UL	/* pci-msm-drv.pcie_sm_regs[2] */
+#define SY_SM_START_OFF		0x00001090UL
