+static uint32_t
+sy_gcc_rd(uint32_t off)
+{
+	if (off < 0x10000UL) {
+		return *(volatile uint32_t *)(gcc_low + off);
+	}
+	return *(volatile uint32_t *)(gcc + (off - 0x50000UL));
+}
+
+static void
+sy_gcc_wr(uint32_t off, uint32_t val)
+{
+	if (off < 0x10000UL) {
+		*(volatile uint32_t *)(gcc_low + off) = val;
+		return;
+	}
+	*(volatile uint32_t *)(gcc + (off - 0x50000UL)) = val;
+}
