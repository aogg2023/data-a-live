+/* RPMh clock/single-command vote: cmd-db entry for a non-VRM resource (e.g. "rf_clk"). */
+static int
+sy_rpmh_lookup_clock(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	unsigned matches = 0;
+
+	for (unsigned i = 0; i < 8 && res[i]; i++)
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	for (unsigned i = 0; i < 8; i++) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = sy_cmddb16(h);
+		if (!slave)
+			break;
+		uint32_t entries = SY_CMDDB_HEADER + sy_cmddb16(h + 2);
+		unsigned count = sy_cmddb16(h + 6);
+		if ((entries & 3u) || entries + count * SY_CMDDB_ENTRY > SY_CMDDB_SIZE) {
+			printf("PANDORA WLAN: cmd-db slave header %u malformed\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; j++) {
+			uint32_t e = entries + SY_CMDDB_ENTRY * j;
+			if (sy_rd(sy_cmddb, e) != key[0] || sy_rd(sy_cmddb, e + 4) != key[1])
+				continue;
+			uint32_t addr = sy_rd(sy_cmddb, e + 16);
+			printf("PANDORA WLAN: cmd-db %s addr=%#x slave=%u\n", res, addr, slave);
+			if (slave == 4 && !(addr & 15u)) {
+				*address = addr;
+				matches++;
+			}
+		}
+	}
+	if (matches != 1) {
+		printf("PANDORA WLAN: cmd-db %s: %u matches; not voting\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+/* One ACTIVE TCS command on the PCIe set (TCS2); the clock level is the data word. */
+static int
+sy_rpmh_vote1(const char *res, uint32_t addr_off, uint32_t data)
+{
+	const struct sy_rpmh_layout *L = &sy_rpmh_v3;
+	uint32_t id, address = 0, b, bit;
+	unsigned major;
+	bool done = false;
+	int rc;
+
+	if (!sy_rsc || !sy_cmddb) {
+		sy_rsc = ml_io_map(SY_RSC_PA, SY_RSC_SIZE);
+		sy_cmddb = ml_io_map(SY_CMDDB_PA, SY_CMDDB_SIZE);
+		if (!sy_rsc || !sy_cmddb) {
+			printf("PANDORA WLAN: RPMh: RSC/cmd-db mapping failed\n");
+			return ENOMEM;
+		}
+	}
+	id = sy_rd(sy_rsc, 0);
+	major = (id >> 16) & 0xffu;
+	if (major < 3) {
+		printf("PANDORA WLAN: RPMh: RSC v%u: no 3.0 layout for %s\n", major, res);
+		return ENODEV;
+	}
+	rc = sy_rpmh_lookup_clock(res, &address);
+	if (rc)
+		return rc;
+	address += addr_off;	/* clk-rpmh: res_addr = cmd-db addr + CLK_RPMH_VRM_EN_OFFSET(4) */
+	b = SY_TCS_OFF + 2 * SY_TCS_STRIDE;
+	bit = 1u << 2;
+	if (sy_rd(sy_rsc, b + L->control) != 0 || sy_rd(sy_rsc, b + L->enable) != 0 ||
+	    sy_rd(sy_rsc, b + L->wait) != 0) {
+		printf("PANDORA WLAN: RPMh: TCS2 busy; %s not voted\n", res);
+		return EBUSY;
+	}
+	sy_wr(sy_rsc, b + L->control, 0);
+	sy_wr(sy_rsc, SY_TCS_OFF + 8, bit);
+	if (!sy_rpmh_sync(b + L->msgid, SY_RPMH_WRITE) ||
+	    !sy_rpmh_sync(b + L->addr, address) ||
+	    !sy_rpmh_sync(b + L->data, data)) {
+		printf("PANDORA WLAN: RPMh: %s command write failed\n", res);
+		return EIO;
+	}
+	if (!sy_rpmh_sync(b + L->wait, 1) || !sy_rpmh_sync(b + L->enable, 1)) {
+		printf("PANDORA WLAN: RPMh: %s arm failed\n", res);
+		return EIO;
+	}
+	sy_wr(sy_rsc, SY_TCS_OFF, sy_rd(sy_rsc, SY_TCS_OFF) | bit);
+	sy_wr(sy_rsc, b + L->control, SY_RPMH_AMC);
+	sy_wr(sy_rsc, b + L->control, SY_RPMH_AMC | SY_RPMH_TRIGGER);
+	for (unsigned us = 0; us < 10000 && !done; us++) {
+		done = ((sy_rd(sy_rsc, SY_TCS_OFF + 4) & bit) != 0) &&
+		    sy_rd(sy_rsc, b + L->status) != 0;
+		if (!done)
+			delay(1);
+	}
+	printf("PANDORA WLAN: RPMh: %s addr %#x data %u on TCS2 done=%d irq=%#x status=%#x\n",
+	    res, address, data, done, sy_rd(sy_rsc, SY_TCS_OFF + 4),
+	    sy_rd(sy_rsc, b + L->status));
+	return done ? 0 : ETIMEDOUT;
+}
+
+static bool
+sy_supplies_on(void)
+{
+	for (unsigned i = 0; i < SY_SUPPLY_N; i++) {
+		const struct sy_supply *s = &sy_supplies[i];
+		int rc;
+
+		printf("PANDORA WLAN: voting %s (%s) at %u mV%s\n", s->name, s->what,
+		    s->mv, s->ldo ? " LDO" : " SMPS");
+		if (s->mv * 1000 < s->min_uv || s->mv * 1000 > s->max_uv) {
+			printf("PANDORA WLAN: %u mV for %s is outside %u-%u uV\n", s->mv,
+			    s->name, s->min_uv, s->max_uv);
+			return false;
+		}
+		rc = sy_rpmh_vote_res(s->name, s->mv, s->ldo ? 7 : 0, s->ldo);
+		if (rc != 0) {
+			printf("PANDORA WLAN: the vote for %s failed (%d)\n", s->name, rc);
+			return false;
+		}
+		printf("PANDORA WLAN: %s on at %u mV\n", s->name, s->mv);
+	}
+	/* cnss-peach node: clocks = <&rsc_clk 6> "rf_clk" and wcal-pbs-supply; both are
+	 * RPMh resources the vendor cnss driver enables, and both were missing here. */
+	{
+		int rfclk = 1, wcal = 1;
+
+		(void)PE_parse_boot_argn("songyuan_rfclk", &rfclk, sizeof(rfclk));
+		if (rfclk) {
+			/* clk-rpmh.c canoe table: [RPMH_RF_CLK1] = clk_rpmh_c1a_e0_div1, defined as
+			 * DEFINE_CLK_RPMH_VRM(c1a_e0, _div1, "C1A_E0", 1) - the cmd-db resource name is
+			 * UPPERCASE "C1A_E0"; the DT consumer name is "rf_clk". Enable word at +4, data 1. */
+			printf("PANDORA WLAN: voting rf_clk (RPMh VRM clock C1A_E0 +4, data 1)\n");
+			if (sy_rpmh_vote1("C1A_E0", 4, 1) != 0)
+				printf("PANDORA WLAN: the rf_clk vote failed\n");
+		}
+		(void)wcal;
+	}
+	return true;
+}
+
+/* ---- power domains and clocks -------------------------------------------------- */
+
+static bool
+sy_gdsc_on(uint32_t gdscr, uint32_t vote_bit, const char *name)
+{
+	/* gcc-canoe.c: both PCIe GDSCs are VOTABLE; 0x5214c BIT(0) collapses the root
+	 * complex's domain and BIT(2) the PHY's (1 = collapse). Clear the vote first, poll
+	 * the power-up bit, then fall back to the domain's own switch. Read PWR_ON back so
+	 * the log proves the domain is really powered. */
+	sy_gcc_wr(0x5214c, sy_gcc_rd(0x5214c) & ~vote_bit);
+	if (!sy_gcc_poll(gdscr + GCC_GDSC_CFG, GDSC_PWR_UP_DONE, GDSC_PWR_UP_DONE, 50, 2000,
+	    name)) {
+		sy_gcc_wr(gdscr, sy_gcc_rd(gdscr) & ~GDSC_SW_COLLAPSE);
+		if (!sy_gcc_poll(gdscr + GCC_GDSC_CFG, GDSC_PWR_UP_DONE, GDSC_PWR_UP_DONE, 50,
+		    2000, name)) {
+			return false;
+		}
+	}
+	printf("PANDORA WLAN: %s on: gdscr %#x cfg %#x collapse %#x power_on %u\n", name,
+	    sy_gcc_rd(gdscr), sy_gcc_rd(gdscr + 4), sy_gcc_rd(0x5214c),
+	    (sy_gcc_rd(gdscr) & GDSC_PWR_ON) ? 1u : 0u);
+	return true;
+}
+
+static bool
+sy_rcg_set(uint32_t rcg, uint32_t cfg, const char *name)
+{
+	sy_gcc_wr(rcg, sy_gcc_rd(rcg) | RCG_ROOT_EN);
+	if (!sy_gcc_poll(rcg, RCG_ROOT_OFF, 0, 10, 500, name)) {
+		return false;
+	}
+	sy_gcc_wr(rcg + 4, cfg);
+	sy_gcc_wr(rcg, sy_gcc_rd(rcg) | RCG_UPDATE);
+	if (!sy_gcc_poll(rcg, RCG_UPDATE, 0, 10, 500, name)) {
+		return false;
+	}
+	sy_gcc_wr(rcg, sy_gcc_rd(rcg) & ~RCG_ROOT_EN);
+	return true;
+}
+
+static bool
+sy_clocks_on(void)
+{
+	static const uint32_t branches[] = {
+		GCC_SLV_AXI, GCC_MSTR_AXI, GCC_CFG_AHB, GCC_AUX, GCC_Q2A, GCC_CNOC_SF
+	};
+
+	if (!sy_gdsc_on(GCC_GDSC_PCIE, 1UL << 0, "root complex 0's power domain") ||
+	    !sy_gdsc_on(GCC_GDSC_PHY, 1UL << 2, "the PHY's power domain")) {
+		return false;
+	}
+	/* aux: bi_tcxo (parent 0 in gcc_parent_map_6), no divider -> 19.2 MHz */
+	if (!sy_rcg_set(GCC_AUX_RCG, 0x000, "aux at 19.2 MHz")) {
+		return false;
+	}
+	/* gcc-canoe gcc_pcie_0_phy_rchng_clk_src: 100 MHz = P_GCC_GPLL0_OUT_EVEN(6) /3 */
+	if (!sy_rcg_set(GCC_RCHNG_RCG, 0x602, "rchng at 100 MHz")) {
+		printf("PANDORA WLAN: the rchng RCG did not lock\n");
+	}
+	sy_wr(tcsr, SY_TCSR_CLKREF, sy_rd(tcsr, SY_TCSR_CLKREF) | 1);
+	sy_usleep(10);
+	/* gcc-canoe/like the local driver's clk_init: switch the pipe clock source to the PHY
+	 * before the clocks are enabled (clk_set_parent(pipe_clk_mux, pipe_clk_ext_src)). */
+	sy_gcc_wr(GCC_PIPE_MUX, sy_gcc_rd(GCC_PIPE_MUX) & ~3UL);
+	printf("PANDORA WLAN: pipe mux %#x (PHY pipe source)\n", sy_gcc_rd(GCC_PIPE_MUX));
+	sy_gcc_wr(GCC_VOTE_BRANCH, sy_gcc_rd(GCC_VOTE_BRANCH) | 0x6f);	/* slv/mstr/cfg/aux/q2a/cnoc_sf, pipe added with the PHY */
+	sy_gcc_wr(GCC_VOTE_BRANCH2, sy_gcc_rd(GCC_VOTE_BRANCH2) |
+	    (1UL << 12) | (1UL << 19) | (1UL << 22));
+	sy_gcc_wr(0x52018, sy_gcc_rd(0x52018) | (1UL << 31));	/* gcc_pcie_0_phy_aux_clk */
+	for (unsigned i = 0; i < (sizeof(branches) / sizeof(branches[0])); i++) {
+		if (!sy_gcc_poll(branches[i], CBCR_CLK_OFF, 0, 10, 1000, "a PCIe clock branch")) {
+			printf("PANDORA WLAN: branch at GCC %#x stays off\n", branches[i]);
+			return false;
+		}
+	}
+	printf("PANDORA WLAN: domains on; aux, reference and branch clocks running\n");
+	return true;
+}
+
+/* ---- pins (port-proven TLMM CTL layout) ---------------------------------------- */
+
+/* TLMM CTL low bits: pull [1:0], func [5:2], drive [8:6], OE [9]; EGPIO present [11],
+ * enable [12]. The port's proven sy_gpio() keeps everything above the low mask and mirrors
+ * ENABLE from whatever PRESENT the boot chain left, so the pad is never re-purposed. */
+static vm_offset_t
+sy_pin_reg(uint32_t pin, uint32_t add)
+{
+	if (pin >= 16 && pin <= 19) {
+		return tlmm_low + (pin - 16) * 0x1000UL + add;
+	}
+	return tlmm + (pin - 102) * 0x1000UL + add;
+}
+
+static void
+sy_pin_ctl(uint32_t pin, uint32_t low)
+{
+	vm_offset_t ctl = sy_pin_reg(pin, 0);
+	uint32_t old = *(volatile uint32_t *)ctl;
+	uint32_t value = (old & ~(0x3ffu | (1u << 12))) | (low & 0x3ffu);
+
+	if (old & (1u << 11)) {
+		value |= (1u << 12);
+	}
+	*(volatile uint32_t *)ctl = value;
+}
+
+static void
+sy_pin_level(uint32_t pin, uint32_t level)
+{
+	*(volatile uint32_t *)sy_pin_reg(pin, 4) = level;
+}
+
+static void
+sy_pin_out(uint32_t pin, uint32_t low)
+{
+	sy_pin_level(pin, 0);	/* level before the output enable, so the pin never glitches */
+	sy_pin_ctl(pin, low);
+}
+
+/* ---- PARF, PHY, root port, link ------------------------------------------------ */
+
+static void
+sy_sm_state(const char *when)
+{
+	printf("PANDORA WLAN: CESTA %s: start %#x state %#x %#x %#x %#x %#x %#x\n", when,
+	    sy_rd(pcism, SY_SM_START_OFF), sy_rd(pcism, SY_SM_DBG0),
+	    sy_rd(pcism, SY_SM_DBG0 + 8), sy_rd(pcism, SY_SM_DBG0 + 0x10),
+	    sy_rd(pcism, SY_SM_DBG0 + 0x18), sy_rd(pcism, SY_SM_DBG0 + 0x40),
+	    sy_rd(pcism, SY_SM_DBG0 + 0x50));
+}
+
+static void
+sy_sm_load(void)
+{
+	uint32_t probe = sy_rd(pcism, SY_SM_START_OFF);
+
+	sy_sm_state("before load");
+	if (probe == 0xffffffffUL) {
+		printf("PANDORA WLAN: CESTA does not answer (start %#x); not touching it\n", probe);
+		return;
+	}
+	/* pci-msm-drv.pcie_sm_regs=0x1D07000,0x1040,0x1048,0x3000,0x1: clear instance 0's
+	 * PWR_CTRL/PWR_MASK overrides before loading the sequence, as msm_pcie_cesta_load_sm_seq
+	 * does. */
+	sy_wr(pcism, SY_SM_PWR_CTRL, 0);
+	sy_wr(pcism, SY_SM_PWR_MASK, 0);
+	for (unsigned i = 0; i < sizeof(sy_sm_seq) / sizeof(sy_sm_seq[0]); i++) {
+		sy_wr(pcism, 4 * i, sy_sm_seq[i]);
+	}
+	for (unsigned i = 0; i < sizeof(sy_sm_branch) / sizeof(sy_sm_branch[0]); i++) {
+		sy_wr(pcism, SY_SM_BRANCH_OFF + 4 * i, sy_sm_branch[i]);
+	}
+	sy_wr(pcism, SY_SM_START_OFF, sy_rd(pcism, SY_SM_START_OFF) | 1);
+	sy_sm_state("after load+start");
+}
+
+static void
+sy_parf_setup(void)
+{
+	sy_wr(parf, PARF_DEVICE_TYPE, 0x4);			/* root complex */
+	sy_wr(parf, PARF_PHY_CTRL, sy_rd(parf, PARF_PHY_CTRL) & ~1UL);
+	sy_wr(parf, PARF_DBI_BASE, (uint32_t)SY_DBI_PA);
+	sy_wr(parf, PARF_DBI_BASE + 4, (uint32_t)(SY_DBI_PA >> 32));
+	sy_wr(parf, PARF_ATU_BASE, (uint32_t)SY_IATU_PA);
+	sy_wr(parf, PARF_ATU_BASE + 4, (uint32_t)(SY_IATU_PA >> 32));
+	/* Upstream pcie-qcom (2.7.0+ IP) qcom_pcie_avoid_dbi_atu_mirroring(): write U64_MAX to
+	 * PARF_SLV_ADDR_SPACE_SIZE/_HI so the PARF stops mirroring DBI and ATU every 16 MiB;
+	 * the DBI/ATU base registers written above then place both blocks at their DT addresses.
+	 * (The old 0 / 0x80000000 values are the legacy pci-msm programming; the new IP needs
+	 * U64_MAX.)
+	 * https://lore.kernel.org/all/8877e1f7-bbb6-49e9-a30c-0ae8e40bf5dd@quicinc.com/T/#t */
+	sy_wr(parf, PARF_SLV_SPACE_SIZE, 0xffffffffUL);
+	sy_wr(parf, PARF_SLV_SPACE_SIZE + 4, 0xffffffffUL);
+	sy_wr(parf, PARF_SYS_CTRL, 0x365e);	/* pci-msm.c msm_pcie_enable_link */
+	sy_wr(parf, 0x174, sy_rd(parf, 0x174) | (1UL << 4));	/* MHI_CLOCK_RESET_CTRL bypass */
+	sy_wr(parf, 0x020, sy_rd(parf, 0x020) & ~(1UL << 5));	/* PM_CTRL: no L1 entry */
+	sy_wr(parf, 0x1a8, sy_rd(parf, 0x1a8) | (1UL << 31));	/* AXI_MSTR_WR_ADDR_HALT */
+	sy_wr(parf, PARF_CLKREQ_SEL, sy_rd(parf, PARF_CLKREQ_SEL) & ~1UL);
+	printf("PANDORA WLAN: PARF glue set (device type, DBI/ATU base, SLV window, L1 policy)\n");
+	/* The DBI read is deferred to after the PHY: the vendor driver never accesses DBI
+	 * before pcie_phy_init() and the pipe clock are up. */
+}
+
+static bool
+sy_phy_start(void)
+{
+	/* pci-msm.c pcie_phy_init: the device tree sequence is written in order (its last
+	 * entries are the PCS SW_RESET and START_CONTROL writes), the PHY is given time to
+	 * stabilise, then the pipe clock is enabled and PHYSTATUS is awaited (bit set = the
+	 * PHY is not ready). */
+	for (unsigned i = 0; i < SY_PHY_ROWS; i++) {
+		sy_wr(phy, sy_phy_seq[i][0], sy_phy_seq[i][1]);
+	}
+	sy_usleep(1000);
+	/* pci-msm.c pcie_phy_init order: the pipe clock is selected and enabled only
+	 * after the PHY sequence, then the pipe interface gets an assert/deassert reset
+	 * (1 ms) before PHYSTATUS is awaited. gcc-canoe has no dedicated pipe reset, so
+	 * the pipe side of that reset uses PCIE_0_PHY_NOCSR_COM_PHY_BCR (0x6c028); the
+	 * live DT has no "pcie_0_phy_pipe_reset" property either. */
+	sy_gcc_wr(GCC_PIPE_MUX, sy_gcc_rd(GCC_PIPE_MUX) & ~3UL);
+	sy_gcc_wr(GCC_VOTE_BRANCH, sy_gcc_rd(GCC_VOTE_BRANCH) | (1UL << 4));
+	sy_gcc_wr(GCC_BCR_PHY_NOCSR, sy_gcc_rd(GCC_BCR_PHY_NOCSR) | 1);
+	sy_usleep(1000);
+	sy_gcc_wr(GCC_BCR_PHY_NOCSR, sy_gcc_rd(GCC_BCR_PHY_NOCSR) & ~1UL);
+	printf("PANDORA WLAN: pipe source %#x, pipe reset bcr %#x, pipe branch %#x\n",
+	    sy_gcc_rd(GCC_PIPE_MUX), sy_gcc_rd(GCC_BCR_PHY_NOCSR), sy_gcc_rd(GCC_PIPE));
+	if (!sy_poll(phy, PHY_STATUS, PHY_STATUS_BIT, 0, 200, 200000, "the PHY's PHYSTATUS")) {
+		return false;
+	}
+	printf("PANDORA WLAN: PHY started (%u writes), pipe branch %#x\n",
+	    (unsigned)SY_PHY_ROWS, sy_gcc_rd(GCC_PIPE));
+	return true;
+}
+
+static void
+sy_diag_regs(const char *when)
+{
+	printf("PANDORA WLAN: %s: parf dev-type %#x sys %#x l1 %#x slv_lo %#x slv_hi %#x atu_lo %#x atu_hi %#x int_mask %#x int2 %#x\n",
+	    when, sy_rd(parf, PARF_DEVICE_TYPE), sy_rd(parf, PARF_SYS_CTRL),
+	    sy_rd(parf, 0x020), sy_rd(parf, 0x358), sy_rd(parf, 0x35c),
+	    sy_rd(parf, 0x634), sy_rd(parf, 0x638), sy_rd(parf, 0x22c), sy_rd(parf, 0x50c));
+	printf("PANDORA WLAN: %s: gcc aux-halt %#x rchng-halt %#x pipe-halt %#x; dbi %#x\n",
+	    when, sy_gcc_rd(GCC_AUX), sy_gcc_rd(0x6b074), sy_gcc_rd(GCC_PIPE), sy_rd(dbi, 0));
+}
+
+static void
+sy_iatu_ecam(void)
+{
+	sy_wr(iatu, IATU_CTRL2(0), 0);
+	sy_wr(iatu, IATU_CTRL1(0), IATU_TYPE_CFG0);
+	sy_wr(iatu, IATU_LBAR(0), (uint32_t)SY_CONF_PA);
+	sy_wr(iatu, IATU_UBAR(0), (uint32_t)(SY_CONF_PA >> 32));
+	sy_wr(iatu, IATU_LAR(0), (uint32_t)(SY_CONF_PA + 0xfffff));
+	sy_wr(iatu, IATU_CTRL2(0), IATU_ENABLE | IATU_CFG_SHIFT);
+	/* pci-msm.c: the cfg0 window is the ECAM for bus 1 (endpoint); root port config is DBI. */
+	
+	/* pci-msm.c msm_pcie_iatu_setup_ecam_blocker: point ECAM at the DBI base and block
+	 * every function of bus 0 except the root port's own config space. */
+	sy_wr(parf, PARF_ECAM_BASE, (uint32_t)SY_DBI_PA);
+	sy_wr(parf, PARF_ECAM_BASE + 4, (uint32_t)(SY_DBI_PA >> 32));
+	sy_wr(parf, 0x360, (uint32_t)SY_DBI_PA + 0x1000);	/* BLOCK_SLV_AXI_WR_BASE */
+	sy_wr(parf, 0x364, (uint32_t)(SY_DBI_PA >> 32));
+	sy_wr(parf, 0x370, (uint32_t)SY_DBI_PA + 0x1000);	/* BLOCK_SLV_AXI_RD_BASE */
+	sy_wr(parf, 0x374, (uint32_t)(SY_DBI_PA >> 32));
+	sy_wr(parf, 0x368, (uint32_t)SY_DBI_PA + 0xfffff);	/* WR limit */
+	sy_wr(parf, 0x36c, (uint32_t)(SY_DBI_PA >> 32));
+	sy_wr(parf, 0x378, (uint32_t)SY_DBI_PA + 0xfffff);	/* RD limit */
+	sy_wr(parf, 0x37c, (uint32_t)(SY_DBI_PA >> 32));
+	sy_wr(parf, PARF_SYS_CTRL, sy_rd(parf, PARF_SYS_CTRL) | 0x04000000);	/* PCIE_ECAM_BLOCKER_EN */
+	printf("PANDORA WLAN: ECAM bus1 window %#lx via iATU0 (CFG0); root port id (DBI) %#x, endpoint id %#x\n",
+	    (unsigned long)SY_CONF_PA, sy_rd(dbi, 0), sy_rd(conf, 0));
+	printf("PANDORA WLAN: iATU0 readback: ctrl1 %#x ctrl2 %#x lbar %#x ubar %#x lar %#x\n",
+	    sy_rd(iatu, IATU_CTRL1(0)), sy_rd(iatu, IATU_CTRL2(0)), sy_rd(iatu, IATU_LBAR(0)),
+	    sy_rd(iatu, IATU_UBAR(0)), sy_rd(iatu, IATU_LAR(0)));
+}
+
+/* Size BAR0 the way the PCI core does: disable decode, write all ones to the whole
+ * (64-bit) BAR, read the mask, restore. M1 kernel_25 showed the old 32-bit-only path
+ * returning size 0xffffffff00200000; the endpoint's BAR0 is a 64-bit memory BAR. */
+static uint64_t
+sy_bar0_size(uint32_t *type, bool *is64)
+{
+	uint32_t cmd = sy_rd(conf, SY_EP_CONF + 0x04);
+	uint32_t lo = sy_rd(conf, SY_EP_CONF + 0x10);
+	uint32_t hi = sy_rd(conf, SY_EP_CONF + 0x14);
+	uint64_t mask;
+
+	*type = lo & 0xfUL;
+	*is64 = (lo & 0x6UL) == 0x4UL;	/* PCI BAR encoding: bits[2:1]=10 -> 64-bit mem */
+	sy_wr(conf, SY_EP_CONF + 0x04, cmd & ~0x6UL);	/* memory decode + bus master off while sizing */
+	sy_usleep(1000);
+	sy_wr(conf, SY_EP_CONF + 0x10, 0xffffffffUL);
+	if (*is64)
+		sy_wr(conf, SY_EP_CONF + 0x14, 0xffffffffUL);
+	mask = (uint64_t)sy_rd(conf, SY_EP_CONF + 0x10);
+	if (*is64) {
+		mask |= (uint64_t)sy_rd(conf, SY_EP_CONF + 0x14) << 32;
+	} else {
+		mask &= 0xffffffffULL;		/* 32-bit BAR: the high word is not part of it */
+	}
+	sy_wr(conf, SY_EP_CONF + 0x10, lo);
+	if (*is64)
+		sy_wr(conf, SY_EP_CONF + 0x14, hi);
+	sy_wr(conf, SY_EP_CONF + 0x04, cmd);
+	if (!mask || mask == 0xffffffffffffffffULL || mask == 0xffffffffUL) {
+		return 0;
+	}
+	return ~(mask & ~0xfULL) + 1ULL;
+}
+
+static bool
+sy_config_read(void)
+{
+	uint32_t rc = sy_rd(dbi, 0);
+	uint32_t pm_state = 0xffffffffUL;	/* PMCSR power state seen by the PCI enable block */		/* root port config lives at the DBI base */
+	uint32_t ep = sy_rd(conf, 0);		/* cfg0 ECAM window = bus 1 device 0 function 0 */
+
+	printf("PANDORA WLAN: config: root port (bus 0) id %#x, endpoint (bus 1) id %#x\n", rc, ep);
+	printf("PANDORA WLAN: endpoint config[0] = %#x -> vendor %#x device %#x\n", ep,
+	    ep & 0xffff, ep >> 16);
+	if ((ep & 0xffff) != 0x17cb || (ep >> 16) != 0x110e) {
+		return false;
+	}
+	{
+		uint32_t bar_type = 0;
+		bool bar64 = false;
+		uint64_t bar_size = sy_bar0_size(&bar_type, &bar64);
+
+		printf("PANDORA WLAN: M1 endpoint found; BAR0 raw %#x/%#x type %#x 64bit %u size %#llx\n",
+		    sy_rd(conf, SY_EP_CONF + 0x10), sy_rd(conf, SY_EP_CONF + 0x14), bar_type, bar64 ? 1u : 0u,
+		    (unsigned long long)bar_size);
+	}
+	/* M2: assign BAR0 0x40400000 / BAR2 0x40300000 (Android golden addresses) and reach
+	 * BAR0 through iATU region 1, then dump the first MHI/BHI words read-only. */
+	{
+	/* saved so the endpoint's original command register can be restored afterwards */
+	uint32_t pci_cmd = sy_rd(conf, SY_EP_CONF + 0x04);
+	{
+		int bar_on = 0;	/* BAR assign + BAR0 read stay off until CFG1 is proven */
+		(void)PE_parse_boot_argn("songyuan_bar", &bar_on, sizeof(bar_on));
+		if (!bar_on) {
+			printf("PANDORA WLAN: M2 BAR test skipped (songyuan_bar=0); windows verified only\n");
+			return true;
+		}
+	}
+	sy_wr(conf, SY_EP_CONF + 0x10, (uint32_t)SY_BAR0_PA | 0x4UL);	/* 64-bit mem BAR, address part */
+	sy_wr(conf, SY_EP_CONF + 0x14, (uint32_t)(SY_BAR0_PA >> 32));
+	sy_wr(conf, SY_EP_CONF + 0x04, sy_rd(conf, SY_EP_CONF + 0x04) | 0x2UL);	/* memory space decode on */
+	sy_usleep(1000);
+	{
+		/* Standard PCI enable, which the Linux PCI core does for the vendor driver:
+		 * walk the capability list for the PM capability, put the endpoint in D0
+		 * (PMCSR state 0), then set Command = Memory Space | Bus Master (0x6). */
+		uint32_t status = (sy_rd(conf, SY_EP_CONF + 0x04) >> 16) & 0xffffUL;
+		uint32_t cap = 0, pm_cap = 0, pmcsr_off = 0, pmcsr0, pmcsr1, cmd0, cmd1;
+		unsigned i, sh;
+
+		cmd0 = sy_rd(conf, SY_EP_CONF + 0x04) & 0xffffUL;
+		if (status & 0x10UL) {
+			cap = sy_rd(conf, SY_EP_CONF + 0x34) & 0xffUL;
+			for (i = 0; i < 32 && cap >= 0x40 && cap < 0xff; i++) {
+				uint32_t hdr = sy_rd(conf, SY_EP_CONF + (cap & ~3UL));
+				sh = (cap & 3UL) * 8UL;
+				if (((hdr >> sh) & 0xffUL) == 0x01UL) {
+					pm_cap = cap;
+					break;
+				}
+				cap = (hdr >> (sh + 8UL)) & 0xffUL;
+			}
+		}
+		pmcsr0 = 0xffffffffUL;
+		if (pm_cap) {
+			pmcsr_off = pm_cap + 4UL;
+			uint32_t v = sy_rd(conf, SY_EP_CONF + (pmcsr_off & ~3UL));
+			sh = (pmcsr_off & 3UL) * 8UL;
+			pmcsr0 = (v >> sh) & 0xffffUL;
+			if ((pmcsr0 & 3UL) != 0) {
+				*(volatile uint16_t *)(conf + SY_EP_CONF + pmcsr_off) =
+				    (uint16_t)(pmcsr0 & ~3UL);	/* D0 */
+				sy_usleep(1000);
+			}
+			uint32_t v2 = sy_rd(conf, SY_EP_CONF + (pmcsr_off & ~3UL));
+			pmcsr1 = (v2 >> sh) & 0xffffUL;		/* 0 = D0 */
+			pm_state = pmcsr1;
+		} else {
+			pmcsr1 = 0xffffffffUL;
+		}
+		*(volatile uint16_t *)(conf + SY_EP_CONF + 0x04) =
+		    (uint16_t)(cmd0 | 0x2UL);	/* memory only; bus master at MHI (plan L240) */
+		{
+			unsigned w;
+
+			for (w = 0; w < 20 && !(sy_rd(conf, SY_EP_CONF + 0x04) & 0x2UL); w++)
+				sy_usleep(1000);
+		}
+		cmd1 = sy_rd(conf, SY_EP_CONF + 0x04) & 0xffffUL;
+		printf("PANDORA WLAN: PCI enable: pm cap %#x pmcsr %#x -> %#x; cmd %#x -> %#x\n",
+		    pm_cap, pmcsr0, pmcsr1, cmd0, cmd1);
+	}
+	/* The root port only forwards memory TLPs that fall inside its Type1 memory
+	 * base/limit window (DBI 0x20); Linux' enumeration programs it (the working k90
+	 * port does the same in assign_bar0(): wr(dm_core + 0x20, ...)). Also give the
+	 * bridge its bus numbers (DBI 0x18: primary 0, secondary 1, subordinate 1). */
+	sy_wr(dbi, 0x18, 0x00010100UL);
+	sy_wr(dbi, 0x20, ((uint32_t)(SY_BAR0_PA + SY_BAR0_SIZE - 1) & 0xfff00000UL) |
+	    (((uint32_t)SY_BAR0_PA >> 16) & 0xfff0UL));
+	printf("PANDORA WLAN: root port window: dbi18 %#x dbi20 %#x (BAR0 %#x..%#x)\n",
+	    sy_rd(dbi, 0x18), sy_rd(dbi, 0x20), (uint32_t)SY_BAR0_PA,
+	    (uint32_t)(SY_BAR0_PA + SY_BAR0_SIZE - 1));
+	sy_wr(conf, SY_EP_CONF + 0x18, (uint32_t)SY_BAR2_PA | 0x4UL);	/* BAR2: 64-bit mem, 32 KiB */
+	sy_wr(conf, SY_EP_CONF + 0x1c, (uint32_t)(SY_BAR2_PA >> 32));
+	printf("PANDORA WLAN: BAR0 assigned: config10 %#x/%#x, BAR2: config18 %#x/%#x, cmd %#x status %#x\n",
+	    sy_rd(conf, SY_EP_CONF + 0x10), sy_rd(conf, SY_EP_CONF + 0x14),
+	    sy_rd(conf, SY_EP_CONF + 0x18), sy_rd(conf, SY_EP_CONF + 0x1c),
+	    sy_rd(conf, SY_EP_CONF + 0x04) & 0xffffUL,
+	    (sy_rd(conf, SY_EP_CONF + 0x04) >> 16) & 0xffffUL);
+	sy_wr(iatu, IATU_CTRL2(1), 0);
+	sy_wr(iatu, IATU_CTRL1(1), IATU_TYPE_MEM);
+	sy_wr(iatu, IATU_LBAR(1), (uint32_t)SY_MEM_BASE);
+	sy_wr(iatu, IATU_UBAR(1), (uint32_t)(SY_MEM_BASE >> 32));
+	sy_wr(iatu, IATU_LAR(1), (uint32_t)(SY_MEM_BASE + SY_MEM_SIZE - 1));
+	sy_wr(iatu, IATU_LTAR(1), (uint32_t)SY_MEM_BASE);	/* identity: host==pci */
+	sy_wr(iatu, IATU_LTAR_HI(1), (uint32_t)(SY_BAR0_PA >> 32));
+	sy_wr(iatu, IATU_CTRL2(1), 0x80000000UL);
+	printf("PANDORA WLAN: iATU1 readback: ctrl1 %#x ctrl2 %#x lbar %#x ubar %#x lar %#x ltar %#x/%#x\n",
+	    sy_rd(iatu, IATU_CTRL1(1)), sy_rd(iatu, IATU_CTRL2(1)), sy_rd(iatu, IATU_LBAR(1)),
+	    sy_rd(iatu, IATU_UBAR(1)), sy_rd(iatu, IATU_LAR(1)), sy_rd(iatu, IATU_LTAR(1)),
+	    sy_rd(iatu, IATU_LTAR_HI(1)));
+	/* Is the iATU we program (DT "iatu", 0x410000000) the same instance the
+	 * hardware uses? The same-card fuxi port and the K90 port both access the
+	 * ATU registers at DBI + 0x1000. Print both aliases read-only. */
+	{
+		uint32_t a0[7], b0[7], a1[7], b1[7];
+		unsigned i;
+
+		for (i = 0; i < 7; i++) {
+			a0[i] = sy_rd(iatu, IATU_REGION(0) + 4 * i);
+			b0[i] = sy_rd(dbi, 0x1000 + IATU_REGION(0) + 4 * i);
+			a1[i] = sy_rd(iatu, IATU_REGION(1) + 4 * i);
+			b1[i] = sy_rd(dbi, 0x1000 + IATU_REGION(1) + 4 * i);
+		}
+		printf("PANDORA WLAN: ATU@iatu_r0:     %#x %#x %#x %#x %#x %#x %#x\n",
+		    a0[0], a0[1], a0[2], a0[3], a0[4], a0[5], a0[6]);
+		printf("PANDORA WLAN: ATU@dbi+1000_r0: %#x %#x %#x %#x %#x %#x %#x\n",
+		    b0[0], b0[1], b0[2], b0[3], b0[4], b0[5], b0[6]);
+		printf("PANDORA WLAN: ATU@iatu_r1:     %#x %#x %#x %#x %#x %#x %#x\n",
+		    a1[0], a1[1], a1[2], a1[3], a1[4], a1[5], a1[6]);
+		printf("PANDORA WLAN: ATU@dbi+1000_r1: %#x %#x %#x %#x %#x %#x %#x\n",
+		    b1[0], b1[1], b1[2], b1[3], b1[4], b1[5], b1[6]);
+	}
+	{
+		int bar_read = 0;	/* the BAR0 read itself stays opt-in this round */
+		(void)PE_parse_boot_argn("songyuan_barread", &bar_read, sizeof(bar_read));
+		if (!bar_read) {
+			printf("PANDORA WLAN: BAR0 read skipped (songyuan_barread=0); ATU aliases dumped\n");
+			return true;
+		}
+	}
+	if ((pm_state & 3UL) != 0 || !(sy_rd(conf, SY_EP_CONF + 0x04) & 0x2UL)) {
+		printf("PANDORA WLAN: PCI enable incomplete (pm state %#x, cmd %#x); "
+		    "skipping the BAR0 read\n", pm_state, sy_rd(conf, SY_EP_CONF + 0x04) & 0xffffUL);
+		return true;
+	}
+	{
+		/* plan L240: map only the head we read; 4 KiB page, one word first */
+		vm_offset_t mem = ml_io_map(SY_BAR0_PA, 0x1000);
+
+		if (!mem) {
+			printf("PANDORA WLAN: BAR0 page mapping failed\n");
+			return true;
+		}
+		printf("PANDORA WLAN: BAR0 %#llx word0 (MHI_REGLEN) %#x\n",
+		    (unsigned long long)SY_BAR0_PA, sy_rd(mem, 0));
+		if (sy_step >= 8) {
+			uint32_t ver = sy_rd(mem, 0x08), cfg = sy_rd(mem, 0x10);
+			uint32_t chdb = sy_rd(mem, 0x18), erdb = sy_rd(mem, 0x20);
+			uint32_t bhio = sy_rd(mem, 0x28), bhie = sy_rd(mem, 0x2c);
+			uint32_t ctrl = sy_rd(mem, 0x38), st = sy_rd(mem, 0x48);
+
+			printf("PANDORA WLAN: MHI: ver %#x (major %u minor %u) cfg %#x chdb %#x erdb %#x "
+			    "bhio %#x bhie %#x ctrl %#x status %#x state %u syserr %u\n",
+			    ver, ver & 0xffff, ver >> 16, cfg, chdb, erdb, bhio, bhie, ctrl, st,
+			    (st >> 8) & 0xff, (st >> 2) & 1);
+			if (bhio && (bhio & 3u) == 0 && bhio + 0x40u <= 0x1000u) {
+				printf("PANDORA WLAN: BHI: version %#x/%#x execenv %#x status %#x errcode %#x "
+				    "errdbg %#x/%#x/%#x\n",
+				    sy_rd(mem, bhio + 0x00), sy_rd(mem, bhio + 0x04),
+				    sy_rd(mem, bhio + 0x28), sy_rd(mem, bhio + 0x2c),
+				    sy_rd(mem, bhio + 0x30), sy_rd(mem, bhio + 0x34),
+				    sy_rd(mem, bhio + 0x38), sy_rd(mem, bhio + 0x3c));
+			} else {
+				printf("PANDORA WLAN: BHI: BHIOFF %#x not in the first 4 KiB page\n", bhio);
+			}
+		}
+		if (sy_step >= 9) {
+			uint64_t fo = 0, fs = 0;
+
+			if (sy_fw_find("amss20.bin", &fo, &fs) == 0) {
+				uint8_t h[16];
+				unsigned k;
+
+				(void)pandora_fw_read(fo, h, sizeof(h));
+				printf("PANDORA WLAN: fw amss20.bin off %#llx size %#llx magic %#x %#x %#x %#x\n",
+				    (unsigned long long)fo, (unsigned long long)fs,
+				    (unsigned)h[0] << 24 | (unsigned)h[1] << 16 | (unsigned)h[2] << 8 | h[3],
+				    (unsigned)h[4] << 24 | (unsigned)h[5] << 16 | (unsigned)h[6] << 8 | h[7],
+				    (unsigned)h[8] << 24 | (unsigned)h[9] << 16 | (unsigned)h[10] << 8 | h[11],
+				    (unsigned)h[12] << 24 | (unsigned)h[13] << 16 | (unsigned)h[14] << 8 | h[15]);
+			} else {
+				printf("PANDORA WLAN: fw amss20.bin not found in the pinned pack\n");
+			}
+			k = 0;
+			(void)k;
+		}
+	}
+	sy_wr(conf, SY_EP_CONF + 0x04, pci_cmd);	/* restore the endpoint's command register */
+	}
+	return true;
+}
+
+/* Locate a file in the pinned firmware pack (PANDFW01: u32 count, entries of
+ * {char name[48]; u64 offset; u64 size} at blk+16; names are basenames). */
+static int
+sy_fw_find(const char *name, uint64_t *off, uint64_t *size)
+{
+	uint8_t blk[4096];
+	uint32_t n = 0;
+	unsigned i, k;
+
+	if (pandora_fw_read(0, blk, sizeof(blk)))
+		return -1;
+	if (blk[0] != 'P' || blk[1] != 'A' || blk[2] != 'N' || blk[3] != 'D' ||
+	    blk[4] != 'F' || blk[5] != 'W' || blk[6] != '0' || blk[7] != '1')
+		return -1;
+	for (i = 0; i < 4; i++)
+		n |= (uint32_t)blk[8 + i] << (8 * i);
+	if (!n || n > 63)
+		return -1;
+	{
+		unsigned nl = 0;
+
+		while (name[nl] && nl < 47)
+			nl++;
+		for (i = 0; i < n; i++) {
+			const uint8_t *e = blk + 16 + i * 64;
+			uint64_t eo = 0, es = 0;
+
+			for (k = 0; k < nl; k++) {
+				if (e[k] != (uint8_t)name[k])
+					break;
+			}
+			if (k != nl || e[nl] != 0)
+				continue;
+			for (k = 0; k < 8; k++) {
+				eo |= (uint64_t)e[48 + k] << (8 * k);
+				es |= (uint64_t)e[56 + k] << (8 * k);
+			}
+			*off = eo;
+			*size = es;
+			return 0;
+		}
+	}
+	return -1;
+}
+
+/* CRM D0: the power state vote the local driver's CESTA path sends before it resets
+ * the controller (pci-msm msm_pcie_enable_cesta -> crm_write_perf_ol + crm_write_pwr_states).
+ * Register offsets are pcie_crm_desc_v3's; the counts are from the phone's own CRM IPC log
+ * (5 power states, 2 PERF_OL VCDs, 16 BW_PT nodes). Without the vote the core never leaves
+ * reset: PARF answers while DBI and the config window stay all ones. */
+static bool
+sy_crm_d0(void)
+{
+	uint32_t update, ch, mask, busy = ~0U;
+	unsigned res, pwr, tries;
+
+	update = sy_rd(crm, SY_CRM_CHN_UPDATE);
+	if (!update)
+		ch = 0;
+	else if (update & 1)
+		ch = 1;
+	else if (update & 2)
+		ch = 0;
+	else {
+		printf("PANDORA WLAN: CRM: both channels busy (%#x)\n", update);
+		return false;
+	}
+	/* PERF_OL: resource 0 is this RC's VCD; states 0 and 1 carry D0's perf level,
+	 * the rest stay zero as the vendor's cache is zero filled. */
+	for (res = 0; res < SY_CRM_PERF_OL_RES; res++)
+		for (pwr = 0; pwr < SY_CRM_NUM_PWR; pwr++)
+			sy_wr(crm, SY_CRM_PWR_ST0 + pwr * 4 + ch * SY_CRM_PWR_CHN +
+			    res * SY_CRM_RES_DIST,
+			    (res == 0 && pwr < 2) ? SY_CRM_D0_PERF_LVL : 0);
+	/* Vendor crm-v2.c D0 only writes PERF_OL (two power states); BW_PT is not
+	 * touched for D0, so no zero flush is issued here either. */
+	sy_wr(crm, SY_CRM_CHN_UPDATE, 1U << ch);
+	mask = 1U << ch;
+	for (tries = 0; tries < 100; tries++) {
+		busy = sy_rd(crm, SY_CRM_CHN_BUSY) & mask;
+		if (busy == mask)
+			break;
+		sy_usleep(100);
+	}
+	printf("PANDORA WLAN: CRM D0: chn_update %#x channel %u: switch %s after %u tries (busy %#x)\n",
+	    update, ch, busy == mask ? "complete" : "timeout", tries + 1, busy);
+	return busy == mask;
+}
+
+/* ---- the run ------------------------------------------------------------------- */
+
+static void
+sy_dump_state(void)
+{
+	printf("PANDORA WLAN: state: pcie0 gdsc %#x/%#x phy gdsc %#x/%#x\n",
+	    sy_gcc_rd(GCC_GDSC_PCIE), sy_gcc_rd(GCC_GDSC_PCIE + 4),
+	    sy_gcc_rd(GCC_GDSC_PHY), sy_gcc_rd(GCC_GDSC_PHY + 4));
+	printf("PANDORA WLAN: state: votes br %#x br2 %#x rscc %#x aux-halt %#x pipe-halt %#x\n",
+	    sy_gcc_rd(GCC_VOTE_BRANCH), sy_gcc_rd(GCC_VOTE_BRANCH2),
+	    sy_gcc_rd(GCC_VOTE_RSCC), sy_gcc_rd(GCC_AUX), sy_gcc_rd(GCC_PIPE));
+	if (sy_gcc_rd(GCC_GDSC_PHY) & GDSC_PWR_ON) {
+		printf("PANDORA WLAN: state: clkref %#x parf sys %#x ltssm %#x phy%#x %#x\n",
+		    sy_rd(tcsr, SY_TCSR_CLKREF), sy_rd(parf, PARF_SYS_CTRL), sy_rd(parf, PARF_LTSSM),
+		    PHY_STATUS, sy_rd(phy, PHY_STATUS));
+	} else {
+		printf("PANDORA WLAN: state: clkref %#x parf sys %#x ltssm %#x (PHY domain down)\n",
+		    sy_rd(tcsr, SY_TCSR_CLKREF), sy_rd(parf, PARF_SYS_CTRL), sy_rd(parf, PARF_LTSSM));
+	}
+	if ((sy_gcc_rd(GCC_GDSC_PCIE) & GDSC_PWR_ON) &&
+	    (sy_gcc_rd(GCC_GDSC_PHY) & GDSC_PWR_ON)) {
+		printf("PANDORA WLAN: state: dbi reglen %#x ver %#x bhi %#x bhie %#x ctrl %#x status %#x\n",
+		    sy_rd(dbi, 0x00), sy_rd(dbi, 0x08), sy_rd(dbi, 0x28), sy_rd(dbi, 0x2c),
+		    sy_rd(dbi, 0x38), sy_rd(dbi, 0x48));
+		printf("PANDORA WLAN: state: link status %#x\n", sy_rd(dbi, DBI_LINKCTRLSTATUS));
+	} else {
+		printf("PANDORA WLAN: state: DBI not read (power domains are down)\n");
+	}
+}
+
+static void
+sy_run(void)
+{
+	printf("PANDORA WLAN: step %u: mapping windows\n", sy_step);
+	parf = ml_io_map(SY_PARF_PA, SY_PARF_SIZE);
+	printf("PANDORA WLAN: map parf= %#lx\n", (unsigned long)parf);
+	phy = ml_io_map(SY_PHY_PA, SY_PHY_SIZE);
+	printf("PANDORA WLAN: map phy= %#lx\n", (unsigned long)phy);
+	dbi = ml_io_map(SY_DBI_PA, SY_DBI_SIZE);
+	printf("PANDORA WLAN: map dbi= %#lx\n", (unsigned long)dbi);
+	iatu = ml_io_map(SY_IATU_PA, SY_IATU_SIZE);
+	printf("PANDORA WLAN: map iatu= %#lx\n", (unsigned long)iatu);
+	conf = ml_io_map(SY_CONF_PA, SY_CONF_SIZE);
+	printf("PANDORA WLAN: map conf= %#lx\n", (unsigned long)conf);
+	pcism = ml_io_map(SY_SM_PA, SY_SM_SIZE);
+	printf("PANDORA WLAN: map pcism= %#lx\n", (unsigned long)pcism);
+	crm = ml_io_map(SY_CRM_PA, SY_CRM_SIZE);
+	printf("PANDORA WLAN: map crm= %#lx\n", (unsigned long)crm);
+	gcc_low = ml_io_map(SY_GCC_LOW_PA, SY_GCC_LOW_SIZE);
+	printf("PANDORA WLAN: map gcc_low= %#lx\n", (unsigned long)gcc_low);
+	gcc = ml_io_map(SY_GCC_PA, SY_GCC_SIZE);
+	printf("PANDORA WLAN: map gcc= %#lx\n", (unsigned long)gcc);
+	tlmm_low = ml_io_map(SY_TLMM_LOW_PA, SY_TLMM_LOW_SIZE);
+	printf("PANDORA WLAN: map tlmm_low= %#lx\n", (unsigned long)tlmm_low);
+	tlmm = ml_io_map(SY_TLMM_PA, SY_TLMM_SIZE);
+	printf("PANDORA WLAN: map tlmm= %#lx\n", (unsigned long)tlmm);
+	tcsr = ml_io_map(SY_TCSR_PA, SY_TCSR_SIZE);
+	printf("PANDORA WLAN: map tcsr= %#lx\n", (unsigned long)tcsr);
+	rsc = ml_io_map(SY_RSC_PA, SY_RSC_SIZE);
+	printf("PANDORA WLAN: map rsc= %#lx\n", (unsigned long)rsc);
+	cmddb = ml_io_map_wcomb(SY_CMDDB_PA, SY_CMDDB_SIZE);
+	printf("PANDORA WLAN: map cmddb= %#lx\n", (unsigned long)cmddb);
+	if (!parf || !phy || !dbi || !iatu || !conf || !crm || !gcc_low || !gcc || !tlmm_low ||
+	    !tlmm || !tcsr || !rsc || !cmddb) {
+		printf("PANDORA WLAN: a window cannot be mapped\n");
+		return;
+	}
+	sy_rsc = rsc;	/* the RPMh block reuses these two mappings */
+	sy_cmddb = cmddb;
+	printf("PANDORA WLAN: windows mapped\n");
+	{
+		int sm_on = 0;
+
+		/* CESTA is not part of the document's M1. The local driver loads it at probe, so
+		 * keep it behind pandora_sm=1 for a separate experiment. */
+		if (PE_parse_boot_argn("pandora_sm", &sm_on, sizeof(sm_on)) && sm_on) {
+			sy_sm_load();
+		}
+	}
+	sy_dump_state();
+	if (sy_step < 2) {
+		return;
+	}
+
+	printf("PANDORA WLAN: step %u: PERST and WLAN_EN low, supplies\n", sy_step);
+	sy_pin_out(PIN_PERST, CTL_OUT_LOW_2MA);
+	sy_pin_level(PIN_PERST, 0);			/* vendor msm_pcie_config_perst: assert = raw 0 (low) */
+	sy_pin_out(PIN_WLAN_EN, CTL_OUT_LOW_8MA);
+	if (!sy_supplies_on()) {
+		return;
+	}
+
+	printf("PANDORA WLAN: step %u: clocks\n", sy_step);
+	if (!sy_clocks_on()) {
+		return;
+	}
+	{
+		int crm_on = 1;	/* pandora_crm=0 skips the vote for a comparison boot */
+
+		(void)PE_parse_boot_argn("pandora_crm", &crm_on, sizeof(crm_on));
+		if (crm_on) {
+			printf("PANDORA WLAN: step %u: CRM D0 (power state vote)\n", sy_step);
+			if (!sy_crm_d0())
+				printf("PANDORA WLAN: CRM D0 did not complete; the controller may stay off\n");
+		}
+	}
+	printf("PANDORA WLAN: step %u: resets and PARF\n", sy_step);
+	sy_gcc_wr(GCC_BCR_PCIE, sy_gcc_rd(GCC_BCR_PCIE) | 1);
+	sy_gcc_wr(GCC_BCR_PHY, sy_gcc_rd(GCC_BCR_PHY) | 1);
+	sy_usleep(1000);
+	sy_gcc_wr(GCC_BCR_PHY, sy_gcc_rd(GCC_BCR_PHY) & ~1UL);
+	sy_gcc_wr(GCC_BCR_PCIE, sy_gcc_rd(GCC_BCR_PCIE) & ~1UL);
+	printf("PANDORA WLAN: resets released: core bcr %#x phy bcr %#x noc bcr %#x phy gdsc %#x\n",
+	    sy_gcc_rd(GCC_BCR_PCIE), sy_gcc_rd(GCC_BCR_PHY), sy_gcc_rd(0x6c020),
+	    sy_gcc_rd(GCC_GDSC_PHY));
+	sy_usleep(1000);
+	sy_parf_setup();
+	if (sy_step < 4) {
+		return;
+	}
+
+	printf("PANDORA WLAN: step %u: the PHY\n", sy_step);
+	if (!sy_phy_start()) {
+		return;
+	}
+	if (sy_step < 5) {
+		return;
+	}
+
+	printf("PANDORA WLAN: step %u: the card's enable, root port, PERST release\n", sy_step);
+	sy_pin_level(PIN_WLAN_EN, IO_HIGH);
+	delay_for_interval(1, NSEC_PER_MSEC);		/* cnss_power_on_device(): udelay(1000) */
+	sy_pin_ctl(PIN_CLKREQ, CTL_CLKREQ_FUNC);
+	sy_pin_ctl(PIN_WAKE, CTL_IN_PULL_UP);
+	sy_diag_regs("after the PHY, before PERST");
+	printf("PANDORA WLAN: sw-ctrl pins read %u %u\n",
+	    (unsigned)(*(volatile uint32_t *)sy_pin_reg(18, 4) & 1),
+	    (unsigned)(*(volatile uint32_t *)sy_pin_reg(19, 4) & 1));
+	/* PCIe CEM TPVPERL: wait while PERST is still asserted, then release it. Vendor
+	 * msm_pcie_config_perst.c drives raw 0 to assert and 1 - on to de-assert; v2m
+	 * msm_pcie_enable_link.c waits perst_delay_us (1 ms default) after de-assert and
+	 * only then writes PARF+0x1b0 |= 0x100 (LTSSM_EN, L896-899). */
+	/* Vendor msm_pcie_enable_link.c L6130-6160, before PERST is released:
+	 * root-port class code, PARF_CFG_BITS_3 (clear bit0, set bit8) and
+	 * LANE_SKEW_OFF bit5. */
+	if (sy_rd(dbi, 0) != 0xffffffffUL) {
+		uint32_t v;
+
+		sy_wr(dbi, 0x8BCu, sy_rd(dbi, 0x8BCu) | 1);		/* DBI_RO_WR_EN */
+		v = sy_rd(dbi, 0x08u);
+		sy_wr(dbi, 0x08u, (v & 0xFFUL) | (0x060400UL << 8));	/* class: PCI bridge */
+		sy_wr(dbi, 0x8BCu, sy_rd(dbi, 0x8BCu) & ~1UL);
+		sy_wr(parf, 0x2C4u, sy_rd(parf, 0x2C4u) & ~1UL);	/* fal10_veto override off */
+		sy_wr(parf, 0x2C4u, sy_rd(parf, 0x2C4u) | 0x100UL);	/* width upscaling support */
+		sy_wr(dbi, 0x714u, sy_rd(dbi, 0x714u) & ~0x20UL);	/* LANE_SKEW_OFF bit5 */
+	}
+	delay_for_interval(100, NSEC_PER_MSEC);
+	sy_pin_level(PIN_PERST, IO_HIGH);		/* vendor msm_pcie_config_perst: deassert = 1 - on (high) */
+	delay_for_interval(1, NSEC_PER_MSEC);	/* vendor perst_delay_us 1000-1005, enabled after */
+	/* Vendor msm_pcie_enable_link.c (L673-792): after PERST release it programs the
+	 * GEN3/link-speed registers through DBI (dm_core+0x80C speed field, DBI_RO_WR_EN
+	 * around Link Control 2) and only then writes PARF+0x1b0 |= 0x100. DBI is readable
+	 * now, so reproduce that minimum before enabling LTSSM. */
+	if (sy_rd(dbi, 0) != 0xffffffffUL) {
+		uint32_t gen3 = sy_rd(dbi, 0x80Cu);
+		uint32_t lnk2;
+
+		/* Initial training is Gen1 (vendor msm_pcie_enable_link.c writes 0x100 right
+		 * after PERST release); the DT target-link-speed=3 speed change comes later. */
+		sy_wr(dbi, 0x80Cu, (gen3 & 0xFFFFE0FFUL) | (1UL << 8));	/* speed field: Gen1 */
+		sy_wr(dbi, 0x8BCu, sy_rd(dbi, 0x8BCu) | 1);		/* DBI_RO_WR_EN */
+		lnk2 = sy_rd(dbi, 0xA0u);
+		/* WCN7850 (17cb:110e) known issue: Gen3 equalization programming makes the link
+		 * fail to train (LKML: X1E80100 Surface Pro 11; forcing max-link-speed=<1> makes
+		 * the same card train and probe). Train Gen1 only here; the DT
+		 * target-link-speed speed change belongs after the link is up. */
+		sy_wr(dbi, 0xA0u, (lnk2 & ~0xFUL) | 1);			/* Link Control 2: Gen1 only */
+		{
+			uint32_t dcs = sy_rd(dbi, 0x78u);
+
+			sy_wr(dbi, 0x78u, (dcs & ~0x7000UL) | (5UL << 12));	/* TLP read size 0x5 */
+		}
+		/* Gen3 EQ / preset programming is deliberately skipped. */
+		sy_wr(dbi, 0x8BCu, sy_rd(dbi, 0x8BCu) & ~1UL);
+		printf("PANDORA WLAN: link speed config: 0x80C %#x 0xA0 %#x (vendor order)\n",
+		    sy_rd(dbi, 0x80Cu), sy_rd(dbi, 0xA0u));
+	} else {
+		printf("PANDORA WLAN: DBI not readable; link speed config skipped\n");
+	}
+	/* Read-only sampling before LTSSM_EN: what the pins and resets really hold. */
+	printf("PANDORA WLAN: pre-EN: perst cfg %#x io %#x; gcc link-down %#x core-bcr %#x phy-bcr %#x; parf phy-ctrl %#x; phy status %#x 1400 %#x 1444 %#x\n",
+	    *(volatile uint32_t *)sy_pin_reg(PIN_PERST, 0),
+	    *(volatile uint32_t *)sy_pin_reg(PIN_PERST, 4),
+	    sy_gcc_rd(0x6c014), sy_gcc_rd(0x6b000), sy_gcc_rd(0x6c01c),
+	    sy_rd(parf, PARF_PHY_CTRL), sy_rd(phy, PHY_STATUS),
+	    sy_rd(phy, 0x1400), sy_rd(phy, 0x1444));
+	printf("PANDORA WLAN: LTSSM before enable %#x (information only)\n",
+	    sy_rd(parf, PARF_LTSSM));
+	sy_wr(parf, PARF_LTSSM, sy_rd(parf, PARF_LTSSM) | PARF_LTSSM_EN);	/* vendor enable_link L896-899 */
+	printf("PANDORA WLAN: after PERST: parf ltssm %#x sys %#x (information only)\n",
+	    sy_rd(parf, PARF_LTSSM), sy_rd(parf, PARF_SYS_CTRL));
+	/* Plan SS6 (L218-220): sm-debug, PARF LTSSM and DBI values are logged only and
+	 * never gate anything; the single outbound config read is the only pass test.
+	 * Vendor msm_pcie_confirm_linkup() and K90 poll DBI+0x80 bit29 (LINK_ACTIVE):
+	 * log it here for up to ~1 s, purely as evidence. */
+	{
+		unsigned i, up = 0;
+		uint32_t st = 0;
+
+		for (i = 0; i < 100; i++) {
+			uint32_t elbi;
+
+			st = sy_rd(dbi, 0x80u);
+			elbi = sy_rd(dbi, 0xF28u);	/* ELBI_SYS_STTS, XMLH_LINK_UP=0x400 */
+			if ((elbi & 0x400UL) || (st != 0xffffffffUL && (st & (1UL << 29)))) {
+				up = 1;
+				break;
+			}
+			if ((i % 10) == 0)
+				printf("PANDORA WLAN: sample %u ms: elbi %#x dbi80 %#x ltssm %#x\n",
+				    i * 10, elbi, st, sy_rd(parf, PARF_LTSSM));
+			delay_for_interval(10, NSEC_PER_MSEC);
+		}
+		sy_link_up = up;
+		printf("PANDORA WLAN: link poll: after %u ms dbi80 %#x elbi %#x active %u\n",
+		    i * 10, st, sy_rd(dbi, 0xF28u), up);
+	}
+	printf("PANDORA WLAN: link setup done: parf %#x sm-debug %#x dbi0 %#x dbi80 %#x (log only)\n",
+	    sy_rd(parf, PARF_LTSSM), sy_rd(pcism, 0x1090), sy_rd(dbi, 0), sy_rd(dbi, 0x80));
+	sy_sm_state("after link setup");
+	/* sy_link_up was set from the LINK_ACTIVE/ELBI poll above; the config read stays
+	 * gated by it (upstream: do not enumerate before the endpoint is ready). */
+	if (sy_step < 6) {
+		return;
+	}
+
+	printf("PANDORA WLAN: step %u: ECAM and the endpoint (one outbound config read)\n", sy_step);
+	if (!sy_link_up) {
+		printf("PANDORA WLAN: the link is not up; skipping the config read (document rule)\n");
+		return;
+	}
+	sy_iatu_ecam();
+	if (sy_config_read()) {
+		printf("PANDORA WLAN: M1 DONE: 17cb:110e answers on PCIe0\n");
+	} else {
+		printf("PANDORA WLAN: ECAM read did not return the endpoint\n");
+	}
+}
+
+static void
+sy_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	printf("PANDORA WLAN: thread, step %u\n", sy_step);
+	printf("PANDORA WLAN: thread: sleeping 6 s\n");
+	delay_for_interval(6000, NSEC_PER_MSEC);
+	printf("PANDORA WLAN: thread: awake, entering sy_run\n");
+	sy_run();
+	printf("PANDORA WLAN: thread: sy_run returned\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+pandora_wlan_init(void)
+{
+	int step = 0;
+
+	if (!PE_parse_boot_argn("songyuan_wlan", &step, sizeof(step)) || step <= 0) {
+		return;
+	}
+	sy_step = (unsigned)step;
+	thread_t th;
+
+	if (kernel_thread_start_priority((thread_continue_t)sy_thread, NULL, 80, &th) ==
+	    KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
+
 void
 pandora_cachevol_start(void)
 {
 	thread_t thread;
+	pandora_wlan_init();	/* M1: PCIe RC0 bring-up, boot-arg songyuan_wlan */
 	if (kernel_thread_start(pandora_cachevol_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
