+/* Select the BAR0 window that contains a device register offset (pci.c:146-165). */
+static void
+sy_ce_window(uint32_t dev_off)
+{
+	uint32_t w = SY_CE_WIN_EN | ((dev_off >> 19) & 0x3fu);
+
+	if (w == sy_ce_win_cur)
+		return;
+	sy_wr(sy_ce_wreg, sy_ce_win_off, w);
+	(void)sy_rd(sy_ce_wreg, sy_ce_win_off);	/* pci.c:160-163 reads the window back */
+	sy_ce_win_cur = w;
+}
+
+static uint32_t
+sy_ce_rd(uint32_t dev_off)
+{
+	if (dev_off < SY_CE_WIN_AP)
+		return sy_rd(sy_bar_va, dev_off);
+	sy_ce_window(dev_off);
+	return sy_rd(sy_ce_win, dev_off & SY_CE_WIN_MASK);
+}
+
+static void
+sy_ce_wr(uint32_t dev_off, uint32_t val)
+{
+	if (dev_off < SY_CE_WIN_AP) {
+		sy_wr(sy_bar_va, dev_off, val);
+		return;
+	}
+	sy_ce_window(dev_off);
+	sy_wr(sy_ce_win, dev_off & SY_CE_WIN_MASK, val);
+}
+
+/* Hardware writes the consumer index of src-direction rings, and the producer
+ * index of the status rings, into this DMA page (hal.c:1937,1969). */
+static uint32_t
+sy_ce_rdp(uint32_t ring_id)
+{
+	return *(volatile uint32_t *)(sy_ce_wc + SY_CE_OFF_RDP + 4u * ring_id);
+}
