+
+/* Endpoint PCIe/MSI setup before firmware load, copied from the locally working
+ * WCN7850 port (UniXNU-sheng WifiProbe.cpp, endpointLinkSetup):
+ *  - the PCI Express capability's link control ASPM bits are cleared, because the
+ *    load must not idle the link;
+ *  - the MSI capability is enabled with a valid DMA sink address, because the
+ *    endpoint raises its transfer-complete/ready events as MSI writes. With the
+ *    capability unprogrammed those writes have no target and the boot loader ends
+ *    in its fatal error state after reading the image (no SMMU fault at all). */
+static void
+sy_endpoint_link_setup(uint64_t sink)
+{
+	uint32_t cap, w, ctrl;
+	unsigned guard;
+
+	if (!conf)
+		return;
+	cap = (uint32_t)(*(volatile uint8_t *)(conf + SY_EP_CONF + 0x34) & 0xfc);
+	for (guard = 0; cap >= 0x40 && guard < 48; guard++) {
+		w = sy_rd(conf, SY_EP_CONF + cap);
+		{
+			uint32_t id = w & 0xff, next = (w >> 8) & 0xff;
+
+			if (id == 0x10) {
+				uint32_t lc = sy_rd(conf, SY_EP_CONF + cap + 0x10);
+
+				printf("PANDORA WLAN: endpoint PCIe cap %#x: link ctrl %#x -> %#x (ASPM off)\n",
+				    cap, lc, lc & ~3u);
+				sy_wr(conf, SY_EP_CONF + cap + 0x10, lc & ~3u);
+			} else if (id == 0x05) {
+				bool is64 = (w >> 16) & 0x80;
+
+				if (is64) {
+					sy_wr(conf, SY_EP_CONF + cap + 4, (uint32_t)sink);
+					sy_wr(conf, SY_EP_CONF + cap + 8, (uint32_t)(sink >> 32));
+					sy_wr(conf, SY_EP_CONF + cap + 0xc, 0);
+				} else {
+					sy_wr(conf, SY_EP_CONF + cap + 4, (uint32_t)sink);
+					sy_wr(conf, SY_EP_CONF + cap + 8, 0);
+				}
+				ctrl = (w & 0xffffu) | ((((w >> 16) & ~0x70u) | 0x20u | 1u) << 16);
+				sy_wr(conf, SY_EP_CONF + cap, ctrl);
+				printf("PANDORA WLAN: endpoint MSI cap %#x: addr %#llx/%u data 0 ctrl %#x -> %#x\n",
+				    cap, (unsigned long long)sink, is64 ? 64 : 32,
+				    w, sy_rd(conf, SY_EP_CONF + cap));
+			}
+			if (!next)
+				break;
+			cap = next;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_log_sync();
+}
+
+static void
+sy_bhi_sbl(void)
+{
+	uint32_t bhio, cmd, hi, lo, size, ivec, st, ee;
+	uint64_t fo = 0, fs = 0;
+	vm_offset_t off;
+	unsigned i;
+
+	if (!sy_bar_va) {
+		printf("PANDORA WLAN: BHI: missing BAR0 mapping\n");
+		return;
+	}
+	if (!sy_guard)
+		(void)PE_parse_boot_argn("songyuan_guard", &sy_guard, sizeof(sy_guard));
+	bhio = sy_rd(sy_bar_va, 0x28);
+	sy_bhi_off = bhio;
+	sy_bhie_off = sy_rd(sy_bar_va, 0x2c);
+	if (sy_bhie_off < 0x40 || sy_bhie_off > 0x3fc0 || (sy_bhie_off & 3))
+		sy_bhie_off = 0;
+	if (bhio < 0x40 || bhio > 0x3fc0 || (bhio & 3)) {
+		printf("PANDORA WLAN: BHI: bad BHIOFF %#x\n", bhio);
+		return;
+	}
+	if (!sy_sbl_va || !sy_buf_size) {
+		printf("PANDORA WLAN: BHI: no buffer (allocation failed); skipping image load\n");
+		return;
+	}
+	if (sy_fw_find("amss20.bin", &fo, &fs) || fs < SY_SBL_SIZE) {
+		printf("PANDORA WLAN: BHI: firmware not usable (size %#llx)\n", (unsigned long long)fs);
+		return;
+	}
+	if (sy_sbl_wc) {
+		if (pandora_fw_read(fo, (void *)sy_sbl_wc, SY_SBL_SIZE)) {
+			printf("PANDORA WLAN: BHI: SBL read (WC alias) failed\n");
+			return;
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+		printf("PANDORA WLAN: BHI: image written through the write-combined alias\n");
+	} else {
+		if (pandora_fw_read(fo, (void *)sy_sbl_va, SY_SBL_SIZE)) {
+			printf("PANDORA WLAN: BHI: SBL read failed\n");
+			return;
+		}
+		for (off = 0; off < SY_SBL_SIZE; off += PAGE_SIZE)
+			flush_dcache64(sy_pa(sy_sbl_va + off), (unsigned)PAGE_SIZE, TRUE);
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	cmd = sy_rd(conf, SY_EP_CONF + 0x04) & 0xffff;
+	sy_wr(conf, SY_EP_CONF + 0x04, cmd | 0x404);
+	printf("PANDORA WLAN: BHI: ep cmd %#x -> %#x; bhio %#x sbl %#lx iova %#x\n",
+	    cmd, sy_rd(conf, SY_EP_CONF + 0x04) & 0xffff, bhio,
+	    (unsigned long)SY_SBL_SIZE, SY_IOVA_BASE);
+	sy_log_sync();
+
+	/* Vendor pci-msm.c link-enable order, checked against the live DT:
+	 *  - the root port's command register gets memory + bus-master (the endpoint's
+	 *    own command register is set below);
+	 *  - PARF 0x4A0 bit0 (AXI_MSTR_WR_NS_BDF_HALT) is cleared because the DT has no
+	 *    qcom,bdf-change-halt-en; if a boot chain left it set, the endpoint's
+	 *    writes are halted silently (exactly our "no SMMU fault" signature).
+	 */
+	{
+		uint32_t rp = sy_rd(dbi, 0x04);
+		uint32_t bdf = sy_rd(parf, 0x4a0);
+
+		sy_wr(dbi, 0x04, rp | 0x6);		/* MEM | MASTER */
+		sy_wr(parf, 0x4a0, bdf & ~1u);		/* NS BDF halt off (vendor default) */
+		printf("PANDORA WLAN: BHI: root port cmd %#x -> %#x; parf 0x4a0 %#x -> %#x; "
+		    "0x1a8 %#x 0x174 %#x\n", rp, sy_rd(dbi, 0x04), bdf, sy_rd(parf, 0x4a0),
+		    sy_rd(parf, 0x1a8), sy_rd(parf, 0x174));
+		sy_log_sync();
+	}
+
+	sy_endpoint_link_setup((uint64_t)SY_IOVA_BASE + 0x7FE000);
+	/* MSI sink: the last free page of the mapped window, outside the SBL and
+	 * AMSS image bytes and outside the MHI context/ring region */
+	sy_wr(sy_bar_va, bhio + 0x20, 0);          /* INTVEC */
+	sy_wr(sy_bar_va, bhio + 0x2c, 0);          /* STATUS clear */
+	sy_wr(sy_bar_va, bhio + 0x08, SY_IOVA_BASE);            /* IMGADDR lo (IOVA) */
+	sy_wr(sy_bar_va, bhio + 0x0c, 0);                      /* IMGADDR hi */
+	sy_wr(sy_bar_va, bhio + 0x10, SY_SBL_SIZE);           /* IMGSIZE */
+	__asm__ volatile("dsb sy" ::: "memory");
+	hi = sy_rd(sy_bar_va, bhio + 0x0c); lo = sy_rd(sy_bar_va, bhio + 0x08);
+	size = sy_rd(sy_bar_va, bhio + 0x10); ivec = sy_rd(sy_bar_va, bhio + 0x20);
+	st = sy_rd(sy_bar_va, bhio + 0x2c);   ee = sy_rd(sy_bar_va, bhio + 0x28);
+	printf("PANDORA WLAN: BHI preflight: %#x:%08x size %#x ivec %#x status %#x ee %#x\n",
+	    hi, lo, size, ivec, st, ee);
+	sy_log_sync();
+	if (sy_guard) {
+		uint64_t guard = SY_IOVA_BASE + sy_buf_size;
+		uint32_t v = 0, fsr = 0, far_lo = 0, far_hi = 0, gfsr = 0, sid = 0;
+		unsigned t, hit = 0;
+
+		sy_wr(sy_bar_va, bhio + 0x2c, 0);
+		sy_wr(sy_bar_va, bhio + 0x08, (uint32_t)guard);
+		sy_wr(sy_bar_va, bhio + 0x0c, (uint32_t)(guard >> 32));
+		sy_wr(sy_bar_va, bhio + 0x10, 0x1000);
+		sy_wr(sy_bar_va, bhio + 0x14, 0);
+		__asm__ volatile("dsb sy" ::: "memory");
+		printf("PANDORA WLAN: GUARD: asking PBL to read unmapped %#llx, 4096 bytes (mapping is %#x bytes)\n",
+		    (unsigned long long)guard, sy_buf_size);
+		sy_log_sync();
+		sy_wr(sy_bar_va, bhio + 0x18, 0x0badf00d);
+		for (t = 0; t < 400; t++) {
+			if (sy_cb_va)
+				fsr = sy_rd(sy_cb_va, 0x58);
+			gfsr = sy_rd(sy_smmu_va, 0x48);
+			v = sy_rd(sy_bar_va, bhio + 0x2c);
+			if ((fsr & 0xc00001feu) || gfsr || (v >> 30) == 3)
+				break;
+			sy_usleep(5000);
+		}
+		if (sy_cb_va) {
+			far_lo = sy_rd(sy_cb_va, 0x60);
+			far_hi = sy_rd(sy_cb_va, 0x64);
+		}
+		sid = sy_rd(sy_smmu_va, 0x1400 + 4 * sy_smmu_cb) & 0xffffu;
+		hit = (fsr & 0xc00001feu) ? 1 : 0;
+		printf("PANDORA WLAN: GUARD result: fault %u cb_fsr %#x far %#x:%#x gfsr %#x sid %#x bhi %#x\n",
+		    hit, fsr, far_hi, far_lo, gfsr, sid, v);
+		sy_log_sync();
+		return;
+	}
+	if (hi != 0 || lo != SY_IOVA_BASE ||
+	    size != SY_SBL_SIZE || ivec || st || ee) {
+		printf("PANDORA WLAN: BHI: preflight mismatch, doorbell not rung\n");
+		return;
+	}
+	{
+		volatile uint32_t *w = (volatile uint32_t *)(sy_sbl_wc ? sy_sbl_wc : sy_sbl_va);
+		uint32_t fsum = 0;
+		unsigned fi;
+
+		for (fi = 0; fi < 256; fi++)
+			fsum += w[fi];
+		printf("PANDORA WLAN: BHI: SBL head %08x %08x %08x %08x %08x %08x %08x %08x sum1k %08x\n",
+		    w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], fsum);
+		sy_log_sync();
+	}
+	{
+		int guard2 = 0;
+
+		(void)PE_parse_boot_argn("songyuan_guard2", &guard2, sizeof(guard2));
+		if (guard2 > 0) {
+		/* One-boot matrix, step 1: ask PBL to read an unmapped IOVA. A CB fault proves
+		 * that the endpoint's DMA is translated by our CB; silence means the stream never
+		 * reaches it. The MHI block is reset afterwards and the image registers restored. */
+		{
+			uint64_t g = SY_IOVA_BASE + sy_buf_size + 0x4000;
+			uint32_t f = 0, gg = 0, v = 0;
+			unsigned t;
+
+			sy_wr(sy_bar_va, bhio + 0x20, 0);
+			sy_wr(sy_bar_va, bhio + 0x2c, 0);
+			sy_wr(sy_bar_va, bhio + 0x08, (uint32_t)g);
+			sy_wr(sy_bar_va, bhio + 0x0c, (uint32_t)(g >> 32));
+			sy_wr(sy_bar_va, bhio + 0x10, 0x1000);
+			__asm__ volatile("dsb sy" ::: "memory");
+			sy_wr(sy_bar_va, bhio + 0x18, 0x0badf00d);
+			for (t = 0; t < 200; t++) {
+				f = sy_cb_va ? sy_rd(sy_cb_va, 0x58) : 0;
+				gg = sy_smmu_va ? sy_rd(sy_smmu_va, 0x48) : 0;
+				v = sy_rd(sy_bar_va, bhio + 0x2c);
+				if ((f & 0xc00001feu) || gg || (v >> 30) == 3)
+					break;
+				delay(1000);
+			}
+			printf("PANDORA WLAN: GUARD: unmapped %#llx -> cb_fsr %#x gfsr %#x bhi %#x after %u ms\n",
+			    (unsigned long long)g, f, gg, v, t);
+			sy_log_sync();
+			sy_mhi_reset();
+			sy_wr(sy_bar_va, bhio + 0x20, 0);
+			sy_wr(sy_bar_va, bhio + 0x2c, 0);
+			sy_wr(sy_bar_va, bhio + 0x08, SY_IOVA_BASE);
+			sy_wr(sy_bar_va, bhio + 0x0c, 0);
+			sy_wr(sy_bar_va, bhio + 0x10, SY_SBL_SIZE);
+			__asm__ volatile("dsb sy" ::: "memory");
+		}
+		}
+	}
+	sy_wr(sy_bar_va, bhio + 0x18, 0x1234567);
+	printf("PANDORA WLAN: BHI: doorbell rung seq 0x1234567, polling\n");
+	sy_log_sync();
+	/* 0xffffffff means "the MHI block did not answer this read yet" (the boot loader
+	 * is starting), not an error status: sheng's MhiBoot.c treats it that way. Also poll
+	 * for the full 2 s: delay() is microseconds, so the earlier 300x10ms loop actually
+	 * gave up after ~40 ms and reported the transient state as the result. */
+	{
+		uint32_t last_st = st, last_ee = ee, shown = 0;
+
+		printf("PANDORA WLAN: BHI: imgaddr %#x/%#x size %#x txdb %#x intvec %#x (readback)\n",
+		    sy_rd(sy_bar_va, bhio + 0x08), sy_rd(sy_bar_va, bhio + 0x0c),
+		    sy_rd(sy_bar_va, bhio + 0x10), sy_rd(sy_bar_va, bhio + 0x18),
+		    sy_rd(sy_bar_va, bhio + 0x20));
+		sy_log_sync();
+		for (i = 0; i < 2000; i++) {
+			st = sy_rd(sy_bar_va, bhio + 0x2c);
+			ee = sy_rd(sy_bar_va, bhio + 0x28);
+			if (i < 30 || st != last_st || ee != last_ee) {
+				if (shown < 60) {
+					printf("PANDORA WLAN: BHI poll %u ms: status %#x code %u ee %#x "
+					    "errcode %#x mhi %#x\n", i, st, st >> 30, ee,
+					    sy_rd(sy_bar_va, bhio + 0x30), sy_rd(sy_bar_va, 0x48));
+					sy_log_sync();
+				}
+				shown++;
+				last_st = st; last_ee = ee;
+			}
+			if ((st >> 30) == 2 || ((st >> 30) == 3 && st != 0xffffffffu))
+				break;
+			delay(1000);	/* 1 ms; delay() takes microseconds */
+		}
+	}
+	printf("PANDORA WLAN: BHI result: status %#x code %u ee %#x errcode %#x mhi %#x\n",
+	    st, st >> 30, ee, sy_rd(sy_bar_va, bhio + 0x30), sy_rd(sy_bar_va, 0x48));
+	sy_log_sync();
+	/* Device-side error detail: distinguish an SMMU translation fault (the device
+	 * DMA never reached our buffer) from an image rejection (BHI errdbg set). */
+	/* Hardware-level PCIe/ANOC error visibility (vendor pci-msm.c register names):
+	 * INT_ALL_STATUS/INT_ALL_2_STATUS and CORE_ERRORS show NoC/AXI faults that the
+	 * SMMU never sees because the transaction dies in the controller. */
+	printf("PANDORA WLAN: PARF diag: int_all %#x/%#x int_all2 %#x/%#x core_errors %#x "
+	    "ecam_block %#x parf_status %#x pm_stts %#x\n",
+	    sy_rd(parf, 0x224), sy_rd(parf, 0x22c), sy_rd(parf, 0x500), sy_rd(parf, 0x508),
+	    sy_rd(parf, 0x3c0), sy_rd(parf, 0x630), sy_rd(parf, 0x230), sy_rd(parf, 0x028));
+	sy_log_sync();
+	sy_pte_walk();
+	if (sy_bhi2 < 0)
+		(void)PE_parse_boot_argn("songyuan_bhi2", &sy_bhi2, sizeof(sy_bhi2));
+	if (sy_bhi2 > 0 && !sy_guard) {
+		uint32_t s2cr_slot = 0xc00u + 4u * sy_smmu_slot;
+
+		/* A: bypass the stage-1 CB and give BHI the physical address. */
+		sy_mhi_reset();
+		sy_wr(sy_smmu_va, s2cr_slot, (1u << 16) | 0u);
+		sy_wr(sy_cb_va, 0x610, 0xffffffffu);
+		sy_wr(sy_cb_va, 0x7f0, 0xffffffffu);
+		__asm__ volatile("dsb sy" ::: "memory");
+		printf("PANDORA WLAN: EXP A: s2cr now %#x (bypass)\n", sy_rd(sy_smmu_va, s2cr_slot));
+		sy_log_sync();
+		(void)sy_bhi_try(sy_bhi_off, "A-bypass-phys", sy_sbl_pa, 0);
+		/* B: back to translating CB, but with a real INTVEC target. */
+		sy_mhi_reset();
+		sy_wr(sy_smmu_va, s2cr_slot, sy_smmu_cb | 0u);
+		sy_wr(sy_cb_va, 0x610, 0xffffffffu);
+		sy_wr(sy_cb_va, 0x7f0, 0xffffffffu);
+		__asm__ volatile("dsb sy" ::: "memory");
+		printf("PANDORA WLAN: EXP B: s2cr now %#x (translate, cb %u), ivec %#x\n",
+		    sy_rd(sy_smmu_va, s2cr_slot), sy_smmu_cb, (uint32_t)sy_sbl_pa);
+		sy_log_sync();
+		(void)sy_bhi_try(sy_bhi_off, "B-translate-ivec", SY_IOVA_BASE, (uint32_t)sy_sbl_pa);
+	}
+	if ((st >> 30) != 2 && sy_smmu_va && sy_gr1_va && (sy_id1 & 0xff) > 1) {
+		/* One-boot matrix, step 2: retry the same image on the last context bank
+		 * (the slot the plan reserves for the firmware-compatible bypass bank), in
+		 * case the bank the probe picked is not usable for host translation. */
+		uint32_t last = (sy_id1 & 0xff) - 1;
+
+		printf("PANDORA WLAN: retry on last bank %u\n", last);
+		sy_log_sync();
+		sy_mhi_reset();
+		sy_smmu_cfg_bank(last, sy_smmu_slot);
+		(void)sy_bhi_try(sy_bhi_off, "C-lastbank", SY_IOVA_BASE, 0);
+	}
+	sy_sbl_ok = ((st >> 30) == 2);
+	sy_smmu_bank_scan();
+	if (sy_smmu_va) {
+		uint32_t gfsr = sy_rd(sy_smmu_va, 0x48);
+		uint32_t fsr = sy_cb_va ? sy_rd(sy_cb_va, 0x58) : 0xffffffffu;
+		uint32_t far_lo = sy_cb_va ? sy_rd(sy_cb_va, 0x60) : 0xffffffffu;
+		uint32_t far_hi = sy_cb_va ? sy_rd(sy_cb_va, 0x64) : 0xffffffffu;
+
+		printf("PANDORA WLAN: BHI diag: smr %#x s2cr %#x cbar %#x tlbstatus %#x cb_fsr %#x "
+		    "far %#x:%#x gfsr %#x gfsynr %#x/%#x/%#x\n",
+		    sy_rd(sy_smmu_va, 0x800 + 4 * sy_smmu_slot),
+		    sy_rd(sy_smmu_va, 0xc00 + 4 * sy_smmu_slot),
+		    sy_gr1_va ? sy_rd(sy_gr1_va, 4 * sy_smmu_cb) : 0xffffffffu,
+		    sy_cb_va ? sy_rd(sy_cb_va, 0x7f4) : 0xffffffffu, fsr, far_hi, far_lo, gfsr,
+		    sy_rd(sy_smmu_va, 0x50), sy_rd(sy_smmu_va, 0x54), sy_rd(sy_smmu_va, 0x58));
+		sy_log_sync();
+	}
+	printf("PANDORA WLAN: BHI diag: parf sid[0x2054] %#x [0x2074] %#x bypass %#x/%#x; "
+	    "errdbg %#x/%#x/%#x numseg %#x serial %#x; dbi80 %#x dbi0 %#x\n",
+	    sy_rd(parf, 0x2054), sy_rd(parf, 0x2074), sy_rd(parf, 0x2c00), sy_rd(parf, 0x2c04),
+	    sy_rd(sy_bar_va, bhio + 0x34), sy_rd(sy_bar_va, bhio + 0x38),
+	    sy_rd(sy_bar_va, bhio + 0x3c), sy_rd(sy_bar_va, bhio + 0x48),
+	    sy_rd(sy_bar_va, bhio + 0x40), sy_rd(dbi, 0x80), sy_rd(dbi, 0));
+	sy_log_sync();
+}
+
+/* CRM D0: the power state vote the local driver's CESTA path sends before it resets
+ * the controller (pci-msm msm_pcie_enable_cesta -> crm_write_perf_ol + crm_write_pwr_states).
+ * Register offsets are pcie_crm_desc_v3's; the counts are from the phone's own CRM IPC log
+ * (5 power states, 2 PERF_OL VCDs, 16 BW_PT nodes). Without the vote the core never leaves
+ * reset: PARF answers while DBI and the config window stay all ones. */
+static bool
+sy_crm_d0(void)
+{
+	uint32_t update, ch, mask, busy = ~0U;
+	unsigned res, pwr, tries;
+
+	update = sy_rd(crm, SY_CRM_CHN_UPDATE);
+	if (!update)
+		ch = 0;
+	else if (update & 1)
+		ch = 1;
+	else if (update & 2)
+		ch = 0;
+	else {
+		printf("PANDORA WLAN: CRM: both channels busy (%#x)\n", update);
+		return false;
+	}
+	/* PERF_OL: resource 0 is this RC's VCD; states 0 and 1 carry D0's perf level,
+	 * the rest stay zero as the vendor's cache is zero filled. */
+	for (res = 0; res < SY_CRM_PERF_OL_RES; res++)
+		for (pwr = 0; pwr < SY_CRM_NUM_PWR; pwr++)
+			sy_wr(crm, SY_CRM_PWR_ST0 + pwr * 4 + ch * SY_CRM_PWR_CHN +
+			    res * SY_CRM_RES_DIST,
+			    (res == 0 && pwr < 2) ? SY_CRM_D0_PERF_LVL : 0);
+	/* Vendor crm-v2.c D0 only writes PERF_OL (two power states); BW_PT is not
+	 * touched for D0, so no zero flush is issued here either. */
+	sy_wr(crm, SY_CRM_CHN_UPDATE, 1U << ch);
+	mask = 1U << ch;
+	for (tries = 0; tries < 100; tries++) {
+		busy = sy_rd(crm, SY_CRM_CHN_BUSY) & mask;
+		if (busy == mask)
+			break;
+		sy_usleep(100);
+	}
+	printf("PANDORA WLAN: CRM D0: chn_update %#x channel %u: switch %s after %u tries (busy %#x)\n",
+	    update, ch, busy == mask ? "complete" : "timeout", tries + 1, busy);
+	return busy == mask;
+}
+
+/* ---- the run ------------------------------------------------------------------- */
+
+static void
+sy_dump_state(void)
+{
+	printf("PANDORA WLAN: state: pcie0 gdsc %#x/%#x phy gdsc %#x/%#x\n",
+	    sy_gcc_rd(GCC_GDSC_PCIE), sy_gcc_rd(GCC_GDSC_PCIE + 4),
+	    sy_gcc_rd(GCC_GDSC_PHY), sy_gcc_rd(GCC_GDSC_PHY + 4));
+	printf("PANDORA WLAN: state: votes br %#x br2 %#x rscc %#x aux-halt %#x pipe-halt %#x\n",
+	    sy_gcc_rd(GCC_VOTE_BRANCH), sy_gcc_rd(GCC_VOTE_BRANCH2),
+	    sy_gcc_rd(GCC_VOTE_RSCC), sy_gcc_rd(GCC_AUX), sy_gcc_rd(GCC_PIPE));
+	if (sy_gcc_rd(GCC_GDSC_PHY) & GDSC_PWR_ON) {
+		printf("PANDORA WLAN: state: clkref %#x parf sys %#x ltssm %#x phy%#x %#x\n",
+		    sy_rd(tcsr, SY_TCSR_CLKREF), sy_rd(parf, PARF_SYS_CTRL), sy_rd(parf, PARF_LTSSM),
+		    PHY_STATUS, sy_rd(phy, PHY_STATUS));
+	} else {
+		printf("PANDORA WLAN: state: clkref %#x parf sys %#x ltssm %#x (PHY domain down)\n",
+		    sy_rd(tcsr, SY_TCSR_CLKREF), sy_rd(parf, PARF_SYS_CTRL), sy_rd(parf, PARF_LTSSM));
+	}
+	if ((sy_gcc_rd(GCC_GDSC_PCIE) & GDSC_PWR_ON) &&
+	    (sy_gcc_rd(GCC_GDSC_PHY) & GDSC_PWR_ON)) {
+		printf("PANDORA WLAN: state: dbi reglen %#x ver %#x bhi %#x bhie %#x ctrl %#x status %#x\n",
+		    sy_rd(dbi, 0x00), sy_rd(dbi, 0x08), sy_rd(dbi, 0x28), sy_rd(dbi, 0x2c),
+		    sy_rd(dbi, 0x38), sy_rd(dbi, 0x48));
+		printf("PANDORA WLAN: state: link status %#x\n", sy_rd(dbi, DBI_LINKCTRLSTATUS));
+	} else {
+		printf("PANDORA WLAN: state: DBI not read (power domains are down)\n");
+	}
+}
+
+/* WCN7850 needs a clean power cycle. A fastboot reboot can leave WLAN_EN,
+ * PERST and the RC exactly as the previous OS left them; upstream documents
+ * that an enable GPIO which is already high means the chip is never reset
+ * ("later power-on only sets a GPIO that is already high... the link never
+ * comes up", LKML power: sequencing: qcom-wcn). Drive both low and hold them
+ * there before the documented M1 power-up starts. */
+static void
+sy_platform_reset(void)
+{
+	if (!tlmm_low || !tlmm) {
+		return;
+	}
+	sy_pin_out(PIN_WLAN_EN, CTL_OUT_LOW_8MA);
+	sy_pin_out(PIN_PERST, CTL_OUT_LOW_2MA);
+	sy_pin_level(PIN_WLAN_EN, 0);
+	sy_pin_level(PIN_PERST, 0);
+	sy_usleep(10000);	/* hold low 10 ms so the chip sees a real reset */
+	printf("PANDORA WLAN: platform reset: WLAN_EN/PERST low for 10 ms\n");
+	sy_log_sync();
+}
+
+/* Leave the card in a known state when this boot gives up (or finishes a
+ * diagnostic step): both reset/enable pins low. Rails keep their last vote;
+ * that is recorded here so the next boot's platform reset is still a real
+ * chip reset (EN low then high). */
+static void
+sy_platform_poweroff(void)
+{
+	if (!tlmm_low || !tlmm) {
+		return;
+	}
+	sy_pin_level(PIN_WLAN_EN, 0);
+	sy_pin_level(PIN_PERST, 0);
+	printf("PANDORA WLAN: platform poweroff: WLAN_EN/PERST low\n");
+}
+
+
+/* Read-only: list every valid SMR so the operator can see which SIDs exist and
+ * which bank each points at. No writes here. */
+static void
+sy_smmu_dump(void)
+{
+	uint32_t banks = sy_id1 & 0xffu, streams = sy_id0 & 0xffu;
+	unsigned i, shown = 0;
+
+	if (!sy_smmu_va || !streams || !banks)
+		return;
+	printf("PANDORA WLAN: SMMU table: streams %u banks %u\n", streams, banks);
+	for (i = 0; i < streams && shown < 36; i++) {
+		uint32_t smr = sy_rd(sy_smmu_va, 0x800 + 4 * i);
+		uint32_t s2cr = sy_rd(sy_smmu_va, 0xc00 + 4 * i);
+
+		if (!(smr & 0x80000000u))
+			continue;
+		printf("PANDORA WLAN: SMMU table[%u]: smr %#x id %#x mask %#x s2cr %#x type %u bank %u\n",
+		    i, smr, smr & 0x7fffu, (smr >> 16) & 0x7fffu, s2cr, (s2cr >> 16) & 3u, s2cr & 0xffu);
+		shown++;
+	}
+	sy_log_sync();
+}
+
+static void
+sy_smmu_bank_scan(void)
+{
+	uint32_t banks = sy_id1 & 0xffu, pages = 2u << ((sy_id1 >> 28) & 7u);
+	uint32_t shift = (sy_id1 >> 31) ? 16u : 12u;
+	unsigned i, shown = 0;
+
+	if (!sy_smmu_va || !banks)
+		return;
+	printf("PANDORA WLAN: SMMU bank scan: %u banks, iova base %#x\n", banks, SY_IOVA_BASE);
+	for (i = 0; i < banks && shown < 24; i++) {
+		vm_offset_t cbv = ml_io_map(0x15000000UL + ((vm_offset_t)pages + i) * (1u << shift), 0x1000);
+		uint32_t sctlr, fsr, far_lo, far_hi;
+
+		if (!cbv)
+			continue;
+		sctlr = sy_rd(cbv, 0x00);
+		fsr = sy_rd(cbv, 0x58);
+		if (!(sctlr & 1u) && !(fsr & 0xc00001feu) && !(fsr & 0x600u))
+			continue;
+		far_lo = sy_rd(cbv, 0x60);
+		far_hi = sy_rd(cbv, 0x64);
+		printf("PANDORA WLAN: SMMU bank[%u]: sctlr %#x fsr %#x far %#x:%#x%s\n",
+		    i, sctlr, fsr, far_hi, far_lo,
+		    ((far_hi == 0 && far_lo == SY_IOVA_BASE) ? "  <- our IOVA" : ""));
+		shown++;
+	}
+	if (!shown)
+		printf("PANDORA WLAN: SMMU bank scan: every bank idle (no request entered the SMMU)\n");
+	sy_log_sync();
+}
+
+
+static void
+sy_bhi_bhie(void)
+{
+	uint64_t fo = 0, fs = 0, iova = SY_IOVA_MAP;
+	uint32_t i, seg = SY_SBL_SIZE, n, ts, st;
+	uint64_t *vec;
+
+	if (!sy_bar_va || !sy_sbl_va || !sy_buf_size || !sy_bhi_off) {
+		printf("PANDORA WLAN: BHIe: missing state\n");
+		return;
+	}
+	if (sy_fw_find("amss20.bin", &fo, &fs) || fs <= SY_SBL_SIZE) {
+		printf("PANDORA WLAN: BHIe: firmware not usable\n");
+		return;
+	}
+	n = (uint32_t)((fs - SY_SBL_SIZE + seg - 1) / seg) + 1;   /* + vector table */
+	if (n > 16 || (uint64_t)n * 16 > 0x1000) {
+		printf("PANDORA WLAN: BHIe: too many segments %u\n", n);
+		return;
+	}
+	if (pandora_fw_read(fo + SY_SBL_SIZE, (void *)(sy_sbl_va + SY_SBL_SIZE),
+	    (vm_size_t)(fs - SY_SBL_SIZE))) {
+		printf("PANDORA WLAN: BHIe: image read failed\n");
+		return;
+	}
+	vec = (uint64_t *)(sy_sbl_va + SY_FW_BUF - 0x1000);
+	for (i = 0; i + 1 < n; i++) {
+		vec[2 * i] = iova + SY_SBL_SIZE + (uint64_t)i * seg;
+		vec[2 * i + 1] = (i + 2 == n) ? (fs - SY_SBL_SIZE - (uint64_t)i * seg) : seg;
+	}
+	/* BHIe registers are at bar0 + BHIEOFF (0x224 here), not at BHIOFF. */
+	if (!sy_bhie_off) {
+		printf("PANDORA WLAN: BHIe: bad BHIEOFF\n");
+		return;
+	}
+	{
+		uint32_t ee = 0;
+		unsigned w;
+
+		for (w = 0; w < 2000; w++) {
+			ee = sy_rd(sy_bar_va, sy_bhi_off + 0x28);
+			if (ee == 1)	/* SBL runs: the rest of the image can be sent */
+				break;
+			delay(1000);
+		}
+		printf("PANDORA WLAN: BHIe: execenv %#x after %u ms (1 = SBL)\n", ee, w);
+		if (ee != 1) {
+			printf("PANDORA WLAN: BHIe: device is not in SBL; not sending the image\n");
+			return;
+		}
+	}
+	/* The rest of the image and the vector table were written through the cached
+	 * mapping, so clean them out before the endpoint reads them. */
+	for (i = 0; i < (SY_FW_BUF >> 12); i++)
+		flush_dcache64(sy_pa(sy_sbl_va + ((vm_offset_t)i << 12)), (unsigned)PAGE_SIZE, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_wr(sy_bar_va, sy_bhie_off + 0x2c, (uint32_t)(iova + SY_FW_BUF - 0x1000));
+	sy_wr(sy_bar_va, sy_bhie_off + 0x30, 0);
+	sy_wr(sy_bar_va, sy_bhie_off + 0x34, (n - 1) * 16);
+	sy_wr(sy_bar_va, sy_bhie_off + 0x3c, 0x1234u);		/* sequence only (bits 29:0) */
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("PANDORA WLAN: BHIe: bhie %#x vec %#llx n %u segs %u size %u ee %#x addr %#x/%#x size %#x db %#x\n",
+	    sy_bhie_off, (unsigned long long)(iova + SY_FW_BUF - 0x1000), n, n - 1, (n - 1) * 16,
+	    sy_rd(sy_bar_va, sy_bhi_off + 0x28),
+	    sy_rd(sy_bar_va, sy_bhie_off + 0x2c), sy_rd(sy_bar_va, sy_bhie_off + 0x30),
+	    sy_rd(sy_bar_va, sy_bhie_off + 0x34), sy_rd(sy_bar_va, sy_bhie_off + 0x3c));
+	ts = 0;
+	for (i = 0; i < 2000; i++) {
+		ts = sy_rd(sy_bar_va, sy_bhie_off + 0x44);
+		if ((ts >> 30) == 2 || ((ts >> 30) == 3 && ts != 0xffffffffu))
+			break;
+		delay(1000);
+	}
+	printf("PANDORA WLAN: BHIe result: txvecstatus %#x code %u seq %#x after %u ms\n",
+	    ts, ts >> 30, ts & 0x3fffffffu, i);
+	if ((ts >> 30) != 2) {
+		printf("PANDORA WLAN: BHIe failed; keeping the failure for the next stage\n");
+		return;
+	}
+	{
+		uint32_t c = sy_rd(sy_bar_va, 0x38);
+		uint32_t ee;
+
+		for (i = 0; i < 2000; i++) {
+			ee = sy_rd(sy_bar_va, sy_bhi_off + 0x28);
+			if (ee == 2)	/* AMSS */
+				break;
+			delay(1000);
+		}
+		printf("PANDORA WLAN: BHIe EE after load: %#x after %u ms (2 = AMSS)\n", ee, i);
+		if (ee != 2) {
+			printf("PANDORA WLAN: BHIe: AMSS did not start; leaving MHI state untouched\n");
+			return;
+		}
+		printf("PANDORA WLAN: BHIe done, AMSS runs; setting M0\n");
+		sy_wr(sy_bar_va, 0x38, (c & ~(0xffu << 8)) | (2u << 8));
+		__asm__ volatile("dsb sy" ::: "memory");
+		sy_keep_alive = 1;
+		printf("PANDORA WLAN: MHI M0 after BHIe: ctrl %#x status %#x (state %u ready %u)\n",
+		    sy_rd(sy_bar_va, 0x38), sy_rd(sy_bar_va, 0x48),
+		    (sy_rd(sy_bar_va, 0x48) >> 8) & 0xff, sy_rd(sy_bar_va, 0x48) & 1);
+		for (i = 0; i < 200; i++) {		/* MHISTATUS state field must read M0 (2) */
+			if (((sy_rd(sy_bar_va, 0x48) >> 8) & 0xffu) == 2)
+				break;
+			delay(1000);
+		}
+		printf("PANDORA WLAN: MHI M0 verify: state %u after %u ms%s\n",
+		    (sy_rd(sy_bar_va, 0x48) >> 8) & 0xffu, i,
+		    ((sy_rd(sy_bar_va, 0x48) >> 8) & 0xffu) == 2 ? "" : " (NOT M0)");
+	}
+}
+
+static void
+sy_mhi_ready(void)
+{
+	uint32_t v;
+	unsigned i;
+
+	if (!sy_bar_va) {
+		printf("PANDORA WLAN: MHI: no BAR0\n");
+		return;
+	}
+	for (i = 0; i < 200; i++) {
+		v = sy_rd(sy_bar_va, 0x38);
+		if (!(v & 0x2u))
+			break;
+		sy_usleep(25000);
+	}
+	for (i = 0; i < 200; i++) {
+		v = sy_rd(sy_bar_va, 0x48);
+		if (v & 1u)
+			break;
+		sy_usleep(25000);
+	}
+	v = sy_rd(sy_bar_va, 0x48);
+	printf("PANDORA WLAN: MHI ready poll: ctrl %#x status %#x (state %u ready %u)\n",
+	    sy_rd(sy_bar_va, 0x38), v, (v >> 8) & 0xff, v & 1);
+	if (v & 1u)
+		printf("PANDORA WLAN: MHI READY reached; M0 is set in stage 17 "
+		    "after context/mmio init (official pm.c order)\n");
+}
+
+
+/* The MHI structures and receive buffers are ordinary cached pages and the
+ * endpoint writes them without snooping. This tree has no invalidate_dcache64
+ * (caches_internal.h only declares flush_dcache64), so the device-written pages
+ * get write-combined aliases, mapped one page at a time because the buffer pages
+ * need not be physically contiguous. */
+static vm_offset_t sy_mhi_uc[0x10];
+
+static vm_offset_t
+sy_mhi_ucva(uint32_t off)
+{
+	unsigned pg = off >> 12;
+
+	if (pg >= sizeof(sy_mhi_uc) / sizeof(sy_mhi_uc[0]) || !sy_mhi_uc[pg])
+		return 0;
+	return sy_mhi_uc[pg] + (off & 0xfffu);
+}
+
+static void
+sy_mhi_map_uc(vm_offset_t pg_va)
+{
+	unsigned i;
+
+	for (i = 0; i < sizeof(sy_mhi_uc) / sizeof(sy_mhi_uc[0]); i++) {
+		if (!sy_mhi_uc[i])
+			sy_mhi_uc[i] = ml_io_map_unmappable(
+			    (vm_offset_t)sy_pa(pg_va + ((vm_offset_t)i << 12)),
+			    PAGE_SIZE, VM_WIMG_WCOMB);
+	}
+	printf("PANDORA WLAN: MHI: %u write-combined page aliases for the 0xc000-byte context/ring/buffer region\n",
+	    (unsigned)(sizeof(sy_mhi_uc) / sizeof(sy_mhi_uc[0])));
+}
+
+/* ---- M5b-1: MHI mission-mode contexts and channels ------------------------------
+ * Channel and event layout from mainline ath12k mhi.c v6.6
+ * (ath12k_mhi_config_wcn7850): 128 channels, 2 event rings; the QMI/QRTR transport
+ * is "IPCR" on channels 20 (UL) and 21 (DL), both on event ring 1; LOOPBACK uses
+ * channels 0/1 on event ring 0. Context records are 44 (0x2c) bytes, ring elements
+ * 16 bytes. Rings and buffers live in the already mapped window at IOVA 0xb07c0000. */
+#define SY_MHI_CH_CTX	0x0000u
+#define SY_MHI_EV_CTX	0x1700u
+#define SY_MHI_CMD_CTX	0x1800u
+#define SY_MHI_ER0	0x1900u
+#define SY_MHI_ER0_LEN	512u
+#define SY_MHI_ER1	0x1b00u
+#define SY_MHI_ER1_LEN	4096u
+#define SY_MHI_CMD_R	0x2b00u
+#define SY_MHI_CMD_LEN	2048u
+#define SY_MHI_CH0_R	0x3300u
+#define SY_MHI_CH1_R	0x3500u
+#define SY_MHI_CH20_R	0x3700u
+#define SY_MHI_CH21_R	0x3b00u
+#define SY_MHI_DL_BUF	0x4000u
+#define SY_DMA_TO_DEV	1u
+#define SY_DMA_FROM_DEV	2u
+#define SY_MHI_DL_NBUF	8
+
+static const struct sy_mhi_chan_desc {
+	uint32_t num, els, er, dir, ring;
+} sy_mhi_desc[] = {
+	{ 0, 32, 0, SY_DMA_TO_DEV, SY_MHI_CH0_R },
+	{ 1, 32, 0, SY_DMA_FROM_DEV, SY_MHI_CH1_R },
+	{ 20, 64, 1, SY_DMA_TO_DEV, SY_MHI_CH20_R },
+	{ 21, 64, 1, SY_DMA_FROM_DEV, SY_MHI_CH21_R },
+};
+
+static void
+sy_mhi_init(void)
+{
+	vm_offset_t pg_va, c;
+	uint64_t pg, rbase;
+	uint32_t cfg, i, erdb;
+
+	if (!sy_bar_va || !sy_sbl_va || sy_buf_size < 0x800000) {
+		printf("PANDORA WLAN: MHI init: buffer too small/absent (%#x)\n", sy_buf_size);
+		return;
+	}
+	pg_va = sy_sbl_va + 0x7C0000;
+	pg = SY_IOVA_MAP + 0x7C0000;
+	sy_mhi_map_uc(pg_va);
+	memset((void *)pg_va, 0, 0xc000);
+
+	/* channel contexts: index = channel number, 44 bytes each */
+	for (i = 0; i < sizeof(sy_mhi_desc) / sizeof(sy_mhi_desc[0]); i++) {
+		const struct sy_mhi_chan_desc *d = &sy_mhi_desc[i];
+		uint32_t rlen = d->els * 16u;
+
+		rbase = pg + d->ring;
+		c = pg_va + SY_MHI_CH_CTX + d->num * 0x2cu;
+		sy_wr(c, 0x00, (2u << 8) | 1u);	/* chcfg: enabled, MHI_DB_BRST_DISABLE */
+		sy_wr(c, 0x04, d->dir);			/* chtype = direction */
+		sy_wr(c, 0x08, d->er);			/* event ring index */
+		sy_wr(c, 0x0c, (uint32_t)rbase);
+		sy_wr(c, 0x10, (uint32_t)(rbase >> 32));
+		sy_wr(c, 0x14, rlen);			/* rlen low */
+		sy_wr(c, 0x18, 0);
+		sy_wr(c, 0x1c, (uint32_t)rbase);	/* rp */
+		sy_wr(c, 0x20, (uint32_t)(rbase >> 32));
+		sy_wr(c, 0x24, (uint32_t)rbase);	/* wp */
+		sy_wr(c, 0x28, (uint32_t)(rbase >> 32));
+	}
+	/* event contexts: ring 0 = 32 elements/irq 1, ring 1 = 256/irq 2, 1 ms */
+	{
+		static const uint32_t el[2] = { 32, 256 };
+		static const uint32_t irq[2] = { 1, 2 };
+		static const uint32_t rlen[2] = { SY_MHI_ER0_LEN, SY_MHI_ER1_LEN };
+		static const uint32_t roff[2] = { SY_MHI_ER0, SY_MHI_ER1 };
+
+		for (i = 0; i < 2; i++) {
+			rbase = pg + roff[i];
+			c = pg_va + SY_MHI_EV_CTX + i * 0x2cu;
+			sy_wr(c, 0x00, i ? (1u << 16) : 0);	/* intmod ms */
+			sy_wr(c, 0x04, 1);			/* ertype valid */
+			sy_wr(c, 0x08, irq[i]);			/* msivec */
+			sy_wr(c, 0x0c, (uint32_t)rbase);
+			sy_wr(c, 0x10, (uint32_t)(rbase >> 32));
+			sy_wr(c, 0x14, rlen[i]);
+			sy_wr(c, 0x18, 0);
+			sy_wr(c, 0x1c, (uint32_t)rbase);
+			sy_wr(c, 0x20, (uint32_t)(rbase >> 32));
+			sy_wr(c, 0x24, (uint32_t)rbase);
+			sy_wr(c, 0x28, (uint32_t)(rbase >> 32));
+			(void)el;
+		}
+	}
+	/* command ring context */
+	rbase = pg + SY_MHI_CMD_R;
+	c = pg_va + SY_MHI_CMD_CTX;
+	sy_wr(c, 0x00, 0); sy_wr(c, 0x04, 0); sy_wr(c, 0x08, 0);
+	sy_wr(c, 0x0c, (uint32_t)rbase); sy_wr(c, 0x10, (uint32_t)(rbase >> 32));
+	sy_wr(c, 0x14, SY_MHI_CMD_LEN); sy_wr(c, 0x18, 0);
+	sy_wr(c, 0x1c, (uint32_t)rbase); sy_wr(c, 0x20, (uint32_t)(rbase >> 32));
+	sy_wr(c, 0x24, (uint32_t)rbase); sy_wr(c, 0x28, (uint32_t)(rbase >> 32));
+	for (i = 0; i < 12; i++)	/* contexts and rings: 0x7c0000..0x7cc000 */
+		flush_dcache64(sy_pa(pg_va + ((vm_offset_t)i << 12)), (unsigned)PAGE_SIZE, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	sy_wr(sy_bar_va, 0x5c, (uint32_t)(pg >> 32)); sy_wr(sy_bar_va, 0x58, (uint32_t)pg);
+	sy_wr(sy_bar_va, 0x64, (uint32_t)((pg + SY_MHI_EV_CTX) >> 32));
+	sy_wr(sy_bar_va, 0x60, (uint32_t)(pg + SY_MHI_EV_CTX));
+	sy_wr(sy_bar_va, 0x6c, (uint32_t)((pg + SY_MHI_CMD_CTX) >> 32));
+	sy_wr(sy_bar_va, 0x68, (uint32_t)(pg + SY_MHI_CMD_CTX));
+	/* with S1 translation the control/data windows must be the mapped IOVA range */
+	sy_wr(sy_bar_va, 0x84, (uint32_t)(SY_IOVA_MAP >> 32));
+	sy_wr(sy_bar_va, 0x80, (uint32_t)SY_IOVA_MAP);
+	sy_wr(sy_bar_va, 0x9c, (uint32_t)(SY_IOVA_MAP >> 32));
+	sy_wr(sy_bar_va, 0x98, (uint32_t)SY_IOVA_MAP);
+	sy_wr(sy_bar_va, 0x8c, (uint32_t)((SY_IOVA_MAP + SY_FW_BUF - 1) >> 32));
+	sy_wr(sy_bar_va, 0x88, (uint32_t)(SY_IOVA_MAP + SY_FW_BUF - 1));
+	sy_wr(sy_bar_va, 0xa4, (uint32_t)((SY_IOVA_MAP + SY_FW_BUF - 1) >> 32));
+	sy_wr(sy_bar_va, 0xa0, (uint32_t)(SY_IOVA_MAP + SY_FW_BUF - 1));
+	cfg = sy_rd(sy_bar_va, 0x10);
+	cfg &= ~((0xffu << 16) | (0xffu << 24));
+	cfg |= (2u << 16);			/* NER = 2, NHWER = 0 */
+	sy_wr(sy_bar_va, 0x10, cfg);
+	/* event ring doorbells start at the ring base (empty ring) */
+	erdb = sy_rd(sy_bar_va, 0x20) & 0xffffu;
+	if (erdb && erdb + 16 <= 0x1000) {
+		uint64_t e0 = pg + SY_MHI_ER0, e1 = pg + SY_MHI_ER1;
+
+		sy_wr(sy_bar_va, erdb, (uint32_t)e0); sy_wr(sy_bar_va, erdb + 4, (uint32_t)(e0 >> 32));
+		sy_wr(sy_bar_va, erdb + 8, (uint32_t)e1); sy_wr(sy_bar_va, erdb + 12, (uint32_t)(e1 >> 32));
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("PANDORA WLAN: MHI ctx: iova %#llx ch[%u %u %u %u] ev[%u %u] "
+	    "er0 %#llx er1 %#llx cmd %#llx chdb %#x erdb %#x\n",
+	    (unsigned long long)pg, sy_mhi_desc[0].num, sy_mhi_desc[1].num,
+	    sy_mhi_desc[2].num, sy_mhi_desc[3].num, 32u, 256u,
+	    (unsigned long long)(pg + SY_MHI_ER0), (unsigned long long)(pg + SY_MHI_ER1),
+	    (unsigned long long)(pg + SY_MHI_CMD_R), sy_rd(sy_bar_va, 0x18) & 0xffffu, erdb);
+	printf("PANDORA WLAN: MHI init done (contexts + channels; doorbells after AMSS)\n");
+}
+
+/* Post the receive buffers and ring the channel doorbells: this is where the device
+ * learns that the host is ready for QRTR/QMI. Only valid once AMSS runs (M0). */
+static void
+sy_mhi_chan_start(void)
+{
+	vm_offset_t pg_va, c;
+	uint64_t pg, buf, tre;
+	uint32_t chdb, i, n, dl;
+
+	if (!sy_bar_va || !sy_sbl_va) {
+		printf("PANDORA WLAN: MHI chan: no BAR0/buffer\n");
+		return;
+	}
+	chdb = sy_rd(sy_bar_va, 0x18) & 0xffffu;
+	if (!chdb || chdb + 8 * 128 > 0x1000) {
+		printf("PANDORA WLAN: MHI chan: bad CHDBOFF %#x\n", chdb);
+		return;
+	}
+	pg_va = sy_sbl_va + 0x7C0000;
+	pg = SY_IOVA_MAP + 0x7C0000;
+	for (i = 0, dl = 0; i < sizeof(sy_mhi_desc) / sizeof(sy_mhi_desc[0]); i++) {
+		const struct sy_mhi_chan_desc *d = &sy_mhi_desc[i];
+		uint32_t ring = d->ring;
+		uint64_t wp;
+
+		if (d->dir != SY_DMA_FROM_DEV)
+			continue;			/* DL channels take host buffers */
+		for (n = 0; n < SY_MHI_DL_NBUF; n++) {
+			buf = pg + SY_MHI_DL_BUF + ((uint64_t)(dl * SY_MHI_DL_NBUF + n) << 11);
+			tre = pg_va + ring + (n << 4);
+			sy_wr(tre, 0, (uint32_t)buf);
+			sy_wr(tre, 4, (uint32_t)(buf >> 32));
+			sy_wr(tre, 8, 0x800u);		/* dword0: length */
+			sy_wr(tre, 12, (2u << 16) | (1u << 9));	/* xfer, MHI_EOT */
+		}
+		wp = pg + ring + ((uint64_t)SY_MHI_DL_NBUF << 4);
+		c = pg_va + SY_MHI_CH_CTX + d->num * 0x2cu;
+		sy_wr(c, 0x24, (uint32_t)wp); sy_wr(c, 0x28, (uint32_t)(wp >> 32));
+		for (n = 0; n < 2; n++)
+			flush_dcache64(sy_pa(pg_va + ring + (n << 12)), (unsigned)PAGE_SIZE, TRUE);
+		flush_dcache64(sy_pa(pg_va + SY_MHI_CH_CTX + d->num * 0x2cu), (unsigned)PAGE_SIZE, TRUE);
+		__asm__ volatile("dsb sy" ::: "memory");
+		sy_wr(sy_bar_va, chdb + 8 * d->num, (uint32_t)wp);
+		sy_wr(sy_bar_va, chdb + 8 * d->num + 4, (uint32_t)(wp >> 32));
+		printf("PANDORA WLAN: MHI chan %u DL: %u buffers, wp %#llx, doorbell %#x\n",
+		    d->num, SY_MHI_DL_NBUF, (unsigned long long)wp, chdb + 8 * d->num);
+		dl++;
+	}
+	sy_mhi_dl_posted = SY_MHI_DL_NBUF;
+	__asm__ volatile("dsb sy" ::: "memory");
+	sy_log_sync();
+}
+
+/* Poll event ring 1 (IPCR and data) and print what the device sends, including the
+ * QRTR header of channel 21 transfers, so the QMI handshake can be built from real
+ * traffic instead of guesses. */
+/* The endpoint updates the event context's *rp* field with its producer index and
+ * the host publishes its own index in the context's *wp* field plus the event ring
+ * doorbell (see mainline mhi_process_data_event_ring/mhi_recycle_ev_ring_element:
+ * read er_ctxt->rp, write er_ctxt->wp, ring ERDB with that wp). A transfer event's
+ * ptr names the TRE in the channel ring, not the data buffer; the buffer address is
+ * inside that TRE. */
+static uint32_t sy_mhi_hi[2];	/* host element index per event ring */
+
+static void
+sy_mhi_ev_walk(unsigned idx, unsigned *shown)
+{
+	static const uint32_t roff[2] = { SY_MHI_ER0, SY_MHI_ER1 };
+	static const uint32_t rlen[2] = { SY_MHI_ER0_LEN, SY_MHI_ER1_LEN };
+	vm_offset_t evc;
+	uint64_t pg, base;
+	uint32_t dev, hi, erdb, n;
+
+	if (idx > 1)
+		return;
+	pg = SY_IOVA_MAP + 0x7C0000;
+	base = pg + roff[idx];
+	evc = pg_va + SY_MHI_EV_CTX + idx * 0x2cu;
+	erdb = sy_rd(sy_bar_va, 0x20) & 0xffffu;
+	{
+		vm_offset_t u = sy_mhi_ucva(SY_MHI_EV_CTX + idx * 0x2c + 0x1c);
+
+		dev = u ? sy_rd(u, 0) : (uint32_t)base;
+	}
+	if (dev < (uint32_t)base || dev >= (uint32_t)(base + rlen[idx]))
+		return;
+	hi = sy_mhi_hi[idx];
+	for (n = 0; n < rlen[idx] / 16 && (uint32_t)(base + hi) != dev; n++) {
+		vm_offset_t e = sy_mhi_ucva(roff[idx] + hi);
+		uint64_t ptr;
+		uint32_t d0, d1, type;
+
+		if (!e)
+			break;
+		ptr = (uint64_t)sy_rd(e, 0) | ((uint64_t)sy_rd(e, 4) << 32);
+		d0 = sy_rd(e, 8); d1 = sy_rd(e, 12);
+		type = (d1 >> 16) & 0xffu;
+		if (*shown < 24) {
+			if (type == 2) {		/* transfer event */
+				uint32_t ch = d1 >> 24, code = d0 >> 24, len = d0 & 0xffffu;
+
+				printf("PANDORA WLAN: MHI xfer ev: ch %u code %u len %u tre %#llx\n",
+				    ch, code, len, (unsigned long long)ptr);
+				if (code == 2 && ch < 128) {
+					unsigned di;
+
+					for (di = 0; di < sizeof(sy_mhi_desc) / sizeof(sy_mhi_desc[0]); di++) {
+						const struct sy_mhi_chan_desc *d = &sy_mhi_desc[di];
+						uint32_t troff;
+						vm_offset_t t;
+						uint64_t buf;
+						uint32_t plen = len ? len : 0x800u;
+
+						if (d->num != ch || d->dir != SY_DMA_FROM_DEV)
+							continue;
+						if (ptr < pg + d->ring || ptr >= pg + d->ring + d->els * 16u)
+							break;
+						troff = (uint32_t)(ptr - (pg + d->ring));
+						t = sy_mhi_ucva(d->ring + troff);
+						if (!t)
+							break;
+						buf = (uint64_t)sy_rd(t, 0) | ((uint64_t)sy_rd(t, 4) << 32);
+						if (buf < SY_IOVA_MAP || buf + 64 > SY_IOVA_MAP + SY_FW_BUF)
+							break;
+						{
+							uint32_t poff = (uint32_t)(buf - SY_IOVA_MAP);
+							vm_offset_t va = sy_mhi_ucva(poff);
+							uint32_t *q;
+
+							if (!va)
+								va = sy_sbl_va + (vm_offset_t)poff;
+							q = (uint32_t *)va;
+							printf("PANDORA WLAN: ch %u rx %u B from %#llx: "
+							    "qrtr ver %#x size %u src %u/%u dst %u/%u "
+							    "first %#x %#x %#x %#x\n",
+							    ch, plen, (unsigned long long)buf,
+							    sy_rd(va, 0), sy_rd(va, 16), sy_rd(va, 4), sy_rd(va, 8),
+							    sy_rd(va, 20), sy_rd(va, 24), q[7], q[8], q[9], q[10]);
+						}
+						break;
+					}
+				}
+			} else if (type == 0x20) {	/* state change */
+				printf("PANDORA WLAN: MHI state ev: %u\n", d0 >> 24);
+			} else if (type == 0x40) {	/* EE event */
+				printf("PANDORA WLAN: MHI EE ev: %u\n", d0 >> 24);
+			} else {
+				printf("PANDORA WLAN: MHI ev type %#x d0 %#x d1 %#x\n", type, d0, d1);
+			}
+			(*shown)++;
+		}
+		hi += 16;
+		if (hi >= rlen[idx])
+			hi = 0;
+		sy_mhi_hi[idx] = hi;
+		sy_wr(evc, 0x24, (uint32_t)(base + hi));	/* publish host index */
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	flush_dcache64(sy_pa(evc), (unsigned)PAGE_SIZE, TRUE);
+	if (erdb && erdb + 16 <= 0x1000) {
+		sy_wr(sy_bar_va, erdb + 8 * idx, (uint32_t)(base + hi));
+		sy_wr(sy_bar_va, erdb + 8 * idx + 4, (uint32_t)((base + hi) >> 32));
+	}
+}
+
+static void
+sy_mhi_poll(void)
+{
+	uint32_t k, erdb, chdb;
+	unsigned shown = 0;
+
+	if (!sy_bar_va || !sy_sbl_va) {
+		printf("PANDORA WLAN: MHI poll: no BAR0/buffer\n");
+		return;
+	}
+	erdb = sy_rd(sy_bar_va, 0x20) & 0xffffu;
+	chdb = sy_rd(sy_bar_va, 0x18) & 0xffffu;
+	for (k = 0; k < 5000; k++) {
+		sy_mhi_ev_walk(0, &shown);
+		sy_mhi_ev_walk(1, &shown);
+		if (k % 1000 == 999)
+			printf("PANDORA WLAN: MHI poll %u ms: state %u ee %#x events %u\n",
+			    (k + 1), (sy_rd(sy_bar_va, 0x48) >> 8) & 0xff,
+			    sy_rd(sy_bar_va, sy_bhi_off + 0x28), shown);
+		delay(1000);
+	}
+	printf("PANDORA WLAN: MHI poll done: %u events, chdb %#x erdb %#x\n",
+	    shown, chdb, erdb);
+	sy_log_sync();
+}
+
+
+
