+static int
+cv_staged_isdir(const char *path)
+{
+	vnode_t vp = NULLVP;
+
+	if (vnode_lookup(path, 0, &vp, vfs_context_kernel()) != 0) {
+		return 0;
+	}
+	int dir = vp->v_type == VDIR;
+	vnode_put(vp);
+	return dir;
