+/* ---- D1: CE transport, HTC connect and WMI_INIT/WMI_READY (stage 21) ----------------
+ *
+ * This is the stage the WLFW QMI handshake was always waiting for.  It is written
+ * against the local mainline ath12k v6.6 snapshot (E:\songyuan\work\ath12k_v66),
+ * and every constant below cites that tree:
+ *  - CE register block: device offset 0x01b80000, 0x2000 per copy engine
+ *    (hal.h:44-53, HAL_CE_WFSS_CE_REG_BASE / HAL_SEQ_WCSS_UMAC_CE0_SRC_REG).
+ *  - BAR0 exposes that block through a window: write
+ *    0x40000000 | ((dev_off>>19)&0x3f), then touch
+ *    BAR0+0x80000+(dev_off & 0x7ffff) (pci.c:22-27, 146-165).
+ *    This phone's register is 0x3278, not the WCN7850 0x310c.
+ *  - Ring registers (relative to the CE block; hal.h:58-102,190-197; hal.c:1253-1422):
+ *      R0 +0x00 base LSB, +0x04 base MSB | (ring size in dwords << 8),
+ *      +0x08 ring id/entry size, +0x10 misc, +0x1c/+0x20 TP address (src rings),
+ *      +0x14/+0x18 HP address (status ring), +0x24 producer int (status),
+ *      +0x30/+0x34 consumer int (src rings), +0xb0 dst ctrl (max buffer len);
+ *      R2 +0x400 HP, +0x404 TP (hal.h:196-197; the status ring R2 pair is at
+ *      dst block + 0x408).
+ *  - Rings: CE0 src 16 x 16 B (HTC control UL), CE1 512 x 8 B dst + 512 x 16 B
+ *    status, CE2 64 x 8 B dst + 64 x 16 B status (HTC/WMI DL), CE3 32 x 16 B src
+ *    (WMI UL) (ce.c:145-220, hw.c:245-336).
+ *  - HTC frame header is 8 bytes (htc.h:58-61), CONNECT_SERVICE 8 B and its
+ *    response 12 B (htc.h:109-118), READY 8 B (htc.h:99-102).  WMI commands go
+ *    over the WMI_CONTROL endpoint (0x0100) whose UL pipe is CE3 and DL pipe is
+ *    CE2 (hw.c:453-532); ep0 (RSVD_CTRL 0x0001) is the local HTC control endpoint
+ *    whose UL pipe is CE0 and DL pipe is CE2.
+ *  - WMI_INIT is a 332-byte WMI payload (wmi.c:3290-3335: 4 B command id added
+ *    by the send path + INIT_CMD struct 32 B + RESOURCE_CONFIG struct 292 B
+ *    + one empty ARRAY_STRUCT header).  ath12k_wmi_alloc_skb() only rounds the
+ *    328 B body up to 4, which it already is, so there is no extra padding TLV.
+ *    WMI_READY is event 0x2 carrying TLV tag 35 (wmi.h:302,675-676;
+ *    wmi.c:5568-5582).  This phone parses SERVICE_READY_EXT2 (aux caps) before
+ *    that ready event (android_dmesg.txt:2384,2388-2390,2409), so WMI_INIT is
+ *    held until EXT2 arrives.
+ *  - The window register on this phone is BAR0+0x3278.  qca_cld3_peach_v2.ko
+ *    hif_read32_mb_reg_window / hif_write32_mb_reg_window (symbol 0x483b44 /
+ *    0x483a18) do `mov w, #0x3278`, then write 0x40000000 with bits [24:19]
+ *    of the device offset, and access BAR0+0x80000+(offset & 0x7ffff).
+ *    0x310c is logged and not selected.
+ *
+ * Design choices for this first pass, stated so a later stage can change them:
+ *  1. No shadow registers: WLAN_CFG carries no shadow_reg_v3 list and the rings
+ *     use the ordinary SRNG HP/TP path of hal.c:1933-1991.  The src-direction
+ *     rings (CE0/CE1-dst/CE3) write HP to the R2 register and read TP from the
+ *     RDP DMA page; the status rings read HP from RDP and write TP to R2+4.
+ *     This keeps D1 independent of the 40-entry shadow list (hal.h:36-41), which
+ *     cannot be validated offline.
+ *  2. No interrupts: the CE status rings are polled, like the existing MHI
+ *     stages; this driver tree has no interrupt handler yet.
+ *  3. Device-written memory (status descriptors, RDP indices, received buffers)
+ *     is read through a write-combined alias of the same physical pages, the
+ *     method sy_mhi_map_uc() already uses (flush_dcache64 exists, invalidate does
+ *     not).
+ */
+#define SY_CE_BASE_OFF	0x01b80000UL	/* hal.h:53 */
+#define SY_CE_WIN_AP	0x00080000UL	/* pci.c:22 WINDOW_START */
+#define SY_CE_WIN_EN	0x40000000UL	/* pci.c:22 WINDOW_ENABLE_BIT */
+#define SY_CE_WIN_MASK	0x0007ffffUL	/* pci.c:22 WINDOW_RANGE_MASK */
+/* BAR0+0x3000 page offset of the window register.  0x278 is BAR0+0x3278,
+ * the register hif_*_mb_reg_window in qca_cld3_peach_v2.ko writes. */
+#define SY_CE_IOVA	0xB0800000UL	/* L2 row 388 of the installed SMMU tables */
+#define SY_CE_SIZE	0x00200000UL	/* 2 MiB = one L3 page (512 x 4 KiB) */
+
+/* ring placement inside the CE region (the same offsets are VA and IOVA offsets) */
+#define SY_CE_OFF_CE0_SRC	0x00000000UL	/* 16 x 16 B = 0x100 */
+#define SY_CE_OFF_CE3_SRC	0x00001000UL	/* 32 x 16 B = 0x200 */
+#define SY_CE_OFF_CE1_DST	0x00002000UL	/* 512 x 8 B = 0x1000 */
+#define SY_CE_OFF_CE1_ST	0x00003000UL	/* 512 x 16 B = 0x2000 */
+#define SY_CE_OFF_CE2_DST	0x00005000UL	/* 64 x 8 B = 0x200 */
+#define SY_CE_OFF_CE2_ST	0x00006000UL	/* 64 x 16 B = 0x400 */
+#define SY_CE_OFF_RDP		0x00007000UL	/* 204 x u32 = 0x330 (hal.h:478-507) */
+#define SY_CE_OFF_CE1_BUF	0x00080000UL	/* 512 x 2048 B */
+#define SY_CE_OFF_CE2_BUF	0x00180000UL	/* 64 x 2048 B */
+#define SY_CE_OFF_CE0_TX	0x001a0000UL	/* 2 x 2048 B HTC control TX */
+#define SY_CE_OFF_CE3_TX	0x001a1000UL	/* 2 x 2048 B WMI TX */
+#define SY_CE_OFF_CE4_SRC	0x00008000UL	/* 2048 x 16 B = 0x8000, host CE4 (ce.c:180-186) */
+#define SY_CE_OFF_CE4_TX	0x001a2000UL	/* 2 x 256 B HTT TX; src_sz_max is 256 */
+#define SY_CE4_TX_SZ		256u
+#define SY_CE_BUF_SZ		2048u		/* ce.c:154-170 CE1/CE2 buffer size */
+
+/* HAL ring ids (hal.h:401,418,435) */
