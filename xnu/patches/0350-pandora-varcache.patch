+static void
+cv_stage_apps(void)
+{
+	uint32_t before, after;
+	unsigned i, renamed = 0, already = 0, failed = 0, present = 0;
+	struct hfsmount *hfs = rootvnode ? VTOHFS(rootvnode) : NULL;
+
+	before = hfs ? hfs_freeblks(hfs, 0) : 0;
+	printf("PANDORA STAGED: freeblks %u\n", before);
+	for (i = 0; i < CV_STAGED_N; i++) {
+		char src[128], dst[96];
+		int error;
+
+		snprintf(dst, sizeof(dst), "/Applications/%s", cv_staged_names[i]);
+		snprintf(src, sizeof(src), "/private/var/staged_system_apps/%s", cv_staged_names[i]);
+		if (cv_staged_isdir(dst)) {
+			already++;
+			present++;
+			printf("PANDORA STAGED: %s already\n", cv_staged_names[i]);
+			continue;
+		}
+		if (!cv_staged_isdir(src)) {
+			vnode_t vp = NULLVP;
+			int se = vnode_lookup(src, 0, &vp, vfs_context_kernel());
+
+			if (vp != NULLVP) {
+				se = vp->v_type == VDIR ? 0 : ENOTDIR;
+				vnode_put(vp);
+			}
+			failed++;
+			printf("PANDORA STAGED: %s source %d\n", cv_staged_names[i], se ? se : ENOENT);
+			continue;
+		}
+		error = pandora_rename(src, dst);
+		printf("PANDORA STAGED: %s rename %d\n", cv_staged_names[i], error);
+		if (error == 0) {
+			int ce = cv_staged_lchown_tree(dst);
+
+			renamed++;
+			present++;
+			printf("PANDORA STAGED: %s chown %d\n", cv_staged_names[i], ce);
+		} else {
+			failed++;
+		}
+	}
+	hfs = rootvnode ? VTOHFS(rootvnode) : NULL;
+	after = hfs ? hfs_freeblks(hfs, 0) : 0;
+	printf("PANDORA STAGED: freeblks %u rename %u already %u fail %u\n",
+	    after, renamed, already, failed);
+	for (i = 0; i < CV_STAGED_N; i++) {
+		char ph[96];
+		int error;
+
+		snprintf(ph, sizeof(ph), "/System/Library/AppPlaceholders/%s", cv_staged_names[i]);
+		error = pandora_rmrf(ph);
+		printf("PANDORA STAGED: placeholder %s %d\n", cv_staged_names[i], error);
+	}
+	cv_staged_renamed = (int)renamed;
+	cv_staged_all = present == CV_STAGED_N;
+}
