+/*
+ * 0351: the firmware pack re-installs /private/var/mobile/Library/Preferences/
+ * com.apple.purplebuddy.plist on every boot. pf only writes a file whose bytes differ, and the
+ * pack's seed (SetupDone/SetupFinishedAllSteps/SetupVersion 11) is older than what iOS writes once
+ * it has completed setup, so the second and every later boot gets the setup state rolled back and
+ * SpringBoard launches Setup Assistant again (log: "exec Setup" only on later boots; the fresh
+ * volume boot did not). Keep the phone's own copy across the pack install and put it back, so the
+ * seed only ever fills a first boot (when the file does not exist yet).
+ */
+static const char *const cv_prefs[] = {
+	"/private/var/mobile/Library/Preferences/com.apple.purplebuddy.plist",
+	"/private/var/mobile/Library/Preferences/com.apple.purplebuddy.notbackedup.plist",
+};
+
+struct cv_saved {
+	const char *path;
+	uint8_t *data;
+	size_t size;
+	uid_t uid;
+	gid_t gid;
+	mode_t mode;
+};
+
+#define CV_SAVED_MAX 4
+#define CV_SAVED_BYTES 16384
+static struct cv_saved cv_saved[CV_SAVED_MAX];
+static uint8_t cv_saved_data[CV_SAVED_MAX][CV_SAVED_BYTES];
+static unsigned cv_saved_n;
+
+static void
+cv_preserve_prefs(void)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	unsigned saved = 0;
+
+	for (unsigned i = 0; i < sizeof(cv_prefs) / sizeof(cv_prefs[0]); i++) {
+		vnode_t vp = NULLVP;
+		struct vnode_attr va;
+
+		if (vnode_lookup(cv_prefs[i], 0, &vp, ctx) != 0) {
+			continue;	/* first boot: nothing to keep, the pack seeds it */
+		}
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_data_size);
+		VATTR_WANTED(&va, va_uid);
+		VATTR_WANTED(&va, va_gid);
+		VATTR_WANTED(&va, va_mode);
+		if (vnode_getattr(vp, &va, ctx) == 0 && va.va_data_size > 0 &&
+		    va.va_data_size <= 16384 && cv_saved_n < CV_SAVED_MAX) {
+			size_t n = (size_t)va.va_data_size;
+			uint8_t *buf = cv_saved_data[cv_saved_n];
+			int resid = 0;
+
+			if (n <= CV_SAVED_BYTES &&
+			    vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)n, 0, UIO_SYSSPACE, 0,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx)) == 0 &&
+			    resid == 0) {
+				cv_saved[cv_saved_n].path = cv_prefs[i];
+				cv_saved[cv_saved_n].data = buf;
+				cv_saved[cv_saved_n].size = n;
+				cv_saved[cv_saved_n].uid = va.va_uid;
+				cv_saved[cv_saved_n].gid = va.va_gid;
+				cv_saved[cv_saved_n].mode = va.va_mode;
+				cv_saved_n++;
+				saved++;
+				vnode_put(vp);
+				continue;
+			}
+		}
+		vnode_put(vp);
+	}
+	if (saved != 0) {
+		printf("PANDORA CACHE: kept %u setup-state file(s) across the firmware pack\n", saved);
+	}
+}
+
+static void
+cv_restore_prefs(void)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	unsigned restored = 0;
+
+	for (unsigned i = 0; i < cv_saved_n; i++) {
+		vnode_t vp = NULLVP;
+		struct vnode_attr va;
+		int resid = 0;
+
+		if (vnode_lookup(cv_saved[i].path, 0, &vp, ctx) != 0) {
+			continue;
+		}
+		(void)vn_rdwr(UIO_WRITE, vp, (caddr_t)cv_saved[i].data,
+		    (int)cv_saved[i].size, 0, UIO_SYSSPACE, IO_SYNC,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_data_size, (off_t)cv_saved[i].size);
+		VATTR_SET(&va, va_uid, cv_saved[i].uid);
+		VATTR_SET(&va, va_gid, cv_saved[i].gid);
+		VATTR_SET(&va, va_mode, cv_saved[i].mode);
+		(void)vnode_setattr(vp, &va, ctx);
+		vnode_put(vp);
+		restored++;
+	}
+	printf("PANDORA CACHE: put back %u setup-state file(s) after the firmware pack\n", restored);
 }
 
