+#define SY_RSC_DRV	2u		/* live DT qcom,drv-id */
+#define SY_VRM_MV	1800u		/* live DT regulator-min-microvolt */
+#define SY_VRM_MODE	7u		/* high power mode (PAND:787) */
+#define SY_VRM_ENABLE	1u		/* enable (PAND:787) */
+#define SY_RPMH_WRITE	(8u | (1u << 8) | (1u << 16))	/* PAND:669: write, 4-byte, ack */
+#define SY_RPMH_AMC	(1u << 16)	/* PAND:796: ACTIVE mode command */
+#define SY_RPMH_DONE	0x10100u	/* PAND:806: issued | complete */
+#define SY_RPMH_TRIGGER	(1u << 24)	/* PAND:799: start the TCS */
+#define SY_CMDDB_MAGIC	0x0c0330dbu	/* PAND:670 */
+#define SY_CMDDB_HEADER	144u		/* PAND:671 */
+#define SY_CMDDB_ENTRY	24u		/* PAND:672 */
+
+struct sy_rpmh_layout {
+	uint32_t wait, control, status, enable, msgid, addr, data, cmd_status, cmd_stride;
+};
+static const struct sy_rpmh_layout sy_rpmh_v2 = {0x10, 0x14, 0x18, 0x1c, 0x30, 0x34, 0x38, 0x3c, 20};
+static const struct sy_rpmh_layout sy_rpmh_v3 = {0x20, 0x24, 0x28, 0x2c, 0x34, 0x38, 0x3c, 0x40, 24};
+
+static vm_offset_t sy_rsc, sy_cmddb;
+static bool sy_rpmh_tried;	/* the vote runs once per boot */
+static int sy_rpmh_result;	/* 0: the vote landed, else its errno */
+
+static uint16_t
+sy_cmddb16(uint32_t off)
+{
+	return (uint16_t)(sy_rd(sy_cmddb, off & ~3u) >> (8u * (off & 3u)));
+}
+
+/* PAND:722-734: write, then read back until the register keeps the value. */
+static bool
+sy_rpmh_sync(uint32_t off, uint32_t v)
+{
+	sy_wr(sy_rsc, off, v);
+	for (unsigned i = 0; i < 1000; i++) {
+		if (sy_rd(sy_rsc, off) == v) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* PAND:682-720: the resource's RPMh address out of the cmd-db (slave 4 = VRM). */
+static int
+sy_rpmh_lookup(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; i++) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; i++) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = sy_cmddb16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = SY_CMDDB_HEADER + sy_cmddb16(h + 2);
+		unsigned count = sy_cmddb16(h + 6);
+		if ((entries & 3u) || entries + count * SY_CMDDB_ENTRY > SY_CMDDB_SIZE) {
+			printf("PANDORA WLAN: cmd-db slave header %u malformed\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; j++) {
+			uint32_t e = entries + SY_CMDDB_ENTRY * j;
+			if (sy_rd(sy_cmddb, e) != key[0] || sy_rd(sy_cmddb, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = sy_rd(sy_cmddb, e + 16);
+			printf("PANDORA WLAN: cmd-db %s addr=%#x slave=%u\n", res, addr, slave);
+			if (slave == 4 && ((addr >> 16) & 7u) == 4 && !(addr & 15u)) {
+				*address = addr;
+				matches++;
+			}
+		}
+	}
+	if (matches != 1) {
+		printf("PANDORA WLAN: cmd-db %s: %u VRM matches; not voting\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+/*
+ * PAND:736-825: one ACTIVE TCS carries the three commands of the vote
+ * (voltage, mode, enable); the RSC is triggered and reports completion in the
+ * TCS status and in each command's status. Only this TCS's interrupt enable bit
+ * is touched, and it is put back. The first call's outcome is kept, so a second
+ * call cannot arm a second request for the same rail.
+ */
+static int
+sy_rpmh_vote_res(const char *res, uint32_t mv, uint32_t mode, bool ldo)
+{
+	const struct sy_rpmh_layout *L = NULL;
+	uint32_t id = 0, config = 0, magic = 0, address = 0;
+	uint32_t major, minor, ntcs, ncpt, b = 0, bit = 0, irq_en = 0;
+	uint32_t word[3] = {0, 0, 0}, cs[3] = {0, 0, 0};
+	uint32_t vals[3] = {mv, SY_VRM_ENABLE, mode};
+	/* voltage, enable, mode: an LDO also gets its mode voted, an SMPS does not */
+	static const uint32_t offs[3] = {0, 4, 8};
+	unsigned t = 0;
+	unsigned ncmd = ldo ? 3u : 2u;
+	int chosen = -1, rc = 0;
+	bool done = false;
+
+	if (!sy_rsc) {
+		sy_rsc = ml_io_map(SY_RSC_PA, SY_RSC_SIZE);
+		sy_cmddb = ml_io_map(SY_CMDDB_PA, SY_CMDDB_SIZE);
+		if (!sy_rsc || !sy_cmddb) {
+			printf("PANDORA WLAN: RPMh: RSC/cmd-db mapping failed\n");
+			return ENOMEM;
+		}
+	}
+	id = sy_rd(sy_rsc, 0);
+	config = sy_rd(sy_rsc, 0x0c);
+	major = (id >> 16) & 0xffu;
+	minor = (id >> 8) & 0xffu;
+	ntcs = (config >> (6u * SY_RSC_DRV)) & 0x3fu;
+	ncpt = (config >> 27) & 0x1fu;
+	printf("PANDORA WLAN: RPMh: rsc=%#x id=%#x (v%u.%u) solver=%#x config=%#x tcs=%u ncpt=%u\n",
+	    SY_RSC_PA, id, major, minor, sy_rd(sy_rsc, 4), config, ntcs, ncpt);
+	/* Linux uses the 3.0 layout for every major >= 3 (PAND:751-756). */
+	L = major >= 3 ? &sy_rpmh_v3 : (major == 2 ? &sy_rpmh_v2 : NULL);
+	if (!L || ntcs < SY_TCS_ACTIVE || ntcs > 16 || ncpt < 3 || ncpt > 16) {
+		printf("PANDORA WLAN: RPMh: RSC v%u.%u layout/geometry not known (tcs %u, "
+		    "ncpt %u); not voting\n", major, minor, ntcs, ncpt);
+		rc = ENODEV;
+		goto out;
+	}
+	magic = sy_rd(sy_cmddb, 4);
+	printf("PANDORA WLAN: RPMh: cmd-db %#x size %#x version=%#x magic=%#x\n",
+	    SY_CMDDB_PA, SY_CMDDB_SIZE, sy_rd(sy_cmddb, 0), magic);
+	if (magic != SY_CMDDB_MAGIC) {
+		printf("PANDORA WLAN: RPMh: cmd-db magic %#x is not %#x; not voting\n",
+		    magic, SY_CMDDB_MAGIC);
+		rc = ENODEV;
+		goto out;
+	}
+	if ((rc = sy_rpmh_lookup(res, &address))) {
+		goto out;
+	}
+	for (t = 0; t < SY_TCS_ACTIVE; t++) {
+		b = SY_TCS_OFF + t * SY_TCS_STRIDE;
+		uint32_t st = sy_rd(sy_rsc, b + L->status), ctl = sy_rd(sy_rsc, b + L->control);
+		uint32_t en = sy_rd(sy_rsc, b + L->enable), wt = sy_rd(sy_rsc, b + L->wait);
+		printf("PANDORA WLAN: RPMh: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, st, ctl, en, wt);
+		if (chosen < 0 && st != 0 && st != 0xffffffffu && ctl == 0 && en == 0 && wt == 0 &&
+		    !(sy_rd(sy_rsc, SY_TCS_OFF + 4) & (1u << t))) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("PANDORA WLAN: RPMh: no free ACTIVE TCS; not voting\n");
+		rc = EBUSY;
+		goto out;
+	}
+	{
+		unsigned tc = (unsigned)chosen;
+		t = tc;
+		b = SY_TCS_OFF + tc * SY_TCS_STRIDE;
+		bit = 1u << tc;
+	}
+	irq_en = sy_rd(sy_rsc, SY_TCS_OFF);
+	if (!sy_rpmh_sync(SY_TCS_OFF, irq_en & ~bit)) {
+		printf("PANDORA WLAN: RPMh: IRQ enable readback failed (want %#x, got %#x)\n",
+		    irq_en & ~bit, sy_rd(sy_rsc, SY_TCS_OFF));
+		rc = EIO;
+		goto out;
+	}
+	for (unsigned c = 0; c < ncmd; c++) {
+		uint32_t cmd = b + c * L->cmd_stride;
+		word[c] = address + offs[c];
+		if (!sy_rpmh_sync(cmd + L->msgid, SY_RPMH_WRITE) ||
+		    !sy_rpmh_sync(cmd + L->addr, word[c]) ||
+		    !sy_rpmh_sync(cmd + L->data, vals[c])) {
+			printf("PANDORA WLAN: RPMh: command %u write failed: msgid %#x (want %#x), "
+			    "addr %#x (want %#x), data %#x (want %u); id=%#x (v%u.%u)\n", c,
+			    sy_rd(sy_rsc, cmd + L->msgid), SY_RPMH_WRITE,
+			    sy_rd(sy_rsc, cmd + L->addr), word[c],
+			    sy_rd(sy_rsc, cmd + L->data), vals[c], id, major, minor);
+			rc = EIO;
+			goto restore;
+		}
+	}
+	if (!sy_rpmh_sync(b + L->wait, (1u << ncmd) - 1u) ||
+	    !sy_rpmh_sync(b + L->enable, (1u << ncmd) - 1u) ||
+	    !sy_rpmh_sync(b + L->control, 0) || !sy_rpmh_sync(b + L->control, SY_RPMH_AMC)) {
+		printf("PANDORA WLAN: RPMh: TCS%u arm failed: wait=%#x enable=%#x control=%#x "
+		    "(want 7, 7, %#x), irq-enable=%#x, commands %#x/%#x/%#x = %u/%u/%u\n",
+		    t, sy_rd(sy_rsc, b + L->wait), sy_rd(sy_rsc, b + L->enable),
+		    sy_rd(sy_rsc, b + L->control), SY_RPMH_AMC, sy_rd(sy_rsc, SY_TCS_OFF),
+		    word[0], word[1], word[2], vals[0], vals[1], vals[2]);
+		rc = EIO;
+		goto restore;
+	}
+	sy_wr(sy_rsc, b + L->control, SY_RPMH_AMC | SY_RPMH_TRIGGER);
+	for (unsigned us = 0; us < 100000 && !done; us++) {
+		bool all = true;
+		for (unsigned c = 0; c < ncmd; c++) {
+			cs[c] = sy_rd(sy_rsc, b + L->cmd_status + c * L->cmd_stride);
+			all &= cs[c] != 0xffffffffu && (cs[c] & SY_RPMH_DONE) == SY_RPMH_DONE;
+		}
+		done = all && sy_rd(sy_rsc, b + L->status) != 0;
+		if (!done) {
+			delay(1);
+		}
+	}
+	printf("PANDORA WLAN: RPMh: %s %u mV/mode %u/enable on TCS%u done=%d irq=%#x "
+	    "status=%#x cmd-status=%#x/%#x/%#x\n", res, mv, mode, t, done,
+	    sy_rd(sy_rsc, SY_TCS_OFF + 4), sy_rd(sy_rsc, b + L->status),
+	    cs[0], cs[1], cs[2]);
+	if (!done) {
+		printf("PANDORA WLAN: RPMh: %s vote timed out: rsc id=%#x (v%u.%u), "
+		    "commands %#x/%#x/%#x = %u/%u/%u, control=%#x status=%#x\n", res, id,
+		    major, minor, word[0], word[1], word[2], vals[0], vals[1], vals[2],
+		    sy_rd(sy_rsc, b + L->control), sy_rd(sy_rsc, b + L->status));
+		rc = ETIMEDOUT;
+	}
+restore:
+	/* Proven or not, return the TCS to idle and put the interrupt mask back. */
+	(void)sy_rpmh_sync(b + L->control, SY_RPMH_AMC);
+	(void)sy_rpmh_sync(b + L->control, 0);
+	(void)sy_rpmh_sync(b + L->enable, 0);
+	(void)sy_rpmh_sync(b + L->wait, 0);
+	sy_wr(sy_rsc, SY_TCS_OFF + 8, bit);	/* W1C: only our TCS's bit */
+	(void)sy_rpmh_sync(SY_TCS_OFF, irq_en);
+out:
+	return rc;
+}
+
+
+/* The card's seven rails: live DT vdd-wlan-*-supply -> rpmh-regulator node ->
+ * qcom,resource-name and qcom,init-voltage; min/max are the regulator's range. */
+struct sy_supply {
+	const char *name, *what;
+	uint32_t mv, min_uv, max_uv;
+	bool ldo;
+};
+static const struct sy_supply sy_supplies[] = {
+	{ "S1J_E1", "vdd-wlan-cx (S1J, pmh0104 S1)", 852, 400000, 1000000, false },
+	{ "S2J_E1", "vdd-wlan-dig (S2J, pmh0104 S2)", 852, 500000, 1100000, false },
+	{ "L3G_E0", "vdd-wlan-io12 (L3G, pmh0110 G L3)", 1200, 1200000, 1200000, true },
+	{ "L2G_E0", "vdd-wlan-aon (L2G, pmh0110 G L2)", 1800, 1800000, 1800000, true },
+	{ "S8F_E0", "vdd-wlan-rfa1 (S8F, pmh0110 F S8)", 1856, 1800000, 2000000, false },
+	{ "S7F_E0", "vdd-wlan-rfa2 (S7F, pmh0110 F S7)", 1256, 1224000, 1372000, false },
+	{ "L3K_E1", "vdd-wlan-ant-share (L3K, pmr735d L3)", 1200, 1200000, 1200000, true },
+};
+
+static bool
+sy_supplies_on(void)
+{
+	for (unsigned i = 0; i < SY_SUPPLY_N; i++) {
+		const struct sy_supply *s = &sy_supplies[i];
+		int rc;
+
+		printf("PANDORA WLAN: voting %s (%s) at %u mV%s\n", s->name, s->what,
+		    s->mv, s->ldo ? " LDO" : " SMPS");
+		if (s->mv * 1000 < s->min_uv || s->mv * 1000 > s->max_uv) {
+			printf("PANDORA WLAN: %u mV for %s is outside %u-%u uV\n", s->mv,
+			    s->name, s->min_uv, s->max_uv);
+			return false;
+		}
+		rc = sy_rpmh_vote_res(s->name, s->mv, s->ldo ? 7 : 0, s->ldo);
+		if (rc != 0) {
+			printf("PANDORA WLAN: the vote for %s failed (%d)\n", s->name, rc);
+			return false;
+		}
+		printf("PANDORA WLAN: %s on at %u mV\n", s->name, s->mv);
+	}
+	return true;
+}
+
+/* ---- power domains and clocks -------------------------------------------------- */
+
+static bool
+sy_gdsc_on(uint32_t gdscr, const char *name)
+{
+	if (sy_gcc_rd(gdscr) & GDSC_PWR_ON) {
+		printf("PANDORA WLAN: %s already on (%#x)\n", name, sy_gcc_rd(gdscr));
+		return true;
+	}
+	sy_gcc_wr(gdscr, sy_gcc_rd(gdscr) & ~GDSC_SW_COLLAPSE);
+	return sy_gcc_poll(gdscr + GCC_GDSC_CFG, GDSC_PWR_UP_DONE, GDSC_PWR_UP_DONE, 50, 2000,
+	    name);
+}
+
+static bool
+sy_rcg_set(uint32_t rcg, uint32_t cfg, const char *name)
+{
+	sy_gcc_wr(rcg, sy_gcc_rd(rcg) | RCG_ROOT_EN);
+	if (!sy_gcc_poll(rcg, RCG_ROOT_OFF, 0, 10, 500, name)) {
+		return false;
+	}
+	sy_gcc_wr(rcg + 4, cfg);
+	sy_gcc_wr(rcg, sy_gcc_rd(rcg) | RCG_UPDATE);
+	if (!sy_gcc_poll(rcg, RCG_UPDATE, 0, 10, 500, name)) {
+		return false;
+	}
+	sy_gcc_wr(rcg, sy_gcc_rd(rcg) & ~RCG_ROOT_EN);
+	return true;
+}
+
+static bool
+sy_clocks_on(void)
+{
+	static const uint32_t branches[] = {
+		GCC_SLV_AXI, GCC_MSTR_AXI, GCC_CFG_AHB, GCC_AUX, GCC_Q2A, GCC_CNOC_SF
+	};
+
+	if (!sy_gdsc_on(GCC_GDSC_PCIE, "root complex 0's power domain") ||
+	    !sy_gdsc_on(GCC_GDSC_PHY, "the PHY's power domain")) {
+		return false;
+	}
+	/* aux: bi_tcxo (parent 0 in gcc_parent_map_6), no divider -> 19.2 MHz */
+	if (!sy_rcg_set(GCC_AUX_RCG, 0x000, "aux at 19.2 MHz")) {
+		return false;
+	}
+	sy_wr(tcsr, SY_TCSR_CLKREF, sy_rd(tcsr, SY_TCSR_CLKREF) | 1);
+	sy_usleep(10);
+	sy_gcc_wr(GCC_VOTE_BRANCH, sy_gcc_rd(GCC_VOTE_BRANCH) | 0x6f);	/* slv/mstr/cfg/aux/q2a/cnoc_sf, pipe added with the PHY */
+	sy_gcc_wr(GCC_VOTE_BRANCH2, sy_gcc_rd(GCC_VOTE_BRANCH2) |
+	    (1UL << 12) | (1UL << 19) | (1UL << 22));
+	for (unsigned i = 0; i < (sizeof(branches) / sizeof(branches[0])); i++) {
+		if (!sy_gcc_poll(branches[i], CBCR_CLK_OFF, 0, 10, 1000, "a PCIe clock branch")) {
+			printf("PANDORA WLAN: branch at GCC %#x stays off\n", branches[i]);
+			return false;
+		}
+	}
+	printf("PANDORA WLAN: domains on; aux, reference and branch clocks running\n");
+	return true;
+}
+
+/* ---- pins (port-proven TLMM CTL layout) ---------------------------------------- */
+
+/* TLMM CTL low bits: pull [1:0], func [5:2], drive [8:6], OE [9]; EGPIO present [11],
+ * enable [12]. The port's proven sy_gpio() keeps everything above the low mask and mirrors
+ * ENABLE from whatever PRESENT the boot chain left, so the pad is never re-purposed. */
+static vm_offset_t
+sy_pin_reg(uint32_t pin, uint32_t add)
+{
+	if (pin >= 16 && pin <= 19) {
+		return tlmm_low + (pin - 16) * 0x1000UL + add;
+	}
+	return tlmm + (pin - 102) * 0x1000UL + add;
+}
+
+static void
+sy_pin_ctl(uint32_t pin, uint32_t low)
+{
+	vm_offset_t ctl = sy_pin_reg(pin, 0);
+	uint32_t old = *(volatile uint32_t *)ctl;
+	uint32_t value = (old & ~(0x3ffu | (1u << 12))) | (low & 0x3ffu);
+
+	if (old & (1u << 11)) {
+		value |= (1u << 12);
+	}
+	*(volatile uint32_t *)ctl = value;
+}
+
+static void
+sy_pin_level(uint32_t pin, uint32_t level)
+{
+	*(volatile uint32_t *)sy_pin_reg(pin, 4) = level;
+}
+
+static void
+sy_pin_out(uint32_t pin, uint32_t low)
+{
+	sy_pin_level(pin, 0);	/* level before the output enable, so the pin never glitches */
+	sy_pin_ctl(pin, low);
+}
+
+/* ---- PARF, PHY, root port, link ------------------------------------------------ */
+
+static void
+sy_parf_setup(void)
+{
+	sy_wr(parf, PARF_DEVICE_TYPE, 0x4);			/* root complex */
+	sy_wr(parf, PARF_PHY_CTRL, sy_rd(parf, PARF_PHY_CTRL) & ~1UL);
+	sy_wr(parf, PARF_DBI_BASE, (uint32_t)SY_DBI_PA);
+	sy_wr(parf, PARF_DBI_BASE + 4, 0);
+	sy_wr(parf, PARF_ATU_BASE, (uint32_t)SY_IATU_PA);
+	sy_wr(parf, PARF_ATU_BASE + 4, (uint32_t)(SY_IATU_PA >> 32));
+	sy_wr(parf, PARF_SYS_CTRL, 0x365e);	/* pci-msm.c msm_pcie_enable_link */
+	sy_wr(parf, 0x174, sy_rd(parf, 0x174) | (1UL << 4));	/* MHI_CLOCK_RESET_CTRL bypass */
+	sy_wr(parf, 0x020, sy_rd(parf, 0x020) & ~(1UL << 5));	/* PM_CTRL: no L1 entry */
+	sy_wr(parf, 0x1a8, sy_rd(parf, 0x1a8) | (1UL << 31));	/* AXI_MSTR_WR_ADDR_HALT */
+	sy_wr(parf, PARF_CLKREQ_SEL, sy_rd(parf, PARF_CLKREQ_SEL) & ~1UL);
+	printf("PANDORA WLAN: PARF glue set (device type, DBI/ATU base, L1 policy)\n");
+}
+
+static bool
+sy_phy_start(void)
+{
+	/* pci-msm.c pcie_phy_init: the device tree sequence is written in order (its last
+	 * entries are the PCS SW_RESET and START_CONTROL writes), the PHY is given time to
+	 * stabilise, then the pipe clock is enabled and PHYSTATUS is awaited (bit set = the
+	 * PHY is not ready). */
+	for (unsigned i = 0; i < SY_PHY_ROWS; i++) {
+		sy_wr(phy, sy_phy_seq[i][0], sy_phy_seq[i][1]);
+	}
+	sy_usleep(1000);
+	sy_gcc_wr(GCC_PIPE_MUX, sy_gcc_rd(GCC_PIPE_MUX) & ~3UL);	/* the PHY's pipe clock */
+	sy_gcc_wr(GCC_VOTE_BRANCH, sy_gcc_rd(GCC_VOTE_BRANCH) | (1UL << 4));
+	if (!sy_gcc_poll(GCC_PIPE, CBCR_CLK_OFF, 0, 10, 1000, "the pipe clock")) {
+		return false;
+	}
+	if (!sy_poll(phy, PHY_STATUS, PHY_STATUS_BIT, 0, 200, 200000, "the PHY's PHYSTATUS")) {
+		return false;
+	}
+	printf("PANDORA WLAN: PHY started (%u writes), pipe clock running\n",
+	    (unsigned)SY_PHY_ROWS);
+	return true;
+}
+
+static void
+sy_root_port_setup(void)
+{
+	sy_wr(dbi, 0x8bc, sy_rd(dbi, 0x8bc) | 1);		/* DBI RO write enable */
+	sy_wr(dbi, 0x10, 0x4);					/* BAR0: 64-bit memory */
+	sy_wr(dbi, 0x14, 0);
+	sy_wr(dbi, 0x3c, (sy_rd(dbi, 0x3c) & 0xffff00ffUL) | 0x100);
+	sy_wr(dbi, 0x18, (sy_rd(dbi, 0x18) & 0xff000000UL) | 0x00ff0100UL);	/* bus 0/1..255 */
+	sy_wr(dbi, 0x04, sy_rd(dbi, 0x04) | 0x107);
+	sy_wr(dbi, 0x08, (sy_rd(dbi, 0x08) & 0x0000ffffUL) | (0x0604UL << 16));	/* class bridge */
+	sy_wr(dbi, 0xa0, (sy_rd(dbi, 0xa0) & ~0xfUL) | 1);	/* target link speed Gen1 */
+	sy_wr(dbi, 0x8bc, sy_rd(dbi, 0x8bc) & ~1UL);
+}
+
+static bool
+sy_link_wait(void)
+{
+	unsigned ltssm = sy_rd(parf, PARF_LTSSM) & 0x3f;
+
+	printf("PANDORA WLAN: LTSSM before enable %#x\n", ltssm);
+	sy_wr(parf, PARF_LTSSM, sy_rd(parf, PARF_LTSSM) | PARF_LTSSM_EN);
+	for (unsigned i = 0; i < 500; i++) {
+		uint32_t status = sy_rd(dbi, DBI_LINKCTRLSTATUS);
+		ltssm = sy_rd(parf, PARF_LTSSM) & 0x3f;
+
+		if ((status & LINK_ACTIVE) && ltssm == 0x11) {
+			printf("PANDORA WLAN: link up: LTSSM %#x, link status %#x (%u ms)\n",
+			    ltssm, status, i * 10);
+			return true;
+		}
+		sy_usleep(10000);
+	}
+	printf("PANDORA WLAN: link did not come up; LTSSM %#x, link status %#x\n",
+	    sy_rd(parf, PARF_LTSSM) & 0x3f, sy_rd(dbi, DBI_LINKCTRLSTATUS));
+	return false;
+}
+
+static void
+sy_iatu_ecam(void)
+{
+	sy_wr(iatu, IATU_CTRL2(0), 0);
+	sy_wr(iatu, IATU_CTRL1(0), IATU_TYPE_CFG0);
+	sy_wr(iatu, IATU_LBAR(0), (uint32_t)SY_CONF_PA);
+	sy_wr(iatu, IATU_UBAR(0), 0);
+	sy_wr(iatu, IATU_LAR(0), (uint32_t)(SY_CONF_PA + 0xfffff));
+	sy_wr(iatu, IATU_CTRL2(0), IATU_ENABLE | IATU_CFG_SHIFT);
+	/* pci-msm.c msm_pcie_iatu_setup_ecam_blocker: point ECAM at the DBI base and block
+	 * every function of bus 0 except the root port's own config space. */
+	sy_wr(parf, PARF_ECAM_BASE, (uint32_t)SY_DBI_PA);
+	sy_wr(parf, PARF_ECAM_BASE + 4, 0);
+	sy_wr(parf, 0x360, (uint32_t)SY_DBI_PA + 0x1000);	/* BLOCK_SLV_AXI_WR_BASE */
+	sy_wr(parf, 0x364, 0);
+	sy_wr(parf, 0x370, (uint32_t)SY_DBI_PA + 0x1000);	/* BLOCK_SLV_AXI_RD_BASE */
+	sy_wr(parf, 0x374, 0);
+	sy_wr(parf, 0x368, (uint32_t)SY_DBI_PA + 0xfffff);	/* WR limit */
+	sy_wr(parf, 0x36c, 0);
+	sy_wr(parf, 0x378, (uint32_t)SY_DBI_PA + 0xfffff);	/* RD limit */
+	sy_wr(parf, 0x37c, 0);
+	sy_wr(parf, PARF_SYS_CTRL, 0x04000000);		/* PCIE_ECAM_BLOCKER_EN */
+	printf("PANDORA WLAN: ECAM window %#lx via iATU region 0 (CFG0, cfg-shift), blocker set\n",
+	    (unsigned long)SY_CONF_PA);
+}
+
+static bool
+sy_config_read(void)
+{
+	uint32_t id = sy_rd(conf, 0);
+
+	printf("PANDORA WLAN: endpoint config[0] = %#x -> vendor %#x device %#x\n", id,
+	    id & 0xffff, id >> 16);
+	if ((id & 0xffff) == 0x17cb && (id >> 16) == 0x110e) {
+		return true;
+	}
+	return false;
+}
+
+/* ---- the run ------------------------------------------------------------------- */
+
+static void
+sy_dump_state(void)
+{
+	printf("PANDORA WLAN: state: pcie0 gdsc %#x/%#x phy gdsc %#x/%#x\n",
+	    sy_gcc_rd(GCC_GDSC_PCIE), sy_gcc_rd(GCC_GDSC_PCIE + 4),
+	    sy_gcc_rd(GCC_GDSC_PHY), sy_gcc_rd(GCC_GDSC_PHY + 4));
+	printf("PANDORA WLAN: state: votes br %#x br2 %#x rscc %#x aux-halt %#x pipe-halt %#x\n",
+	    sy_gcc_rd(GCC_VOTE_BRANCH), sy_gcc_rd(GCC_VOTE_BRANCH2),
+	    sy_gcc_rd(GCC_VOTE_RSCC), sy_gcc_rd(GCC_AUX), sy_gcc_rd(GCC_PIPE));
+	if (sy_gcc_rd(GCC_GDSC_PHY) & GDSC_PWR_ON) {
+		printf("PANDORA WLAN: state: clkref %#x parf sys %#x ltssm %#x phy%#x %#x\n",
+		    sy_rd(tcsr, SY_TCSR_CLKREF), sy_rd(parf, PARF_SYS_CTRL), sy_rd(parf, PARF_LTSSM),
+		    PHY_STATUS, sy_rd(phy, PHY_STATUS));
+	} else {
+		printf("PANDORA WLAN: state: clkref %#x parf sys %#x ltssm %#x (PHY domain down)\n",
+		    sy_rd(tcsr, SY_TCSR_CLKREF), sy_rd(parf, PARF_SYS_CTRL), sy_rd(parf, PARF_LTSSM));
+	}
+	if ((sy_gcc_rd(GCC_GDSC_PCIE) & GDSC_PWR_ON) &&
+	    (sy_gcc_rd(GCC_GDSC_PHY) & GDSC_PWR_ON)) {
+		printf("PANDORA WLAN: state: dbi reglen %#x ver %#x bhi %#x bhie %#x ctrl %#x status %#x\n",
+		    sy_rd(dbi, 0x00), sy_rd(dbi, 0x08), sy_rd(dbi, 0x28), sy_rd(dbi, 0x2c),
+		    sy_rd(dbi, 0x38), sy_rd(dbi, 0x48));
+		printf("PANDORA WLAN: state: link status %#x\n", sy_rd(dbi, DBI_LINKCTRLSTATUS));
+	} else {
+		printf("PANDORA WLAN: state: DBI not read (power domains are down)\n");
+	}
+}
+
+static void
+sy_run(void)
+{
+	bool ok;
+
+	printf("PANDORA WLAN: step %u: mapping windows\n", sy_step);
+	parf = ml_io_map(SY_PARF_PA, SY_PARF_SIZE);
+	phy = ml_io_map(SY_PHY_PA, SY_PHY_SIZE);
+	dbi = ml_io_map(SY_DBI_PA, SY_DBI_SIZE);
+	iatu = ml_io_map(SY_IATU_PA, SY_IATU_SIZE);
+	conf = ml_io_map(SY_CONF_PA, SY_CONF_SIZE);
+	gcc_low = ml_io_map(SY_GCC_LOW_PA, SY_GCC_LOW_SIZE);
+	gcc = ml_io_map(SY_GCC_PA, SY_GCC_SIZE);
+	tlmm_low = ml_io_map(SY_TLMM_LOW_PA, SY_TLMM_LOW_SIZE);
+	tlmm = ml_io_map(SY_TLMM_PA, SY_TLMM_SIZE);
+	tcsr = ml_io_map(SY_TCSR_PA, SY_TCSR_SIZE);
+	rsc = ml_io_map(SY_RSC_PA, SY_RSC_SIZE);
+	cmddb = ml_io_map_wcomb(SY_CMDDB_PA, SY_CMDDB_SIZE);
+	if (!parf || !phy || !dbi || !iatu || !conf || !gcc_low || !gcc || !tlmm_low ||
+	    !tlmm || !tcsr || !rsc || !cmddb) {
+		printf("PANDORA WLAN: a window cannot be mapped\n");
+		return;
+	}
+	sy_rsc = rsc;	/* the RPMh block reuses these two mappings */
+	sy_cmddb = cmddb;
+	printf("PANDORA WLAN: windows mapped\n");
+	sy_dump_state();
+	if (sy_step < 2) {
+		return;
+	}
+
+	printf("PANDORA WLAN: step %u: PERST and WLAN_EN low, supplies\n", sy_step);
+	sy_pin_out(PIN_PERST, CTL_OUT_LOW_2MA);
+	sy_pin_out(PIN_WLAN_EN, CTL_OUT_LOW_8MA);
+	if (!sy_supplies_on()) {
+		return;
+	}
+
+	printf("PANDORA WLAN: step %u: clocks\n", sy_step);
+	if (!sy_clocks_on()) {
+		return;
+	}
+	printf("PANDORA WLAN: step %u: resets and PARF\n", sy_step);
+	sy_gcc_wr(GCC_BCR_PCIE, sy_gcc_rd(GCC_BCR_PCIE) | 1);
+	sy_gcc_wr(GCC_BCR_PHY, sy_gcc_rd(GCC_BCR_PHY) | 1);
+	sy_usleep(1000);
+	sy_gcc_wr(GCC_BCR_PHY, sy_gcc_rd(GCC_BCR_PHY) & ~1UL);
+	sy_gcc_wr(GCC_BCR_PCIE, sy_gcc_rd(GCC_BCR_PCIE) & ~1UL);
+	sy_usleep(1000);
+	sy_parf_setup();
+	if (sy_step < 4) {
+		return;
+	}
+
+	printf("PANDORA WLAN: step %u: the PHY\n", sy_step);
+	if (!sy_phy_start()) {
+		return;
+	}
+	if (sy_step < 5) {
+		return;
+	}
+
+	printf("PANDORA WLAN: step %u: the card's enable, root port, PERST release\n", sy_step);
+	sy_pin_level(PIN_WLAN_EN, IO_HIGH);
+	delay_for_interval(50, NSEC_PER_MSEC);
+	sy_pin_ctl(PIN_CLKREQ, CTL_CLKREQ_FUNC);
+	sy_pin_ctl(PIN_WAKE, CTL_IN_PULL_UP);
+	printf("PANDORA WLAN: sw-ctrl pins read %u %u\n",
+	    (unsigned)(*(volatile uint32_t *)sy_pin_reg(18, 4) & 1),
+	    (unsigned)(*(volatile uint32_t *)sy_pin_reg(19, 4) & 1));
+	sy_root_port_setup();
+	delay_for_interval(50, NSEC_PER_MSEC);
+	sy_pin_level(PIN_PERST, IO_HIGH);
+	ok = sy_link_wait();
+	if (!ok) {
+		return;
+	}
+	if (sy_step < 6) {
+		return;
+	}
+
+	printf("PANDORA WLAN: step %u: ECAM and the endpoint\n", sy_step);
+	sy_iatu_ecam();
+	if (sy_config_read()) {
+		printf("PANDORA WLAN: M1 DONE: 17cb:110e answers on PCIe0\n");
+	} else {
+		printf("PANDORA WLAN: ECAM read did not return the endpoint\n");
+	}
+}
+
+static void
+sy_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	printf("PANDORA WLAN: thread, step %u\n", sy_step);
+	delay_for_interval(6000, NSEC_PER_MSEC);
+	sy_run();
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+pandora_wlan_init(void)
+{
+	int step = 0;
+
+	if (!PE_parse_boot_argn("songyuan_wlan", &step, sizeof(step)) || step <= 0) {
+		return;
+	}
+	sy_step = (unsigned)step;
+	thread_t th;
+
+	if (kernel_thread_start_priority((thread_continue_t)sy_thread, NULL, 80, &th) ==
+	    KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
+
 void
 pandora_cachevol_start(void)
 {
 	thread_t thread;
+	pandora_wlan_init();	/* M1: PCIe RC0 bring-up, boot-arg songyuan_wlan */
 	if (kernel_thread_start(pandora_cachevol_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
