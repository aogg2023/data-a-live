+
+/* ---- PCIe0 NoC (BCM) vote, exactly as the locally working sheng WCN7850 port ----
+ * UniXNU-sheng bsd/dev/WifiProbe.cpp: "The endpoint's DMA runs over the PCIe
+ * NoC, whose bus clock manager (SN7) the interconnect driver votes for when the
+ * link is brought up (pcie-mem path, always tag); nothing has done that here."
+ * Without this vote register access works but the device's DMA does not, which is
+ * exactly the failure this driver has been seeing (BHI error, no SMMU fault).
+ * cmd-db is parsed with the same structure as pandora_gpu.c cmddb_find(). */
+struct sy_rh_cmd { uint32_t addr, data, wait; };
+
+static int
+sy_cmddb_find(const char *name, uint32_t *addr, uint32_t *unit, uint32_t *width, uint32_t *levels)
+{
+	uint32_t key[2] = { 0, 0 };
+	uint32_t i, j;
+
+	if (!sy_cmddb)
+		return ENOENT;
+	for (i = 0; i < 8 && name[i]; i++)
+		key[i / 4] |= (uint32_t)(uint8_t)name[i] << (8u * (i % 4));
+	for (i = 0; i < 8; i++) {
+		uint32_t h = 8u + 16u * i, entries, data, count;
+
+		if (!sy_cmddb16(h))
+			break;
+		entries = 144 + sy_cmddb16(h + 2);
+		data = 144 + sy_cmddb16(h + 4);
+		count = sy_cmddb16(h + 6);
+		for (j = 0; j < count && entries + 24 * (j + 1) <= 0x20000; j++) {
+			uint32_t e = entries + 24 * j;
+
+			if (sy_rd(sy_cmddb, e) != key[0] || sy_rd(sy_cmddb, e + 4) != key[1])
+				continue;
+			*addr = sy_rd(sy_cmddb, e + 16);
+			{
+				uint32_t auxlen = sy_cmddb16(e + 20);
+				uint32_t aux = data + sy_cmddb16(e + 22);
+				uint32_t k;
+
+				*unit = 0; *width = 0;
+				for (k = 0; k < 16; k++)
+					levels[k] = 0;
+				for (k = 0; k + 2 <= auxlen && k < 32 && aux + k + 2 <= 0x20000; k += 2)
+					levels[k / 2] = sy_cmddb16(aux + k);
+				*unit = levels[0] | (uint32_t)levels[1] << 16;
+				*width = levels[2];
+			}
+			return 0;
+		}
+	}
+	return ENOENT;
+}
+
+static uint32_t
+sy_rpmh_send_cmds(const struct sy_rh_cmd *cmds, unsigned n)
+{
+	/* Try the PCIe rail set (TCS2) first, then the sets the fuxi WCN7850 port used
+	 * for its BCM votes (TCS0/TCS1). The first idle set after clearing our own
+	 * stale IRQ bit is used; nothing outside our bit is touched. */
+	static const uint32_t tries[3] = { 2u, 0u, 1u };
+	const struct sy_rpmh_layout *L = &sy_rpmh_v3;
+	uint32_t t = 2, b = 0, bit = 0, wait = 0, done = 0, idx;
+	unsigned c, us;
+
+	if (!sy_rsc || !n || n > 8)
+		return 1;
+	for (idx = 0; idx < 3u; idx++) {
+		unsigned attempt;
+
+		t = tries[idx];
+		b = SY_TCS_OFF + t * SY_TCS_STRIDE;
+		bit = 1u << t;
+		for (attempt = 0; attempt < 2; attempt++) {
+			uint32_t st = sy_rd(sy_rsc, SY_TCS_OFF + 4);
+
+			if (!sy_rd(sy_rsc, b + L->control) && !sy_rd(sy_rsc, b + L->enable) &&
+			    !sy_rd(sy_rsc, b + L->wait) && !(st & bit))
+				break;
+			printf("PANDORA WLAN: ICC/RPMh TCS%u busy: control %#x enable %#x wait %#x irq %#x\n",
+			    t, sy_rd(sy_rsc, b + L->control), sy_rd(sy_rsc, b + L->enable),
+			    sy_rd(sy_rsc, b + L->wait), st);
+			sy_wr(sy_rsc, SY_TCS_OFF + 8, bit);
+			(void)sy_rpmh_sync(b + L->control, 0);
+			(void)sy_rpmh_sync(b + L->enable, 0);
+			(void)sy_rpmh_sync(b + L->wait, 0);
+			for (us = 0; us < 20 && (sy_rd(sy_rsc, SY_TCS_OFF + 4) & bit); us++)
+				delay(1);
+		}
+		if (!sy_rd(sy_rsc, b + L->control) && !sy_rd(sy_rsc, b + L->enable) &&
+		    !sy_rd(sy_rsc, b + L->wait) && !(sy_rd(sy_rsc, SY_TCS_OFF + 4) & bit))
+			break;
+	}
+	if (idx == 3u) {
+		printf("PANDORA WLAN: ICC/RPMh: no idle TCS (2/0/1) for the BCM batch\n");
+		return 1;
+	}
+	printf("PANDORA WLAN: ICC/RPMh: using TCS%u for the BCM batch\n", t);
+	sy_wr(sy_rsc, b + L->control, 0);
+	sy_wr(sy_rsc, SY_TCS_OFF + 8, bit);
+	for (c = 0; c < n; c++) {
+		uint32_t q = b + c * L->cmd_stride;
+
+		sy_wr(sy_rsc, q + L->msgid, 8u | (1u << 16) | (1u << 8));
+		sy_wr(sy_rsc, q + L->addr, cmds[c].addr);
+		sy_wr(sy_rsc, q + L->data, cmds[c].data);
+		if (cmds[c].wait)
+			wait |= 1u << c;
+	}
+	sy_wr(sy_rsc, b + L->wait, wait);
+	sy_wr(sy_rsc, b + L->enable, (1u << n) - 1u);
+	sy_wr(sy_rsc, SY_TCS_OFF, sy_rd(sy_rsc, SY_TCS_OFF) | bit);
+	sy_wr(sy_rsc, b + L->control, SY_RPMH_AMC);
+	sy_wr(sy_rsc, b + L->control, SY_RPMH_AMC | SY_RPMH_TRIGGER);
+	for (us = 0; us < 10000 && !done; us++) {
+		bool all = (sy_rd(sy_rsc, SY_TCS_OFF + 4) & bit) != 0;
+
+		done = all && sy_rd(sy_rsc, b + L->status) != 0;
+		if (!done)
+			delay(1);
+	}
+	(void)sy_rpmh_sync(b + L->control, SY_RPMH_AMC);
+	(void)sy_rpmh_sync(b + L->control, 0);
+	(void)sy_rpmh_sync(b + L->enable, 0);
+	(void)sy_rpmh_sync(b + L->wait, 0);
+	sy_wr(sy_rsc, SY_TCS_OFF + 8, bit);
+	sy_wr(sy_rsc, SY_TCS_OFF, sy_rd(sy_rsc, SY_TCS_OFF) & ~bit);
+	return done ? 0 : 2;
+}
+
+static void
+sy_icc_vote(void)
+{
+	/* Linux v6.x drivers/interconnect/qcom/kuno.c (SM8850, "Kuno") is the
+	 * authority for this SoC. The PCIe path is voted through:
+	 *   pcie_anoc:  bcm_sn1 "SN1" -> xm_pcie3_0 (MASTER_PCIE_0)
+	 *   mem_noc:    bcm_sh1 "SH1" -> qns_memnoc_cnoc, qns_pcie
+	 *   system_noc: bcm_sn7 "SN7" -> xs_pcie_0 (SLAVE_PCIE_0)
+	 * The sheng WCN7850 port votes the equivalent NoC BCM before the endpoint
+	 * DMA; without it register access works but DMA does not. Bandwidth is
+	 * encoded like bcm-voter/sheng: commit|valid|avg<<14|peak (14-bit each). */
+	static const char *const names[] = { "SN1", "SN7", "SH1" };
+	static int enabled = -1, failed;
+	struct sy_rh_cmd cmds[3];
+	unsigned n = 0, i;
+	uint32_t levels[16];
+
+	if (enabled < 0) {
+		(void)PE_parse_boot_argn("songyuan_icc", &enabled, sizeof(enabled));
+		if (enabled < 0)
+			enabled = 1;
+		printf("PANDORA WLAN: ICC: songyuan_icc=%d (kuno.c PCIe BCMs SN1/SN7/SH1)\n", enabled);
+	}
+	if (!enabled || failed)
+		return;
+	for (i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		uint32_t addr = 0, unit = 0, width = 0, vote = 0x400;
+
+		if (sy_cmddb_find(names[i], &addr, &unit, &width, levels)) {
+			printf("PANDORA WLAN: ICC: cmd-db %s not found\n", names[i]);
+			continue;
+		}
+		if (unit && width) {
+			const uint64_t kBps = 2000000;
+			uint64_t scaled = (kBps * width + 15) / 16;
+			uint64_t x = (scaled * 1000 + unit - 1) / unit;
+
+			vote = x < 1 ? 1 : x > 0x3fff ? 0x3fff : (uint32_t)x;
+		}
+		printf("PANDORA WLAN: ICC %s addr %#x unit %u width %u vote %u\n",
+		    names[i], addr, unit, width, vote);
+		cmds[n].addr = addr;
+		cmds[n].data = (1u << 30) | (1u << 29) | (vote << 14) | vote;
+		cmds[n].wait = 1;
+		n++;
+	}
+	if (!n) {
+		failed = 1;
+		printf("PANDORA WLAN: ICC: no BCM resource found; no vote sent\n");
+		return;
+	}
+	cmds[n - 1].data |= (1u << 30);		/* last command commits */
+	{
+		uint32_t e = sy_rpmh_send_cmds(cmds, n);
+
+		for (i = 0; i < n; i++)
+			printf("PANDORA WLAN: ICC vote addr %#x data %#x\n", cmds[i].addr, cmds[i].data);
+		printf("PANDORA WLAN: ICC vote batch result %u (0 = acknowledged)\n", e);
+		if (e)
+			failed = 1;
+	}
+	sy_log_sync();
+}
