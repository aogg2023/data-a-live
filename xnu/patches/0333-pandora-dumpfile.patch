+
+/* 0333/0334/0336: diagnostic read-back for the console log. Boot-arg pandora_dumpfile takes a
+ * comma separated list of absolute paths; a directory is listed, a file is printed as text.
+ * pandora_dumpmatch=<substring> limits listings to matching names. pandora_dumpnewest=<dir>,<prefix>
+ * prints the newest (mtime) matching file's content. Read only.
+ *
+ * HFS+ gives readdir entries in either the 32-bit or the 64-bit dirent layout depending on the
+ * call; d_reclen (at offset 4 or 16) is the packed step, d_namlen (at 7 or 18) the name length.
+ * The layout is detected from the first entry, so the walk stays aligned for both. */
+#define PF_NAME_MAX 255
+static void
+pf_dump_text(const char *tag, const uint8_t *b, unsigned n)
+{
+	char line[200];
+	unsigned at = 0;
+	for (unsigned i = 0; i < n; i++) {
+		char c = (char)b[i];
+		if (c == '\r') {
+			continue;
+		}
+		if (c == '\n' || at >= sizeof(line) - 1) {
+			line[at] = 0;
+			printf("PANDORA DUMP: %s %s\n", tag, line);
+			at = 0;
+			continue;
+		}
+		line[at++] = (c >= 32 && c < 127) ? c : '.';
+	}
+	if (at) {
+		line[at] = 0;
+		printf("PANDORA DUMP: %s %s\n", tag, line);
+	}
+}
+
+static int
+pf_contains(const char *hay, const char *needle)
+{
+	size_t n = strlen(needle);
+	if (n == 0) {
+		return 1;
+	}
+	for (const char *p = hay; *p; p++) {
+		if (strncmp(p, needle, n) == 0) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static int
+pf_walk_dir(vnode_t vp, vfs_context_t ctx, uint8_t *buf, unsigned cap, unsigned *used, int *num)
+{
+	uio_t auio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+	if (auio == NULL) {
+		return ENOMEM;
+	}
+	uio_addiov(auio, (uintptr_t)buf, cap);
+	int eofflag = 0;
+	*num = 0;
+	int error = VNOP_READDIR(vp, auio, 0, &eofflag, num, ctx);
+	*used = cap - (unsigned)uio_resid(auio);
+	uio_free(auio);
+	return error;
+}
+
+/* Copy the entry names out of a readdir buffer, one name per slot. Returns the count. */
+static unsigned
+pf_names(uint8_t *buf, unsigned used, char (*names)[256], unsigned max, int *ext_out)
+{
+	unsigned off = 0, n = 0;
+	int ext = -1;
+	if (used < 24) {
+		*ext_out = -1;
+		return 0;
+	}
+	/* detect the layout from the first entry's d_reclen / name */
+	{
+		unsigned reclen32 = *(uint16_t *)(void *)(buf + 4);
+		unsigned reclen64 = *(uint16_t *)(void *)(buf + 16);
+		if (reclen32 >= 8 && reclen32 <= used && buf[7] >= 1 && buf[7] <= 255 &&
+		    buf[8] == '.') {
+			ext = 0;
+		} else if (reclen64 >= 8 && reclen64 <= used && *(uint16_t *)(void *)(buf + 18) >= 1 &&
+		    *(uint16_t *)(void *)(buf + 18) <= 255 && buf[21] == '.') {
+			ext = 1;
+		} else {
+			ext = (reclen64 >= 8 && reclen64 <= used) ? 1 : 0;
+		}
+	}
+	while (off + 8 < used && n < max) {
+		unsigned reclen, namlen;
+		const char *name;
+		if (ext) {
+			if (off + 21 > used) {
+				break;
+			}
+			reclen = *(uint16_t *)(void *)(buf + off + 16);
+			namlen = *(uint16_t *)(void *)(buf + off + 18);
+			name = (const char *)(buf + off + 21);
+		} else {
+			if (off + 8 > used) {
+				break;
+			}
+			reclen = *(uint16_t *)(void *)(buf + off + 4);
+			namlen = (unsigned)*(uint8_t *)(buf + off + 7);
+			name = (const char *)(buf + off + 8);
+		}
+		if (reclen < 8 || off + reclen > used) {
+			break;
+		}
+		if (namlen > PF_NAME_MAX) {
+			namlen = PF_NAME_MAX;
+		}
+		/* keep the name inside the record */
+		if ((ext ? 21u : 8u) + namlen > reclen) {
+			namlen = reclen - (ext ? 21u : 8u);
+		}
+		if (namlen > 0 && (reclen > 0)) {
+			unsigned k;
+			for (k = 0; k < namlen; k++) {
+				names[n][k] = name[k];
+			}
+			names[n][k] = 0;
+			n++;
+		}
+		off += reclen;
+	}
+	*ext_out = ext;
+	return n;
+}
+
+static void
+pf_dump_dir(vnode_t vp, const char *path, vfs_context_t ctx)
+{
+	uint8_t *buf = kalloc_data(262144, Z_WAITOK);
+	char (*names)[256] = kalloc_data(2048 * 256, Z_WAITOK);
+	if (buf == NULL || names == NULL) {
+		if (buf) {
+			kfree_data(buf, 262144);
+		}
+		if (names) {
+			kfree_data(names, 2048 * 256);
+		}
+		return;
+	}
+	unsigned used = 0;
+	int num = 0;
+	int ext = -1;
+	int error = pf_walk_dir(vp, ctx, buf, 262144, &used, &num);
+	unsigned n = pf_names(buf, used, names, 2048, &ext);
+	char match[64];
+	int have = PE_parse_boot_argn("pandora_dumpmatch", match, sizeof(match)) && match[0] != 0;
+	printf("PANDORA DUMP: dir %s: %u bytes, %d entries, err %d, layout %d, names %u%s%s\n", path,
+	    used, num, error, ext, n, have ? ", match " : "", have ? match : "");
+	for (unsigned i = 0; i < n; i++) {
+		if (have && !pf_contains(names[i], match)) {
+			continue;
+		}
+		printf("PANDORA DUMP: dir %s/%s\n", path, names[i]);
+	}
+	kfree_data(buf, 262144);
+	kfree_data(names, 2048 * 256);
+}
+
+static void
+pf_dump_file(vnode_t vp, const char *path, off_t size, vfs_context_t ctx)
+{
+	if (size > (off_t)(512 * 1024)) {
+		size = 512 * 1024;
+	}
+	if (size <= 0) {
+		printf("PANDORA DUMP: file %s: empty\n", path);
+		return;
+	}
+	uint8_t *buf = kalloc_data((vm_size_t)size, Z_WAITOK);
+	if (buf == NULL) {
+		return;
+	}
+	int resid = 0;
+	int error = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)size, 0, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	printf("PANDORA DUMP: file %s: %lld bytes err %d\n", path, (long long)size, error);
+	if (!error) {
+		pf_dump_text(path, buf, (unsigned)(size - resid));
+	}
+	kfree_data(buf, (vm_size_t)size);
+}
+
+static void
+pf_dump_path(const char *path, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int error = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (error) {
+		printf("PANDORA DUMP: open %s: %d\n", path, error);
+		return;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_mode);
+	VATTR_WANTED(&va, va_data_size);
+	if (vnode_getattr(vp, &va, ctx)) {
+		printf("PANDORA DUMP: getattr %s failed\n", path);
+		vnode_close(vp, FREAD, ctx);
+		return;
+	}
+	if (S_ISDIR(va.va_mode)) {
+		pf_dump_dir(vp, path, ctx);
+	} else {
+		pf_dump_file(vp, path, va.va_data_size, ctx);
+	}
+	vnode_close(vp, FREAD, ctx);
+}
+
+static void
+pf_dump_newest(const char *spec, vfs_context_t ctx)
+{
+	char tmp[256];
+	strlcpy(tmp, spec, sizeof(tmp));
+	char *comma = strchr(tmp, ',');
+	if (comma == NULL) {
+		printf("PANDORA DUMP: newest %s: no comma\n", spec);
+		return;
+	}
+	*comma = 0;
+	const char *dir = tmp, *prefix = comma + 1;
+	vnode_t dvp = NULLVP;
+	if (vnode_open(dir, FREAD, 0, 0, &dvp, ctx)) {
+		printf("PANDORA DUMP: newest: cannot open %s\n", dir);
+		return;
+	}
+	uint8_t *buf = kalloc_data(262144, Z_WAITOK);
+	char (*names)[256] = kalloc_data(2048 * 256, Z_WAITOK);
+	if (buf == NULL || names == NULL) {
+		printf("PANDORA DUMP: newest: no memory\n");
+		if (buf) {
+			kfree_data(buf, 262144);
+		}
+		if (names) {
+			kfree_data(names, 2048 * 256);
+		}
+		vnode_close(dvp, FREAD, ctx);
+		return;
+	}
+	unsigned used = 0;
+	int num = 0, ext = -1;
+	int error = pf_walk_dir(dvp, ctx, buf, 262144, &used, &num);
+	vnode_close(dvp, FREAD, ctx);
+	unsigned n = pf_names(buf, used, names, 2048, &ext);
+	printf("PANDORA DUMP: newest %s: %d entries, layout %d, names %u, prefix %s\n", dir, num, ext, n,
+	    prefix);
+	size_t plen = strlen(prefix);
+	char best[256] = {0};
+	int64_t best_time = 0;
+	for (unsigned i = 0; i < n; i++) {
+		if (strncmp(names[i], prefix, plen) != 0) {
+			continue;
+		}
+		char path[512];
+		snprintf(path, sizeof(path), "%s/%s", dir, names[i]);
+		vnode_t vp = NULLVP;
+		if (vnode_open(path, FREAD, 0, 0, &vp, ctx)) {
+			continue;
+		}
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_modify_time);
+		if (!vnode_getattr(vp, &va, ctx) && (int64_t)va.va_modify_time.tv_sec >= best_time) {
+			best_time = (int64_t)va.va_modify_time.tv_sec;
+			strlcpy(best, names[i], sizeof(best));
+		}
+		vnode_close(vp, FREAD, ctx);
+	}
+	kfree_data(buf, 262144);
+	kfree_data(names, 2048 * 256);
+	printf("PANDORA DUMP: newest %s/%s (mtime %lld)\n", dir, best, (long long)best_time);
+	if (best[0]) {
+		char path[512];
+		snprintf(path, sizeof(path), "%s/%s", dir, best);
+		vnode_t vp = NULLVP;
+		if (vnode_open(path, FREAD, 0, 0, &vp, ctx) == 0) {
+			struct vnode_attr va;
+			VATTR_INIT(&va);
+			VATTR_WANTED(&va, va_data_size);
+			if (!vnode_getattr(vp, &va, ctx)) {
+				pf_dump_file(vp, path, va.va_data_size, ctx);
+			}
+			vnode_close(vp, FREAD, ctx);
+		}
+	}
+}
+
+static void
+pf_dump_files(vfs_context_t ctx)
+{
+	char list[256];
+	if (PE_parse_boot_argn("pandora_dumpfile", list, sizeof(list)) && list[0] != 0) {
+		for (char *p = list; p && *p; ) {
+			char *comma = strchr(p, ',');
+			if (comma) {
+				*comma = 0;
+			}
+			if (p[0] == '/') {
+				pf_dump_path(p, ctx);
+			}
+			p = comma ? comma + 1 : NULL;
+		}
+	}
+	char spec[256];
+	if (PE_parse_boot_argn("pandora_dumpnewest", spec, sizeof(spec)) && spec[0] != 0) {
+		pf_dump_newest(spec, ctx);
+	}
+}
+
 #endif /* PANDORA */
