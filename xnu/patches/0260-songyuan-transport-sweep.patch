  * is what separates "our SE configuration is wrong" from "the chip does not
  * answer": it runs on every boot and prints one line.
  */
+/*
+ * Transport configuration sweep: the SE loopback is the only way to see whether
+ * the SPI packing/word-length/clock-phase settings are right without the chip.
+ * Each row prints what went out and what came back; a config is right when the
+ * two are byte-identical. Several frame lengths and patterns are run with the
+ * current (official) settings first, so a bit offset that changes with the length
+ * can be told apart from one that does not.
+ */
+static void
+sy_pack_cfg(unsigned start0, unsigned dir, unsigned lenf, uint32_t wlen)
+{
+	uint32_t cfg[4] = {0, 0, 0, 0};
+	unsigned idx = start0;
+	for (unsigned i = 0; i < 4; i++) {
+		cfg[i] = ((uint32_t)idx << SE_PACK_START_SHIFT) |
+		    ((uint32_t)dir << SE_PACK_DIR_SHIFT) |
+		    ((uint32_t)lenf << SE_PACK_LEN_SHIFT);
+		idx = (i + 1) * 8u + start0;
+	}
+	cfg[3] |= SE_PACK_STOP;
+	uint32_t cfg0 = cfg[0] | (cfg[1] << SE_PACK_VECTOR_SHIFT);
+	uint32_t cfg1 = cfg[2] | (cfg[3] << SE_PACK_VECTOR_SHIFT);
+	sy_wr(sy.se, SE_TX_PACK0, cfg0);
+	sy_wr(sy.se, SE_TX_PACK1, cfg1);
+	sy_wr(sy.se, SE_RX_PACK0, cfg0);
+	sy_wr(sy.se, SE_RX_PACK1, cfg1);
+	sy_wr(sy.se, SE_SPI_WORD_LEN, wlen);
+}
+
+static int
+sy_loop_once(const uint8_t *tx, uint8_t *rx, unsigned n)
+{
+	unsigned saved = sy.path;
+	int err;
+	sy.path = 0;
+	sy_engine_select(0);
+	sy_wr(sy.se, SE_SPI_LOOPBACK, 1);
+	err = sy_spi_dma(tx, rx, n);
+	sy_wr(sy.se, SE_SPI_LOOPBACK, 0);
+	sy.path = saved;
+	sy_engine_select(saved);
+	return err;
+}
+
+static void
+sy_sweep_one(const char *tag, const uint8_t *tx, unsigned n)
+{
+	uint8_t rx[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+	int err = sy_loop_once(tx, rx, n);
+	printf("SONGYUAN TOUCH: sweep %s n %u err %d:", tag, n, err);
+	sy_hex(" tx", tx, n);
+	sy_hex(" rx", rx, n);
+	printf("\n");
+}
+
+static void
+sy_transport_sweep(void)
+{
+	static const uint8_t p6[6] = {0xa5, 0x5a, 0x11, 0x22, 0x33, 0x44};
+	static const uint8_t q6[6] = {0xf0, 0x0f, 0xaa, 0x55, 0x3c, 0xc3};
+	static const uint8_t p4[4] = {0xde, 0xad, 0xbe, 0xef};
+	static const uint8_t p8[8] = {0x81, 0x7e, 0x24, 0xdb, 0x5a, 0xa5, 0x3c, 0xc3};
+
+	sy_pack_cfg(7, 1, 7, 4);	/* what the official settings produce today */
+	sy_sweep_one("cur-p4", p4, 4);
+	sy_sweep_one("cur-p6", p6, 6);
+	sy_sweep_one("cur-q6", q6, 6);
+	sy_sweep_one("cur-p8", p8, 8);
+	sy_pack_cfg(8, 1, 7, 4);
+	sy_sweep_one("start8", p6, 6);
+	sy_pack_cfg(0, 1, 7, 4);
+	sy_sweep_one("start0", p6, 6);
+	sy_pack_cfg(7, 0, 7, 4);
+	sy_sweep_one("dir0", p6, 6);
+	sy_pack_cfg(7, 1, 3, 4);
+	sy_sweep_one("len3", p6, 6);
+	sy_pack_cfg(7, 1, 7, 3);
+	sy_sweep_one("wlen3", p6, 6);
+	sy_pack_cfg(7, 1, 7, 0x1fu);
+	sy_sweep_one("wlen31", p6, 6);
+	sy_pack_cfg(7, 1, 7, 4);
+	sy_wr(sy.se, SE_SPI_CPHA, SE_SPI_CPHA_BIT);
+	sy_sweep_one("cpha1", p6, 6);
+	sy_wr(sy.se, SE_SPI_CPHA, 0);
+	sy_wr(sy.se, SE_SPI_CPOL, SE_SPI_CPOL_BIT);
+	sy_sweep_one("cpol1", p6, 6);
+	sy_wr(sy.se, SE_SPI_CPOL, 0);
+	sy_pack_cfg(7, 1, 7, 4);	/* back to the official settings */
+}
